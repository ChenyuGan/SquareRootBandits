namespace Bandits.Support.ReferenceSuppressedDownCoverage

variable {p : ConstructorDimensions.Parameters}

/-- Every previously completed batch survives an ordinary step, including a
step whose solver returns no word. The status premise is explicit. -/
theorem step_completed_subset {eta : LearningRate} (i : Fin (p.m - 1))
    (row : CompleteRow p) (a : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p) (s : State p eta)
    (hu : s.status = .unoccupied) :
    s.downBatch.completed ⊆ (step i row a t own s).downBatch.completed := by
  intro W hW
  simp only [step, hu, ite_true]
  unfold decodeAt
  split
  · simp only [AffineBatchDecoder.decodeStep, AffineBatchDecoder.step]
    split
    · exact hW
    · exact List.mem_append_left _ hW
  · exact hW

/-- Preservation along the literal fold; there is no successful-solver premise. -/
theorem run_completed_subset {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (a : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n))
    (s : State p eta) (hu : s.status = .unoccupied) :
    s.downBatch.completed ⊆ (run i row a history hn us s).downBatch.completed := by
  induction us generalizing s with
  | nil => exact fun _ h => h
  | cons u us ih =>
    have hu' := (step_registers i row a (calendar hn u) (history u) s).2.2.2.2.trans hu
    exact fun W hW => ih _ hu' (step_completed_subset i row a _ _ s hu hW)

/-- A parsed audit decision recovers its actual completing batch and raw word.
The input state invariants are stated explicitly; later applications derive
them from `replay_batch_spec`, rather than supplying a batch. -/
theorem decision_completed_batch {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (a : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n))
    (s : State p eta) (hu : s.status = .unoccupied)
    (hk : s.downBatch.pending.length < AffineBatchDecoder.quota p)
    (hc : ∀ W ∈ s.downBatch.completed, W.length = AffineBatchDecoder.quota p)
    (d : Fin p.T × OrdinaryMessageCodec.DownRecord (codecParams p eta))
    (hd : d ∈ decisions i row a history hn us s) :
    ∃ W ∈ (run i row a history hn us s).downBatch.completed,
      W.length = AffineBatchDecoder.quota p ∧
      AffineBatchDecoder.decisionTime W = some d.1 ∧
      ∃ w : AffineChannelLaw.Word (AffineBatchDecoder.width p),
        AffineBatchDecoder.batchOutput W = some w ∧
        AffineBatchDecoder.satisfies (AffineBatchDecoder.samples W) w ∧
        (OrdinaryMessageCodec.wordEquivFlat (codecParams p eta)).symm w =
          OrdinaryMessageCodec.encodeDown (codecParams p eta) d.2 := by
  obtain ⟨before, u, after, heq, ht, hp⟩ :=
    (mem_decisions_iff i row a history hn us s d).mp hd
  let sb := run i row a history hn before s
  have hbu : sb.status = .unoccupied :=
    (run_registers i row a history hn before s).2.2.2.2.trans hu
  have hbk : sb.downBatch.pending.length < AffineBatchDecoder.quota p :=
    (run_batch_spec i row a history hn before s hu hk hc).1
  obtain ⟨w, _, hge, hw, he⟩ := parsedAt_some_completed eta i row a
    (calendar hn u) (history u) sb.downBatch d.2 hp
  have hel : AffineBatchDecoder.eligible
      (traceAt i row a (calendar hn u) (history u) (calendar hn u)) := by
    by_contra hne
    rw [AffineBatchDecoder.positiveAt, ite_eq_right hne, List.append_nil] at hge
    exact (Nat.not_le_of_lt hbk) hge
  have hlen : sb.downBatch.pending.length + 1 = AffineBatchDecoder.quota p := by
    rw [AffineBatchDecoder.positiveAt, ite_eq_left hel, List.length_append,
      List.length_singleton] at hge
    omega
  let W := sb.downBatch.pending ++ [AffineBatchDecoder.entry p
    (traceAt i row a (calendar hn u) (history u)) (calendar hn u)]
  have hWlen : W.length = AffineBatchDecoder.quota p := by
    simpa only [W, List.length_append, List.length_singleton] using hlen
  have hraw : AffineBatchDecoder.batchOutput W = some w := by
    simpa only [AffineBatchDecoder.positiveAt, ite_eq_left hel] using hw
  have hdecode := decodeAt_complete i row a (calendar hn u) (history u)
    sb.downBatch hel hlen
  have hmember : W ∈ (step i row a (calendar hn u) (history u) sb).downBatch.completed := by
    simp only [step, hbu, ite_true, hdecode]
    exact List.mem_append_right _ (List.mem_singleton_self _)
  have hstepu : (step i row a (calendar hn u) (history u) sb).status = .unoccupied :=
    (step_registers i row a (calendar hn u) (history u) sb).2.2.2.2.trans hbu
  refine ⟨W, ?_, hWlen, ?_, w, hraw, ?_, he⟩
  · rw [heq, run_append]
    exact run_completed_subset i row a history hn after _ hstepu hmember
  · rw [ht]
    exact AffineBatchDecoder.decisionTime_append p _ _ _
  · exact (AffineBatchDecoder.solve_eq_some_iff _ w).mp hraw |>.1

/-- One genuine run step preserves all earlier physical observations. Both
index proofs are typing data and impose no equality of histories. -/
theorem advance_history_prefix (x : ReferenceInitializationRun.Input p)
    (b : ReferenceInitializationRun.Boundary p) (j : Fin p.m) (t : ℕ)
    (ht : t < ReferenceInitializationRun.elapsed p b.completed)
    (ht' : t < ReferenceInitializationRun.elapsed p
      (ReferenceInitializationRun.advance x b).completed) :
    (ReferenceInitializationRun.advance x b).history j ⟨t, ht'⟩ = b.history j ⟨t, ht⟩ := by
  generalize heq : ReferenceInitializationRun.advance x b = c at ht' ⊢
  unfold ReferenceInitializationRun.advance at heq
  split at heq
  · cases heq
    rfl
  · split at heq
    · cases heq
      exact ReferenceInitializationRun.extendedHistory_prefix x b _ j ⟨t, ht⟩
    · cases heq
      rfl

/-- Compatibility of the actual generated histories at any two opportunities,
including the stopped tail after launch. -/
theorem run_history_prefix (x : ReferenceInitializationRun.Input p)
    {r q : ℕ} (hrq : r ≤ q) (j : Fin p.m) (t : ℕ)
    (ht : t < ReferenceInitializationRun.elapsed p (ReferenceInitializationRun.run x r).completed)
    (ht' : t < ReferenceInitializationRun.elapsed p (ReferenceInitializationRun.run x q).completed) :
    (ReferenceInitializationRun.run x q).history j ⟨t, ht'⟩ =
      (ReferenceInitializationRun.run x r).history j ⟨t, ht⟩ := by
  induction q with
  | zero =>
    have hr : r = 0 := by omega
    subst r
    rfl
  | succ q ih =>
    by_cases hr : r ≤ q
    · have hmid : t < ReferenceInitializationRun.elapsed p
          (ReferenceInitializationRun.run x q).completed :=
        ht.trans_le (ReferenceInitializationRun.elapsed_mono p
          (InitializationFailureProvenance.run_completed_mono x hr))
      exact (advance_history_prefix x _ j t hmid ht').trans (ih hr hmid)
    · have hr' : r = q + 1 := by omega
      subst r
      rfl

/-- An already active follower keeps its activation and cannot become newly
forced. This rules out erasure by the fresh handoff at launch. -/
theorem advance_active_preserved (x : ReferenceInitializationRun.Input p)
    (b : ReferenceInitializationRun.Boundary p) (i : ActiveRoundActions.Follower p.m)
    (a : Activation p) (ha : b.activation i = some a) (hf : b.forcedFailure i = false) :
    (ReferenceInitializationRun.advance x b).activation i = some a ∧
      (ReferenceInitializationRun.advance x b).forcedFailure i = false := by
  unfold ReferenceInitializationRun.advance
  split
  · exact ⟨ha, hf⟩
  · split
    · refine ⟨ReferenceInitializationRun.activated_activation x b _ i a ha, ?_⟩
      change (b.forcedFailure i || ReferenceInitializationRun.forced x b _ i) = false
      rw [hf, ReferenceInitializationRun.activated_not_forced x b _ i a ha]
      rfl
    · exact ⟨ha, hf⟩

theorem run_active_preserved (x : ReferenceInitializationRun.Input p)
    {r q : ℕ} (hrq : r ≤ q) (i : ActiveRoundActions.Follower p.m) (a : Activation p)
    (ha : (ReferenceInitializationRun.run x r).activation i = some a)
    (hf : (ReferenceInitializationRun.run x r).forcedFailure i = false) :
    (ReferenceInitializationRun.run x q).activation i = some a ∧
      (ReferenceInitializationRun.run x q).forcedFailure i = false := by
  induction q with
  | zero =>
    have hr : r = 0 := by omega
    subst r
    exact ⟨ha, hf⟩
  | succ q ih =>
    by_cases hr : r ≤ q
    · obtain ⟨ha', hf'⟩ := ih hr
      exact advance_active_preserved x _ i a ha' hf'
    · have hr' : r = q + 1 := by omega
      subst r
      exact ⟨ha, hf⟩

/-- Reindex a fold on an earlier generated prefix into a later generated
history. The history equality is derived from the real run recursion. -/
theorem run_generated_prefix (x : ReferenceInitializationRun.Input p)
    {r q : ℕ} (hrq : r ≤ q) (i : Fin (p.m - 1)) (j : Fin p.m) (a : Activation p)
    (us : List (Fin (ReferenceInitializationRun.elapsed p
      (ReferenceInitializationRun.run x r).completed))) (st : State p x.eta) :
    run i x.row a ((ReferenceInitializationRun.run x q).history j)
        (ReferenceInitializationRun.elapsed_le_T p _)
        (us.map (Fin.castLE (ReferenceInitializationRun.elapsed_mono p
          (InitializationFailureProvenance.run_completed_mono x hrq)))) st =
      run i x.row a ((ReferenceInitializationRun.run x r).history j)
        (ReferenceInitializationRun.elapsed_le_T p _) us st := by
  induction us generalizing st with
  | nil => rfl
  | cons u us ih =>
    simp only [List.map_cons, run]
    have hcalendar : calendar (ReferenceInitializationRun.elapsed_le_T p _)
        (Fin.castLE (ReferenceInitializationRun.elapsed_mono p
          (InitializationFailureProvenance.run_completed_mono x hrq)) u) =
        calendar (ReferenceInitializationRun.elapsed_le_T p _) u := by
      apply Fin.ext
      rfl
    have hh : (ReferenceInitializationRun.run x q).history j
        (Fin.castLE (ReferenceInitializationRun.elapsed_mono p
          (InitializationFailureProvenance.run_completed_mono x hrq)) u) =
        (ReferenceInitializationRun.run x r).history j u :=
      run_history_prefix x hrq j u.val u.isLt _
    rw [hcalendar, hh]
    exact ih _

/-- Actual generated replay on a later prefix retains every earlier completed
batch, without resetting at block boundaries. -/
theorem replay_generated_completed_subset (x : ReferenceInitializationRun.Input p)
    {r q : ℕ} (hrq : r ≤ q) (i : Fin (p.m - 1)) (j : Fin p.m) (a : Activation p) :
    (replay x.eta i x.row a ((ReferenceInitializationRun.run x r).history j)
      (ReferenceInitializationRun.elapsed_le_T p _)).downBatch.completed ⊆
    (replay x.eta i x.row a ((ReferenceInitializationRun.run x q).history j)
      (ReferenceInitializationRun.elapsed_le_T p _)).downBatch.completed := by
  let n := ReferenceInitializationRun.elapsed p (ReferenceInitializationRun.run x r).completed
  let m := ReferenceInitializationRun.elapsed p (ReferenceInitializationRun.run x q).completed
  have hnm : n ≤ m := ReferenceInitializationRun.elapsed_mono p
    (InitializationFailureProvenance.run_completed_mono x hrq)
  let tail : List (Fin m) := List.ofFn (fun v : Fin (m - n) =>
    ⟨n + v.val, by omega⟩)
  have hlist : List.ofFn (fun v : Fin m => v) =
      (List.ofFn (fun u : Fin n => u)).map (Fin.castLE hnm) ++ tail := by
    rw [List.ofFn_congr (show m = n + (m - n) by omega), List.ofFn_add]
    simp only [List.map_ofFn, Function.comp_def]
    rfl
  intro W hW
  change W ∈ (run i x.row a ((ReferenceInitializationRun.run x q).history j)
    (ReferenceInitializationRun.elapsed_le_T p _) (List.ofFn (fun v : Fin m => v))
    (initial p x.eta)).downBatch.completed
  rw [hlist, run_append, run_generated_prefix x hrq]
  exact run_completed_subset i x.row a _ _ tail _
    (replay_registers x.eta i x.row a _ _).2.2.2.2.2 hW

/-- Expand the existing literal suppressed witness, recover the actual solver
batch, and retain it in the replay of the terminal physical history. The sole
event premise is `suppressedDownAt`; activation and prefix compatibility are
proved internally. The raw solver word is not assumed to be authentic. -/
theorem suppressedDownAt_completed_batch (x : ReferenceInitializationRun.Input p)
    (s : Fin (BootstrapDimensions.n_boot p)) (i : ActiveRoundActions.Follower p.m)
    (hs : InitializationFailureProvenance.suppressedDownAt x s i) :
    ∃ a, (ReferenceInitializationRun.output x).activation i = some a ∧
      (ReferenceInitializationRun.output x).forcedFailure i = false ∧
      ∃ W ∈ (replay x.eta (BootstrapPhysicalInput.sourceFollowerIndex p i) x.row a
          ((ReferenceInitializationRun.output x).history
            (PublicDiscreteDraws.followerPlayer p.two_le_m i))
          (ReferenceInitializationRun.elapsed_le_T p _)).downBatch.completed,
        W.length = AffineBatchDecoder.quota p ∧
        ∃ d : Fin p.T × OrdinaryMessageCodec.DownRecord (codecParams p x.eta),
          AffineBatchDecoder.decisionTime W = some d.1 ∧
          OrdinaryMessageCodec.acceptDown (codecParams p x.eta) 0 (d.1.val + 1) d.2 ∧
          d.1.val + 1 < ReferenceInitializationRun.launchRound x ∧
          ∃ w : AffineChannelLaw.Word (AffineBatchDecoder.width p),
            AffineBatchDecoder.batchOutput W = some w ∧
            AffineBatchDecoder.satisfies (AffineBatchDecoder.samples W) w ∧
            (OrdinaryMessageCodec.wordEquivFlat (codecParams p x.eta)).symm w =
              OrdinaryMessageCodec.encodeDown (codecParams p x.eta) d.2 := by
  obtain ⟨h, hcross, hcompleted, hf, a, ha, d, hd, hacc, hlaunch⟩ := hs
  let b := ReferenceInitializationRun.run x s.val
  let z := ReferenceInitializationRun.replayInput x b h i a ha
  have hfb : b.forcedFailure i = false := hf
  have hab : b.activation i = some a := ha
  have hordinary : ReferenceInitializationRun.ordinary x b i =
      replay x.eta (BootstrapPhysicalInput.sourceFollowerIndex p i) x.row a
        (b.history (PublicDiscreteDraws.followerPlayer p.two_le_m i))
        (ReferenceInitializationRun.elapsed_le_T p _) := by
    simp only [ReferenceInitializationRun.ordinary, hfb, Bool.false_eq_true,
      ite_false, hab, atLaunch]
  have hspec := replay_batch_spec x.eta (BootstrapPhysicalInput.sourceFollowerIndex p i)
    x.row a (b.history (PublicDiscreteDraws.followerPlayer p.two_le_m i))
    (ReferenceInitializationRun.elapsed_le_T p _)
  rw [← hordinary] at hspec
  obtain ⟨W, hW, hlen, htime, w, hw, hsat, hencode⟩ := decision_completed_batch
    (BootstrapPhysicalInput.sourceFollowerIndex p i) x.row a
    (ReferencePrelaunchPhysicalReplay.chronologicalHistory z)
    (ReferencePrelaunchPhysicalReplay.blockEnd_le_T p _)
    (ReferencePrelaunchPhysicalReplay.blockIndices z)
    (ReferenceInitializationRun.ordinary x b i)
    (ReferenceInitializationRun.ordinary_registers x b i).2.2.2.2.2
    hspec.1 hspec.2.1 d hd
  have hblock : run (BootstrapPhysicalInput.sourceFollowerIndex p i) x.row a
      (ReferencePrelaunchPhysicalReplay.chronologicalHistory z)
      (ReferencePrelaunchPhysicalReplay.blockEnd_le_T p _)
      (ReferencePrelaunchPhysicalReplay.blockIndices z)
      (ReferenceInitializationRun.ordinary x b i) =
      ReferencePrelaunchPhysicalReplay.blockReplay z := by
    rw [← ReferenceInitializationRun.replayInput_incoming x b h i a ha hf]
    rfl
  rw [hblock, ← ReferenceInitializationRun.replayInput_continued x b h i a ha] at hW
  have hstep : ReferenceInitializationRun.run x (s.val + 1) =
      ReferenceInitializationRun.finishBlock x b h := by
    rw [ReferenceInitializationRun.run_succ,
      ReferenceInitializationRun.advance_of_no_crossing x b hcross h]
  have hWstep : W ∈ (replay x.eta (BootstrapPhysicalInput.sourceFollowerIndex p i)
      x.row a ((ReferenceInitializationRun.run x (s.val + 1)).history
        (PublicDiscreteDraws.followerPlayer p.two_le_m i))
      (ReferenceInitializationRun.elapsed_le_T p _)).downBatch.completed := by
    rw [hstep]
    exact hW
  have hterminal := replay_generated_completed_subset x (Nat.succ_le_of_lt s.isLt)
    (BootstrapPhysicalInput.sourceFollowerIndex p i)
    (PublicDiscreteDraws.followerPlayer p.two_le_m i) a hWstep
  obtain ⟨haout, hfout⟩ := run_active_preserved x (Nat.le_of_lt s.isLt) i a ha hf
  exact ⟨a, haout, hfout, W, hterminal, hlen, d, htime, hacc, hlaunch,
    w, hw, hsat, hencode⟩

variable (p : ConstructorDimensions.Parameters) (ids : IDArray p)
  (rewards : Fin p.T → Fin p.K → Fin (D p + 1))
  (C_star C_h : ℝ) (eta : LearningRate)

local notation "X" => GeneratedBootstrapRoundLaw.input p ids rewards C_star C_h eta

/-- The complete terminal replay collects precisely the actual strict-prelaunch
eligible times, in increasing order. All intervening eligible tests are included.
The activation premise specifies the actual terminal activation. -/
theorem terminal_collected_times (e : GeneratedBootstrapRoundLaw.Coordinates p)
    (i : Fin (p.m - 1)) (a : Activation p)
    (ha : (ReferenceInitializationRun.output (X e)).activation
      (ReferencePrelaunchDownInvariance.receiverFollower i) = some a) :
    (AffineBatchDecoder.collected (replay eta i e.1 a
      ((ReferenceInitializationRun.output (X e)).history
        (PublicDiscreteDraws.followerPlayer p.two_le_m
          (ReferencePrelaunchDownInvariance.receiverFollower i)))
      (ReferenceInitializationRun.elapsed_le_T p _)).downBatch).map
        AffineBatchDecoder.Entry.time =
      (ReferenceSuppressedDownTail.eligibleTimes p ids rewards C_star C_h eta e i).sort
        (· ≤ ·) := by
  let b := ReferenceInitializationRun.output (X e)
  let j := PublicDiscreteDraws.followerPlayer p.two_le_m
    (ReferencePrelaunchDownInvariance.receiverFollower i)
  have hpair := replay_collected_pairwise eta i e.1 a (b.history j)
    (ReferenceInitializationRun.elapsed_le_T p b.completed)
  apply List.Pairwise.eq_of_mem_iff (r := fun t u : Fin p.T => t < u)
    (List.pairwise_map.mpr (hpair.imp (fun h => h)))
    (ReferenceSuppressedDownTail.eligibleTimes p ids rewards C_star C_h eta e i).sortedLT_sort.pairwise
  intro t
  rw [Finset.mem_sort, ReferenceSuppressedDownTail.mem_eligibleTimes_iff]
  constructor
  · intro ht
    obtain ⟨en, hen, htime⟩ := List.mem_map.mp ht
    obtain ⟨u, hau, hdown, hsel, hpos, htu, _⟩ :=
      (replay_collected_mem_iff eta i e.1 a (b.history j)
        (ReferenceInitializationRun.elapsed_le_T p b.completed) en).mp hen
    have hcal : calendar (ReferenceInitializationRun.elapsed_le_T p b.completed) u = t :=
      htu.symm.trans htime
    have hval : u.val = t.val := congrArg Fin.val hcal
    have htt : t.val < ReferenceInitializationRun.elapsed p b.completed := by
      rw [← hval]
      exact u.isLt
    have hlaunch := InitializationFailureProvenance.output_history_round_before_launch
      (X e) t (Nat.succ_le_of_lt htt)
    refine ⟨a, ha, hlaunch, htt, ?_, ?_⟩
    · apply (ReferenceSuppressedDownTail.downInput_selected_iff p i e.1 a t _).mpr
      exact ⟨by rwa [← hval], by rwa [← hcal], by rwa [← hcal]⟩
    · change 0 < (b.history j ⟨t.val, htt⟩).2.val.val
      have hu : (⟨t.val, htt⟩ : Fin (ReferenceInitializationRun.elapsed p b.completed)) = u :=
        Fin.ext hval.symm
      rwa [hu]
  · rintro ⟨a', ha', _, ht, hsel, hpos⟩
    have heqa : a' = a := Option.some.inj (ha'.symm.trans ha)
    subst a'
    obtain ⟨hau, hdown, hfollow⟩ :=
      (ReferenceSuppressedDownTail.downInput_selected_iff p i e.1 a t _).mp hsel
    let en : AffineBatchDecoder.Entry p.T (AffineBatchDecoder.width p) :=
      ⟨t, (e.1.2 t).2 (0, i)⟩
    apply List.mem_map.mpr
    refine ⟨en, ?_, rfl⟩
    apply (replay_collected_mem_iff eta i e.1 a (b.history j)
      (ReferenceInitializationRun.elapsed_le_T p b.completed) en).mpr
    refine ⟨⟨t.val, ht⟩, hau, hdown, hfollow, hpos, ?_, rfl⟩
    rfl

/-- Filtering a finite sorted calendar preserves its exact increasing order. -/
theorem sort_filter_start (A : Finset (Fin p.T)) (start : Fin p.T) :
    ((A.filter (fun t => start ≤ t)).sort (· ≤ ·)) =
      (A.sort (· ≤ ·)).filter (fun t => decide (start ≤ t)) := by
  apply List.Pairwise.eq_of_mem_iff (r := (· < ·))
    (A.filter (fun t => start ≤ t)).sortedLT_sort.pairwise
    (A.sortedLT_sort.pairwise.filter _)
  intro t
  simp only [Finset.mem_sort, Finset.mem_filter, List.mem_filter, decide_eq_true_eq]

/-- A nonempty contiguous segment of a strictly sorted calendar is the first
`length` tests at its own first retained time. No block/batch factor is used. -/
theorem infix_first_times (A : Finset (Fin p.T)) (start : Fin p.T)
    (rest : List (Fin p.T)) (hi : start :: rest <:+: A.sort (· ≤ ·)) :
    (((A.filter (fun t => start ≤ t)).sort (· ≤ ·)).take (start :: rest).length) =
      start :: rest := by
  obtain ⟨before, after, heq⟩ := hi
  have hpair := A.sortedLT_sort.pairwise
  rw [← heq, List.append_assoc] at hpair
  obtain ⟨_, htail, hcross⟩ := List.pairwise_append.mp hpair
  have hbefore : before.filter (fun t => decide (start ≤ t)) = [] := by
    apply List.filter_eq_nil_iff.mpr
    intro t ht
    have hlt : t < start := hcross t ht start List.mem_cons_self
    simpa only [decide_eq_true_eq] using (not_le_of_gt hlt)
  have hafter : ((start :: rest) ++ after).filter (fun t => decide (start ≤ t)) =
      (start :: rest) ++ after := by
    apply List.filter_eq_self.mpr
    intro t ht
    have hle : start ≤ t := by
      rcases List.mem_cons.mp ht with h | h
      · exact h ▸ le_rfl
      · exact (List.pairwise_cons.mp htail).1 t h |>.le
    exact decide_eq_true hle
  rw [sort_filter_start, ← heq, List.append_assoc, List.filter_append,
    hbefore, List.nil_append, hafter]
  exact List.take_left

/-- Every literal suppressed decision supplies one actual calendar start and
one raw solved word in the producer's survival event. Partial batches may
start in an earlier block. No completed batch, stability or trace is an input. -/
theorem suppressedDownAt_fixedStartSurvival
    (e : GeneratedBootstrapRoundLaw.Coordinates p)
    (s : Fin (BootstrapDimensions.n_boot p)) (i : ActiveRoundActions.Follower p.m)
    (hs : InitializationFailureProvenance.suppressedDownAt (X e) s i) :
    ∃ start : Fin p.T, ∃ w : AffineChannelLaw.Word (AffineBatchDecoder.width p),
      e ∈ ReferenceSuppressedDownTail.fixedStartSurvival p ids rewards C_star C_h eta
        (BootstrapPhysicalInput.sourceFollowerIndex p i) start w (AffineBatchDecoder.quota p) := by
  obtain ⟨a, ha, _, W, hW, hlen, _, _, _, _, w, hw, hsat, _⟩ :=
    suppressedDownAt_completed_batch (X e) s i hs
  let k := BootstrapPhysicalInput.sourceFollowerIndex p i
  have hi : ReferencePrelaunchDownInvariance.receiverFollower k = i := by
    apply Fin.ext
    rfl
  have ha' : (ReferenceInitializationRun.output (X e)).activation
      (ReferencePrelaunchDownInvariance.receiverFollower k) = some a := by
    rw [hi]
    exact ha
  let b := ReferenceInitializationRun.output (X e)
  let j := PublicDiscreteDraws.followerPlayer p.two_le_m i
  have hW' : W ∈ (replay eta k e.1 a (b.history j)
      (ReferenceInitializationRun.elapsed_le_T p b.completed)).downBatch.completed := hW
  have hprovenance := (replay_completed_provenance eta k e.1 a (b.history j)
    (ReferenceInitializationRun.elapsed_le_T p b.completed) W hW').2
  have hsample : ∀ en ∈ W, en.sample = ReferenceSuppressedDownTail.downSample p e en.time k := by
    intro en hen
    obtain ⟨u, _, _, _, _, ht, hsample⟩ := hprovenance en hen
    rw [ht]
    exact hsample
  have hinfix : W <:+: AffineBatchDecoder.collected
      (replay eta k e.1 a (b.history j)
        (ReferenceInitializationRun.elapsed_le_T p b.completed)).downBatch :=
    (List.infix_of_mem_flatten hW').trans List.infix_append_left
  have htimes := hinfix.map AffineBatchDecoder.Entry.time
  have hterminal := terminal_collected_times p ids rewards C_star C_h eta e k a ha'
  rw [hi] at hterminal
  rw [hterminal] at htimes
  have hne : W ≠ [] := by
    intro hnil
    rw [hnil, List.length_nil] at hlen
    have := AffineBatchDecoder.quota_pos p
    omega
  cases W with
  | nil => exact (hne rfl).elim
  | cons first rest =>
    have hmaplen : ((first :: rest).map AffineBatchDecoder.Entry.time).length =
        AffineBatchDecoder.quota p := by
      rw [List.length_map]
      exact hlen
    have hfirst : ReferenceSuppressedDownTail.firstTimes p ids rewards C_star C_h eta
        e k first.time (AffineBatchDecoder.quota p) =
        (first :: rest).map AffineBatchDecoder.Entry.time := by
      have h := infix_first_times p
        (ReferenceSuppressedDownTail.eligibleTimes p ids rewards C_star C_h eta e k)
        first.time (rest.map AffineBatchDecoder.Entry.time) htimes
      change ((ReferenceSuppressedDownTail.timesAfter p ids rewards C_star C_h eta
        e k first.time).sort (· ≤ ·)).take
          ((first :: rest).map AffineBatchDecoder.Entry.time).length = _ at h
      rw [hmaplen] at h
      exact h
    have henough : AffineBatchDecoder.quota p ≤
        (ReferenceSuppressedDownTail.timesAfter p ids rewards C_star C_h eta
          e k first.time).card := by
      have hlength := congrArg List.length hfirst
      rw [ReferenceSuppressedDownTail.firstTimes_length, hmaplen] at hlength
      have := Nat.min_le_right (AffineBatchDecoder.quota p)
        (ReferenceSuppressedDownTail.timesAfter p ids rewards C_star C_h eta
          e k first.time).card
      omega
    have hsamples : AffineBatchDecoder.samples (first :: rest) =
        (ReferenceSuppressedDownTail.firstTimes p ids rewards C_star C_h eta
          e k first.time (AffineBatchDecoder.quota p)).map
          (fun t => ReferenceSuppressedDownTail.downSample p e t k) := by
      rw [hfirst, List.map_map]
      exact List.map_congr_left hsample
    refine ⟨first.time, w, henough, ?_⟩
    rw [← hsamples]
    exact hsat

/-- Entire-original-space deterministic coverage of the existing literal
suppressed-decision event by the existing follower/start/word finite union. -/
theorem E_down_subset_quotaSurvivalEvent :
    ReferenceSuppressedDownTail.E_down p ids rewards C_star C_h eta ⊆
      ReferenceSuppressedDownTail.quotaSurvivalEvent p ids rewards C_star C_h eta := by
  rintro e ⟨i, s, hs⟩
  obtain ⟨start, w, hw⟩ := suppressedDownAt_fixedStartSurvival p ids rewards C_star C_h eta e s i hs
  exact Set.mem_iUnion.mpr ⟨BootstrapPhysicalInput.sourceFollowerIndex p i,
    Set.mem_iUnion.mpr ⟨start, Set.mem_iUnion.mpr ⟨w, hw⟩⟩⟩

/-- The literal event has finite outer measure because its original sampling
law is a probability measure; measurability of the event is not used. -/
theorem E_down_outer_measure_ne_top :
    GeneratedBootstrapRoundLaw.originalLaw p
      (ReferenceSuppressedDownTail.E_down p ids rewards C_star C_h eta) ≠ ∞ :=
  measure_ne_top _ _

/-- Real-valued outer-measure bound for the literal event. This uses no
measurability assertion for `E_down`. The inverse power is an actual inverse,
rather than truncated subtraction of natural exponents. -/
theorem E_down_real_outer_probability_le :
    (GeneratedBootstrapRoundLaw.originalLaw p).real
      (ReferenceSuppressedDownTail.E_down p ids rewards C_star C_h eta) ≤
      ((p.m - 1 : ℕ) : ℝ) * p.T * 2 ^ AffineBatchDecoder.width p *
        (2 ^ AffineBatchDecoder.quota p : ℝ)⁻¹ := by
  have hfinite : GeneratedBootstrapRoundLaw.originalLaw p
      (ReferenceSuppressedDownTail.quotaSurvivalEvent p ids rewards C_star C_h eta) ≠ ∞ :=
    measure_ne_top _ _
  exact (measureReal_mono (E_down_subset_quotaSurvivalEvent p ids rewards C_star C_h eta)
    hfinite).trans
      (ReferenceSuppressedDownTail.quotaSurvivalEvent_real_probability_le
        p ids rewards C_star C_h eta)

/-- The source numerical quarter bound, honestly interpreted as outer measure
until the separately owned literal-event measurability result is available. -/
theorem E_down_real_outer_probability_le_quarter :
    (GeneratedBootstrapRoundLaw.originalLaw p).real
      (ReferenceSuppressedDownTail.E_down p ids rewards C_star C_h eta) ≤
      1 / (4 * (N p : ℝ) ^ 2) := by
  have hfinite : GeneratedBootstrapRoundLaw.originalLaw p
      (ReferenceSuppressedDownTail.quotaSurvivalEvent p ids rewards C_star C_h eta) ≠ ∞ :=
    measure_ne_top _ _
  exact (measureReal_mono (E_down_subset_quotaSurvivalEvent p ids rewards C_star C_h eta)
    hfinite).trans
      (ReferenceSuppressedDownTail.quotaSurvivalEvent_real_probability_le_quarter
        p ids rewards C_star C_h eta)

end Bandits.Support.ReferenceSuppressedDownCoverage

