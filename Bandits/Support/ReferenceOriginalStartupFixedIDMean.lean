/-!
# Original reference startup comparator mean on a fixed-ID source law

The charge below is the existing complete-source reference boundary
comparator charge. Its calendar cutoff is identified with the generated
physical start, and literal fixed-ID insertion identifies the same selected
family execution used by the accepted complete-row observable. The original
coordinator selector and all private coordinates remain unchanged.

Sources: `sources/zip4/manuscript/07_public_setup.tex:123-164`,
`sources/zip4/manuscript/appendix_b_communication.tex:753-798`, and
`sources/zip4/manuscript/08_main_theorem.tex:78-105`.
-/

@[expose] public section

noncomputable section

open MeasureTheory
open Bandits.Support.ConstructorDimensions
open Bandits.Support.BootstrapDimensions
open Bandits.Support.CompletePublicTable
open Bandits.Support.BootstrapPrivateRoundStreams
open Bandits.Support.ActualInitializationPhysicalStep
open Bandits.Support.ReferenceActivePhysicalStep
open Bandits.Support.ReferenceInitializationRun
open Bandits.Support.ReferenceInitializationIndexMixture
open Bandits.Support.InitializationRowObservables
open Bandits.Support.ReferenceCompletePhysicalHistory
open Bandits.Support.ReferenceFixedIDSourceSection
open scoped BigOperators

namespace Bandits.Support.ReferenceOriginalStartupFixedIDMean

abbrev Parameters := ConstructorDimensions.Parameters

variable {p : Parameters} (rate : ReferenceActivePhysicalStep.RateInput p)
  (z : BootstrapPrivateRoundStreams.SourceInput p)
  (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
  (C_star C_h : ℝ) (S : Finset (Fin p.K))

/-- The literal comparator charge on the complete original-source reference
execution generated by the accepted input and boundary adapters. -/
@[expose] def startupComparatorCharge : ℝ :=
  InitializationRowObservables.comparatorChargeAtBoundary p rewards S
    (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h)

/-- Expand the existing boundary observable at its exact strict launch cutoff.
The launch is read from this same generated input, including the `T+1`
no-launch convention. -/
theorem startupComparatorCharge_eq_launch_sum :
    startupComparatorCharge rate z rewards C_star C_h S =
      ∑ t : Fin p.T, ∑ a ∈ S,
        if t.val + 1 < ReferenceInitializationRun.launchRound
          (ReferenceCompletePhysicalHistory.generatedInput rate z rewards C_star C_h) then
          ((rewards t a).val : ℝ) / (D p : ℝ) else 0 := by
  unfold startupComparatorCharge
  rw [InitializationRowObservables.comparatorChargeAtBoundary_eq_sum]
  simp only [InitializationRowObservables.launchRound_output_boundary,
    ReferenceCompletePhysicalHistory.generatedBoundary]
  rfl

/-- On the actual generated boundary, the strict launch cutoff is exactly
`t.val < physicalStart`. This includes no crossing, an ordinary crossing,
and a crossing at the terminal boundary. -/
theorem startupComparatorCharge_eq_strictPhysicalStart_sum :
    startupComparatorCharge rate z rewards C_star C_h S =
      ∑ t : Fin p.T, ∑ a ∈ S,
        if t.val < ReferenceCompletePhysicalHistory.physicalStart
          rate z rewards C_star C_h then
          ((rewards t a).val : ℝ) / (D p : ℝ) else 0 := by
  classical
  rw [startupComparatorCharge_eq_launch_sum]
  apply Finset.sum_congr rfl
  intro t ht
  apply Finset.sum_congr rfl
  intro a ha
  have hcut :
      (t.val + 1 < ReferenceInitializationRun.launchRound
        (ReferenceCompletePhysicalHistory.generatedInput rate z rewards C_star C_h)) ↔
      t.val < ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h := by
    cases hcross : (ReferenceInitializationRun.output
        (ReferenceCompletePhysicalHistory.generatedInput rate z rewards C_star C_h)).crossing with
    | none =>
        have hterminal :
            ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h = p.T := by
          simpa [ReferenceCompletePhysicalHistory.physicalStart,
            ReferenceCompletePhysicalHistory.generatedBoundary] using
              ReferenceInitializationRun.output_elapsed_of_no_crossing
                (ReferenceCompletePhysicalHistory.generatedInput rate z rewards C_star C_h)
                hcross
        simp [ReferenceInitializationRun.launchRound, hcross, hterminal]
    | some crossing =>
        simp [ReferenceInitializationRun.launchRound, hcross,
          ReferenceCompletePhysicalHistory.physicalStart,
          ReferenceCompletePhysicalHistory.generatedBoundary]
  by_cases h : t.val + 1 < ReferenceInitializationRun.launchRound
      (ReferenceCompletePhysicalHistory.generatedInput rate z rewards C_star C_h)
  · have hs := hcut.mp h
    simp only [h, hs]
  · have hs : ¬ t.val < ReferenceCompletePhysicalHistory.physicalStart
        rate z rewards C_star C_h := fun hs => h (hcut.mpr hs)
    simp only [h, hs]

/-- The generated source input is definitionally the existing selected-row
adapter applied to the original ID, complete row family, and private arrays.
In particular, its coordinator scalar remains the one inside `e`. -/
theorem generatedInput_fixedIDInsertion_eq_fixedRowInput
    (ids : CompletePublicTable.IDArray p) (rows : CompletePublicTable.CompleteRows p)
    (e : BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p) :
    ReferenceCompletePhysicalHistory.generatedInput rate
        (ReferenceFixedIDSourceSection.fixedIDSourceInsertion ids (rows, e))
        rewards C_star C_h =
      ReferenceInitializationIndexMixture.fixedRowInput p ids rewards C_star C_h rate.eta
        (rows (PrivateSourceStreams.coordinatorIndex p e.1.2)) e := by
  rfl

/-- The inserted boundary of the source-generated input is the existing
whole-family actual output. The coordinator scalar in `e` still chooses the
row and remains an input to that same fixed-row execution. -/
theorem generatedBoundary_fixedIDInsertion_eq_actualOutput
    (ids : CompletePublicTable.IDArray p) (rows : CompletePublicTable.CompleteRows p)
    (e : BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p) :
    ReferenceCompletePhysicalHistory.generatedBoundary rate
        (ReferenceFixedIDSourceSection.fixedIDSourceInsertion ids (rows, e))
        rewards C_star C_h =
      ReferenceInitializationIndexMixture.actualOutput
        p ids rewards C_star C_h rate.eta rows e := by
  rw [ReferenceCompletePhysicalHistory.generatedBoundary]
  rw [generatedInput_fixedIDInsertion_eq_fixedRowInput rate rewards C_star C_h ids rows e]
  rfl

/-- Consequently the inserted fixed-ID charge is the same comparator
observable on the accepted actual output. -/
theorem startupComparatorCharge_fixedIDInsertion_eq_actualOutput
    (ids : CompletePublicTable.IDArray p) (rows : CompletePublicTable.CompleteRows p)
    (e : BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p) :
    startupComparatorCharge rate
        (ReferenceFixedIDSourceSection.fixedIDSourceInsertion ids (rows, e))
        rewards C_star C_h S =
      InitializationRowObservables.comparatorChargeAtBoundary p rewards S
        (ReferenceInitializationIndexMixture.actualOutput
          p ids rewards C_star C_h rate.eta rows e) := by
  unfold startupComparatorCharge
  exact congrArg (InitializationRowObservables.comparatorChargeAtBoundary p rewards S)
    (generatedBoundary_fixedIDInsertion_eq_actualOutput
      rate rewards C_star C_h ids rows e)

private theorem measurable_generatedOutput_source :
    Measurable (fun source : BootstrapPrivateRoundStreams.SourceInput p =>
      ReferenceInitializationRun.output
        (ReferenceCompletePhysicalHistory.generatedInput rate source rewards C_star C_h)) := by
  have hindex : Measurable (fun source : BootstrapPrivateRoundStreams.SourceInput p =>
      PrivateSourceStreams.coordinatorIndex p source.2.1.2) :=
    (PrivateSourceStreams.measurable_coordinatorIndex p).comp
      (measurable_snd.comp (measurable_fst.comp measurable_snd))
  have hselected : Measurable (fun source : BootstrapPrivateRoundStreams.SourceInput p =>
      source.1.2 (PrivateSourceStreams.coordinatorIndex p source.2.1.2)) := by
    have heval : Measurable
        (fun w : Fin (ConstructorDimensions.M p) ×
            BootstrapPrivateRoundStreams.SourceInput p => w.2.1.2 w.1) := by
      apply measurable_from_prod_countable_right
      intro j
      exact (measurable_pi_apply j).comp (measurable_snd.comp measurable_fst)
    exact heval.comp (hindex.prodMk measurable_id)
  have hcoordinates : Measurable
      (fun source : BootstrapPrivateRoundStreams.SourceInput p =>
        (source.1.1, (source.1.2
          (PrivateSourceStreams.coordinatorIndex p source.2.1.2), source.2)) :
        BootstrapPrivateRoundStreams.SourceInput p →
          ReferenceInitializationMeasurability.InputCoordinates p) := by
    exact (measurable_fst.comp measurable_fst).prodMk
      (hselected.prodMk measurable_snd)
  have hcoordinates_eq :
      (fun source : BootstrapPrivateRoundStreams.SourceInput p =>
        ReferenceInitializationRun.output
          (ReferenceCompletePhysicalHistory.generatedInput rate source rewards C_star C_h)) =
      (fun source : BootstrapPrivateRoundStreams.SourceInput p =>
        ReferenceInitializationRun.output
          (ReferenceInitializationMeasurability.inputOfCoordinates p C_star C_h rate.eta
            rewards (source.1.1, (source.1.2
              (PrivateSourceStreams.coordinatorIndex p source.2.1.2), source.2)))) := by
    funext source
    rfl
  rw [hcoordinates_eq]
  exact (ReferenceInitializationMeasurability.measurable_output
    p C_star C_h rate.eta rewards).comp hcoordinates

private theorem actualOutput_comparatorCharge_integral_eq_uniform
    (ids : CompletePublicTable.IDArray p)
    (rows : CompletePublicTable.CompleteRows p) (hS : S.card = p.m) :
    (∫ e, InitializationRowObservables.comparatorChargeAtBoundary p rewards S
      (ReferenceInitializationIndexMixture.actualOutput
        p ids rewards C_star C_h rate.eta rows e)
      ∂BootstrapPrivateRoundStreams.extendedPrivateLaw p) =
      (1 / (ConstructorDimensions.M p : ℝ)) *
        ∑ j : Fin (ConstructorDimensions.M p),
          ∫ e, InitializationRowObservables.comparatorChargeAtBoundary p rewards S
            (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta (rows j) e)
            ∂BootstrapPrivateRoundStreams.extendedPrivateLaw p := by
  classical
  let φ : ReferenceInitializationRun.Boundary p → ℝ :=
    InitializationRowObservables.comparatorChargeAtBoundary p rewards S
  let μ := BootstrapPrivateRoundStreams.extendedPrivateLaw p
  let atom : Fin (ConstructorDimensions.M p) →
      Set (BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p) := fun j =>
    {e | PrivateSourceStreams.coordinatorIndex p e.1.2 = j}
  let f : BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p → ℝ := fun e =>
    φ (ReferenceInitializationIndexMixture.actualOutput
      p ids rewards C_star C_h rate.eta rows e)
  let piece : Fin (ConstructorDimensions.M p) →
      BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p → ℝ := fun j =>
    (atom j).indicator f
  have hφ : Measurable φ :=
    InitializationRowObservables.measurable_comparatorChargeAtBoundary p rewards S
  have hbound (b : ReferenceInitializationRun.Boundary p) :
      φ b ∈ Set.Icc 0 ((p.m : ℝ) * (p.T : ℝ)) :=
    InitializationRowObservables.comparatorChargeAtBoundary_bounds p rewards S hS b
  have hJ : Measurable (fun e : BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p =>
      PrivateSourceStreams.coordinatorIndex p e.1.2) :=
    (PrivateSourceStreams.measurable_coordinatorIndex p).comp
      (measurable_snd.comp measurable_fst)
  have hAtom (j : Fin (ConstructorDimensions.M p)) : MeasurableSet (atom j) := by
    exact hJ (measurableSet_singleton j)
  have hfMeas : Measurable f := by
    exact hφ.comp (ReferenceInitializationIndexMixture.measurable_actualOutput
      p ids rewards C_star C_h rate.eta rows)
  have hC : 0 ≤ (p.m : ℝ) * (p.T : ℝ) := by positivity
  have hf : Integrable f μ := by
    apply Integrable.of_bound hfMeas.aestronglyMeasurable ((p.m : ℝ) * (p.T : ℝ))
      (ae_of_all _ fun e => ?_)
    rw [Real.norm_eq_abs]
    exact abs_le.mpr ⟨by linarith [hC, (hbound
      (ReferenceInitializationIndexMixture.actualOutput
        p ids rewards C_star C_h rate.eta rows e)).1],
      (hbound (ReferenceInitializationIndexMixture.actualOutput
        p ids rewards C_star C_h rate.eta rows e)).2⟩
  have hpoint : ∀ e, f e = ∑ j : Fin (ConstructorDimensions.M p), piece j e := by
    intro e
    calc
      f e = piece (PrivateSourceStreams.coordinatorIndex p e.1.2) e := by
        simp [piece, atom]
      _ = ∑ j : Fin (ConstructorDimensions.M p), piece j e := by
        symm
        apply Finset.sum_eq_single (PrivateSourceStreams.coordinatorIndex p e.1.2)
        · intro j hj hne
          simp [piece, atom, Ne.symm hne]
        · simp
  have hpieces : ∀ j : Fin (ConstructorDimensions.M p), Integrable (piece j) μ := by
    intro j
    simpa [piece] using hf.indicator (hAtom j)
  have hsplit :
      (∫ e, f e ∂μ) =
        ∑ j : Fin (ConstructorDimensions.M p), ∫ e in atom j, f e ∂μ := by
    calc
      (∫ e, f e ∂μ) = ∫ e, ∑ j ∈ Finset.univ, piece j e ∂μ := by
        congr 1
        funext e
        exact hpoint e
      _ = ∑ j ∈ Finset.univ, ∫ e, piece j e ∂μ :=
        integral_finsetSum Finset.univ (fun j hj => hpieces j)
      _ = ∑ j : Fin (ConstructorDimensions.M p), ∫ e in atom j, f e ∂μ := by
        apply Finset.sum_congr rfl
        intro j hj
        change (∫ e, (atom j).indicator f e ∂μ) = ∫ e in atom j, f e ∂μ
        exact integral_indicator (hAtom j)
  calc
    _ = ∑ j : Fin (ConstructorDimensions.M p), ∫ e in atom j, f e ∂μ := hsplit
    _ = ∑ j : Fin (ConstructorDimensions.M p),
        (1 / (ConstructorDimensions.M p : ℝ)) *
          ∫ e, φ (ReferenceInitializationIndexMixture.fixedRowOutput
            p ids rewards C_star C_h rate.eta (rows j) e) ∂μ := by
      apply Finset.sum_congr rfl
      intro j hj
      rcases ReferenceInitializationIndexMixture.actualOutput_bounded_test_disintegration
          p ids rewards C_star C_h rate.eta rows j φ hφ 0
          ((p.m : ℝ) * (p.T : ℝ)) hbound with ⟨_, _, hformula⟩
      exact hformula
    _ = (1 / (ConstructorDimensions.M p : ℝ)) *
        ∑ j : Fin (ConstructorDimensions.M p),
          ∫ e, φ (ReferenceInitializationIndexMixture.fixedRowOutput
            p ids rewards C_star C_h rate.eta (rows j) e) ∂μ := by
      rw [Finset.mul_sum]

/-- The source charge is measurable and pointwise bounded by the full
comparator reward range. These facts use the accepted support cardinality,
without any launch, success, or ID-quality premise. -/
theorem integrable_startupComparatorCharge
    (ids : CompletePublicTable.IDArray p)
    (hS : S ∈ ProductSetLaw.support p.K p.m) :
    Integrable (fun source : BootstrapPrivateRoundStreams.SourceInput p =>
      startupComparatorCharge rate source rewards C_star C_h S)
      (ReferenceFixedIDSourceSection.fixedIDSourceLaw (p := p) ids) := by
  have hcard : S.card = p.m := BootstrapLaunchMonitor.supportedSet_card p hS
  have hm : Measurable (fun source : BootstrapPrivateRoundStreams.SourceInput p =>
      startupComparatorCharge rate source rewards C_star C_h S) := by
    exact (InitializationRowObservables.measurable_comparatorChargeAtBoundary p rewards S).comp
      (measurable_generatedOutput_source rate rewards C_star C_h)
  have hbound (source : BootstrapPrivateRoundStreams.SourceInput p) :
      startupComparatorCharge rate source rewards C_star C_h S ∈
        Set.Icc 0 ((p.m : ℝ) * (p.T : ℝ)) := by
    exact InitializationRowObservables.comparatorChargeAtBoundary_bounds p rewards S hcard
      (ReferenceCompletePhysicalHistory.generatedBoundary rate source rewards C_star C_h)
  have hC : 0 ≤ (p.m : ℝ) * (p.T : ℝ) := by positivity
  apply Integrable.of_bound hm.aestronglyMeasurable ((p.m : ℝ) * (p.T : ℝ))
    (ae_of_all _ fun source => ?_)
  rw [Real.norm_eq_abs]
  exact abs_le.mpr ⟨by linarith [hC, (hbound source).1], (hbound source).2⟩

/-- Under every literal fixed-ID source law, the complete original-source
charge has exactly the accepted complete-row `c_S` mean. The continuous row
family, original selector scalar, and every private coordinate are preserved
by insertion. -/
theorem fixedIDSourceLaw_integral_startupComparatorCharge_eq_c_S
    (ids : CompletePublicTable.IDArray p)
    (hS : S ∈ ProductSetLaw.support p.K p.m) :
    (∫ source, startupComparatorCharge rate source rewards C_star C_h S
      ∂ReferenceFixedIDSourceSection.fixedIDSourceLaw (p := p) ids) =
      ∫ row, InitializationRowObservables.c_S p ids rewards C_star C_h rate.eta S row
        ∂CompletePublicTable.completeRowMeasure p := by
  have hcard : S.card = p.m := BootstrapLaunchMonitor.supportedSet_card p hS
  have hsourceInt := integrable_startupComparatorCharge
    rate rewards C_star C_h S ids hS
  let φ : ReferenceInitializationRun.Boundary p → ℝ :=
    InitializationRowObservables.comparatorChargeAtBoundary p rewards S
  let μrows := CompletePublicTable.completeRowsMeasure p
  let μrow := CompletePublicTable.completeRowMeasure p
  let μprivate := BootstrapPrivateRoundStreams.extendedPrivateLaw p
  let f : CompletePublicTable.CompleteRows p ×
      BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p → ℝ := fun w =>
    φ (ReferenceInitializationIndexMixture.actualOutput
      p ids rewards C_star C_h rate.eta w.1 w.2)
  have hφ : Measurable φ :=
    InitializationRowObservables.measurable_comparatorChargeAtBoundary p rewards S
  have hφBound (b : ReferenceInitializationRun.Boundary p) :
      φ b ∈ Set.Icc 0 ((p.m : ℝ) * (p.T : ℝ)) :=
    InitializationRowObservables.comparatorChargeAtBoundary_bounds p rewards S hcard b
  have hprodMeas : Measurable f := by
    exact hφ.comp (ReferenceInitializationIndexMixture.measurable_actualOutput_family
      p ids rewards C_star C_h rate.eta)
  have hC : 0 ≤ (p.m : ℝ) * (p.T : ℝ) := by positivity
  have hprodInt : Integrable f (μrows.prod μprivate) := by
    apply Integrable.of_bound hprodMeas.aestronglyMeasurable
      ((p.m : ℝ) * (p.T : ℝ)) (ae_of_all _ fun w => ?_)
    rw [Real.norm_eq_abs]
    exact abs_le.mpr ⟨by linarith [hC, (hφBound
      (ReferenceInitializationIndexMixture.actualOutput
        p ids rewards C_star C_h rate.eta w.1 w.2)).1],
      (hφBound (ReferenceInitializationIndexMixture.actualOutput
        p ids rewards C_star C_h rate.eta w.1 w.2)).2⟩
  have hfixedMeas : Measurable
      (fun w : CompleteRow p × BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p =>
        φ (ReferenceInitializationIndexMixture.fixedRowOutput
          p ids rewards C_star C_h rate.eta w.1 w.2)) := by
    exact hφ.comp (ReferenceInitializationIndexMixture.measurable_fixedRowOutput_pair
      p ids rewards C_star C_h rate.eta)
  have hfixedInt : Integrable
      (fun w : CompleteRow p × BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p =>
        φ (ReferenceInitializationIndexMixture.fixedRowOutput
          p ids rewards C_star C_h rate.eta w.1 w.2))
      (μrow.prod μprivate) := by
    apply Integrable.of_bound hfixedMeas.aestronglyMeasurable
      ((p.m : ℝ) * (p.T : ℝ)) (ae_of_all _ fun w => ?_)
    rw [Real.norm_eq_abs]
    exact abs_le.mpr ⟨by linarith [hC, (hφBound
      (ReferenceInitializationIndexMixture.fixedRowOutput
        p ids rewards C_star C_h rate.eta w.1 w.2)).1],
      (hφBound (ReferenceInitializationIndexMixture.fixedRowOutput
        p ids rewards C_star C_h rate.eta w.1 w.2)).2⟩
  have hrowAverage :
      (∫ rows : CompletePublicTable.CompleteRows p,
        (1 / (ConstructorDimensions.M p : ℝ)) *
          ∑ j : Fin (ConstructorDimensions.M p),
            ∫ e, φ (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta (rows j) e) ∂μprivate
          ∂μrows) =
      ∫ row, InitializationRowObservables.c_S p ids rewards C_star C_h rate.eta S row
        ∂μrow := by
    have htermJointInt (j : Fin (ConstructorDimensions.M p)) :
        Integrable
          (fun w : CompletePublicTable.CompleteRows p ×
              BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p =>
            φ (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta (w.1 j) w.2))
          (μrows.prod μprivate) := by
      let mp : MeasurePreserving
          (fun w : CompletePublicTable.CompleteRows p ×
              BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p => (w.1 j, w.2))
          (μrows.prod μprivate) (μrow.prod μprivate) :=
        MeasurePreserving.prod
          (CompletePublicTable.measurePreserving_completeRowProjection p j)
          (MeasurePreserving.id μprivate)
      exact mp.integrable_comp_of_integrable hfixedInt
    have htermOuterInt (j : Fin (ConstructorDimensions.M p)) :
        Integrable
          (fun rows : CompletePublicTable.CompleteRows p =>
            ∫ e, φ (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta (rows j) e) ∂μprivate) μrows :=
      (htermJointInt j).integral_prod_left
    have htermMean (j : Fin (ConstructorDimensions.M p)) :
        (∫ rows, ∫ e, φ (ReferenceInitializationIndexMixture.fixedRowOutput
          p ids rewards C_star C_h rate.eta (rows j) e) ∂μprivate ∂μrows) =
        ∫ row, InitializationRowObservables.c_S p ids rewards C_star C_h rate.eta S row
          ∂μrow := by
      let mp : MeasurePreserving
          (fun w : CompletePublicTable.CompleteRows p ×
              BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p => (w.1 j, w.2))
          (μrows.prod μprivate) (μrow.prod μprivate) :=
        MeasurePreserving.prod
          (CompletePublicTable.measurePreserving_completeRowProjection p j)
          (MeasurePreserving.id μprivate)
      have hmap : (μrows.prod μprivate).map
          (fun w : CompletePublicTable.CompleteRows p ×
            BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p => (w.1 j, w.2)) =
            μrow.prod μprivate := mp.map_eq
      have hfixedMap : AEStronglyMeasurable
          (fun w : CompleteRow p × BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p =>
            φ (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta w.1 w.2))
          ((μrows.prod μprivate).map (fun w : CompletePublicTable.CompleteRows p ×
            BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p => (w.1 j, w.2))) := by
        rw [hmap]
        exact hfixedMeas.aestronglyMeasurable
      calc
        _ = ∫ w, φ (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta (w.1 j) w.2)
              ∂(μrows.prod μprivate) := by
          symm
          exact integral_prod _ (htermJointInt j)
        _ = ∫ w, φ (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta w.1 w.2) ∂μrow.prod μprivate := by
          calc
            _ = ∫ w, φ (ReferenceInitializationIndexMixture.fixedRowOutput
                  p ids rewards C_star C_h rate.eta w.1 w.2)
                  ∂(μrows.prod μprivate).map (fun w : CompletePublicTable.CompleteRows p ×
                    BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p => (w.1 j, w.2)) := by
              symm
              exact integral_map mp.measurable.aemeasurable hfixedMap
            _ = _ := by rw [hmap]
        _ = ∫ w, InitializationRowObservables.initializationComparatorCharge
              p ids rewards C_star C_h rate.eta S w.1 w.2 ∂μrow.prod μprivate := by
          apply integral_congr_ae
          exact ae_of_all _ fun w =>
            (InitializationRowObservables.initializationComparatorCharge_eq_comparatorChargeAtBoundary
              p ids rewards C_star C_h rate.eta S w.1 w.2).symm
        _ = ∫ row, InitializationRowObservables.c_S p ids rewards C_star C_h rate.eta S row
              ∂μrow :=
          InitializationRowObservables.integral_rowPrivate_comparatorCharge
            p ids rewards C_star C_h rate.eta S hcard
    have htermOuterInt' : ∀ j ∈ (Finset.univ : Finset (Fin (ConstructorDimensions.M p))),
        Integrable
          (fun rows : CompletePublicTable.CompleteRows p =>
            ∫ e, φ (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta (rows j) e) ∂μprivate) μrows := by
      intro j hj
      exact htermOuterInt j
    calc
      _ = (1 / (ConstructorDimensions.M p : ℝ)) *
          ∑ j : Fin (ConstructorDimensions.M p),
            ∫ rows, ∫ e, φ (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta (rows j) e) ∂μprivate ∂μrows := by
            rw [integral_const_mul, integral_finsetSum Finset.univ htermOuterInt']
      _ = (1 / (ConstructorDimensions.M p : ℝ)) *
          ∑ j : Fin (ConstructorDimensions.M p),
            ∫ row, InitializationRowObservables.c_S p ids rewards C_star C_h rate.eta S row
              ∂μrow := by
            congr 1
            apply Finset.sum_congr rfl
            intro j hj
            exact htermMean j
      _ = ∫ row,
          InitializationRowObservables.c_S p ids rewards C_star C_h rate.eta S row
          ∂μrow := by
            have hMpos : 0 < (ConstructorDimensions.M p : ℝ) :=
              Nat.cast_pos.mpr (ConstructorDimensions.M_pos p)
            simp only [Finset.sum_const, Finset.card_univ, Fintype.card_fin,
              nsmul_eq_mul]
            field_simp [ne_of_gt hMpos]
  have hproductCharge :
      (∫ w, f w ∂μrows.prod μprivate) =
        ∫ row, InitializationRowObservables.c_S p ids rewards C_star C_h rate.eta S row
          ∂μrow := by
    calc
      _ = ∫ rows, ∫ e, f (rows, e) ∂μprivate ∂μrows := integral_prod _ hprodInt
      _ = ∫ rows, (1 / (ConstructorDimensions.M p : ℝ)) *
          ∑ j : Fin (ConstructorDimensions.M p),
            ∫ e, φ (ReferenceInitializationIndexMixture.fixedRowOutput
              p ids rewards C_star C_h rate.eta (rows j) e) ∂μprivate ∂μrows := by
          apply integral_congr_ae
          exact ae_of_all _ fun rows =>
            actualOutput_comparatorCharge_integral_eq_uniform
              rate rewards C_star C_h S ids rows hcard
      _ = ∫ row, InitializationRowObservables.c_S p ids rewards C_star C_h rate.eta S row
          ∂μrow := hrowAverage
  calc
    (∫ source, startupComparatorCharge rate source rewards C_star C_h S
        ∂ReferenceFixedIDSourceSection.fixedIDSourceLaw (p := p) ids) =
      ∫ w : CompletePublicTable.CompleteRows p ×
          BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p,
        startupComparatorCharge rate
          (ReferenceFixedIDSourceSection.fixedIDSourceInsertion ids w)
          rewards C_star C_h S
          ∂(CompletePublicTable.completeRowsMeasure p).prod
            (BootstrapPrivateRoundStreams.extendedPrivateLaw p) :=
      ReferenceFixedIDSourceSection.fixedIDSourceLaw_integral_eq_insertion
        (p := p) ids _ hsourceInt
    _ = ∫ w : CompletePublicTable.CompleteRows p ×
          BootstrapPrivateRoundStreams.ExtendedPrivateCoordinates p,
        f w ∂μrows.prod μprivate := by
        apply integral_congr_ae
        exact ae_of_all _ fun w => by
          rcases w with ⟨rows, e⟩
          simpa [f, φ, ReferenceFixedIDSourceSection.fixedIDSourceInsertion] using
            startupComparatorCharge_fixedIDInsertion_eq_actualOutput
              rate rewards C_star C_h S ids rows e
    _ = ∫ row, InitializationRowObservables.c_S p ids rewards C_star C_h rate.eta S row
        ∂CompletePublicTable.completeRowMeasure p := hproductCharge

/-- The comparator-only public ancestor yields the explicit source startup
threshold for every fixed ID and supported comparator, without an
identification-good or scalar-lower-bound premise. -/
theorem fixedIDSourceLaw_integral_startupComparatorCharge_le
    (ids : CompletePublicTable.IDArray p)
    (hS : S ∈ ProductSetLaw.support p.K p.m) :
    (∫ source, startupComparatorCharge rate source rewards C_star C_h S
      ∂ReferenceFixedIDSourceSection.fixedIDSourceLaw (p := p) ids) ≤
        128 * (4 * (BootstrapStartupCostScale.Q C_star C_h p : ℝ) +
          (p.K : ℝ) * (B_boot p : ℝ) +
          (p.m : ℝ) * (p.K : ℝ) * (B_boot p : ℝ) * (4 * (b_N p : ℝ))) +
        (p.m : ℝ) * (p.T : ℝ) / (N p : ℝ) ^ 2 := by
  rw [fixedIDSourceLaw_integral_startupComparatorCharge_eq_c_S
    rate rewards C_star C_h S ids hS]
  exact GeneratedComparatorChargeTail.c_S_integral_le
    p ids rewards C_star C_h rate.eta S hS

end Bandits.Support.ReferenceOriginalStartupFixedIDMean

