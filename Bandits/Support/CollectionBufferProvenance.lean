public import Bandits.Support.CollectionCheckedExecution

import Lean.Elab.Tactic.Omega

/-!
# Raw-buffer and decoder-record provenance for checked collection folds

The mathematical evidence is
`sources/zip4/manuscript/06_interruptions.tex:16-28,80-100,257-283` and
`sources/zip4/manuscript/appendix_a_local_protocol.tex:8-14,60-64`.

These results follow the existing checked collection operations. Their inputs
remain the explicit local inputs of `CollectionCheckedExecution`; they do not
certify a physical recorder, channel, message, or cutoff value.
-/

@[expose] public section

namespace Bandits.Support.CollectionBufferProvenance

open Bandits.Support.CollectionCheckedExecution
open Bandits.Support.CoordinatorCollectionLedger
open Bandits.Support.OrdinaryMessageCodec

variable {p : ConstructorDimensions.Parameters}
variable {eta : ℝ} {heta : 0 < eta}
  {hcap : sourceLearningCap p eta} {n : ℕ}
  {hn : (n : ℝ) = eta * (ConstructorDimensions.D p : ℝ)}

/-- The unique lookup operation used to recover one supplied round from the
actual chronological fold list. It has no fallback value. -/
def findRoundInput? (inputs : List (RoundInput (p := p) (eta := eta)))
    (r : Fin p.T) : Option (RoundInput (p := p) (eta := eta)) :=
  inputs.find? fun input => decide (input.round = r)

/-- The literal queue record named by one supplied round. The arrival field is
retained independently of the enable bit before freeze, as in `replayRecords?`;
`QueueReplay` preserves its registers when the record bit is false. -/
def suppliedReplayRecord (input : RoundInput (p := p) (eta := eta))
    (a : Fin p.K) (freezeAt : ℕ) : Bool × ℕ :=
  (input.enabled && decide (sourceRound input.round < freezeAt),
    if sourceRound input.round < freezeAt then localArrival input.raw a else 0)

/-- Extract records from actual round lookups in the requested order. A missing
round returns `none`; no Boolean or arrival default is used. -/
def suppliedReplayRecords? (inputs : List (RoundInput (p := p) (eta := eta)))
    (a : Fin p.K) (freezeAt : ℕ) : List (Fin p.T) → Option (List (Bool × ℕ))
  | [] => some []
  | r :: rest => do
      let input ← findRoundInput? inputs r
      let tail ← suppliedReplayRecords? inputs a freezeAt rest
      pure (suppliedReplayRecord input a freezeAt :: tail)

/-- The raw-buffer cell generated by supplied inputs, retaining the actual
initial cell if the matching input does not insert a positive arrival. -/
def suppliedRawBufferCell (initial : Fin p.K → Fin p.T → Option ℕ)
    (inputs : List (RoundInput (p := p) (eta := eta))) (freezeAt : ℕ)
    (a : Fin p.K) (r : Fin p.T) : Option ℕ :=
  match findRoundInput? inputs r with
  | none => initial a r
  | some input =>
      match input.raw with
      | none => initial a r
      | some (b, amount) =>
          if b = a ∧ 0 < amount ∧ sourceRound r < freezeAt then
            some amount
          else initial a r

/-- The option-valued cell produced by a successful stage (1) update at its
own round. -/
def rawBufferCellAfterStart (old : Fin p.K → Fin p.T → Option ℕ)
    (raw : Option (Fin p.K × ℕ)) (a : Fin p.K) (freezeAt : ℕ)
    (r : Fin p.T) : Option ℕ :=
  match raw with
  | none => old a r
  | some (b, amount) =>
      if b = a ∧ 0 < amount ∧ sourceRound r < freezeAt then some amount
      else old a r

/-- Every supplied label in a chronological suffix lies in its exact
half-open calendar interval. -/
theorem chronologicalFrom_round_bounds (cursor : ℕ)
    (inputs : List (RoundInput (p := p) (eta := eta)))
    (hchron : chronologicalFrom cursor inputs)
    (input : RoundInput (p := p) (eta := eta)) (hmem : input ∈ inputs) :
    cursor ≤ sourceRound input.round ∧
      sourceRound input.round < cursor + inputs.length := by
  induction inputs generalizing cursor with
  | nil => simp at hmem
  | cons head rest ih =>
      rcases hchron with ⟨hhead, htail⟩
      simp only [List.mem_cons] at hmem
      rcases hmem with heq | hmem
      · subst input
        simp [hhead]
      · have htailBounds := ih (cursor + 1) htail hmem
        simp only [List.length_cons]
        constructor <;> omega

/-- Chronology gives strict increase from the head to every later input. -/
theorem chronologicalFrom_tail_round_ne_head (cursor : ℕ)
    (input : RoundInput (p := p) (eta := eta))
    (rest : List (RoundInput (p := p) (eta := eta)))
    (hchron : chronologicalFrom cursor (input :: rest))
    (later : RoundInput (p := p) (eta := eta)) (hlater : later ∈ rest) :
    later.round ≠ input.round := by
  rcases hchron with ⟨hhead, htail⟩
  have hbound := chronologicalFrom_round_bounds (cursor + 1) rest
    htail later hlater
  intro heq
  have hlabel := congrArg sourceRound heq
  omega

/-- A successful chronological list has no repeated round label. -/
theorem chronologicalFrom_rounds_nodup (cursor : ℕ)
    (inputs : List (RoundInput (p := p) (eta := eta)))
    (hchron : chronologicalFrom cursor inputs) :
    (inputs.map RoundInput.round).Nodup := by
  induction inputs generalizing cursor with
  | nil => simp
  | cons input rest ih =>
      rcases hchron with ⟨hhead, htail⟩
      apply List.nodup_cons.mpr
      constructor
      · intro hmem
        rcases List.mem_map.mp hmem with ⟨later, hlater, hround⟩
        have hne := chronologicalFrom_tail_round_ne_head cursor input rest
          ⟨hhead, htail⟩ later hlater
        exact hne hround
      · exact ih (cursor + 1) htail

/-- A lookup result is an actual matching input from the fold list. -/
theorem findRoundInput?_spec
    (inputs : List (RoundInput (p := p) (eta := eta))) (r : Fin p.T)
    (input : RoundInput (p := p) (eta := eta))
    (hfind : findRoundInput? inputs r = some input) :
    input ∈ inputs ∧ input.round = r := by
  induction inputs with
  | nil => simp [findRoundInput?] at hfind
  | cons head rest ih =>
      by_cases hhead : head.round = r
      · simp [findRoundInput?, hhead] at hfind
        subst input
        exact ⟨by simp, hhead⟩
      · simp [findRoundInput?, hhead] at hfind
        rcases ih hfind with ⟨hmem, hround⟩
        exact ⟨by simp [hmem], hround⟩

/-- Chronological lookup returns a supplied input at its unique round label. -/
theorem chronologicalFrom_findRoundInput?_of_mem
    (cursor : ℕ) (inputs : List (RoundInput (p := p) (eta := eta)))
    (hchron : chronologicalFrom cursor inputs)
    (input : RoundInput (p := p) (eta := eta)) (hmem : input ∈ inputs) :
    findRoundInput? inputs input.round = some input := by
  induction inputs generalizing cursor with
  | nil => simp at hmem
  | cons head rest ih =>
      rcases hchron with ⟨hhead, htail⟩
      simp only [List.mem_cons] at hmem
      rcases hmem with heq | hmem
      · subst input
        simp [findRoundInput?]
      · have hbound := chronologicalFrom_round_bounds (cursor + 1) rest
          htail input hmem
        have hneq : head.round ≠ input.round := by
          intro heq
          have hlabel := congrArg sourceRound heq
          omega
        simp [findRoundInput?, hneq]
        exact ih (cursor + 1) htail hmem

/-- Different members of a chronological input list have different round
labels, proved directly from the actual cursor progression. -/
theorem chronologicalFrom_input_round_injective (cursor : ℕ)
    (inputs : List (RoundInput (p := p) (eta := eta)))
    (hchron : chronologicalFrom cursor inputs)
    (x y : RoundInput (p := p) (eta := eta))
    (hx : x ∈ inputs) (hy : y ∈ inputs) (hxy : x.round = y.round) : x = y := by
  induction inputs generalizing cursor with
  | nil => simp at hx
  | cons head rest ih =>
      rcases hchron with ⟨hhead, htail⟩
      simp only [List.mem_cons] at hx hy
      rcases hx with hx | hx <;> rcases hy with hy | hy
      · cases hx
        cases hy
        rfl
      · subst x
        have hbound := chronologicalFrom_round_bounds (cursor + 1) rest
          htail y hy
        have hlabel := congrArg sourceRound hxy
        omega
      · subst y
        have hbound := chronologicalFrom_round_bounds (cursor + 1) rest
          htail x hx
        have hlabel := congrArg sourceRound hxy
        omega
      · exact ih (cursor + 1) htail hx hy

/-- Every in-interval calendar label has exactly one matching input in a
successful chronological list; the returned `find?` result is that input. -/
theorem chronologicalFrom_findRoundInput?_in_interval
    (cursor : ℕ) (inputs : List (RoundInput (p := p) (eta := eta)))
    (hchron : chronologicalFrom cursor inputs)
    (r : Fin p.T) (hlo : cursor ≤ sourceRound r)
    (hhi : sourceRound r < cursor + inputs.length) :
    ∃ input, findRoundInput? inputs r = some input ∧
      input.round = r ∧ input ∈ inputs ∧
      ∀ other, findRoundInput? inputs r = some other → other = input := by
  induction inputs generalizing cursor with
  | nil => simp at hhi; omega
  | cons head rest ih =>
      rcases hchron with ⟨hhead, htail⟩
      by_cases htarget : sourceRound r = cursor
      · have hr : r = head.round := by
          apply Fin.ext
          have hval : r.val = head.round.val := by
            dsimp [sourceRound] at htarget hhead
            omega
          exact hval
        subst r
        have hfind : findRoundInput? (head :: rest) head.round = some head := by
          simp [findRoundInput?]
        refine ⟨head, hfind, rfl, by simp, ?_⟩
        intro other hother
        rw [hfind] at hother
        injection hother with heq
        exact heq.symm
      · have hlo' : cursor + 1 ≤ sourceRound r := by omega
        have hhi' : sourceRound r < (cursor + 1) + rest.length := by
          simp only [List.length] at hhi
          omega
        obtain ⟨input, hfind, hround, hmem, huniq⟩ :=
          ih (cursor + 1) htail hlo' hhi'
        have hheadne : head.round ≠ r := by
          intro heq
          have hlabel := congrArg sourceRound heq
          omega
        refine ⟨input, ?_, hround, ?_, ?_⟩
        · simpa [findRoundInput?, hheadne] using hfind
        · simp [hmem]
        · intro other hother
          have htailFind : findRoundInput? rest r = some other := by
            simpa [findRoundInput?, hheadne] using hother
          exact huniq other htailFind

/-- A missing round lookup is certified by absence of every matching input. -/
theorem findRoundInput?_eq_none_of_forall
    (inputs : List (RoundInput (p := p) (eta := eta))) (r : Fin p.T)
    (hmiss : ∀ input ∈ inputs, input.round ≠ r) :
    findRoundInput? inputs r = none := by
  induction inputs generalizing r with
  | nil => rfl
  | cons head rest ih =>
      have hhead := hmiss head (by simp)
      have htail : ∀ input ∈ rest, input.round ≠ r := by
        intro input hmem
        apply hmiss input
        simp [hmem]
      simp [findRoundInput?, hhead]
      exact htail

/-- A calendar list generated by `calendarIndices` contains only labels in
its represented source-round interval. -/
theorem calendarIndices_sourceRound_bounds
    (T start length : ℕ) (hbound : start + length ≤ T)
    (r : Fin T) (hmem : r ∈ calendarIndices T start length hbound) :
    start + 1 ≤ sourceRound r ∧ sourceRound r < start + length + 1 := by
  have hmem' : r ∈ List.ofFn (fun j : Fin length =>
      (⟨start + j.val, by have hj := j.isLt; omega⟩ : Fin T)) := by
    simpa [calendarIndices] using hmem
  obtain ⟨j, hj⟩ := List.mem_ofFn.mp hmem'
  have hval : r.val = start + j.val := by
    have h := congrArg Fin.val hj
    simpa using h.symm
  have hjlt := j.isLt
  constructor <;> dsimp [sourceRound] <;> omega

/-- The exact positive-buffer cell has the source's local arrival under
`getD 0`, with zero after freeze. -/
theorem bufferedArrival_eq_localArrival_of_rawBufferCell
    (l : Ledger p eta heta hcap n hn) (a : Fin p.K) (r : Fin p.T)
    (raw : Option (Fin p.K × ℕ))
    (hcell : l.rawBuffer a r = match raw with
      | none => none
      | some (b, amount) =>
          if b = a ∧ 0 < amount ∧ sourceRound r < l.freezeAt then
            some amount
          else none) :
    bufferedArrival l a r =
      if sourceRound r < l.freezeAt then localArrival raw a else 0 := by
  cases raw with
  | none => simp [bufferedArrival, localArrival, hcell]
  | some pair =>
      rcases pair with ⟨b, amount⟩
      by_cases hba : b = a
      · subst b
        by_cases hzero : amount = 0
        · simp [bufferedArrival, localArrival, hcell, hzero]
        · have hpositive : 0 < amount := by omega
          by_cases hbefore : sourceRound r < l.freezeAt
          · simp [bufferedArrival, localArrival, hcell, hpositive, hbefore]
          · simp [bufferedArrival, hcell, hpositive, hbefore]
      · simp [bufferedArrival, localArrival, hcell, hba]

/-- Actual replay records equal the records obtained from unique supplied
round lookups once their enable-history and raw-buffer fields are identified. -/
theorem replayRecords?_matches_supplied
    (l : Ledger p eta heta hcap n hn)
    (inputs : List (RoundInput (p := p) (eta := eta))) (a : Fin p.K)
    (indices : List (Fin p.T))
    (hdata : ∀ r ∈ indices, ∃ input,
      findRoundInput? inputs r = some input ∧
      l.enabledHistory r = some input.enabled ∧
      bufferedArrival l a r =
        if sourceRound r < l.freezeAt then localArrival input.raw a else 0) :
    replayRecords? l a indices =
      suppliedReplayRecords? inputs a l.freezeAt indices := by
  induction indices with
  | nil => rfl
  | cons r rest ih =>
      obtain ⟨input, hfind, henabled, harrival⟩ := hdata r (by simp)
      have hround := (findRoundInput?_spec inputs r input hfind).2
      have htail : ∀ s ∈ rest, ∃ input,
          findRoundInput? inputs s = some input ∧
          l.enabledHistory s = some input.enabled ∧
          bufferedArrival l a s =
            if sourceRound s < l.freezeAt then localArrival input.raw a else 0 := by
        intro s hs
        exact hdata s (by simp [hs])
      simp [replayRecords?, suppliedReplayRecords?, suppliedReplayRecord,
        hfind, henabled, harrival, hround, ih htail]

/-- Successful record extraction preserves list concatenation and record
order. -/
theorem replayRecords?_append
    (l : Ledger p eta heta hcap n hn) (a : Fin p.K)
    (leftIndices rightIndices : List (Fin p.T))
    (leftRecords rightRecords : List (Bool × ℕ))
    (hleft : replayRecords? l a leftIndices = some leftRecords)
    (hright : replayRecords? l a rightIndices = some rightRecords) :
    replayRecords? l a (leftIndices ++ rightIndices) =
      some (leftRecords ++ rightRecords) := by
  induction leftIndices generalizing leftRecords with
  | nil =>
      simp [replayRecords?] at hleft
      subst leftRecords
      simpa using hright
  | cons r rest ih =>
      cases henabled : l.enabledHistory r with
      | none => simp [replayRecords?, henabled] at hleft
      | some enabled =>
          cases htail : replayRecords? l a rest with
          | none => simp [replayRecords?, henabled, htail] at hleft
          | some tailRecords =>
              have hrecords :
                  (enabled && decide (sourceRound r < l.freezeAt),
                    bufferedArrival l a r) :: tailRecords = leftRecords := by
                simpa [replayRecords?, henabled, htail] using hleft
              subst leftRecords
              have hcombined := ih tailRecords htail
              simp [replayRecords?, henabled, hcombined]

/-- At the candidate's own cell, stage (1) inserts exactly a positive raw
arrival for the matching unknown arm before freeze, independent of enablement. -/
theorem startRoundCandidate_unknown_raw_buffer_cell
    (l : Ledger p eta heta hcap n hn) (r : Fin p.T) (enabled : Bool)
    (raw : Option (Fin p.K × ℕ)) (a : Fin p.K)
    (hunknown : l.currentRegisters a = none) :
    (startRoundCandidate l r enabled raw).rawBuffer a r =
      match raw with
      | none => l.rawBuffer a r
      | some (b, amount) =>
          if b = a ∧ 0 < amount ∧ sourceRound r < l.freezeAt then some amount
          else l.rawBuffer a r := by
  cases raw with
  | none => rfl
  | some pair =>
      rcases pair with ⟨b, amount⟩
      by_cases hba : b = a
      · subst b
        by_cases hpositive : 0 < amount
        · by_cases hbefore : sourceRound r < l.freezeAt
          · have hput := putRaw_same l.rawBuffer a r amount
            simp [startRoundCandidate, hunknown, hpositive, hbefore, hput]
          · simp [startRoundCandidate, hunknown, hpositive, hbefore]
        · have hzero : amount = 0 := by omega
          simp [startRoundCandidate, hunknown, hzero]
      · by_cases hcondition : l.currentRegisters b = none ∧
            0 < amount ∧ sourceRound r < l.freezeAt
        · have hput := putRaw_other l.rawBuffer b a r r amount
            (Or.inl (Ne.symm hba))
          have hfalse : ¬ (b = a ∧ 0 < amount ∧ sourceRound r < l.freezeAt) := by
            rintro ⟨hab, _, _⟩
            exact hba hab
          simpa [startRoundCandidate, hcondition, hfalse, hba] using hput
        ·
          simp [startRoundCandidate, hcondition, hba]

/-- The successful checked stage (1) writes the exact candidate cell. -/
theorem startRound_success_unknown_buffer_cell
    (l started : Ledger p eta heta hcap n hn) (t : ℕ) (enabled : Bool)
    (raw : Option (Fin p.K × ℕ)) (a : Fin p.K) (r : Fin p.T)
    (hr : sourceRound r = t)
    (hstart : startRound l t enabled raw = .success started)
    (hunknown : l.currentRegisters a = none) :
    started.rawBuffer a r = rawBufferCellAfterStart l.rawBuffer raw a l.freezeAt r := by
  have hstartR : startRound l (sourceRound r) enabled raw = .success started := by
    simpa [hr] using hstart
  have hgenerated := startRound_success_generatedBuffer l started r enabled raw hstartR
  have hcell := congrFun (congrFun hgenerated a) r
  cases raw with
  | none =>
      simpa [rawBufferCellAfterStart, generatedBuffer, singleRoundSequence,
        explicitArrivalCell, stageOneBufferCell] using hcell
  | some pair =>
      rcases pair with ⟨b, amount⟩
      by_cases hba : b = a
      · subst b
        by_cases hzero : amount = 0
        · simpa [rawBufferCellAfterStart, generatedBuffer, singleRoundSequence,
            explicitArrivalCell, stageOneBufferCell, hzero] using hcell
        · have hpositive : 0 < amount := by omega
          by_cases hbefore : sourceRound r < l.freezeAt
          · simpa [rawBufferCellAfterStart, generatedBuffer, singleRoundSequence,
              explicitArrivalCell, stageOneBufferCell, hunknown, hzero, hpositive,
              hbefore] using hcell
          · simpa [rawBufferCellAfterStart, generatedBuffer, singleRoundSequence,
              explicitArrivalCell, stageOneBufferCell, hunknown, hzero, hpositive,
              hbefore] using hcell
      · simpa [rawBufferCellAfterStart, generatedBuffer, singleRoundSequence,
          explicitArrivalCell, stageOneBufferCell, hba] using hcell

/-- A successful actual start cannot turn a known arm into an unknown arm. -/
theorem startRound_success_unknown_reflects
    (l started : Ledger p eta heta hcap n hn) (t : ℕ) (enabled : Bool)
    (raw : Option (Fin p.K × ℕ)) (a : Fin p.K)
    (hstart : startRound l t enabled raw = .success started)
    (hunknown : started.currentRegisters a = none) :
    l.currentRegisters a = none := by
  rw [startRound_success_candidate l started t enabled raw hstart] at hunknown
  cases hreg : l.currentRegisters a with
  | none => rfl
  | some current => simp [startRoundCandidate, hreg] at hunknown

/-- Successful decoding preserves an arm that remains unknown. -/
theorem decodeUp_success_preserves_unknown_arm
    (l result : Ledger p eta heta hcap n hn) (i : Fin (p.m - 1))
    (parsed : Option (UpRecord (codecParams p eta))) (a : Fin p.K)
    (hdecode : decodeUp l i parsed = .success result)
    (hunknown : result.currentRegisters a = none) :
    l.currentRegisters a = none ∧ result.rawBuffer a = l.rawBuffer a := by
  cases parsed with
  | none =>
      by_cases hinput : validLedgerCheck l = true ∧ l.phase = .started ∧
          1 ≤ l.cutoff ∧ l.cutoff ≤ l.cursor ∧ l.cursor ≤ p.T
      · let next : Ledger p eta heta hcap n hn := { l with phase := .decoded }
        by_cases hvalid : validLedgerCheck next = true
        · simp [decodeUp, hinput, next, hvalid] at hdecode
        · simp [decodeUp, hinput, next, hvalid] at hdecode
      · simp [decodeUp, hinput] at hdecode
  | some M =>
      obtain ⟨_, _, _, _, _, _, _, _, hcandidate⟩ :=
        decodeUp_success_candidate l result i M hdecode
      rw [hcandidate] at hunknown ⊢
      have hneq : l.assignment.arm i ≠ a := by
        intro heq
        subst a
        simp [acceptUpCandidate, Function.update_self] at hunknown
      constructor
      · simpa [acceptUpCandidate, Function.update_of_ne (Ne.symm hneq)] using hunknown
      · change clearRawArm l.rawBuffer (l.assignment.arm i) a = l.rawBuffer a
        funext r
        exact clearRawArm_other l.rawBuffer (l.assignment.arm i) a r
          (Ne.symm hneq)

/-- An ordinary decoder rejection returns the literal phase-advanced ledger. -/
theorem decodeUp_rejected_phase_candidate
    (l result : Ledger p eta heta hcap n hn) (i : Fin (p.m - 1))
    (parsed : Option (UpRecord (codecParams p eta)))
    (hdecode : decodeUp l i parsed = .rejected result) :
    result = { l with phase := .decoded } := by
  cases parsed with
  | none =>
      by_cases hinput : validLedgerCheck l = true ∧ l.phase = .started ∧
          1 ≤ l.cutoff ∧ l.cutoff ≤ l.cursor ∧ l.cursor ≤ p.T
      · let next : Ledger p eta heta hcap n hn := { l with phase := .decoded }
        by_cases hvalid : validLedgerCheck next = true
        · have heq : Checked.rejected next = Checked.rejected result := by
            simpa [decodeUp, hinput, next, hvalid] using hdecode
          injection heq with hresult
          exact hresult.symm
        · simp [decodeUp, hinput, next, hvalid] at hdecode
      · simp [decodeUp, hinput] at hdecode
  | some M =>
      by_cases hinput : validLedgerCheck l = true ∧ l.phase = .started ∧
          1 ≤ l.cutoff ∧ l.cutoff ≤ l.cursor ∧ l.cursor ≤ p.T
      · by_cases haccept : acceptUpCheck l i M = true
        · by_cases hunknown : l.currentRegisters (l.assignment.arm i) = none ∧
              l.cutoffRegisters (l.assignment.arm i) = none
          · let prefixIndices := calendarIndices p.T (l.cutoff - 1)
                (l.cursor - l.cutoff) (by omega)
            let lastIndex : Fin p.T := ⟨l.cursor - 1, by omega⟩
            cases hpast : replayRecords? l (l.assignment.arm i) prefixIndices with
            | none => simp [decodeUp, hinput, haccept, hunknown,
                prefixIndices, hpast] at hdecode
            | some past =>
                cases hlast : replayRecords? l (l.assignment.arm i)
                    [lastIndex] with
                | none => simp [decodeUp, hinput, haccept, hunknown,
                    prefixIndices, lastIndex, hpast, hlast] at hdecode
                | some records =>
                    cases records with
                    | nil => simp [decodeUp, hinput, haccept, hunknown,
                        prefixIndices, lastIndex, hpast, hlast] at hdecode
                    | cons current tail =>
                        cases tail with
                        | nil =>
                            by_cases hdomain : replayOutputDomainsCheck (p := p)
                                (4 * n) M.val.q (past ++ [current]) = true
                            · by_cases hvalid : validLedgerCheck
                                  (acceptUpCandidate l i M past current) = true
                              · simp [decodeUp, hinput, haccept, hunknown,
                                  prefixIndices, lastIndex, hpast, hlast,
                                  hdomain, hvalid] at hdecode
                              · simp [decodeUp, hinput, haccept, hunknown,
                                  prefixIndices, lastIndex, hpast, hlast,
                                  hdomain, hvalid] at hdecode
                            · simp [decodeUp, hinput, haccept, hunknown,
                                prefixIndices, lastIndex, hpast, hlast,
                                hdomain] at hdecode
                        | cons _ _ => simp [decodeUp, hinput, haccept,
                            hunknown, prefixIndices, lastIndex, hpast,
                            hlast] at hdecode
          · simp [decodeUp, hinput, haccept, hunknown] at hdecode
        · let next : Ledger p eta heta hcap n hn := { l with phase := .decoded }
          by_cases hvalid : validLedgerCheck next = true
          · have heq : Checked.rejected next = Checked.rejected result := by
              simpa [decodeUp, hinput, haccept, next, hvalid] using hdecode
            injection heq with hresult
            exact hresult.symm
          · simp [decodeUp, hinput, haccept, next, hvalid] at hdecode
      · simp [decodeUp, hinput] at hdecode

/-- A rejected actual decoder preserves all register and raw-buffer fields. -/
theorem decodeUp_rejected_preserves_arm
    (l result : Ledger p eta heta hcap n hn) (i : Fin (p.m - 1))
    (parsed : Option (UpRecord (codecParams p eta))) (a : Fin p.K)
    (hdecode : decodeUp l i parsed = .rejected result) :
    result.currentRegisters a = l.currentRegisters a ∧
      result.rawBuffer a = l.rawBuffer a := by
  rw [decodeUp_rejected_phase_candidate l result i parsed hdecode]
  exact ⟨rfl, rfl⟩

/-- A successful fold preserves its original assignment and receiver-local
cutoff, freeze, and base-score fields. -/
def collectionContext (l : Ledger p eta heta hcap n hn) :=
  (l.assignment, l.sigma, l.cutoff, l.freezeAt, l.baseScore)

theorem startRound_success_context
    (l result : Ledger p eta heta hcap n hn) (t : ℕ) (enabled : Bool)
    (raw : Option (Fin p.K × ℕ))
    (h : startRound l t enabled raw = .success result) :
    collectionContext result = collectionContext l := by
  rw [startRound_success_candidate l result t enabled raw h]
  rfl

theorem decodeUp_success_context
    (l result : Ledger p eta heta hcap n hn) (i : Fin (p.m - 1))
    (parsed : Option (UpRecord (codecParams p eta)))
    (h : decodeUp l i parsed = .success result) :
    collectionContext result = collectionContext l := by
  cases parsed with
  | none =>
      by_cases hinput : validLedgerCheck l = true ∧ l.phase = .started ∧
          1 ≤ l.cutoff ∧ l.cutoff ≤ l.cursor ∧ l.cursor ≤ p.T
      · let next : Ledger p eta heta hcap n hn := { l with phase := .decoded }
        by_cases hvalid : validLedgerCheck next = true
        · simp [decodeUp, hinput, next, hvalid] at h
        · simp [decodeUp, hinput, next, hvalid] at h
      · simp [decodeUp, hinput] at h
  | some M =>
      obtain ⟨_, _, _, _, _, _, _, _, hcandidate⟩ :=
        decodeUp_success_candidate l result i M h
      rw [hcandidate]
      simp [collectionContext, acceptUpCandidate]

theorem decodeUp_rejected_context
    (l result : Ledger p eta heta hcap n hn) (i : Fin (p.m - 1))
    (parsed : Option (UpRecord (codecParams p eta)))
    (h : decodeUp l i parsed = .rejected result) :
    collectionContext result = collectionContext l := by
  cases parsed with
  | none =>
      rw [decodeUp_rejected_phase_candidate l result i .none h]
      rfl
  | some M =>
      rw [decodeUp_rejected_phase_candidate l result i (some M) h]
      rfl

theorem finishRound_success_context
    (l result : Ledger p eta heta hcap n hn)
    (h : finishRound l = .success result) :
    collectionContext result = collectionContext l := by
  rw [finishRound_success_candidate l result h]
  rfl

/-- Each successful checked round preserves receiver-local context. -/
theorem checkedRound_success_context
    (l started decoded finished : Ledger p eta heta hcap n hn)
    (input : RoundInput (p := p) (eta := eta))
    (hstart : startRound l (sourceRound input.round) input.enabled input.raw =
      .success started)
    (hdecode : decodeUp started input.selectedFollower input.parsed =
        .success decoded ∨ decodeUp started input.selectedFollower input.parsed =
        .rejected decoded)
    (hfinish : finishRound decoded = .success finished) :
    collectionContext finished = collectionContext l := by
  rcases hdecode with hsuccess | hrejected
  · exact (finishRound_success_context decoded finished hfinish).trans
      ((decodeUp_success_context started decoded input.selectedFollower
        input.parsed hsuccess).trans
        (startRound_success_context l started (sourceRound input.round)
          input.enabled input.raw hstart))
  · exact (finishRound_success_context decoded finished hfinish).trans
      ((decodeUp_rejected_context started decoded input.selectedFollower
        input.parsed hrejected).trans
        (startRound_success_context l started (sourceRound input.round)
          input.enabled input.raw hstart))

/-- Successful checked rounds advance the cursor by one. -/
theorem checkedRound_success_cursor
    (l started decoded finished : Ledger p eta heta hcap n hn)
    (input : RoundInput (p := p) (eta := eta))
    (hstart : startRound l (sourceRound input.round) input.enabled input.raw =
      .success started)
    (hdecode : decodeUp started input.selectedFollower input.parsed =
        .success decoded ∨ decodeUp started input.selectedFollower input.parsed =
        .rejected decoded)
    (hfinish : finishRound decoded = .success finished) :
    finished.cursor = l.cursor + 1 := by
  have hstartCursor := startRound_success_cursor l started
    (sourceRound input.round) input.enabled input.raw hstart
  have hstartTime := startRound_success_time l started
    (sourceRound input.round) input.enabled input.raw hstart
  have hdecodeBehavior := decodeUp_cursor_behavior started
    input.selectedFollower input.parsed
  have hdecodedCursor : decoded.cursor = started.cursor := by
    rcases hdecode with hsuccess | hrejected
    · rw [hsuccess] at hdecodeBehavior
      exact hdecodeBehavior.1
    · rw [hrejected] at hdecodeBehavior
      exact hdecodeBehavior.1
  have hfinishCursor := finishRound_success_chronology decoded finished hfinish
  calc
    finished.cursor = decoded.cursor + 1 := hfinishCursor.1
    _ = started.cursor + 1 := by rw [hdecodedCursor]
    _ = l.cursor + 1 := by rw [hstartCursor, hstartTime]
/-- Successful checked folds preserve receiver-local context. -/
theorem checkedRounds_success_preserves_context
    (l final : Ledger p eta heta hcap n hn)
    (inputs : List (RoundInput (p := p) (eta := eta)))
    (accepted : List Bool)
    (h : checkedRounds l inputs = some (accepted, final)) :
    collectionContext final = collectionContext l := by
  induction inputs generalizing l accepted final with
  | nil =>
      simp [checkedRounds] at h
      rcases h with ⟨rfl, rfl⟩
      rfl
  | cons input rest ih =>
      cases hs : startRound l (sourceRound input.round) input.enabled input.raw with
      | invalid => simp [checkedRounds, hs] at h
      | rejected bad => simp [checkedRounds, hs] at h
      | success started =>
          cases hd : decodeUp started input.selectedFollower input.parsed with
          | invalid => simp [checkedRounds, hs, hd] at h
          | rejected decoded =>
              cases hf : finishRound decoded with
              | invalid => simp [checkedRounds, hs, hd, hf] at h
              | rejected bad => simp [checkedRounds, hs, hd, hf] at h
              | success finished =>
                  cases hr : checkedRounds finished rest with
                  | none => simp [checkedRounds, hs, hd, hf, hr] at h
                  | some pair =>
                      simp [checkedRounds, hs, hd, hf, hr] at h
                      rcases h with ⟨rfl, rfl⟩
                      exact (ih finished pair.2 pair.1 hr).trans
                        ((finishRound_success_context decoded finished hf).trans
                          ((decodeUp_rejected_context started decoded
                            input.selectedFollower input.parsed hd).trans
                            (startRound_success_context l started
                              (sourceRound input.round) input.enabled input.raw hs)))
          | success decoded =>
              cases hf : finishRound decoded with
              | invalid => simp [checkedRounds, hs, hd, hf] at h
              | rejected bad => simp [checkedRounds, hs, hd, hf] at h
              | success finished =>
                  cases hr : checkedRounds finished rest with
                  | none => simp [checkedRounds, hs, hd, hf, hr] at h
                  | some pair =>
                      simp [checkedRounds, hs, hd, hf, hr] at h
                      rcases h with ⟨rfl, rfl⟩
                      exact (ih finished pair.2 pair.1 hr).trans
                        ((finishRound_success_context decoded finished hf).trans
                          ((decodeUp_success_context started decoded
                            input.selectedFollower input.parsed hd).trans
                            (startRound_success_context l started
                              (sourceRound input.round) input.enabled input.raw hs)))

/-- A successful checked round preserves an unknown arm's raw column. -/
theorem checkedRound_success_unknown_column
    (l started decoded finished : Ledger p eta heta hcap n hn)
    (input : RoundInput (p := p) (eta := eta)) (a : Fin p.K)
    (hstart : startRound l (sourceRound input.round) input.enabled input.raw =
      .success started)
    (hdecode : decodeUp started input.selectedFollower input.parsed =
        .success decoded ∨ decodeUp started input.selectedFollower input.parsed =
        .rejected decoded)
    (hfinish : finishRound decoded = .success finished)
    (hunknown : finished.currentRegisters a = none) :
    l.currentRegisters a = none ∧
      (∀ r, finished.rawBuffer a r =
        (startRoundCandidate l input.round input.enabled input.raw).rawBuffer a r) := by
  have hdecodedUnknown : decoded.currentRegisters a = none := by
    rw [finishRound_success_candidate decoded finished hfinish] at hunknown
    exact hunknown
  have hfinishRaw : finished.rawBuffer a = decoded.rawBuffer a := by
    rw [finishRound_success_candidate decoded finished hfinish]
    rfl
  have hstartedCandidate : started =
      startRoundCandidate l input.round input.enabled input.raw := by
    have hcand := startRound_success_candidate l started
      (sourceRound input.round) input.enabled input.raw hstart
    have hindex : (⟨sourceRound input.round - 1, by
        simp [sourceRound]⟩ : Fin p.T) = input.round := by
      apply Fin.ext
      simp [sourceRound]
    rw [hcand, hindex]
  rcases hdecode with hsuccess | hrejected
  · have hfields := decodeUp_success_preserves_unknown_arm started decoded
      input.selectedFollower input.parsed a hsuccess hdecodedUnknown
    have hstartedUnknown := hfields.1
    have hinputUnknown := startRound_success_unknown_reflects l started
      (sourceRound input.round) input.enabled input.raw a hstart hstartedUnknown
    refine ⟨hinputUnknown, ?_⟩
    intro r
    calc
      finished.rawBuffer a r = decoded.rawBuffer a r := congrFun hfinishRaw r
      _ = started.rawBuffer a r := congrFun hfields.2 r
      _ = (startRoundCandidate l input.round input.enabled input.raw).rawBuffer a r := by
        rw [hstartedCandidate]
  · have hfields := decodeUp_rejected_preserves_arm started decoded
      input.selectedFollower input.parsed a hrejected
    have hstartedUnknown := hfields.1.symm.trans hdecodedUnknown
    have hinputUnknown := startRound_success_unknown_reflects l started
      (sourceRound input.round) input.enabled input.raw a hstart hstartedUnknown
    refine ⟨hinputUnknown, ?_⟩
    intro r
    calc
      finished.rawBuffer a r = decoded.rawBuffer a r := congrFun hfinishRaw r
      _ = started.rawBuffer a r := congrFun hfields.2 r
      _ = (startRoundCandidate l input.round input.enabled input.raw).rawBuffer a r := by
        rw [hstartedCandidate]

/-- Stage (1) stores a positive matching arrival before freeze, regardless of
enablement. -/
theorem startRoundCandidate_unknown_raw_cell
    (l : Ledger p eta heta hcap n hn)
    (input : RoundInput (p := p) (eta := eta)) (a : Fin p.K)
    (hunknown : l.currentRegisters a = none) :
    (startRoundCandidate l input.round input.enabled input.raw).rawBuffer a
        input.round =
      match input.raw with
      | none => l.rawBuffer a input.round
      | some (b, amount) =>
          if b = a ∧ 0 < amount ∧ sourceRound input.round < l.freezeAt then
            some amount
          else l.rawBuffer a input.round := by
  exact startRoundCandidate_unknown_raw_buffer_cell l input.round input.enabled
    input.raw a hunknown

/-- A checked start writes no buffer cell at a different calendar round. -/
theorem startRoundCandidate_buffer_other_round
    (l : Ledger p eta heta hcap n hn)
    (input : RoundInput (p := p) (eta := eta)) (a : Fin p.K) (r : Fin p.T)
    (hr : r ≠ input.round) :
    (startRoundCandidate l input.round input.enabled input.raw).rawBuffer a r =
      l.rawBuffer a r := by
  cases hraw : input.raw with
  | none => rfl
  | some pair =>
      rcases pair with ⟨b, amount⟩
      by_cases hcond : l.currentRegisters b = none ∧ 0 < amount ∧
          sourceRound input.round < l.freezeAt
      · have hput := putRaw_other l.rawBuffer b a input.round r amount
          (Or.inr hr)
        simpa [startRoundCandidate, hraw, hcond] using hput
      · simp [startRoundCandidate, hcond]
/-- A successful checked round only removes pending followers. -/
theorem checkedRound_success_pending_subset
    (l started decoded finished : Ledger p eta heta hcap n hn)
    (input : RoundInput (p := p) (eta := eta))
    (hstart : startRound l (sourceRound input.round) input.enabled input.raw =
      .success started)
    (hdecode : decodeUp started input.selectedFollower input.parsed =
        .success decoded ∨ decodeUp started input.selectedFollower input.parsed =
        .rejected decoded)
    (hfinish : finishRound decoded = .success finished) :
    finished.pending ⊆ l.pending := by
  have hstartPending : started.pending = l.pending := by
    rw [startRound_success_candidate l started (sourceRound input.round) input.enabled input.raw hstart]; rfl
  have hfinishPending : finished.pending = decoded.pending := by rw [finishRound_success_candidate decoded finished hfinish]; rfl
  rcases hdecode with hsuccess | hrejected
  · cases hparsed : input.parsed with
    | none =>
        rw [hparsed] at hsuccess
        by_cases hinput : validLedgerCheck started = true ∧ started.phase = .started ∧
            1 ≤ started.cutoff ∧ started.cutoff ≤ started.cursor ∧
              started.cursor ≤ p.T
        · let next : Ledger p eta heta hcap n hn := { started with phase := .decoded }
          by_cases hvalid : validLedgerCheck next = true
          · simp [decodeUp, hinput, next, hvalid] at hsuccess
          · simp [decodeUp, hinput, next, hvalid] at hsuccess
        · simp [decodeUp, hinput] at hsuccess
    | some M =>
        rw [hparsed] at hsuccess
        obtain ⟨_, _, _, past, current, _, _, _, hcandidate⟩ :=
          decodeUp_success_candidate started decoded input.selectedFollower M hsuccess
        rw [hfinishPending, hcandidate, ← hstartPending]
        intro follower hfollower
        change follower ∈ started.pending.erase input.selectedFollower at hfollower
        exact (Finset.mem_erase.mp hfollower).2
  · rw [hfinishPending, decodeUp_rejected_phase_candidate started decoded
      input.selectedFollower input.parsed hrejected, hstartPending]

/-- A successful fold with a final unknown arm preserves its exact positive-
arrival buffer column by chronological lookup and only removes pending followers. -/
theorem checkedRounds_unknown_arm_buffer
    (l final : Ledger p eta heta hcap n hn)
    (inputs : List (RoundInput (p := p) (eta := eta)))
    (accepted : List Bool) (a : Fin p.K)
    (h : checkedRounds l inputs = some (accepted, final))
    (hfinal : final.currentRegisters a = none)
    (hchron : chronologicalFrom l.cursor inputs) :
    l.currentRegisters a = none ∧
      (∀ r, final.rawBuffer a r =
        suppliedRawBufferCell l.rawBuffer inputs l.freezeAt a r) ∧
      final.pending ⊆ l.pending := by
  induction inputs generalizing l accepted final with
  | nil =>
      simp [checkedRounds] at h
      rcases h with ⟨rfl, rfl⟩
      exact ⟨hfinal, by intro r; simp [suppliedRawBufferCell, findRoundInput?],
        Finset.Subset.rfl⟩
  | cons input rest ih =>
      rcases hchron with ⟨hinputRound, htailChron⟩
      cases hs : startRound l (sourceRound input.round) input.enabled input.raw with
      | invalid => simp [checkedRounds, hs] at h
      | rejected bad => simp [checkedRounds, hs] at h
      | success started =>
          cases hd : decodeUp started input.selectedFollower input.parsed with
          | invalid => simp [checkedRounds, hs, hd] at h
          | rejected decoded =>
              cases hf : finishRound decoded with
              | invalid => simp [checkedRounds, hs, hd, hf] at h
              | rejected bad => simp [checkedRounds, hs, hd, hf] at h
              | success finished =>
                  cases hr : checkedRounds finished rest with
                  | none => simp [checkedRounds, hs, hd, hf, hr] at h
                  | some pair =>
                      simp [checkedRounds, hs, hd, hf, hr] at h
                      rcases h with ⟨rfl, rfl⟩
                      have hcontext := checkedRound_success_context l started
                        decoded finished input hs (Or.inr hd) hf
                      have hfreeze := congrArg (fun c => c.2.2.2.1) hcontext
                      change finished.freezeAt = l.freezeAt at hfreeze
                      have hnext := checkedRound_success_cursor l started decoded
                        finished input hs (Or.inr hd) hf
                      have htailChron' : chronologicalFrom finished.cursor rest := by
                        rw [hnext]
                        exact htailChron
                      have htail := ih finished pair.2 pair.1 hr hfinal htailChron'
                      have hstep := checkedRound_success_unknown_column l started
                        decoded finished input a hs (Or.inr hd) hf htail.1
                      have hpending := checkedRound_success_pending_subset l
                        started decoded finished input hs (Or.inr hd) hf
                      refine ⟨hstep.1, ?_, htail.2.2.trans hpending⟩
                      intro r
                      by_cases hsame : r = input.round
                      · subst r
                        have hnoLater : ∀ later ∈ rest,
                            later.round ≠ input.round :=
                          chronologicalFrom_tail_round_ne_head l.cursor
                            input rest ⟨hinputRound, htailChron⟩
                        have hlookupTail := findRoundInput?_eq_none_of_forall
                          rest input.round hnoLater
                        have htailInitial : suppliedRawBufferCell
                            finished.rawBuffer rest finished.freezeAt a input.round =
                              finished.rawBuffer a input.round := by
                          simp [suppliedRawBufferCell, hlookupTail]
                        have htailCell := htail.2.1 input.round
                        rw [hfreeze] at htailCell
                        rw [hfreeze] at htailInitial
                        rw [htailInitial] at htailCell
                        rw [hstep.2 input.round] at htailCell
                        have hheadFormula : suppliedRawBufferCell l.rawBuffer
                            (input :: rest) l.freezeAt a input.round =
                              (startRoundCandidate l input.round input.enabled
                                input.raw).rawBuffer a input.round := by
                          simpa [suppliedRawBufferCell, findRoundInput?] using
                            (startRoundCandidate_unknown_raw_cell l input a hstep.1).symm
                        rw [hheadFormula]
                        exact htailCell
                      · have htailCell := htail.2.1 r
                        rw [hfreeze] at htailCell
                        have hroundNe : input.round ≠ r := by
                          intro heq
                          exact hsame heq.symm
                        have hstepCell : finished.rawBuffer a r = l.rawBuffer a r := by
                          calc
                            finished.rawBuffer a r =
                                (startRoundCandidate l input.round input.enabled
                                  input.raw).rawBuffer a r := hstep.2 r
                            _ = l.rawBuffer a r :=
                              startRoundCandidate_buffer_other_round l input a r
                                hsame
                        have hskip : suppliedRawBufferCell l.rawBuffer
                            (input :: rest) l.freezeAt a r =
                              suppliedRawBufferCell l.rawBuffer rest l.freezeAt a r := by
                          simp [suppliedRawBufferCell, findRoundInput?, hroundNe]
                        have hinitial : suppliedRawBufferCell l.rawBuffer rest
                            l.freezeAt a r = suppliedRawBufferCell finished.rawBuffer
                              rest l.freezeAt a r := by
                          cases hfind : findRoundInput? rest r <;>
                            simp [suppliedRawBufferCell, hfind, hstepCell]
                        have hheadFormula : suppliedRawBufferCell l.rawBuffer
                            (input :: rest) l.freezeAt a r =
                              suppliedRawBufferCell finished.rawBuffer rest
                                l.freezeAt a r := hskip.trans hinitial
                        rw [hheadFormula]
                        exact htailCell
          | success decoded =>
              cases hf : finishRound decoded with
              | invalid => simp [checkedRounds, hs, hd, hf] at h
              | rejected bad => simp [checkedRounds, hs, hd, hf] at h
              | success finished =>
                  cases hr : checkedRounds finished rest with
                  | none => simp [checkedRounds, hs, hd, hf, hr] at h
                  | some pair =>
                      simp [checkedRounds, hs, hd, hf, hr] at h
                      rcases h with ⟨rfl, rfl⟩
                      have hcontext := checkedRound_success_context l started
                        decoded finished input hs (Or.inl hd) hf
                      have hfreeze := congrArg (fun c => c.2.2.2.1) hcontext
                      change finished.freezeAt = l.freezeAt at hfreeze
                      have hnext := checkedRound_success_cursor l started decoded
                        finished input hs (Or.inl hd) hf
                      have htailChron' : chronologicalFrom finished.cursor rest := by
                        rw [hnext]
                        exact htailChron
                      have htail := ih finished pair.2 pair.1 hr hfinal htailChron'
                      have hstep := checkedRound_success_unknown_column l started
                        decoded finished input a hs (Or.inl hd) hf htail.1
                      have hpending := checkedRound_success_pending_subset l
                        started decoded finished input hs (Or.inl hd) hf
                      refine ⟨hstep.1, ?_, htail.2.2.trans hpending⟩
                      intro r
                      by_cases hsame : r = input.round
                      · subst r
                        have hnoLater : ∀ later ∈ rest,
                            later.round ≠ input.round :=
                          chronologicalFrom_tail_round_ne_head l.cursor
                            input rest ⟨hinputRound, htailChron⟩
                        have hlookupTail := findRoundInput?_eq_none_of_forall
                          rest input.round hnoLater
                        have htailInitial : suppliedRawBufferCell
                            finished.rawBuffer rest finished.freezeAt a input.round =
                              finished.rawBuffer a input.round := by
                          simp [suppliedRawBufferCell, hlookupTail]
                        have htailCell := htail.2.1 input.round
                        rw [hfreeze] at htailCell
                        rw [hfreeze] at htailInitial
                        rw [htailInitial] at htailCell
                        rw [hstep.2 input.round] at htailCell
                        have hheadFormula : suppliedRawBufferCell l.rawBuffer
                            (input :: rest) l.freezeAt a input.round =
                              (startRoundCandidate l input.round input.enabled
                                input.raw).rawBuffer a input.round := by
                          simpa [suppliedRawBufferCell, findRoundInput?] using
                            (startRoundCandidate_unknown_raw_cell l input a hstep.1).symm
                        rw [hheadFormula]
                        exact htailCell
                      · have htailCell := htail.2.1 r
                        rw [hfreeze] at htailCell
                        have hroundNe : input.round ≠ r := by
                          intro heq
                          exact hsame heq.symm
                        have hstepCell : finished.rawBuffer a r = l.rawBuffer a r := by
                          calc
                            finished.rawBuffer a r =
                                (startRoundCandidate l input.round input.enabled
                                  input.raw).rawBuffer a r := hstep.2 r
                            _ = l.rawBuffer a r :=
                              startRoundCandidate_buffer_other_round l input a r
                                hsame
                        have hskip : suppliedRawBufferCell l.rawBuffer
                            (input :: rest) l.freezeAt a r =
                              suppliedRawBufferCell l.rawBuffer rest l.freezeAt a r := by
                          simp [suppliedRawBufferCell, findRoundInput?, hroundNe]
                        have hinitial : suppliedRawBufferCell l.rawBuffer rest
                            l.freezeAt a r = suppliedRawBufferCell finished.rawBuffer
                              rest l.freezeAt a r := by
                          cases hfind : findRoundInput? rest r <;>
                            simp [suppliedRawBufferCell, hfind, hstepCell]
                        have hheadFormula : suppliedRawBufferCell l.rawBuffer
                            (input :: rest) l.freezeAt a r =
                              suppliedRawBufferCell finished.rawBuffer rest
                                l.freezeAt a r := hskip.trans hinitial
                        rw [hheadFormula]
                        exact htailCell

/-- Expose the actual initializer, accepted bits, and final ledger. -/
theorem startAndRunChecked_success_components
    (assignment : Assignment p) (sigma cutoff freezeAt : ℕ)
    (baseScore : Fin (p.m - 1) → ℕ)
    (outside : Fin p.K → Option CutoffRegister)
    (inputs : List (RoundInput (p := p) (eta := eta)))
    (execution : Execution p eta heta hcap n hn)
    (h : startAndRunChecked p eta heta hcap n hn assignment sigma cutoff
      freezeAt baseScore outside inputs = .success execution) :
    ∃ accepted, startCollectionChecked p eta heta hcap n hn assignment sigma
      cutoff freezeAt baseScore outside = .success execution.initial ∧
      checkedRounds execution.initial inputs = some (accepted, execution.final) := by
  cases hs : startCollectionChecked p eta heta hcap n hn assignment sigma
      cutoff freezeAt baseScore outside with
  | invalid => simp [startAndRunChecked, hs] at h
  | rejected bad => simp [startAndRunChecked, hs] at h
  | success initial =>
      cases hr : checkedRounds initial inputs with
      | none => simp [startAndRunChecked, hs, hr] at h
      | some pair =>
          simp [startAndRunChecked, hs, hr] at h
          have hExecution : execution = ⟨initial, pair.1, pair.2⟩ := h.symm
          have hinitial : execution.initial = initial := congrArg Execution.initial hExecution
          have hfinal : execution.final = pair.2 := congrArg Execution.final hExecution
          refine ⟨pair.1, ?_, ?_⟩
          · rw [hinitial]
          · rw [hinitial, hfinal]
            simpa using hr

/-- The checked initializer preserves the supplied assignment, cutoff,
freeze, and base-score fields and starts at the supplied cutoff cursor. -/
theorem startCollectionChecked_success_context
    (assignment : Assignment p) (sigma cutoff freezeAt : ℕ)
    (baseScore : Fin (p.m - 1) → ℕ)
    (outside : Fin p.K → Option CutoffRegister)
    (initial : Ledger p eta heta hcap n hn)
    (h : startCollectionChecked p eta heta hcap n hn assignment sigma cutoff
      freezeAt baseScore outside = .success initial) :
    initial.assignment = assignment ∧ initial.sigma = sigma ∧
      initial.cursor = cutoff ∧ initial.cutoff = cutoff ∧
      initial.freezeAt = freezeAt ∧ initial.baseScore = baseScore := by
  unfold startCollectionChecked at h
  repeat (first | split at h | dsimp only at h)
  all_goals
    first
    | contradiction
    | (injection h with heq; cases heq; exact ⟨rfl, rfl, rfl, rfl, rfl, rfl⟩)

/-- The actual checked initializer has every raw-buffer cell empty. -/
theorem startCollectionChecked_success_empty_rawBuffer
    (assignment : Assignment p) (sigma cutoff freezeAt : ℕ)
    (baseScore : Fin (p.m - 1) → ℕ)
    (outside : Fin p.K → Option CutoffRegister)
    (initial : Ledger p eta heta hcap n hn)
    (h : startCollectionChecked p eta heta hcap n hn assignment sigma cutoff
      freezeAt baseScore outside = .success initial) :
    ∀ a r, initial.rawBuffer a r = none := by
  exact CollectionCheckedExecution.startCollectionChecked_success_empty_rawBuffer
    p eta heta hcap n hn assignment sigma cutoff freezeAt baseScore outside initial h

/-- Exact final raw-buffer provenance from unique lookups in the actual input
list for an arm that remains unknown. -/
theorem startAndRunChecked_success_unknown_buffer
    (assignment : Assignment p) (sigma cutoff freezeAt : ℕ)
    (baseScore : Fin (p.m - 1) → ℕ)
    (outside : Fin p.K → Option CutoffRegister)
    (inputs : List (RoundInput (p := p) (eta := eta)))
    (execution : Execution p eta heta hcap n hn) (a : Fin p.K)
    (h : startAndRunChecked p eta heta hcap n hn assignment sigma cutoff
      freezeAt baseScore outside inputs = .success execution)
    (hunknown : execution.final.currentRegisters a = none) :
    execution.initial.assignment = assignment ∧
      execution.initial.cursor = cutoff ∧ execution.initial.cutoff = cutoff ∧
      execution.initial.freezeAt = freezeAt ∧
      execution.final.assignment = assignment ∧
      execution.final.cutoff = cutoff ∧ execution.final.freezeAt = freezeAt ∧
      (∀ input ∈ inputs,
        execution.final.enabledHistory input.round = some input.enabled) ∧
      execution.initial.currentRegisters a = none ∧
      (∀ r, execution.final.rawBuffer a r =
        match findRoundInput? inputs r with
        | none => none
        | some input =>
            match input.raw with
            | none => none
            | some (b, amount) =>
                if b = a ∧ 0 < amount ∧ sourceRound r < freezeAt then
                  some amount
                else none) ∧
      (∀ r, freezeAt ≤ sourceRound r → execution.final.rawBuffer a r = none) ∧
      (∀ r, sourceRound r < execution.initial.cursor ∨
        execution.final.cursor ≤ sourceRound r → execution.final.rawBuffer a r = none) ∧
      execution.final.pending ⊆ execution.initial.pending := by
  obtain ⟨accepted, hinitial, hfold⟩ :=
    startAndRunChecked_success_components assignment sigma cutoff freezeAt
      baseScore outside inputs execution h
  have hinitContext := startCollectionChecked_success_context assignment sigma
    cutoff freezeAt baseScore outside execution.initial hinitial
  have hinitEmpty := startCollectionChecked_success_empty_rawBuffer assignment
    sigma cutoff freezeAt baseScore outside execution.initial hinitial
  have hchron := startAndRunChecked_success_input_chronology p eta heta hcap n hn
    assignment sigma cutoff freezeAt baseScore outside inputs execution h
  have hbuffer := checkedRounds_unknown_arm_buffer execution.initial execution.final
    inputs accepted a hfold hunknown hchron
  have hcontext := checkedRounds_success_preserves_context execution.initial
    execution.final inputs accepted hfold
  have hcursor := startAndRunChecked_success_chronology p eta heta hcap n hn
    assignment sigma cutoff freezeAt baseScore outside inputs execution h
  have henables := startAndRunChecked_success_records_supplied_enables p eta heta
    hcap n hn assignment sigma cutoff freezeAt baseScore outside inputs execution h
  have hfinalCursor := hcursor.1
  rcases hinitContext with ⟨hassign0, hsigma0, hcursor0, hcut0, hfreeze0, hbase0⟩
  have hassignFinal : execution.final.assignment = assignment := by
    have := congrArg (fun c => c.1) hcontext
    exact this.trans hassign0
  have hcutFinal : execution.final.cutoff = cutoff := by
    have hleft := congrArg (fun c => c.2.2.1) hcontext
    exact hleft.trans hcut0
  have hfreezeFinal : execution.final.freezeAt = freezeAt := by
    have hleft := congrArg (fun c => c.2.2.2.1) hcontext
    exact hleft.trans hfreeze0
  have hinitialUnknown := hbuffer.1
  have hformula : ∀ r, execution.final.rawBuffer a r =
      match findRoundInput? inputs r with
      | none => none
      | some input =>
          match input.raw with
          | none => none
          | some (b, amount) =>
              if b = a ∧ 0 < amount ∧ sourceRound r < freezeAt then
                some amount
              else none := by
    intro r
    rw [hbuffer.2.1 r]
    simp [suppliedRawBufferCell, hinitEmpty a r, hfreeze0]
  have hlookupOutside : ∀ r,
      sourceRound r < execution.initial.cursor ∨
        execution.final.cursor ≤ sourceRound r → findRoundInput? inputs r = none := by
    intro r hout
    apply findRoundInput?_eq_none_of_forall
    intro input hmem hround
    have hbounds := chronologicalFrom_round_bounds execution.initial.cursor
      inputs hchron input hmem
    have hlabels := congrArg sourceRound hround
    omega
  have hfreezeEmpty : ∀ r, freezeAt ≤ sourceRound r →
      execution.final.rawBuffer a r = none := by
    intro r hafter
    rw [hformula r]
    cases hlookup : findRoundInput? inputs r with
    | none => rfl
    | some input =>
        have hnot : ¬ sourceRound r < freezeAt := Nat.not_lt.mpr hafter
        cases hraw : input.raw with
        | none => simp [hraw]
        | some pair => simp [hraw, hnot]
  have houtsideEmpty : ∀ r,
      sourceRound r < execution.initial.cursor ∨
        execution.final.cursor ≤ sourceRound r → execution.final.rawBuffer a r = none := by
    intro r hout
    rw [hformula r, hlookupOutside r hout]
  exact ⟨hassign0, hcursor0, hcut0, hfreeze0, hassignFinal, hcutFinal,
    hfreezeFinal, henables, hinitialUnknown, hformula, hfreezeEmpty, houtsideEmpty,
    hbuffer.2.2⟩

/-- Extend an unknown-arm buffer through the next successful checked start. -/
theorem next_start_success_unknown_buffer
    (l started : Ledger p eta heta hcap n hn)
    (input : RoundInput (p := p) (eta := eta)) (a : Fin p.K)
    (hstart : startRound l (sourceRound input.round) input.enabled input.raw =
      .success started)
    (hunknown : l.currentRegisters a = none) :
    l.currentRegisters a = none ∧
      ∀ r, started.rawBuffer a r =
        if r = input.round then
          rawBufferCellAfterStart l.rawBuffer input.raw a l.freezeAt r
        else l.rawBuffer a r := by
  refine ⟨hunknown, ?_⟩
  intro r
  by_cases hr : r = input.round
  · subst r
    simpa [rawBufferCellAfterStart] using startRound_success_unknown_buffer_cell l started
      (sourceRound input.round) input.enabled input.raw a input.round rfl
      hstart hunknown
  · have hcandidate := startRound_success_candidate l started
      (sourceRound input.round) input.enabled input.raw hstart
    have hidx : (⟨sourceRound input.round - 1, by
          simp [sourceRound]⟩ : Fin p.T) = input.round := by
      apply Fin.ext
      simp [sourceRound]
    have hcell := congrArg
      (fun x : Ledger p eta heta hcap n hn => x.rawBuffer a r) hcandidate
    rw [hidx] at hcell
    have hcell' : started.rawBuffer a r =
        (startRoundCandidate l input.round input.enabled input.raw).rawBuffer a r := by
      simpa only [hidx] using hcell
    simpa [hr] using (calc
      started.rawBuffer a r =
          (startRoundCandidate l input.round input.enabled input.raw).rawBuffer a r :=
        hcell'
      _ = l.rawBuffer a r := startRoundCandidate_buffer_other_round l input a r hr)

/-- A successful actual decoder gives a real receiver interval. -/
theorem decodeUp_success_input_bounds
    (l result : Ledger p eta heta hcap n hn) (i : Fin (p.m - 1))
    (M : UpRecord (codecParams p eta))
    (hdecode : decodeUp l i (some M) = .success result) :
    1 ≤ l.cutoff ∧ l.cutoff ≤ l.cursor ∧ l.cursor ≤ p.T := by
  by_cases hinput : validLedgerCheck l = true ∧ l.phase = .started ∧
      1 ≤ l.cutoff ∧ l.cutoff ≤ l.cursor ∧ l.cursor ≤ p.T
  · exact ⟨hinput.2.2.1, hinput.2.2.2.1, hinput.2.2.2.2⟩
  · simp [decodeUp, hinput] at hdecode

/-- Identify actual decoder replay records with unique raw/enabled lookups on
a successful continuation; retain the existing once-only endpoint equation. -/
theorem successful_decode_records_are_replayRecords
    (assignment : Assignment p) (sigma cutoff freezeAt : ℕ)
    (baseScore : Fin (p.m - 1) → ℕ)
    (outside : Fin p.K → Option CutoffRegister)
    (inputs : List (RoundInput (p := p) (eta := eta)))
    (execution : Execution p eta heta hcap n hn)
    (input : RoundInput (p := p) (eta := eta))
    (started decoded finished : Ledger p eta heta hcap n hn)
    (i : Fin (p.m - 1))
    (M : UpRecord (codecParams p eta))
    (hRun : startAndRunChecked p eta heta hcap n hn assignment sigma cutoff
      freezeAt baseScore outside inputs = .success execution)
    (hunknown : execution.final.currentRegisters
      (execution.final.assignment.arm i) = none)
    (hstart : startRound execution.final (sourceRound input.round)
      input.enabled input.raw = .success started)
    (hdecode : decodeUp started i (some M) = .success decoded)
    (hfinish : finishRound decoded = .success finished) :
    ∃ hbound : started.cutoff - 1 + (started.cursor - started.cutoff) ≤ p.T,
      ∃ lastIndex : Fin p.T,
        sourceRound lastIndex = started.cursor ∧
        ∃ past current,
          replayRecords? started (execution.final.assignment.arm i)
              (calendarIndices p.T (started.cutoff - 1)
                (started.cursor - started.cutoff) hbound) = some past ∧
          replayRecords? started (execution.final.assignment.arm i) [lastIndex] =
            some [current] ∧
          suppliedReplayRecords? (inputs ++ [input])
              (execution.final.assignment.arm i) started.freezeAt
              (calendarIndices p.T (started.cutoff - 1)
                (started.cursor - started.cutoff) hbound ++ [lastIndex]) =
            some (past ++ [current]) ∧
          started.currentRegisters (execution.final.assignment.arm i) = none ∧
          finished.currentRegisters (execution.final.assignment.arm i) =
            some ⟨(QueueReplay.replay (4 * n) (0, M.val.q)
                (past ++ [current])).2,
              (QueueReplay.replay (4 * n) (0, M.val.q)
                (past ++ [current])).1 -
                (QueueReplay.replay (4 * n) (0, M.val.q) past).1⟩ ∧
          finished.increment (execution.final.assignment.arm i) =
            (QueueReplay.replay (4 * n) (0, M.val.q)
              (past ++ [current])).1 ∧
          finished.cutoffRegisters (execution.final.assignment.arm i) =
            some ⟨started.baseScore i + M.val.S, M.val.q, M.val.delta⟩ := by
  let a := execution.final.assignment.arm i
  obtain ⟨_, hinitialCursor, hinitialCutoff, _, hfinalAssignment, hfinalCutoff,
      hfinalFreeze, henables, _, hrawFormula, _, houtsideEmpty, _⟩ :=
    startAndRunChecked_success_unknown_buffer assignment sigma cutoff freezeAt
      baseScore outside inputs execution a hRun hunknown
  have hchron := startAndRunChecked_success_input_chronology p eta heta hcap n hn
    assignment sigma cutoff freezeAt baseScore outside inputs execution hRun
  have hcursorRun := startAndRunChecked_success_chronology p eta heta hcap n hn
    assignment sigma cutoff freezeAt baseScore outside inputs execution hRun
  have hfinalCursor := hcursorRun.1
  obtain ⟨hbound, lastIndex, hlastSource, past, current, hpast, hlast,
      hstartedUnknown, hcurrent, hincrement, hcutoff⟩ :=
    checked_acceptance_finish_once execution.final started decoded finished
      (sourceRound input.round) input.enabled input.raw i M hstart hdecode hfinish
  have htime := startRound_success_time execution.final started
    (sourceRound input.round) input.enabled input.raw hstart
  have hstartedCursor := startRound_success_cursor execution.final started
    (sourceRound input.round) input.enabled input.raw hstart
  have hstartedContext := startRound_success_context execution.final started
    (sourceRound input.round) input.enabled input.raw hstart
  have hstartedAssignment : started.assignment = execution.final.assignment := by
    have h := congrArg (fun c => c.1) hstartedContext
    change started.assignment = execution.final.assignment at h
    exact h
  have hstartedArm : started.assignment.arm i = a := by
    simp [a, hstartedAssignment]
  have hstartedCutoff : started.cutoff = cutoff := by
    have h := congrArg (fun c => c.2.2.1) hstartedContext
    exact h.trans hfinalCutoff
  have hstartedFreeze : started.freezeAt = freezeAt := by
    have h := congrArg (fun c => c.2.2.2.1) hstartedContext
    exact h.trans hfinalFreeze
  have hstartedCursorFinal : started.cursor = execution.final.cursor :=
    hstartedCursor.trans htime
  have hdecodeBounds := decodeUp_success_input_bounds started decoded i M hdecode
  have hfoldUpper : execution.initial.cursor + inputs.length =
      execution.final.cursor := hfinalCursor.symm
  have hstartTime : sourceRound input.round = execution.final.cursor := htime
  have hlastRound : lastIndex = input.round := by
    apply Fin.ext
    have hlabels := hlastSource
    dsimp [sourceRound] at hlabels ⊢
    omega
  have hnoEarlier : ∀ old ∈ inputs, old.round ≠ input.round := by
    intro old hold heq
    have hbounds := chronologicalFrom_round_bounds execution.initial.cursor
      inputs hchron old hold
    have hlabels := congrArg sourceRound heq
    omega
  have hnoEarlierLookup := findRoundInput?_eq_none_of_forall inputs
    input.round hnoEarlier
  have hfindCurrent : findRoundInput? (inputs ++ [input]) lastIndex = some input := by
    have hfindNoneCore : inputs.find?
        (fun old => decide (old.round = input.round)) = none := by
      simpa [findRoundInput?] using hnoEarlierLookup
    have hfindAtRoundCore : (inputs ++ [input]).find?
        (fun old => decide (old.round = input.round)) = some input := by
      rw [List.find?_append, hfindNoneCore]
      simp
    simpa [findRoundInput?, hlastRound] using hfindAtRoundCore
  have hstartHistory := startRound_success_history_update execution.final
    started input.round input.enabled input.raw hstart
  have hstartedEnableCurrent : started.enabledHistory input.round =
      some input.enabled := by
    rw [hstartHistory]
    simp
  have hstartedEnableLast : started.enabledHistory lastIndex =
      some input.enabled := by
    simpa [hlastRound] using hstartedEnableCurrent
  have hfinalCurrentEmpty : execution.final.rawBuffer a input.round = none :=
    houtsideEmpty input.round (Or.inr (by rw [hstartTime]))
  have hnextBuffer := next_start_success_unknown_buffer execution.final started
    input a hstart hunknown
  have hstartedCurrentCell : started.rawBuffer a input.round =
      match input.raw with
      | none => none
      | some (b, amount) =>
          if b = a ∧ 0 < amount ∧
              sourceRound input.round < started.freezeAt then
            some amount
          else none := by
    have h := hnextBuffer.2 input.round
    simpa [rawBufferCellAfterStart, hfinalCurrentEmpty, hfinalFreeze,
      hstartedFreeze] using h
  have hcurrentArrival := bufferedArrival_eq_localArrival_of_rawBufferCell
    started a input.round input.raw hstartedCurrentCell
  have hcurrentArrivalLast : bufferedArrival started a lastIndex =
      if sourceRound lastIndex < started.freezeAt then
        localArrival input.raw a else 0 := by
    simpa [hlastRound] using hcurrentArrival
  have hpastA : replayRecords? started a
      (calendarIndices p.T (started.cutoff - 1)
        (started.cursor - started.cutoff) hbound) = some past := by
    simpa [a, hstartedArm] using hpast
  have hlastA : replayRecords? started a [lastIndex] = some [current] := by
    simpa [a, hstartedArm] using hlast
  have hstartedUnknownA : started.currentRegisters a = none := by
    simpa [a, hstartedArm] using hstartedUnknown
  have hcurrentA : finished.currentRegisters a =
      some ⟨(QueueReplay.replay (4 * n) (0, M.val.q)
          (past ++ [current])).2,
        (QueueReplay.replay (4 * n) (0, M.val.q)
          (past ++ [current])).1 -
          (QueueReplay.replay (4 * n) (0, M.val.q) past).1⟩ := by
    simpa [a, hstartedArm] using hcurrent
  have hincrementA : finished.increment a =
      (QueueReplay.replay (4 * n) (0, M.val.q) (past ++ [current])).1 := by
    simpa [a, hstartedArm] using hincrement
  have hcutoffA : finished.cutoffRegisters a =
      some ⟨started.baseScore i + M.val.S, M.val.q, M.val.delta⟩ := by
    simpa [a, hstartedArm] using hcutoff
  let prefixIndices' := calendarIndices p.T (started.cutoff - 1)
    (started.cursor - started.cutoff) hbound
  let replayIndices := prefixIndices' ++ [lastIndex]
  have hdata : ∀ r ∈ replayIndices, ∃ supplied,
      findRoundInput? (inputs ++ [input]) r = some supplied ∧
      started.enabledHistory r = some supplied.enabled ∧
      bufferedArrival started a r =
        if sourceRound r < started.freezeAt then
          localArrival supplied.raw a else 0 := by
    intro r hrmem
    have hmemParts := List.mem_append.mp hrmem
    rcases hmemParts with hprefixMem | hlastMem
    · have hcalendar := calendarIndices_sourceRound_bounds p.T
        (started.cutoff - 1) (started.cursor - started.cutoff) hbound r hprefixMem
      have hprefixLow : execution.initial.cursor ≤ sourceRound r := by
        omega
      have hprefixHigh : sourceRound r <
          execution.initial.cursor + inputs.length := by
        have hlabelLt : sourceRound r < started.cursor := by
          have hcutLe := hdecodeBounds.2.1
          omega
        calc
          sourceRound r < started.cursor := hlabelLt
          _ = execution.final.cursor := hstartedCursorFinal
          _ = execution.initial.cursor + inputs.length := hfoldUpper.symm
      obtain ⟨supplied, hfind, hround, hsuppliedMem, _⟩ :=
        chronologicalFrom_findRoundInput?_in_interval execution.initial.cursor
          inputs hchron r hprefixLow hprefixHigh
      have hfindExtended : findRoundInput? (inputs ++ [input]) r =
          some supplied := by
        have hfindCore : inputs.find?
            (fun old => decide (old.round = r)) = some supplied := by
          simpa [findRoundInput?] using hfind
        have hfindExtendedCore : (inputs ++ [input]).find?
            (fun old => decide (old.round = r)) = some supplied := by
          rw [List.find?_append, hfindCore]
          simp
        simpa [findRoundInput?] using hfindExtendedCore
      have hnotCurrent : r ≠ input.round := by
        intro heq
        have hlabels := congrArg sourceRound heq
        omega
      have hhistory : started.enabledHistory r = some supplied.enabled := by
        calc
          started.enabledHistory r =
              (Function.update execution.final.enabledHistory input.round
                (some input.enabled)) r := congrFun hstartHistory r
          _ = execution.final.enabledHistory r :=
            Function.update_of_ne hnotCurrent (some input.enabled)
              execution.final.enabledHistory
          _ = some supplied.enabled := by
            have hs := henables supplied hsuppliedMem
            rw [hround] at hs
            exact hs
      have hfinalCell : execution.final.rawBuffer a r =
          match supplied.raw with
          | none => none
          | some (b, amount) =>
              if b = a ∧ 0 < amount ∧ sourceRound r < freezeAt then
                some amount
              else none := by
        rw [hrawFormula r, hfind]
      have hstartedCell : started.rawBuffer a r = execution.final.rawBuffer a r := by
        have hne : r ≠ input.round := hnotCurrent
        simpa [hne] using hnextBuffer.2 r
      have hcell : started.rawBuffer a r =
          match supplied.raw with
          | none => none
          | some (b, amount) =>
              if b = a ∧ 0 < amount ∧ sourceRound r < started.freezeAt then
                some amount
              else none := by
        calc
          started.rawBuffer a r = execution.final.rawBuffer a r := hstartedCell
          _ = _ := by rw [hfinalCell, hstartedFreeze]
      have harrival := bufferedArrival_eq_localArrival_of_rawBufferCell
        started a r supplied.raw hcell
      exact ⟨supplied, hfindExtended, hhistory, harrival⟩
    · have hlastMem' : r = lastIndex := by
        simpa using hlastMem
      subst r
      exact ⟨input, hfindCurrent, hstartedEnableLast, hcurrentArrivalLast⟩
  have hmatched := replayRecords?_matches_supplied started
    (inputs ++ [input]) a replayIndices hdata
  have hcombined : replayRecords? started a replayIndices =
      some (past ++ [current]) := by
    simpa [replayIndices, prefixIndices'] using
      replayRecords?_append started a prefixIndices' [lastIndex] past [current]
        hpastA hlastA
  have hsupplied : suppliedReplayRecords? (inputs ++ [input]) a
      started.freezeAt replayIndices = some (past ++ [current]) :=
    hmatched.symm.trans hcombined
  refine ⟨hbound, lastIndex, ?_, past, current, hpastA, hlastA, ?_,
      hstartedUnknownA, hcurrentA, hincrementA, hcutoffA⟩
  · exact hlastSource.trans hstartedCursor.symm
  · simpa [replayIndices, prefixIndices'] using hsupplied

end Bandits.Support.CollectionBufferProvenance

