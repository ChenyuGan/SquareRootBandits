/-!
# Measurable code for the actual within-block initialization fold

This module recursively codes the existing decreasing-cursor execution on
the original source and local-state invariant. It uses the accepted cursor
transition and the existing `BlockFoldCode` output shape.

Sources: `sources/zip4/manuscript/07_public_setup.tex:55-114`,
`sources/zip4/manuscript/appendix_b_communication.tex:94-131,160-165`, and
`sources/zip4/manuscript/06_interruptions.tex:235-297`.
-/

@[expose] public section

noncomputable section

open MeasureTheory
open Bandits.Support.ConstructorDimensions
open Bandits.Support.BootstrapDimensions
open Bandits.Support.ActualInitializationPhysicalStep
open Bandits.Support.ActualInitializationRun
open Bandits.Support.ActualInitializationBlockMeasurability
open Bandits.Support.ActualInitializationCursorMeasurability

namespace Bandits.Support.ActualInitializationBlockFoldMeasurability

abbrev Parameters := ConstructorDimensions.Parameters
abbrev RateInput := ActiveFollowerDownAcceptance.RateInput

private def continuationCodeOfBeginCode {p : Parameters}
    (code : BootstrapCoordinatorRoundMeasurability.CoordinatorLocalCode p) :
    ActualInitializationBlockMeasurability.ContinuationCode p :=
  (code.block, (code.target, (code.coordinator, (code.monitor.1, none))) )

private theorem continuationCodeOf_assembledBeginCode {p : Parameters}
    (base : BootstrapCoordinatorRoundMeasurability.CoordinatorContinuousBase p)
    (code : BootstrapCoordinatorRoundMeasurability.CoordinatorLocalCode p) :
    ActualInitializationBlockMeasurability.continuationCodeOf
        (.prelaunch (BootstrapCoordinatorRoundMeasurability.assemblePrelaunch p base code)) =
      continuationCodeOfBeginCode code := by
  cases code
  rfl

/-- A literal, length-indexed view of a round-code list. The `Sum` tags make
the absent positions distinct from present codes, including continuous code
fibres. -/
def roundCodeListCoordinates {α : Type*} (rounds : List α) :
    ℕ × (ℕ → Unit ⊕ α) :=
  (rounds.length, fun n =>
    match rounds[n]? with
    | none => Sum.inl ()
    | some code => Sum.inr code)

/-- The output uses exactly `BlockFoldCode`'s existing fields. Its measurable
structure is generated by the exposed literal fields and every length/index
coordinate of the stored round-code list. -/
def blockFoldCodeCoordinates {p : Parameters} {rate : RateInput p}
    {block : Fin (n_boot p)} {C_star C_h : ℝ}
    (code : ActualInitializationBlockMeasurability.BlockFoldCode
      p rate block C_star C_h) :
    ActualInitializationBlockMeasurability.ContinuationCode p ×
      ((Fin (p.m - 1) → ActualInitializationRoundMeasurability.FollowerCode p rate block) ×
        (ℕ × (ℕ → Unit ⊕ ActualInitializationStepMeasurability.ActualRoundOutputCode
          p rate block))) :=
  (code.phase, (code.followers, roundCodeListCoordinates code.rounds))

instance blockFoldCodeMeasurableSpace (p : Parameters) (rate : RateInput p)
    (block : Fin (n_boot p)) (C_star C_h : ℝ) :
    MeasurableSpace (ActualInitializationBlockMeasurability.BlockFoldCode
      p rate block C_star C_h) :=
  MeasurableSpace.comap blockFoldCodeCoordinates inferInstance

theorem measurable_blockFoldCodeCoordinates {p : Parameters} {rate : RateInput p}
    {block : Fin (n_boot p)} {C_star C_h : ℝ} :
    Measurable (blockFoldCodeCoordinates (p := p) (rate := rate) (block := block)
      (C_star := C_star) (C_h := C_h)) :=
  comap_measurable _

private theorem measurable_roundCodeListCoordinates_cons
    {Ω : Type*} [MeasurableSpace Ω] {α : Type*} [MeasurableSpace α]
    (head : Ω → α) (tail : Ω → List α)
    (hhead : Measurable head)
    (htail : Measurable (fun ω => roundCodeListCoordinates (tail ω))) :
    Measurable (fun ω => roundCodeListCoordinates (head ω :: tail ω)) := by
  have hlength : Measurable (fun ω => (head ω :: tail ω).length) := by
    change Measurable (fun ω => Nat.succ (tail ω).length)
    exact (measurable_of_countable Nat.succ).comp (measurable_fst.comp htail)
  have hstream : Measurable (fun ω => (roundCodeListCoordinates (head ω :: tail ω)).2) := by
    apply measurable_pi_iff.mpr
    intro n
    cases n with
    | zero =>
        simp only [roundCodeListCoordinates, List.getElem?_cons_zero]
        exact measurable_inr.comp hhead
    | succ n =>
        simp only [roundCodeListCoordinates, List.getElem?_cons_succ]
        exact (measurable_pi_apply n).comp (measurable_snd.comp htail)
  exact hlength.prodMk hstream

/-- The actual recursive code on the original local induction tuple. At zero
fuel it keeps the continuation and heterogeneous followers unchanged. At
positive fuel it consumes the accepted physical cursor code and continues at
`cursor + 1` with the exact accepted successor input. -/
noncomputable def actualBlockFoldCodeAux {p : Parameters} {rate : RateInput p}
    {block : Fin (n_boot p)} {C_star C_h : ℝ} :
    (cursor fuel : ℕ) →
      cursor + fuel = BootstrapObservedFollower.blockLength p block →
      ActualInitializationPhysicalStep.GridRewardTable p →
      ActualInitializationCursorMeasurability.CursorInput p rate block
        C_star C_h cursor →
      ActualInitializationBlockMeasurability.BlockFoldCode p rate block C_star C_h
  | cursor, 0, hbudget, _rewards, input =>
      { phase := ActualInitializationBlockMeasurability.continuationCodeOf input.1.2.1
        followers := fun i => ActualInitializationRoundMeasurability.followerCodeOfState
          p rate block (input.1.2.2 i)
        rounds := [] }
  | cursor, fuel + 1, hbudget, rewards, input => by
      have hcursor : cursor < BootstrapObservedFollower.blockLength p block := by omega
      let output := ActualInitializationCursorMeasurability.actualCursorOutputCode
        hcursor rewards input
      let nextInput := ActualInitializationCursorMeasurability.cursorSuccessorInput
        hcursor rewards input
      let tail := actualBlockFoldCodeAux (cursor + 1) fuel (by omega) rewards nextInput
      exact ⟨tail.phase, tail.followers, output.1 :: tail.rounds⟩
termination_by cursor fuel _ _ _ => fuel
decreasing_by omega

/-- The original zero-cursor input assembled from the existing `beginBlock`
on the complete source and incoming carry. Its predicate is exactly the
existing block induction invariant. -/
def actualCursorZeroInput {p : Parameters} {rate : RateInput p}
    {block : Fin (n_boot p)} {C_star C_h : ℝ}
    (input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h) :
    ActualInitializationCursorMeasurability.CursorInput p rate block C_star C_h 0 := by
  let started := ActualInitializationRun.beginBlock p rate block input.1 input.2.1
  have hinvariant : ActualInitializationRun.BlockInvariant p rate block input.1 C_star C_h
      0 (.prelaunch started.coordinator) started.followers := by
    simpa only [input.2.2.1, input.2.2.2] using started.invariant
  exact ⟨(input.1, (.prelaunch started.coordinator, started.followers)), hinvariant⟩

/-- The zero-cursor coordinates are Borel by the accepted joint block-start
producer. Reconstruction uses the same source and carry as `beginBlock`. -/
theorem measurable_actualCursorZeroInput {p : Parameters} {rate : RateInput p}
    {block : Fin (n_boot p)} {C_star C_h : ℝ} :
    Measurable (actualCursorZeroInput (p := p) (rate := rate) (block := block)
      (C_star := C_star) (C_h := C_h)) := by
  apply Measurable.subtype_mk
  apply measurable_comap_iff.mpr
  have hsource : Measurable (fun input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h => input.1) := measurable_fst
  have hstartedCode :=
    (ActualInitializationBeginJointMeasurability.measurable_actualBeginBlockCodeOfInput
      (p := p) (rate := rate) (block := block) (C_star := C_star) (C_h := C_h))
  have hcode : Measurable (fun input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h =>
        ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input) := hstartedCode
  have hcontinuation : Measurable (fun input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h =>
        continuationCodeOfBeginCode
          (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).1) := by
    have hlocal : Measurable (fun input : ActualInitializationBlockMeasurability.BlockInput
        p rate block C_star C_h =>
          (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).1) :=
      measurable_fst.comp hcode
    have hmap : Measurable (@continuationCodeOfBeginCode p) := measurable_of_countable _
    exact hmap.comp hlocal
  have hfollowers : Measurable (fun input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h =>
        (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).2) :=
    measurable_snd.comp hcode
  have hcodeCoordinates : Measurable (fun input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h =>
        (input.1,
          (continuationCodeOfBeginCode
            (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).1,
            (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).2))) :=
    hsource.prodMk (hcontinuation.prodMk hfollowers)
  have hreconstruct : ∀ input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h,
      ActualInitializationCursorMeasurability.cursorTupleCoordinates
        (actualCursorZeroInput input).1 =
        (input.1,
          (continuationCodeOfBeginCode
            (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).1,
            (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).2)) := by
    intro input
    let started := ActualInitializationRun.beginBlock p rate block input.1 input.2.1
    have hbegin := ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput_reconstructs
      input
    rcases hbegin with ⟨hcoordinator, hfollowers⟩
    change (input.1,
        (ActualInitializationBlockMeasurability.continuationCodeOf
          (.prelaunch started.coordinator),
          fun i => ActualInitializationRoundMeasurability.followerCodeOfState p rate block
            (started.followers i))) = _
    apply Prod.ext
    · rfl
    · apply Prod.ext
      · have hcont₁ := congrArg (fun coordinator =>
            ActualInitializationBlockMeasurability.continuationCodeOf (.prelaunch coordinator))
          hcoordinator.symm
        exact hcont₁.trans (continuationCodeOf_assembledBeginCode
          (BootstrapCoordinatorRoundMeasurability.selectedCoordinatorBase p input.1 C_star C_h)
          (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).1)
      · funext i
        have hfollowersStarted :
            ActualInitializationRoundMeasurability.followerStateOfCode p rate block
              ((ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).2 i) =
            started.followers i := by
          simpa [started] using hfollowers i
        change ActualInitializationRoundMeasurability.followerCodeOfState p rate block
            (started.followers i) =
          (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).2 i
        calc
          _ = ActualInitializationRoundMeasurability.followerCodeOfState p rate block
                (ActualInitializationRoundMeasurability.followerStateOfCode p rate block
                  ((ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).2 i)) :=
              congrArg (ActualInitializationRoundMeasurability.followerCodeOfState p rate block)
                hfollowersStarted.symm
          _ = (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).2 i :=
              ActualInitializationCursorMeasurability.followerCodeOfState_decode _
  have heq : (fun input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h =>
        ActualInitializationCursorMeasurability.cursorTupleCoordinates
          (actualCursorZeroInput input).1) =
      (fun input => (input.1,
        (continuationCodeOfBeginCode
          (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).1,
          (ActualInitializationBlockMeasurability.actualBeginBlockCodeOfInput input).2))) := by
    funext input
    exact hreconstruct input
  have htupleCoordinates : Measurable (fun input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h =>
        ActualInitializationCursorMeasurability.cursorTupleCoordinates
          (actualCursorZeroInput input).1) := by
    rw [heq]
    exact hcodeCoordinates
  exact htupleCoordinates

/-- The within-block recursive producer is Borel on precisely the original
cursor invariant subtype. Its measurable structure keeps the whole source
and the accepted local code coordinates. -/
theorem measurable_actualBlockFoldCodeAux {p : Parameters} {rate : RateInput p}
    {block : Fin (n_boot p)} {C_star C_h : ℝ} {cursor fuel : ℕ}
    (hbudget : cursor + fuel = BootstrapObservedFollower.blockLength p block)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p) :
    Measurable (actualBlockFoldCodeAux (p := p) (rate := rate) (block := block)
      (C_star := C_star) (C_h := C_h) cursor fuel hbudget rewards) := by
  induction fuel generalizing cursor with
  | zero =>
      have hcoords := ActualInitializationCursorMeasurability.measurable_cursorInputCoordinates
        (rate := rate) (block := block) (C_star := C_star) (C_h := C_h) (cursor := cursor)
      have hpointwise :
          (fun input : ActualInitializationCursorMeasurability.CursorInput
              p rate block C_star C_h cursor =>
            blockFoldCodeCoordinates (actualBlockFoldCodeAux (p := p) (rate := rate)
              (block := block) (C_star := C_star) (C_h := C_h) cursor 0 hbudget rewards input)) =
          (fun input =>
            (ActualInitializationBlockMeasurability.continuationCodeOf input.1.2.1,
              ((fun i => ActualInitializationRoundMeasurability.followerCodeOfState
                p rate block (input.1.2.2 i)),
                roundCodeListCoordinates
                  ([] : List (ActualInitializationStepMeasurability.ActualRoundOutputCode
                    p rate block))))) := by
        funext input
        rw [actualBlockFoldCodeAux.eq_def]
        rfl
      have hcontinuation : Measurable (fun input : ActualInitializationCursorMeasurability.CursorInput
          p rate block C_star C_h cursor =>
          ActualInitializationBlockMeasurability.continuationCodeOf input.1.2.1) := by
        exact measurable_fst.comp (measurable_snd.comp hcoords)
      have hfollowerCodes : Measurable (fun input : ActualInitializationCursorMeasurability.CursorInput
          p rate block C_star C_h cursor =>
          fun i => ActualInitializationRoundMeasurability.followerCodeOfState p rate block
            (input.1.2.2 i)) := by
        exact measurable_snd.comp (measurable_snd.comp hcoords)
      apply measurable_comap_iff.mpr
      change Measurable (fun input => blockFoldCodeCoordinates
        (actualBlockFoldCodeAux (p := p) (rate := rate) (block := block)
          (C_star := C_star) (C_h := C_h) cursor 0 hbudget rewards input))
      rw [hpointwise]
      exact hcontinuation.prodMk (hfollowerCodes.prodMk measurable_const)
  | succ fuel ih =>
      have hcursor : cursor < BootstrapObservedFollower.blockLength p block := by omega
      have hnextBudget : cursor + 1 + fuel =
          BootstrapObservedFollower.blockLength p block := by omega
      let nextFn : ActualInitializationCursorMeasurability.CursorInput p rate block
          C_star C_h cursor →
          ActualInitializationCursorMeasurability.CursorInput p rate block
            C_star C_h (cursor + 1) :=
        ActualInitializationCursorMeasurability.cursorSuccessorInput hcursor rewards
      let tailFn : ActualInitializationCursorMeasurability.CursorInput p rate block
          C_star C_h cursor →
          ActualInitializationBlockMeasurability.BlockFoldCode p rate block C_star C_h :=
        fun input => actualBlockFoldCodeAux (p := p) (rate := rate) (block := block)
          (C_star := C_star) (C_h := C_h) (cursor + 1) fuel hnextBudget rewards
          (nextFn input)
      let headFn : ActualInitializationCursorMeasurability.CursorInput p rate block
          C_star C_h cursor →
          ActualInitializationStepMeasurability.ActualRoundOutputCode p rate block :=
        fun input => (ActualInitializationCursorMeasurability.actualCursorOutputCode
          hcursor rewards input).1
      have houtput := ActualInitializationCursorMeasurability.measurable_actualCursorOutputCode
        (rate := rate) (C_star := C_star) (C_h := C_h) hcursor rewards
      have hnext := ActualInitializationCursorMeasurability.measurable_cursorSuccessorInput
        (rate := rate) (C_star := C_star) (C_h := C_h) hcursor rewards
      have htail := ih hnextBudget
      have htailComp : Measurable tailFn := by
        dsimp [tailFn, nextFn]
        exact htail.comp hnext
      have htailCoordinates := (measurable_blockFoldCodeCoordinates).comp htailComp
      have hphase : Measurable (fun input : ActualInitializationCursorMeasurability.CursorInput
          p rate block C_star C_h cursor =>
          (tailFn input).phase) :=
        measurable_fst.comp htailCoordinates
      have hfollowers : Measurable (fun input : ActualInitializationCursorMeasurability.CursorInput
          p rate block C_star C_h cursor =>
          (tailFn input).followers) :=
        measurable_fst.comp (measurable_snd.comp htailCoordinates)
      have htailRounds : Measurable (fun input : ActualInitializationCursorMeasurability.CursorInput
          p rate block C_star C_h cursor =>
          roundCodeListCoordinates (tailFn input).rounds) :=
        measurable_snd.comp (measurable_snd.comp htailCoordinates)
      have hhead : Measurable (fun input : ActualInitializationCursorMeasurability.CursorInput
          p rate block C_star C_h cursor =>
          headFn input) :=
        measurable_fst.comp houtput
      have hrounds := measurable_roundCodeListCoordinates_cons headFn
        (fun input => (tailFn input).rounds) hhead htailRounds
      have hcoordinates : Measurable (fun input :
          ActualInitializationCursorMeasurability.CursorInput p rate block C_star C_h cursor =>
          blockFoldCodeCoordinates
            (actualBlockFoldCodeAux (p := p) (rate := rate) (block := block)
              (C_star := C_star) (C_h := C_h) cursor (fuel + 1) hbudget rewards input)) := by
        have hpointwise :
            (fun input : ActualInitializationCursorMeasurability.CursorInput
                p rate block C_star C_h cursor =>
              blockFoldCodeCoordinates (actualBlockFoldCodeAux (p := p) (rate := rate)
                (block := block) (C_star := C_star) (C_h := C_h) cursor (fuel + 1)
                hbudget rewards input)) =
            (fun input =>
              ((tailFn input).phase,
                ((tailFn input).followers,
                  roundCodeListCoordinates (headFn input :: (tailFn input).rounds)))) := by
          funext input
          rw [actualBlockFoldCodeAux.eq_def]
          rfl
        rw [hpointwise]
        exact hphase.prodMk (hfollowers.prodMk hrounds)
      exact measurable_comap_iff.mpr hcoordinates

/-- The stored list has one complete round code for each recursive cursor
step. -/
theorem actualBlockFoldCodeAux_rounds_length {p : Parameters}
    {rate : RateInput p} {block : Fin (n_boot p)} {C_star C_h : ℝ}
    {cursor fuel : ℕ}
    (hbudget : cursor + fuel = BootstrapObservedFollower.blockLength p block)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (input : ActualInitializationCursorMeasurability.CursorInput
      p rate block C_star C_h cursor) :
    (actualBlockFoldCodeAux (p := p) (rate := rate) (block := block)
      (C_star := C_star) (C_h := C_h) cursor fuel hbudget rewards input).rounds.length = fuel := by
  induction fuel generalizing cursor with
  | zero =>
      rw [actualBlockFoldCodeAux.eq_def]
      rfl
  | succ fuel ih =>
      have hnextBudget : cursor + 1 + fuel =
          BootstrapObservedFollower.blockLength p block := by omega
      rw [actualBlockFoldCodeAux.eq_def]
      simp only [List.length_cons]
      have htail := ih hnextBudget
        (ActualInitializationCursorMeasurability.cursorSuccessorInput
          (by omega) rewards input)
      omega

/-- Run the accepted cursor recursion from `R.beginBlock`, varying both the
whole original source and the existing incoming carry. -/
def actualBlockFoldCodeOfInput {p : Parameters} {rate : RateInput p}
    {block : Fin (n_boot p)} {C_star C_h : ℝ}
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (input : ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h) :
    ActualInitializationBlockMeasurability.BlockFoldCode p rate block C_star C_h :=
  actualBlockFoldCodeAux (p := p) (rate := rate) (block := block)
    (C_star := C_star) (C_h := C_h) 0 (BootstrapObservedFollower.blockLength p block)
    (by omega) rewards (actualCursorZeroInput input)

/-- Joint Borel measurability of the actual block fold on the complete
source-and-carry input. -/
theorem measurable_actualBlockFoldCodeOfInput {p : Parameters} {rate : RateInput p}
    {block : Fin (n_boot p)} {C_star C_h : ℝ}
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p) :
    Measurable (actualBlockFoldCodeOfInput (p := p) (rate := rate) (block := block)
      (C_star := C_star) (C_h := C_h) rewards) := by
  exact (measurable_actualBlockFoldCodeAux
    (p := p) (rate := rate) (block := block) (C_star := C_star) (C_h := C_h)
    (cursor := 0) (fuel := BootstrapObservedFollower.blockLength p block) (by omega)
    rewards).comp measurable_actualCursorZeroInput

/-- Standard Borel composition through any measurable map into the same
whole-source and actual-carry block input. -/
theorem measurable_actualBlockFoldCodeOfInput_comp
    {p : Parameters} {rate : RateInput p} {block : Fin (n_boot p)}
    {C_star C_h : ℝ} {Ω : Type*} [MeasurableSpace Ω]
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (input : Ω → ActualInitializationBlockMeasurability.BlockInput
      p rate block C_star C_h) (hinput : Measurable input) :
    Measurable (fun ω => actualBlockFoldCodeOfInput rewards (input ω)) :=
  (measurable_actualBlockFoldCodeOfInput rewards).comp hinput

end Bandits.Support.ActualInitializationBlockFoldMeasurability

end
