namespace Bandits.Support.ReferenceSourceOwnHistoryContainment

abbrev Parameters := ConstructorDimensions.Parameters
abbrev SourceInput (p : Parameters) := BootstrapPrivateRoundStreams.SourceInput p
abbrev OwnEntry (p : Parameters) := Fin p.K × ReferencePrelaunchFollower.Observation p
abbrev IncomingCode (p : Parameters) (rate : ReferenceActivePhysicalStep.RateInput p) :=
  Option (ReferenceActivePhysicalStepMeasurability.StateCode p rate)
abbrev IncomingIndex (p : Parameters) (n : ℕ) := {t : Fin p.T // t.val ≤ n}

variable {p : Parameters}

/-- The literal actual complete own-history prefix. Its entry contains both
the physical arm and the original quantized observation. -/
def ownBefore (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (n : ℕ) (hn : n ≤ p.T) (z : SourceInput p) :
    Fin p.m → Fin n → OwnEntry p :=
  fun i k => ReferenceCompletePhysicalHistory.completeOwnHistory rate z rewards C_star C_h i
    (Fin.castLE hn k)

/-- Replacing only selected controls at offsets at least `n` leaves the same
actual complete-own-history entries before `n`. -/
theorem ownBefore_factor (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (control0 : ContinuousLearningRows.TimeControl p)
    (n : ℕ) (hn : n ≤ p.T) (z : SourceInput p) :
    ownBefore rate rewards C_star C_h n hn z =
      ownBefore rate rewards C_star C_h n hn
        (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n z) := by
  by_cases hnt : n < p.T
  · funext i k
    have h :=
      ReferenceCompleteOwnHistoryPrefixLocality.completeOwnHistory_eq_of_replaceSelectedControlSuffix
        rate rewards C_star C_h z ⟨n, hnt⟩ (fun _ => control0) i
        (Fin.castLE hn k) k.isLt
    change ReferenceCompletePhysicalHistory.completeOwnHistory rate z rewards C_star C_h i
        (Fin.castLE hn k) =
      ReferenceCompletePhysicalHistory.completeOwnHistory rate
        (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n z)
        rewards C_star C_h i (Fin.castLE hn k)
    rw [ReferenceSourcePrefixHistoryFiltration.sourcePrefix_eq_suffix control0 n hnt z]
    exact h
  · have hT : p.T ≤ n := by omega
    rw [ReferenceSourcePrefixHistoryFiltration.sourcePrefix_eq_self control0 n hT z]

-- These two decoders are total measurable extensions of the existing code
-- projections. The proof below shows that every actual history lookup is
-- present, so neither padding branch supplies an actual history entry.
private def decodeBoundaryLog (p : Parameters)
    (x : Option (Fin p.K × Fin (D p + 1))) : OwnEntry p :=
  match x with
  | none => (⟨0, ConstructorDimensions.K_pos p⟩,
      ActualInitializationPhysicalStep.observationOfGrid p ⟨0, Nat.zero_lt_succ _⟩)
  | some (arm, grid) => (arm, ActualInitializationPhysicalStep.observationOfGrid p grid)

private theorem measurable_decodeBoundaryLog (p : Parameters) :
    Measurable (decodeBoundaryLog p) := by
  let : MeasurableSpace (Option (Fin p.K × Fin (D p + 1))) :=
    LaterAssignmentStartMeasurability.optionMeasurableSpace
  let : MeasurableSingletonClass ((Fin p.K × Fin (D p + 1)) ⊕ PUnit) :=
    ⟨fun x => by
      cases x with
      | inl armGrid =>
          rw [measurableSet_sum_iff]
          constructor
          · have hpre : Sum.inl ⁻¹' ({Sum.inl armGrid} :
                Set ((Fin p.K × Fin (D p + 1)) ⊕ PUnit)) = {armGrid} := by
              ext y
              simp
            rw [hpre]
            exact measurableSet_singleton armGrid
          · have hpre : Sum.inr ⁻¹' ({Sum.inl armGrid} :
                Set ((Fin p.K × Fin (D p + 1)) ⊕ PUnit)) = ∅ := by
              ext y
              simp
            rw [hpre]
            exact MeasurableSet.empty
      | inr u =>
          rw [measurableSet_sum_iff]
          constructor
          · have hpre : Sum.inl ⁻¹' ({Sum.inr u} :
                Set ((Fin p.K × Fin (D p + 1)) ⊕ PUnit)) = ∅ := by
              ext y
              simp
            rw [hpre]
            exact MeasurableSet.empty
          · have hpre : Sum.inr ⁻¹' ({Sum.inr u} :
                Set ((Fin p.K × Fin (D p + 1)) ⊕ PUnit)) = {u} := by
              ext y
              simp
            rw [hpre]
            exact measurableSet_singleton u⟩
  let : MeasurableSingletonClass (Option (Fin p.K × Fin (D p + 1))) :=
    ⟨fun x => by
      change MeasurableSet[
          (inferInstance : MeasurableSpace
            ((Fin p.K × Fin (D p + 1)) ⊕ PUnit)).comap
              (Equiv.optionEquivSumPUnit (Fin p.K × Fin (D p + 1)))]
        ({x} : Set (Option (Fin p.K × Fin (D p + 1))) )
      apply (MeasurableSpace.measurableSet_comap).2
      refine ⟨{Equiv.optionEquivSumPUnit (Fin p.K × Fin (D p + 1)) x},
        measurableSet_singleton _, ?_⟩
      ext y
      simp⟩
  exact measurable_of_countable (decodeBoundaryLog p)

private theorem observationOfGrid_index (p : Parameters)
    (y : ReferencePrelaunchFollower.Observation p) :
    ActualInitializationPhysicalStep.observationOfGrid p
        (ReferenceInitializationMeasurability.observationGridIndex p y) = y := by
  apply Subtype.ext
  apply Subtype.ext
  calc
    _ = (ReferenceInitializationMeasurability.observationGridIndex p y).val / (D p : ℝ) :=
      ActualInitializationPhysicalStep.observationOfGrid_value p _
    _ = y.val.val := (ReferenceInitializationMeasurability.observationGridIndex_value p y).symm

private def decodeRoundRecordTag (p : Parameters)
    (rate : ReferenceActivePhysicalStep.RateInput p) (player : Fin p.m) :
    Unit ⊕ ReferenceActiveHorizonMeasurability.RoundRecordCode (p := p) (rate := rate) →
      OwnEntry p :=
  Sum.elim (fun _ : Unit =>
      (⟨0, ConstructorDimensions.K_pos p⟩,
        ActualInitializationPhysicalStep.observationOfGrid p ⟨0, Nat.zero_lt_succ _⟩))
    (fun code => ReferenceActiveHorizonMeasurability.roundRecordCodeOwnEntry code player)

private theorem measurable_decodeRoundRecordTag
    (rate : ReferenceActivePhysicalStep.RateInput p) (player : Fin p.m) :
    Measurable (decodeRoundRecordTag p rate player) := by
  exact Measurable.sumElim measurable_const
    (ReferenceActiveHorizonMeasurability.measurable_roundRecordCodeOwnEntry player)

private theorem measurable_listObservationAt {α : Type*} [MeasurableSpace α] (n : ℕ) :
    Measurable (fun records : List α =>
      ReferenceActiveHorizonMeasurability.listObservationAt records n) := by
  exact (measurable_pi_apply n).comp
    (measurable_snd.comp
      (ReferenceActiveHorizonMeasurability.measurable_listObservationCoordinates (α := α)))

private theorem measurable_variableListObservationAt {α : Type*} [MeasurableSpace α] :
    Measurable (fun v : ℕ × List α =>
      ReferenceActiveHorizonMeasurability.listObservationAt v.2 v.1) := by
  exact measurable_from_prod_countable_right
    (f := fun v : ℕ × List α =>
      ReferenceActiveHorizonMeasurability.listObservationAt v.2 v.1)
    (fun n => measurable_listObservationAt (α := α) n)

private theorem measurable_generatedBoundary (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) :
    Measurable (fun z : SourceInput p =>
      ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h) := by
  have h := (ReferenceInitializationMeasurability.measurable_output
      p C_star C_h rate.eta rewards).comp
    (ReferencePrelaunchCarriedMeasurability.measurable_sourceCoordinates (p := p))
  convert h using 1
  funext z
  exact congrArg ReferenceInitializationRun.output
    (ReferencePrelaunchCarriedMeasurability.sourceCoordinates_referenceInput
      z rewards C_star C_h rate).symm

private theorem measurable_physicalStart (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) :
    Measurable (fun z : SourceInput p =>
      ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h) := by
  have h := (measurable_of_countable (fun b : ReferenceInitializationRun.Boundary p =>
      ReferenceInitializationRun.elapsed p b.completed)).comp
    (measurable_generatedBoundary rate rewards C_star C_h)
  convert h using 1
  funext z
  rfl

private theorem measurable_generatedBoundaryLog
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) :
    Measurable (fun z : SourceInput p =>
      ReferenceInitializationMeasurability.boundaryLog p
        (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h)) := by
  exact (measurable_of_countable (ReferenceInitializationMeasurability.boundaryLog p)).comp
    (measurable_generatedBoundary rate rewards C_star C_h)

private theorem measurable_completeSuffixCode
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) :
    Measurable (fun z : SourceInput p =>
      ReferenceGeneratedCompleteCalendarObservation.completeSuffixCode
        (rate := rate) rewards C_star C_h z) :=
  ReferenceGeneratedCompleteCalendarObservation.measurable_completeSuffixCode
    (rate := rate) rewards C_star C_h

private theorem measurable_completeOwnHistory_entry
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (player : Fin p.m) (time : Fin p.T) :
    Measurable (fun z : SourceInput p =>
      ReferenceCompletePhysicalHistory.completeOwnHistory rate z rewards C_star C_h player time) := by
  classical
  let start := fun z : SourceInput p =>
    ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h
  let logs := fun z : SourceInput p =>
    ReferenceInitializationMeasurability.boundaryLog p
      (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h)
  let codes := fun z : SourceInput p =>
    ReferenceGeneratedCompleteCalendarObservation.completeSuffixCode
      (rate := rate) rewards C_star C_h z
  have hstart : Measurable start := measurable_physicalStart rate rewards C_star C_h
  have hlogs : Measurable logs := measurable_generatedBoundaryLog rate rewards C_star C_h
  have hcodes : Measurable codes := measurable_completeSuffixCode rate rewards C_star C_h
  have hlogAt : Measurable (fun z : SourceInput p => logs z player time) :=
    (measurable_pi_apply time).comp
      ((measurable_pi_apply player).comp hlogs)
  have hinit : Measurable (fun z : SourceInput p => decodeBoundaryLog p (logs z player time)) :=
    (measurable_decodeBoundaryLog p).comp hlogAt
  have hoffset : Measurable (fun z : SourceInput p => time.val - start z) :=
    (measurable_of_countable (fun s : ℕ => time.val - s)).comp hstart
  have htagged : Measurable (fun z : SourceInput p =>
      ReferenceActiveHorizonMeasurability.listObservationAt (codes z) (time.val - start z)) := by
    exact measurable_variableListObservationAt.comp (hoffset.prodMk hcodes)
  have hactive : Measurable (fun z : SourceInput p =>
      decodeRoundRecordTag p rate player
        (ReferenceActiveHorizonMeasurability.listObservationAt (codes z)
          (time.val - start z))) :=
    (measurable_decodeRoundRecordTag rate player).comp htagged
  have hset : MeasurableSet {z : SourceInput p | start z ≤ time.val} :=
    hstart (MeasurableSpace.measurableSet_top : MeasurableSet {s : ℕ | s ≤ time.val})
  have hpiece : Measurable (fun z : SourceInput p =>
      if start z ≤ time.val then
        decodeRoundRecordTag p rate player
          (ReferenceActiveHorizonMeasurability.listObservationAt (codes z)
            (time.val - start z))
      else decodeBoundaryLog p (logs z player time)) :=
    Measurable.ite hset hactive hinit
  have heq : (fun z : SourceInput p =>
      ReferenceCompletePhysicalHistory.completeOwnHistory rate z rewards C_star C_h player time) =
      fun z => if start z ≤ time.val then
        decodeRoundRecordTag p rate player
          (ReferenceActiveHorizonMeasurability.listObservationAt (codes z)
            (time.val - start z))
      else decodeBoundaryLog p (logs z player time) := by
    funext z
    by_cases hbefore : time.val < start z
    · have hprefix := ReferenceCompletePhysicalHistory.completeOwnHistory_prefix
        rate z rewards C_star C_h player time hbefore
      have hlog := ReferenceInitializationMeasurability.boundaryLog_prefix p
        (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h)
        player ⟨time.val, hbefore⟩
      have htime :
          (⟨time.val, Nat.lt_of_lt_of_le hbefore
            (ReferenceInitializationRun.elapsed_le_T p
              (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h).completed)⟩ :
            Fin p.T) = time := Fin.ext rfl
      rw [htime] at hlog
      have hvalue := ReferenceInitializationMeasurability.boundaryLog_value p
        (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h)
        player ⟨time.val, hbefore⟩
      have hobs : ActualInitializationPhysicalStep.observationOfGrid p
          (ReferenceInitializationMeasurability.observationGridIndex p
            ((ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h).history
              player ⟨time.val, hbefore⟩).2) =
            ((ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h).history
              player ⟨time.val, hbefore⟩).2 := by
        apply Subtype.ext
        apply Subtype.ext
        calc
          _ = (ReferenceInitializationMeasurability.observationGridIndex p
              ((ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h).history
                player ⟨time.val, hbefore⟩).2).val / (D p : ℝ) :=
            ActualInitializationPhysicalStep.observationOfGrid_value p _
          _ = _ := hvalue
      have hnot : ¬ start z ≤ time.val := by omega
      rw [ite_eq_right hnot]
      calc
        ReferenceCompletePhysicalHistory.completeOwnHistory rate z rewards C_star C_h player time =
            (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h).history
              player ⟨time.val, hbefore⟩ := hprefix
        _ = decodeBoundaryLog p (logs z player time) := by
          change (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h).history
              player ⟨time.val, hbefore⟩ =
            decodeBoundaryLog p
              (ReferenceInitializationMeasurability.boundaryLog p
                (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h)
                player time)
          have hlog' :
              ReferenceInitializationMeasurability.boundaryLog p
                  (ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h)
                  player time = some (((ReferenceCompletePhysicalHistory.generatedBoundary
                    rate z rewards C_star C_h).history player
                      ⟨time.val, hbefore⟩).1,
                ReferenceInitializationMeasurability.observationGridIndex p
                  ((ReferenceCompletePhysicalHistory.generatedBoundary rate z rewards C_star C_h).history
                    player ⟨time.val, hbefore⟩).2) := by
            simpa [htime] using hlog
          rw [hlog']
          simp [decodeBoundaryLog, hobs]
    · have hpost : start z ≤ time.val := by omega
      rw [ite_eq_left hpost]
      have hpost' : ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h ≤
          time.val := by simpa [start] using hpost
      have hlaunch : ReferenceCorrectedInitializationLaunch.correctedLaunch
          rate z rewards C_star C_h ≠ none := by
        intro hnone
        have hT := ReferenceCompletePhysicalHistory.correctedLaunch_none_start_eq_T
          rate z rewards C_star C_h hnone
        rw [hT] at hpost'
        omega
      obtain ⟨active, hlaunch⟩ := Option.ne_none_iff_exists.mp hlaunch
      have hindex : time.val - start z <
          (ReferenceGeneratedCompleteCalendarObservation.completeSuffixCode
            (rate := rate) rewards C_star C_h z).length := by
        rw [ReferenceGeneratedCompleteCalendarObservation.completeSuffixCode_length]
        change time.val - ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h <
          p.T - ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h
        omega
      have hget : (codes z)[time.val - start z]? =
          some ((codes z).get ⟨time.val - start z, hindex⟩) :=
        List.getElem?_eq_getElem hindex
      have htag :
          ReferenceActiveHorizonMeasurability.listObservationAt (codes z)
            (time.val - start z) = Sum.inr
              ((codes z).get ⟨time.val - start z, hindex⟩) := by
        simp [ReferenceActiveHorizonMeasurability.listObservationAt, hget]
      have hnone : ReferenceCorrectedInitializationLaunch.correctedLaunch
          rate z rewards C_star C_h ≠ none := by rw [← hlaunch]; simp
      let suffixRun := ReferenceCompletePhysicalHistory.correctedSuffixRun
        rate z rewards C_star C_h hnone
      have hrunCount : suffixRun.records.length = p.T - start z := by
        simpa [suffixRun, start] using
          ReferenceCompletePhysicalHistory.correctedSuffixRun_record_count
            rate z rewards C_star C_h hnone
      have hrunIndex : time.val - start z < suffixRun.records.length := by
        rw [hrunCount]
        change time.val - ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h <
          p.T - ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h
        omega
      let suffixIndex : Fin suffixRun.records.length := ⟨time.val - start z, hrunIndex⟩
      let record := suffixRun.records.get suffixIndex
      have hrecords := ReferenceCompletePhysicalHistory.completeOwnHistory_suffix
        rate z rewards C_star C_h player active hlaunch.symm
        ⟨time.val - start z, by
          change time.val - ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h <
            p.T - ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h
          omega⟩
      have htime : start z + (time.val - start z) = time.val := by omega
      have htime' : ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h +
          (time.val - start z) = time.val := by simpa [start] using htime
      have hfin : time =
          ⟨ReferenceCompletePhysicalHistory.physicalStart rate z rewards C_star C_h +
            (time.val - start z), by rw [htime']; exact time.isLt⟩ := by
        apply Fin.ext
        exact htime'.symm
      have hactual :
          ReferenceCompletePhysicalHistory.completeOwnHistory rate z rewards C_star C_h player time =
            record.ownEntries player := by
        rw [hfin]
        simpa [suffixRun, record, suffixIndex, hnone] using hrecords
      have hrecordCode :
          (codes z).get ⟨time.val - start z, hindex⟩ =
            ReferenceActiveHorizonMeasurability.roundRecordCode record := by
        simp [codes, ReferenceGeneratedCompleteCalendarObservation.completeSuffixCode,
          ReferenceCompletePhysicalHistory.completeSuffixRecords, hnone, suffixRun,
          record, suffixIndex]
      have hdecode :=
        (ReferenceActiveHorizonMeasurability.roundRecordCode_reconstructs record).2.2.2.2 player
      calc
        ReferenceCompletePhysicalHistory.completeOwnHistory rate z rewards C_star C_h player time =
            record.ownEntries player := hactual
        _ = decodeRoundRecordTag p rate player
            (ReferenceActiveHorizonMeasurability.listObservationAt (codes z)
              (time.val - start z)) := by
          rw [htag, hrecordCode]
          simp only [decodeRoundRecordTag, Sum.elim_inr]
          exact hdecode.symm
  rw [heq]
  exact hpiece

/-- Unconditional Borel measurability of the actual complete own-history
prefix, constructed from the generated boundary log and complete suffix code.
-/
theorem measurable_ownBefore (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (n : ℕ) (hn : n ≤ p.T) :
    Measurable (fun z : SourceInput p => ownBefore rate rewards C_star C_h n hn z) := by
  apply measurable_pi_iff.mpr
  intro player
  apply measurable_pi_iff.mpr
  intro k
  exact measurable_completeOwnHistory_entry rate rewards C_star C_h player
    (Fin.castLE hn k)

/-- The actual own-history prefix is adapted to the original-source prefix
filtration at the successor field. -/
theorem ownBefore_measurable (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (control0 : ContinuousLearningRows.TimeControl p)
    (n : ℕ) (hn : n ≤ p.T) :
    Measurable[ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1)]
      (ownBefore rate rewards C_star C_h n hn) := by
  rw [ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration_succ]
  have h := (measurable_ownBefore rate rewards C_star C_h n hn).comp
    (comap_measurable (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n))
  convert h using 1
  funext z
  exact ownBefore_factor rate rewards C_star C_h control0 n hn z

/-- The complete forward table in the row selected by the original private
coordinator index. -/
def selectedForwardRow (z : SourceInput p) : CompletePublicTable.ForwardRow p :=
  (z.1.2 (ActualInitializationPhysicalStep.selectedRowIndex p z)).1

/-- The original selected continuous controls at exactly the bounded source
offsets `Fin n`. -/
def selectedControlPrefix (n : ℕ) (hn : n ≤ p.T) (z : SourceInput p) :=
  fun k : Fin n =>
    (z.1.2 (ActualInitializationPhysicalStep.selectedRowIndex p z)).2 (Fin.castLE hn k)

/-- The existing encoded incoming register at each included source round. -/
def incomingReadouts (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (n : ℕ) (z : SourceInput p) :
    IncomingIndex p n → IncomingCode p rate :=
  fun t => ReferenceSourcePrefixHistoryFiltration.incoming rate rewards C_star C_h t.1 z

/-- The analysis enlargement generated by the original IDs, complete selected
forward row, every original private coordinate, selected controls before `n`,
the actual `ownBefore` prefix, and incoming encoded states through offset `n`
when such a source round exists. -/
@[instance_reducible] def inspectedHistorySpace (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (n : ℕ) (hn : n ≤ p.T) : MeasurableSpace (SourceInput p) :=
  (inferInstance : MeasurableSpace (CompletePublicTable.IDArray p)).comap (fun z => z.1.1) ⊔
    (inferInstance : MeasurableSpace (CompletePublicTable.ForwardRow p)).comap selectedForwardRow ⊔
    (inferInstance : MeasurableSpace (ExtendedPrivateCoordinates p)).comap Prod.snd ⊔
    (inferInstance : MeasurableSpace (Fin n → ContinuousLearningRows.TimeControl p)).comap
      (selectedControlPrefix n hn) ⊔
    (inferInstance : MeasurableSpace (Fin p.m → Fin n → OwnEntry p)).comap
      (ownBefore rate rewards C_star C_h n hn) ⊔
    (inferInstance : MeasurableSpace (IncomingIndex p n → IncomingCode p rate)).comap
      (incomingReadouts rate rewards C_star C_h n)

private theorem selectedForward_measurable :
    Measurable (selectedForwardRow (p := p)) := by
  have hcoords := ReferencePrelaunchCarriedMeasurability.measurable_sourceCoordinates
    (p := p)
  exact measurable_fst.comp (measurable_fst.comp (measurable_snd.comp hcoords))

private theorem selectedForward_prefix_eq
    (control0 : ContinuousLearningRows.TimeControl p) (n : ℕ) (z : SourceInput p) :
    selectedForwardRow (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n z) =
      selectedForwardRow z := by
  change ((ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n z).1.2
      (ActualInitializationPhysicalStep.selectedRowIndex p
        (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n z))).1 = _
  rw [ReferenceSourcePrefixHistoryFiltration.sourcePrefix_selected]
  exact ReferenceSourcePrefixHistoryFiltration.sourcePrefix_forward control0 n z
    (ActualInitializationPhysicalStep.selectedRowIndex p z)

private theorem selectedControls_measurable (n : ℕ) (hn : n ≤ p.T) :
    Measurable (selectedControlPrefix (p := p) n hn) := by
  have hcoords := ReferencePrelaunchCarriedMeasurability.measurable_sourceCoordinates
    (p := p)
  have hrow := measurable_fst.comp (measurable_snd.comp hcoords)
  apply measurable_pi_iff.mpr
  intro k
  exact (measurable_pi_apply (Fin.castLE hn k)).comp
    (measurable_snd.comp hrow)

private theorem selectedControls_prefix_eq
    (control0 : ContinuousLearningRows.TimeControl p) (n : ℕ) (hn : n ≤ p.T)
    (z : SourceInput p) :
    selectedControlPrefix n hn (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n z) =
      selectedControlPrefix n hn z := by
  funext k
  simp [selectedControlPrefix, ReferenceSourcePrefixHistoryFiltration.sourcePrefix_selected,
    ReferenceSourcePrefixHistoryFiltration.sourcePrefix_control, k.isLt]

private theorem incomingVector_measurable
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (control0 : ContinuousLearningRows.TimeControl p)
    (n : ℕ) :
    Measurable[ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1)]
      (incomingReadouts rate rewards C_star C_h n) := by
  let : MeasurableSpace (SourceInput p) :=
    ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1)
  apply measurable_pi_iff.mpr
  intro t
  have h := ReferenceSourcePrefixHistoryFiltration.incoming_measurable
    rate rewards C_star C_h control0 t.1
  have hmono := (ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0).mono
    (by omega : t.1.val + 1 ≤ n + 1)
  exact h.mono hmono le_rfl

private theorem selectedForward_adapted
    (control0 : ContinuousLearningRows.TimeControl p) (n : ℕ) :
    Measurable[ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1)]
      (selectedForwardRow (p := p)) := by
  rw [ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration_succ]
  have h := (selectedForward_measurable (p := p)).comp
    (comap_measurable (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n))
  convert h using 1
  funext z
  exact (selectedForward_prefix_eq control0 n z).symm

private theorem selectedControls_adapted
    (control0 : ContinuousLearningRows.TimeControl p)
    (n : ℕ) (hn : n ≤ p.T) :
    Measurable[ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1)]
      (selectedControlPrefix (p := p) n hn) := by
  rw [ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration_succ]
  have h := (selectedControls_measurable (p := p) n hn).comp
    (comap_measurable (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n))
  convert h using 1
  funext z
  exact (selectedControls_prefix_eq control0 n hn z).symm

private theorem ids_adapted
    (control0 : ContinuousLearningRows.TimeControl p) (n : ℕ) :
    Measurable[ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1)]
      (fun z : SourceInput p => z.1.1) := by
  rw [ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration_succ]
  have hcoords := ReferencePrelaunchCarriedMeasurability.measurable_sourceCoordinates
    (p := p)
  have h := (measurable_fst.comp hcoords).comp
    (comap_measurable (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n))
  convert h using 1
  funext z
  exact (ReferenceSourcePrefixHistoryFiltration.sourcePrefix_ids control0 n z).symm

private theorem privateCoordinates_adapted
    (control0 : ContinuousLearningRows.TimeControl p) (n : ℕ) :
    Measurable[ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1)]
      (fun z : SourceInput p => z.2) := by
  rw [ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration_succ]
  have hcoords := ReferencePrelaunchCarriedMeasurability.measurable_sourceCoordinates
    (p := p)
  have h := (measurable_snd.comp (measurable_snd.comp hcoords)).comp
    (comap_measurable (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 n))
  convert h using 1
  funext z
  exact (ReferenceSourcePrefixHistoryFiltration.sourcePrefix_private control0 n z).symm

private theorem observed_components_le_prefix
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (control0 : ContinuousLearningRows.TimeControl p)
    (n : ℕ) (hn : n ≤ p.T) :
    inspectedHistorySpace rate rewards C_star C_h n hn ≤
      ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1) := by
  let m := ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1)
  have hids : (inferInstance : MeasurableSpace (CompletePublicTable.IDArray p)).comap
      (fun z : SourceInput p => z.1.1) ≤ m :=
    (ids_adapted control0 n).comap_le
  have hfwd : (inferInstance : MeasurableSpace (CompletePublicTable.ForwardRow p)).comap
      selectedForwardRow ≤ m :=
    (selectedForward_adapted control0 n).comap_le
  have hprivate : (inferInstance : MeasurableSpace (ExtendedPrivateCoordinates p)).comap
      (Prod.snd : SourceInput p → ExtendedPrivateCoordinates p) ≤ m :=
    (privateCoordinates_adapted control0 n).comap_le
  have hcontrols : (inferInstance : MeasurableSpace
      (Fin n → ContinuousLearningRows.TimeControl p)).comap (selectedControlPrefix n hn) ≤ m :=
    (selectedControls_adapted control0 n hn).comap_le
  have hown : (inferInstance : MeasurableSpace (Fin p.m → Fin n → OwnEntry p)).comap
      (ownBefore rate rewards C_star C_h n hn) ≤ m :=
    (ownBefore_measurable rate rewards C_star C_h control0 n hn).comap_le
  have hincoming : (inferInstance : MeasurableSpace
      (IncomingIndex p n → IncomingCode p rate)).comap
        (incomingReadouts rate rewards C_star C_h n) ≤ m :=
    (incomingVector_measurable rate rewards C_star C_h control0 n).comap_le
  dsimp [inspectedHistorySpace]
  exact sup_le (sup_le (sup_le (sup_le (sup_le hids hfwd) hprivate) hcontrols) hown)
    hincoming

/-- Every literal observable generating the enlargement is measurable at the
original-source successor prefix field. -/
theorem inspectedHistorySpace_le_sourcePrefixFiltration
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (control0 : ContinuousLearningRows.TimeControl p)
    (n : ℕ) (hn : n ≤ p.T) :
    inspectedHistorySpace rate rewards C_star C_h n hn ≤
      ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1) :=
  observed_components_le_prefix rate rewards C_star C_h control0 n hn

private theorem source_prefix_le_original
    (control0 : ContinuousLearningRows.TimeControl p) (n : ℕ) :
    ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 n ≤
      (inferInstance : MeasurableSpace (SourceInput p)) :=
  (ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0).le' n

/-- The enlarged analysis field is contained in the original source Borel
space as well as in the successor prefix field. -/
theorem inspectedHistorySpace_le_original
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (control0 : ContinuousLearningRows.TimeControl p)
    (n : ℕ) (hn : n ≤ p.T) :
    inspectedHistorySpace rate rewards C_star C_h n hn ≤
      (inferInstance : MeasurableSpace (SourceInput p)) :=
  (inspectedHistorySpace_le_sourcePrefixFiltration rate rewards C_star C_h control0 n hn).trans
    (source_prefix_le_original control0 (n + 1))

/-- Own-history is measurable in the sigma field generated by the listed
observables, by its defining source-coordinate comap. -/
theorem ownBefore_measurable_in_inspectedHistorySpace
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (n : ℕ) (hn : n ≤ p.T) :
    Measurable[inspectedHistorySpace rate rewards C_star C_h n hn]
      (ownBefore rate rewards C_star C_h n hn) := by
  have h : Measurable[
      (inferInstance : MeasurableSpace (Fin p.m → Fin n → OwnEntry p)).comap
        (ownBefore rate rewards C_star C_h n hn)]
      (ownBefore rate rewards C_star C_h n hn) :=
    comap_measurable (ownBefore rate rewards C_star C_h n hn)
  have hle : (inferInstance : MeasurableSpace (Fin p.m → Fin n → OwnEntry p)).comap
      (ownBefore rate rewards C_star C_h n hn) ≤
      inspectedHistorySpace rate rewards C_star C_h n hn := by
    dsimp [inspectedHistorySpace]
    exact le_sup_of_le_left (le_sup_of_le_right le_rfl)
  exact h.mono hle le_rfl

/-- Each retained incoming state readout is measurable in its corresponding
defining comap, and hence in the generated analysis field. -/
theorem incoming_measurable_in_inspectedHistorySpace
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ)
    (n : ℕ) (hn : n ≤ p.T) (t : Fin p.T) (ht : t.val ≤ n) :
    Measurable[inspectedHistorySpace rate rewards C_star C_h n hn]
      (ReferenceSourcePrefixHistoryFiltration.incoming rate rewards C_star C_h t) := by
  let idx : IncomingIndex p n := ⟨t, ht⟩
  have hvec : Measurable[
      (inferInstance : MeasurableSpace (IncomingIndex p n → IncomingCode p rate)).comap
        (incomingReadouts rate rewards C_star C_h n)]
      (incomingReadouts rate rewards C_star C_h n) :=
    comap_measurable (incomingReadouts rate rewards C_star C_h n)
  have hread : Measurable[
      (inferInstance : MeasurableSpace (IncomingIndex p n → IncomingCode p rate)).comap
        (incomingReadouts rate rewards C_star C_h n)]
      (fun z => (incomingReadouts rate rewards C_star C_h n z) idx) :=
    (measurable_pi_apply idx).comp hvec
  have hle : (inferInstance : MeasurableSpace
      (IncomingIndex p n → IncomingCode p rate)).comap
        (incomingReadouts rate rewards C_star C_h n) ≤
      inspectedHistorySpace rate rewards C_star C_h n hn := by
    dsimp [inspectedHistorySpace]
    exact le_sup_of_le_right le_rfl
  have heq : (fun z => (incomingReadouts rate rewards C_star C_h n z) idx) =
      ReferenceSourcePrefixHistoryFiltration.incoming rate rewards C_star C_h t := by
    rfl
  rw [← heq]
  exact hread.mono hle le_rfl

/-- The conditional-expectation tower from the original-source prefix field
to the explicitly generated inspected-history field. `hY` is only the usual
integrability input for this general analytic lemma. -/
theorem inspectedHistory_condExp_tower
    (rate : ReferenceActivePhysicalStep.RateInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (C_star C_h : ℝ) (control0 : ContinuousLearningRows.TimeControl p)
    (n : ℕ) (hn : n ≤ p.T) (Y : SourceInput p → ℝ)
    (hY : Integrable Y (BootstrapPrivateRoundStreams.sourceInputLaw p)) :
    let μ := BootstrapPrivateRoundStreams.sourceInputLaw p
    μ[μ[Y | ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1)] |
      inspectedHistorySpace rate rewards C_star C_h n hn] =ᵐ[μ]
        μ[Y | inspectedHistorySpace rate rewards C_star C_h n hn] := by
  let μ := BootstrapPrivateRoundStreams.sourceInputLaw p
  have hm12 : inspectedHistorySpace rate rewards C_star C_h n hn ≤
      ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1) :=
    inspectedHistorySpace_le_sourcePrefixFiltration rate rewards C_star C_h control0 n hn
  have hm2 : ReferenceSourcePrefixHistoryFiltration.sourcePrefixFiltration control0 (n + 1) ≤
      (inferInstance : MeasurableSpace (SourceInput p)) :=
    source_prefix_le_original control0 (n + 1)
  have : IsProbabilityMeasure μ := BootstrapPrivateRoundStreams.sourceInputLaw_probability p
  have : SigmaFinite (μ.trim hm2) := by infer_instance
  have _integrableInput := hY
  exact MeasureTheory.condExp_condExp_of_le hm12 hm2

