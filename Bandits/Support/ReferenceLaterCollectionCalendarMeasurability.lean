module

public import Bandits.Support.ReferenceLaterCollectionSourceReadoutMeasurability

/-!
# Numerical and integer-arrival views of the later-collection calendar

Sources: `sources/zip4/manuscript/05_binary_transport.tex:354-431`,
`sources/zip4/manuscript/06_interruptions.tex:192-233,355-408`, and
`sources/zip4/manuscript/08_main_theorem.tex:26-75`.

Both exported calendars are literal maps of the existing unfiltered
`partialCalendar`. On a physical-start fibre the original suffix has fixed
length, so its list is assembled from the admitted indexed optional readouts.
The measurable structure on lists is generated by the exact length and all
sum-tagged indexed entries; continuous reward and rate vectors retain their
usual product Borel spaces. Fibre identities use the existing calendar gets
and the same indexed suffix record, with subtype proof fields erased only by
proof irrelevance.

These exports prove calendar measurability only. They do not establish total
readout coverage, queue or score truth, stopped endpoints, local-history
adaptation, a conditional law, concentration, or a source-facing regret claim.
-/

@[expose] public section

noncomputable section

open MeasureTheory
open Bandits.Support.ConstructorDimensions

namespace Bandits.Support.ReferenceLaterCollectionCalendarMeasurability

open ReferenceCompleteSuffixInputMeasurability
open ReferenceLaterCollectionSourceReadoutMeasurability
open ReferenceLaterCollectionArrivalReadout

variable {p : ConstructorDimensions.Parameters}
  (rate : ReferenceActivePhysicalStep.RateInput p)
  (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
  (C_star C_h : ℝ)

abbrev Source (p : ConstructorDimensions.Parameters) :=
  BootstrapPrivateRoundStreams.SourceInput p

abbrev NumericalCell (p : ConstructorDimensions.Parameters) :=
  Bool × (Option (Fin p.K) × ((Fin p.K → ℝ) × (Fin p.K → ℝ)))

abbrev ArrivalCell (p : ConstructorDimensions.Parameters) := Bool × (Fin p.K → ℕ)

abbrev NumericalEntry (p : ConstructorDimensions.Parameters) :=
  Fin p.T × Option (NumericalCell p)

abbrev ArrivalEntry (p : ConstructorDimensions.Parameters) :=
  Fin p.T × Option (ArrivalCell p)

/-- The literal full numerical observation of each existing partial-calendar
entry. No time, source record, or absent readout is removed or replaced. -/
def numericalCalendar (source : Source p) : List (NumericalEntry p) :=
  (ReferenceLaterCollectionArrivalReadout.partialCalendar
    rate rewards C_star C_h source).map fun entry =>
      (entry.1, entry.2.map numericalCoordinates)

/-- The literal full integer-arrival observation of each existing
partial-calendar entry. The inner vector is the original queue quantization
for every arm. -/
def arrivalCalendar (source : Source p) : List (ArrivalEntry p) :=
  (ReferenceLaterCollectionArrivalReadout.partialCalendar
    rate rewards C_star C_h source).map fun entry =>
      (entry.1, entry.2.map (arrivalCoordinates rate))

private abbrev PhysicalStartFiber (s : Fin (p.T + 1)) :=
  {source : Source p //
    ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h = s.val}

private def suffixIndexOnFiber (s : Fin (p.T + 1))
    (k : Fin (p.T - s.val)) (x : PhysicalStartFiber rate rewards C_star C_h s) :
    Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate x.val rewards C_star C_h).length :=
  ⟨k.val, by
    rw [ReferenceCompletePhysicalHistory.completeSuffixRecords_length, x.property]
    exact k.isLt⟩

private def indexedOnFiber (s : Fin (p.T + 1))
    (k : Fin (p.T - s.val)) (x : PhysicalStartFiber rate rewards C_star C_h s) :
    IndexedSource rate rewards C_star C_h k.val :=
  ⟨x.val, (suffixIndexOnFiber rate rewards C_star C_h s k x).isLt⟩

private theorem measurable_indexedOnFiber (s : Fin (p.T + 1))
    (k : Fin (p.T - s.val)) :
    Measurable (indexedOnFiber rate rewards C_star C_h s k) := by
  exact measurable_subtype_coe.subtype_mk
    (h := fun x => (suffixIndexOnFiber rate rewards C_star C_h s k x).isLt)

private def numericalFiberEntry (s : Fin (p.T + 1))
    (k : Fin (p.T - s.val)) (x : PhysicalStartFiber rate rewards C_star C_h s) :
    NumericalEntry p :=
  let indexed := indexedOnFiber rate rewards C_star C_h s k x
  Prod.mk (actualRoundInputAt rate rewards C_star C_h k.val indexed).time
    ((actualReadout rate rewards C_star C_h k.val
      (ReferenceCompletePhysicalHistory.physicalStart rate x.val rewards C_star C_h,
        indexed)).map numericalCoordinates)

private def arrivalFiberEntry (s : Fin (p.T + 1))
    (k : Fin (p.T - s.val)) (x : PhysicalStartFiber rate rewards C_star C_h s) :
    ArrivalEntry p :=
  let indexed := indexedOnFiber rate rewards C_star C_h s k x
  Prod.mk (actualRoundInputAt rate rewards C_star C_h k.val indexed).time
    ((actualReadout rate rewards C_star C_h k.val
      (ReferenceCompletePhysicalHistory.physicalStart rate x.val rewards C_star C_h,
        indexed)).map (arrivalCoordinates rate))

private theorem measurable_numericalFiberEntry (s : Fin (p.T + 1))
    (k : Fin (p.T - s.val)) :
    Measurable (numericalFiberEntry rate rewards C_star C_h s k) := by
  have hindex := measurable_indexedOnFiber rate rewards C_star C_h s k
  have htime := (ReferenceActivePhysicalStepMeasurability.measurable_time.comp
    (measurable_actualRoundInputAt rate rewards C_star C_h k.val)).comp hindex
  have hreadout :=
    (measurable_physicalStartReadout_numerical rate rewards C_star C_h k.val).comp hindex
  exact htime.prodMk hreadout

private theorem measurable_arrivalFiberEntry (s : Fin (p.T + 1))
    (k : Fin (p.T - s.val)) :
    Measurable (arrivalFiberEntry rate rewards C_star C_h s k) := by
  have hindex := measurable_indexedOnFiber rate rewards C_star C_h s k
  have htime := (ReferenceActivePhysicalStepMeasurability.measurable_time.comp
    (measurable_actualRoundInputAt rate rewards C_star C_h k.val)).comp hindex
  have hreadout :=
    (measurable_physicalStartReadout_arrivals rate rewards C_star C_h k.val).comp hindex
  exact htime.prodMk hreadout

private def numericalFiberCalendar (s : Fin (p.T + 1)) :
    PhysicalStartFiber rate rewards C_star C_h s → List (NumericalEntry p) :=
  fun x => List.ofFn (fun k : Fin (p.T - s.val) =>
    numericalFiberEntry rate rewards C_star C_h s k x)

private def arrivalFiberCalendar (s : Fin (p.T + 1)) :
    PhysicalStartFiber rate rewards C_star C_h s → List (ArrivalEntry p) :=
  fun x => List.ofFn (fun k : Fin (p.T - s.val) =>
    arrivalFiberEntry rate rewards C_star C_h s k x)

private theorem measurable_list_ofFn {X α : Type*} [MeasurableSpace X]
    [MeasurableSpace α] (n : ℕ) (f : X → Fin n → α) (hf : Measurable f) :
    Measurable (fun x => List.ofFn (f x)) := by
  apply measurable_comap_iff.mpr
  change Measurable (fun x =>
    ((List.ofFn (f x)).length,
      fun j => ReferenceActiveHorizonMeasurability.listObservationAt
        (List.ofFn (f x)) j))
  simp only [List.length_ofFn]
  apply measurable_const.prodMk
  apply measurable_pi_iff.mpr
  intro j
  by_cases hj : j < n
  · let i : Fin n := ⟨j, hj⟩
    have heq : (fun x => ReferenceActiveHorizonMeasurability.listObservationAt
        (List.ofFn (f x)) j) = fun x => Sum.inr (f x i) := by
      funext x
      simp [ReferenceActiveHorizonMeasurability.listObservationAt, i, hj]
    rw [heq]
    exact measurable_inr.comp ((measurable_pi_apply i).comp hf)
  · have heq : (fun x => ReferenceActiveHorizonMeasurability.listObservationAt
        (List.ofFn (f x)) j) = fun _ => (Sum.inl () : Unit ⊕ α) := by
      funext x
      simp [ReferenceActiveHorizonMeasurability.listObservationAt, hj]
    rw [heq]
    exact measurable_const

private theorem measurable_numericalFiberCalendar (s : Fin (p.T + 1)) :
    Measurable (numericalFiberCalendar rate rewards C_star C_h s) := by
  apply measurable_list_ofFn (p.T - s.val)
  apply measurable_pi_iff.mpr
  intro k
  exact measurable_numericalFiberEntry rate rewards C_star C_h s k

private theorem measurable_arrivalFiberCalendar (s : Fin (p.T + 1)) :
    Measurable (arrivalFiberCalendar rate rewards C_star C_h s) := by
  apply measurable_list_ofFn (p.T - s.val)
  apply measurable_pi_iff.mpr
  intro k
  exact measurable_arrivalFiberEntry rate rewards C_star C_h s k

/-- Every finite get of the numerical calendar is the same physical record
and the same optional readout as the unfiltered `partialCalendar`. -/
theorem numericalCalendar_get (source : Source (p := p))
    (k : Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate source rewards C_star C_h).length) :
    (numericalCalendar rate rewards C_star C_h source).get
        ⟨k.val, by simp [numericalCalendar, ReferenceLaterCollectionArrivalReadout.partialCalendar]⟩ =
      Prod.mk ((ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate source rewards C_star C_h).get k).input.time
        ((ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
          (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
          ((ReferenceCompletePhysicalHistory.completeSuffixRecords
            rate source rewards C_star C_h).get k)).map numericalCoordinates) := by
  have h := ReferenceLaterCollectionArrivalReadout.partialCalendar_get
    rate rewards C_star C_h source k
  have hmap := congrArg
    (fun entry : Fin p.T × Option (RecordedQueueRun.RoundInput p.K) =>
      Prod.mk entry.1 (entry.2.map numericalCoordinates)) h
  simpa only [numericalCalendar, List.get_eq_getElem, List.getElem_map] using hmap

/-- Every finite get of the arrival calendar keeps every queue coordinate of
the same optional readout. -/
theorem arrivalCalendar_get (source : Source (p := p))
    (k : Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate source rewards C_star C_h).length) :
    (arrivalCalendar rate rewards C_star C_h source).get
        ⟨k.val, by simp [arrivalCalendar, ReferenceLaterCollectionArrivalReadout.partialCalendar]⟩ =
      Prod.mk ((ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate source rewards C_star C_h).get k).input.time
        ((ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
          (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
          ((ReferenceCompletePhysicalHistory.completeSuffixRecords
            rate source rewards C_star C_h).get k)).map (arrivalCoordinates rate)) := by
  have h := ReferenceLaterCollectionArrivalReadout.partialCalendar_get
    rate rewards C_star C_h source k
  have hmap := congrArg
    (fun entry : Fin p.T × Option (RecordedQueueRun.RoundInput p.K) =>
      Prod.mk entry.1 (entry.2.map (arrivalCoordinates rate))) h
  simpa only [arrivalCalendar, List.get_eq_getElem, List.getElem_map] using hmap

/-- The numerical calendar has exactly one entry per actual suffix record. -/
theorem numericalCalendar_length (source : Source (p := p)) :
    (numericalCalendar rate rewards C_star C_h source).length =
      p.T - ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h := by
  rw [numericalCalendar, List.length_map]
  exact ReferenceLaterCollectionArrivalReadout.partialCalendar_length
    rate rewards C_star C_h source

/-- The arrival calendar has exactly one entry per actual suffix record. -/
theorem arrivalCalendar_length (source : Source (p := p)) :
    (arrivalCalendar rate rewards C_star C_h source).length =
      p.T - ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h := by
  rw [arrivalCalendar, List.length_map]
  exact ReferenceLaterCollectionArrivalReadout.partialCalendar_length
    rate rewards C_star C_h source

/-- Numerical observations retain precisely the original physical dates. -/
theorem numericalCalendar_times (source : Source (p := p)) :
    (numericalCalendar rate rewards C_star C_h source).map (fun entry => entry.1.val) =
      List.range'
        (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
        (p.T - ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h) 1 := by
  rw [numericalCalendar, List.map_map]
  change (ReferenceLaterCollectionArrivalReadout.partialCalendar
    rate rewards C_star C_h source).map (fun entry => entry.1.val) = _
  exact ReferenceLaterCollectionArrivalReadout.partialCalendar_times
    rate rewards C_star C_h source

/-- Integer-arrival observations retain precisely the original physical dates. -/
theorem arrivalCalendar_times (source : Source (p := p)) :
    (arrivalCalendar rate rewards C_star C_h source).map (fun entry => entry.1.val) =
      List.range'
        (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
        (p.T - ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h) 1 := by
  rw [arrivalCalendar, List.map_map]
  change (ReferenceLaterCollectionArrivalReadout.partialCalendar
    rate rewards C_star C_h source).map (fun entry => entry.1.val) = _
  exact ReferenceLaterCollectionArrivalReadout.partialCalendar_times
    rate rewards C_star C_h source

private theorem numericalFiberEntry_eq_calendar_get (s : Fin (p.T + 1))
    (k : Fin (p.T - s.val)) (x : PhysicalStartFiber rate rewards C_star C_h s) :
    numericalFiberEntry rate rewards C_star C_h s k x =
      Prod.mk ((ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate x.val rewards C_star C_h).get
          (suffixIndexOnFiber rate rewards C_star C_h s k x)).input.time
        ((ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
          (ReferenceCompletePhysicalHistory.physicalStart rate x.val rewards C_star C_h)
          ((ReferenceCompletePhysicalHistory.completeSuffixRecords
            rate x.val rewards C_star C_h).get
              (suffixIndexOnFiber rate rewards C_star C_h s k x))).map numericalCoordinates) := by
  rfl

private theorem arrivalFiberEntry_eq_calendar_get (s : Fin (p.T + 1))
    (k : Fin (p.T - s.val)) (x : PhysicalStartFiber rate rewards C_star C_h s) :
    arrivalFiberEntry rate rewards C_star C_h s k x =
      Prod.mk ((ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate x.val rewards C_star C_h).get
          (suffixIndexOnFiber rate rewards C_star C_h s k x)).input.time
        ((ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
          (ReferenceCompletePhysicalHistory.physicalStart rate x.val rewards C_star C_h)
          ((ReferenceCompletePhysicalHistory.completeSuffixRecords
            rate x.val rewards C_star C_h).get
              (suffixIndexOnFiber rate rewards C_star C_h s k x))).map
                (arrivalCoordinates rate)) := by
  rfl

private theorem numericalCalendar_eq_fiberCalendar (s : Fin (p.T + 1))
    (x : PhysicalStartFiber rate rewards C_star C_h s) :
    numericalCalendar rate rewards C_star C_h x.val =
      numericalFiberCalendar rate rewards C_star C_h s x := by
  apply List.ext_getElem
  · simp [numericalFiberCalendar, numericalCalendar_length, x.property]
  · intro i hiLeft hiRight
    have hi : i < p.T - s.val := by
      simpa [numericalCalendar_length, x.property] using hiLeft
    let k : Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate x.val rewards C_star C_h).length :=
      ⟨i, by
        rw [ReferenceCompletePhysicalHistory.completeSuffixRecords_length, x.property]
        exact hi⟩
    have hget := numericalCalendar_get rate rewards C_star C_h x.val k
    have hactual : (numericalCalendar rate rewards C_star C_h x.val)[i] =
        Prod.mk ((ReferenceCompletePhysicalHistory.completeSuffixRecords
          rate x.val rewards C_star C_h).get k).input.time
          ((ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
            (ReferenceCompletePhysicalHistory.physicalStart rate x.val rewards C_star C_h)
            ((ReferenceCompletePhysicalHistory.completeSuffixRecords
              rate x.val rewards C_star C_h).get k)).map numericalCoordinates) := by
      simpa only [List.get_eq_getElem] using hget
    have hentry := numericalFiberEntry_eq_calendar_get rate rewards C_star C_h s
      ⟨i, hi⟩ x
    have hidx : suffixIndexOnFiber rate rewards C_star C_h s ⟨i, hi⟩ x = k := by
      apply Fin.ext
      rfl
    simpa only [numericalFiberCalendar, List.getElem_ofFn, hidx] using
      hactual.trans hentry.symm

private theorem arrivalCalendar_eq_fiberCalendar (s : Fin (p.T + 1))
    (x : PhysicalStartFiber rate rewards C_star C_h s) :
    arrivalCalendar rate rewards C_star C_h x.val =
      arrivalFiberCalendar rate rewards C_star C_h s x := by
  apply List.ext_getElem
  · simp [arrivalFiberCalendar, arrivalCalendar_length, x.property]
  · intro i hiLeft hiRight
    have hi : i < p.T - s.val := by
      simpa [arrivalCalendar_length, x.property] using hiLeft
    let k : Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate x.val rewards C_star C_h).length :=
      ⟨i, by
        rw [ReferenceCompletePhysicalHistory.completeSuffixRecords_length, x.property]
        exact hi⟩
    have hget := arrivalCalendar_get rate rewards C_star C_h x.val k
    have hactual : (arrivalCalendar rate rewards C_star C_h x.val)[i] =
        Prod.mk ((ReferenceCompletePhysicalHistory.completeSuffixRecords
          rate x.val rewards C_star C_h).get k).input.time
          ((ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
            (ReferenceCompletePhysicalHistory.physicalStart rate x.val rewards C_star C_h)
            ((ReferenceCompletePhysicalHistory.completeSuffixRecords
              rate x.val rewards C_star C_h).get k)).map (arrivalCoordinates rate)) := by
      simpa only [List.get_eq_getElem] using hget
    have hentry := arrivalFiberEntry_eq_calendar_get rate rewards C_star C_h s
      ⟨i, hi⟩ x
    have hidx : suffixIndexOnFiber rate rewards C_star C_h s ⟨i, hi⟩ x = k := by
      apply Fin.ext
      rfl
    simpa only [arrivalFiberCalendar, List.getElem_ofFn, hidx] using
      hactual.trans hentry.symm

/-- Both numerical and integer-arrival list maps are Borel on the original
source, with the natural finite-list, product, option, and function spaces. -/
theorem measurable_numericalCalendar :
    Measurable (numericalCalendar rate rewards C_star C_h) := by
  intro target htarget
  have hfiberSet (s : Fin (p.T + 1)) :
      MeasurableSet {source : Source p |
      ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h = s.val} := by
    exact (measurableSet_singleton s.val).preimage
      (measurable_physicalStart rate rewards C_star C_h)
  have heq : numericalCalendar rate rewards C_star C_h ⁻¹' target =
      ⋃ s : Fin (p.T + 1), Subtype.val ''
        ((fun x : PhysicalStartFiber rate rewards C_star C_h s =>
          numericalCalendar rate rewards C_star C_h x.val) ⁻¹' target) := by
    ext source
    constructor
    · intro hsource
      let s : Fin (p.T + 1) :=
        ⟨ReferenceCompletePhysicalHistory.physicalStart
          rate source rewards C_star C_h,
          by
            have h := ReferenceCompletePhysicalHistory.physicalStart_le_T
              rate source rewards C_star C_h
            omega⟩
      refine Set.mem_iUnion.mpr ⟨s, ?_⟩
      exact ⟨⟨source, rfl⟩, hsource, rfl⟩
    · intro hsource
      obtain ⟨s, x, hx, hval⟩ := Set.mem_iUnion.mp hsource
      subst source
      exact hx
  rw [heq]
  exact MeasurableSet.iUnion fun s =>
    MeasurableSet.subtype_image (hfiberSet s) (by
      rw [funext (numericalCalendar_eq_fiberCalendar rate rewards C_star C_h s)]
      exact measurable_numericalFiberCalendar rate rewards C_star C_h s htarget)

/-- The full integer-arrival calendar is Borel on the original source. -/
theorem measurable_arrivalCalendar :
    Measurable (arrivalCalendar rate rewards C_star C_h) := by
  intro target htarget
  have hfiberSet (s : Fin (p.T + 1)) :
      MeasurableSet {source : Source p |
      ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h = s.val} := by
    exact (measurableSet_singleton s.val).preimage
      (measurable_physicalStart rate rewards C_star C_h)
  have heq : arrivalCalendar rate rewards C_star C_h ⁻¹' target =
      ⋃ s : Fin (p.T + 1), Subtype.val ''
        ((fun x : PhysicalStartFiber rate rewards C_star C_h s =>
          arrivalCalendar rate rewards C_star C_h x.val) ⁻¹' target) := by
    ext source
    constructor
    · intro hsource
      let s : Fin (p.T + 1) :=
        ⟨ReferenceCompletePhysicalHistory.physicalStart
          rate source rewards C_star C_h,
          by
            have h := ReferenceCompletePhysicalHistory.physicalStart_le_T
              rate source rewards C_star C_h
            omega⟩
      refine Set.mem_iUnion.mpr ⟨s, ?_⟩
      exact ⟨⟨source, rfl⟩, hsource, rfl⟩
    · intro hsource
      obtain ⟨s, x, hx, hval⟩ := Set.mem_iUnion.mp hsource
      subst source
      exact hx
  rw [heq]
  exact MeasurableSet.iUnion fun s =>
    MeasurableSet.subtype_image (hfiberSet s) (by
      rw [funext (arrivalCalendar_eq_fiberCalendar rate rewards C_star C_h s)]
      exact measurable_arrivalFiberCalendar rate rewards C_star C_h s htarget)

/-- The option projection at each finite numerical-calendar index is absent
exactly when the original later-collection readout is absent. -/
theorem numericalCalendar_get_none_iff (source : Source (p := p))
    (k : Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate source rewards C_star C_h).length) :
    ((numericalCalendar rate rewards C_star C_h source).get
      ⟨k.val, by simp [numericalCalendar,
        ReferenceLaterCollectionArrivalReadout.partialCalendar]⟩).2 = none ↔
      ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
        (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
        ((ReferenceCompletePhysicalHistory.completeSuffixRecords
          rate source rewards C_star C_h).get k) = none := by
  rw [numericalCalendar_get rate rewards C_star C_h source k]
  cases ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
      (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
      ((ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate source rewards C_star C_h).get k) <;> simp

/-- The option projection at each finite arrival-calendar index is absent
exactly when the original later-collection readout is absent. -/
theorem arrivalCalendar_get_none_iff (source : Source (p := p))
    (k : Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate source rewards C_star C_h).length) :
    ((arrivalCalendar rate rewards C_star C_h source).get
      ⟨k.val, by simp [arrivalCalendar,
        ReferenceLaterCollectionArrivalReadout.partialCalendar]⟩).2 = none ↔
      ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
        (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
        ((ReferenceCompletePhysicalHistory.completeSuffixRecords
          rate source rewards C_star C_h).get k) = none := by
  rw [arrivalCalendar_get rate rewards C_star C_h source k]
  cases ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
      (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
      ((ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate source rewards C_star C_h).get k) <;> simp

/-- A present disabled numerical cell remains a `some` entry with its complete
marker, reward, and rate coordinates. -/
theorem numericalCalendar_get_disabled (source : Source (p := p))
    (k : Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate source rewards C_star C_h).length)
    (c : RecordedQueueRun.RoundInput p.K)
    (hreadout : ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
      (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
      ((ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate source rewards C_star C_h).get k) = some c)
    (henabled : c.enabled = false) :
    ((numericalCalendar rate rewards C_star C_h source).get
      ⟨k.val, by simp [numericalCalendar,
        ReferenceLaterCollectionArrivalReadout.partialCalendar]⟩).2 =
      some (false, (c.recordedArm, (c.reward, c.rate))) := by
  rw [numericalCalendar_get rate rewards C_star C_h source k, hreadout]
  simp [numericalCoordinates, henabled]

/-- A present enabled cell with no arm marker remains present and retains the
whole reward and rate vectors. -/
theorem numericalCalendar_get_enabled_no_marker (source : Source (p := p))
    (k : Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate source rewards C_star C_h).length)
    (c : RecordedQueueRun.RoundInput p.K)
    (hreadout : ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
      (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
      ((ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate source rewards C_star C_h).get k) = some c)
    (henabled : c.enabled = true) (hmarker : c.recordedArm = none) :
    ((numericalCalendar rate rewards C_star C_h source).get
      ⟨k.val, by simp [numericalCalendar,
        ReferenceLaterCollectionArrivalReadout.partialCalendar]⟩).2 =
      some (true, (none, (c.reward, c.rate))) := by
  rw [numericalCalendar_get rate rewards C_star C_h source k, hreadout]
  simp [numericalCoordinates, henabled, hmarker]

/-- An enabled cell whose recorded arm has only zero integer arrivals is
still a present `some` readout. Its numerical projection retains the marker,
while its arrival projection retains every zero coordinate. -/
theorem present_enabled_zero_integer_arrivals (source : Source (p := p))
    (k : Fin (ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate source rewards C_star C_h).length)
    (c : RecordedQueueRun.RoundInput p.K) (a : Fin p.K)
    (hreadout : ReferenceLaterCollectionArrivalReadout.laterCollectionReadout
      (ReferenceCompletePhysicalHistory.physicalStart rate source rewards C_star C_h)
      ((ReferenceCompletePhysicalHistory.completeSuffixRecords
        rate source rewards C_star C_h).get k) = some c)
    (henabled : c.enabled = true) (hmarker : c.recordedArm = some a)
    (hzero : ∀ b, RecordedQueueRun.quantizedArrival
      (ReferenceFirstLaunchNumericalCell.queueParameters rate) c b = 0) :
    ((numericalCalendar rate rewards C_star C_h source).get
      ⟨k.val, by simp [numericalCalendar,
        ReferenceLaterCollectionArrivalReadout.partialCalendar]⟩).2 =
        some (true, (some a, (c.reward, c.rate))) ∧
      ((arrivalCalendar rate rewards C_star C_h source).get
        ⟨k.val, by simp [arrivalCalendar,
          ReferenceLaterCollectionArrivalReadout.partialCalendar]⟩).2 =
        some (true, fun _ => 0) := by
  constructor
  · rw [numericalCalendar_get rate rewards C_star C_h source k, hreadout]
    simp [numericalCoordinates, henabled, hmarker]
  · rw [arrivalCalendar_get rate rewards C_star C_h source k, hreadout]
    have hvector : (fun b => RecordedQueueRun.quantizedArrival
        (ReferenceFirstLaunchNumericalCell.queueParameters rate) c b) =
        fun _ => 0 := funext hzero
    simp [arrivalCoordinates, henabled, hvector]

private theorem numericalCalendar_nil_of_emptySuffix (source : Source (p := p))
    (hempty : ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate source rewards C_star C_h = []) :
    numericalCalendar rate rewards C_star C_h source = [] := by
  simp [numericalCalendar, ReferenceLaterCollectionArrivalReadout.partialCalendar, hempty]

private theorem arrivalCalendar_nil_of_emptySuffix (source : Source (p := p))
    (hempty : ReferenceCompletePhysicalHistory.completeSuffixRecords
      rate source rewards C_star C_h = []) :
    arrivalCalendar rate rewards C_star C_h source = [] := by
  simp [arrivalCalendar, ReferenceLaterCollectionArrivalReadout.partialCalendar, hempty]

/-- No corrected launch produces the genuine empty numerical suffix list. -/
theorem numericalCalendar_eq_nil_of_no_launch (source : Source (p := p))
    (hlaunch : ReferenceCorrectedInitializationLaunch.correctedLaunch
      rate source rewards C_star C_h = none) :
    numericalCalendar rate rewards C_star C_h source = [] := by
  exact numericalCalendar_nil_of_emptySuffix rate rewards C_star C_h source
    (ReferenceCompletePhysicalHistory.no_launch_complete_history
      rate source rewards C_star C_h hlaunch).2.1

/-- No corrected launch produces the genuine empty arrival suffix list. -/
theorem arrivalCalendar_eq_nil_of_no_launch (source : Source (p := p))
    (hlaunch : ReferenceCorrectedInitializationLaunch.correctedLaunch
      rate source rewards C_star C_h = none) :
    arrivalCalendar rate rewards C_star C_h source = [] := by
  exact arrivalCalendar_nil_of_emptySuffix rate rewards C_star C_h source
    (ReferenceCompletePhysicalHistory.no_launch_complete_history
      rate source rewards C_star C_h hlaunch).2.1

/-- A launch exactly at the terminal boundary has no post-launch physical
rounds, hence its numerical calendar is genuinely empty. -/
theorem numericalCalendar_eq_nil_of_launch_at_T (source : Source (p := p))
    (active : ReferenceActivePhysicalStep.State p rate)
    (hlaunch : ReferenceCorrectedInitializationLaunch.correctedLaunch
      rate source rewards C_star C_h = some active)
    (hstart : ReferenceCompletePhysicalHistory.physicalStart
      rate source rewards C_star C_h = p.T) :
    numericalCalendar rate rewards C_star C_h source = [] := by
  exact numericalCalendar_nil_of_emptySuffix rate rewards C_star C_h source
    (ReferenceCompletePhysicalHistory.terminal_crossing_complete_history
      rate source rewards C_star C_h active hlaunch hstart).1

/-- A launch exactly at the terminal boundary has no post-launch physical
rounds, hence its arrival calendar is genuinely empty. -/
theorem arrivalCalendar_eq_nil_of_launch_at_T (source : Source (p := p))
    (active : ReferenceActivePhysicalStep.State p rate)
    (hlaunch : ReferenceCorrectedInitializationLaunch.correctedLaunch
      rate source rewards C_star C_h = some active)
    (hstart : ReferenceCompletePhysicalHistory.physicalStart
      rate source rewards C_star C_h = p.T) :
    arrivalCalendar rate rewards C_star C_h source = [] := by
  exact arrivalCalendar_nil_of_emptySuffix rate rewards C_star C_h source
    (ReferenceCompletePhysicalHistory.terminal_crossing_complete_history
      rate source rewards C_star C_h active hlaunch hstart).1

end Bandits.Support.ReferenceLaterCollectionCalendarMeasurability

