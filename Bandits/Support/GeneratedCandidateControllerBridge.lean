module

public import Bandits.Support.GeneratedForwardPrefixTests
public import Bandits.Support.BootstrapAllCandidateController

/-!
# Generated block bridge to the all-candidate controller

Sources: `sources/zip4/manuscript/appendix_b_communication.tex:101-126,
134-165,294-326` and `sources/zip4/manuscript/07_public_setup.tex:93-114,
129-156`.

This module identifies the existing virtual false-forward event with a pass at
some calendar prefix of the accepted all-candidate controller on the physical
block generated by `ReferenceInitializationRun`. Its complement supplies the
controller's clean-prefix condition. The results are deterministic and local
to that generated block; they assert no coupling with an arbitrary execution.
-/

public section

noncomputable section

open Bandits.Support.ConstructorDimensions
open Bandits.Support.BootstrapDimensions
open Bandits.Support.CompletePublicTable
open Bandits.Support.PublicDiscreteDraws

namespace Bandits.Support.GeneratedCandidateControllerBridge

variable {p : Parameters}

private theorem castPhysicalBlock_uninformed {s₁ s₂ : Fin (n_boot p)}
    (e : s₁ = s₂) (v : BootstrapPhysicalBlock.Input p s₁) :
    (e ▸ v).uninformed = v.uninformed := by
  cases e
  rfl

private def followerOfBlockCast {s₁ s₂ : Fin (n_boot p)}
    (e : s₁ = s₂) (v : BootstrapPhysicalBlock.Input p s₁)
    (i : {i // i ∈ (e ▸ v).uninformed}) : {i // i ∈ v.uninformed} :=
  ⟨i.val, by
    have hi := i.property
    exact Eq.mp
      (congrArg (fun u => i.val ∈ u) (castPhysicalBlock_uninformed e v)) hi⟩

private theorem truePrefixRun_eq_of_blockCast
    {s₁ s₂ : Fin (n_boot p)} (e : s₁ = s₂)
    (v : BootstrapPhysicalBlock.Input p s₁)
    (i : {i // i ∈ (e ▸ v).uninformed}) :
    BootstrapTruePrefixController.run (e ▸ v) i p.T =
      BootstrapTruePrefixController.run v (followerOfBlockCast e v i) p.T := by
  cases e
  rfl

/-- The generated block keeps exactly the incoming follower set at the
ReferenceInitializationRun boundary, after its accepted block-index cast. -/
theorem actualPhysicalBlock_uninformed
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s) :
    (GeneratedForwardPrefixTests.actualPhysicalBlock x s h).uninformed =
      ReferenceInitializationRun.uninformed
        (GeneratedForwardPrefixTests.actualBoundary x s) := by
  change
    (GeneratedForwardPrefixTests.actualBlockIndex x s h ▸
      ReferenceInitializationRun.physical x
        (GeneratedForwardPrefixTests.actualBoundary x s)
        (GeneratedForwardPrefixTests.actualBlockRemaining x s h)).uninformed = _
  rw [castPhysicalBlock_uninformed]
  rfl

private theorem sortedTake_toFinset_eq_filter_lt
    (times : List (Fin p.T)) (hsorted : times.SortedLT)
    (selected : Finset (Fin p.T)) (hselected : times.toFinset = selected)
    (q : ℕ) (hqpos : 0 < q) (hqlength : q ≤ times.length) :
    (times.take q).toFinset =
      selected.filter (fun t => t.val < (times.get ⟨q - 1, by omega⟩).val + 1) := by
  let last : Fin p.T := times.get ⟨q - 1, by omega⟩
  have hlastIndex : q - 1 < times.length := by omega
  change (times.take q).toFinset = selected.filter (fun t => t.val < last.val + 1)
  ext t
  simp only [List.mem_toFinset, Finset.mem_filter]
  constructor
  · intro ht
    have hmem : t ∈ times := List.mem_of_mem_take ht
    have hidx : times.idxOf t < q :=
      (List.mem_take_iff_idxOf_lt hmem).mp ht
    have hidxLen : times.idxOf t < times.length :=
      List.idxOf_lt_length_iff.mpr hmem
    have hget : times.get ⟨times.idxOf t, hidxLen⟩ = t :=
      List.idxOf_get hidxLen
    have horder :
        times.get ⟨times.idxOf t, hidxLen⟩ ≤ times.get ⟨q - 1, hlastIndex⟩ := by
      apply (hsorted.strictMono_get.le_iff_le).2
      exact Nat.le_pred_of_lt hidx
    rw [hget] at horder
    have hval : t.val ≤ last.val := Fin.le_iff_val_le_val.mp horder
    have hselectedMem : t ∈ selected := by
      rw [← hselected]
      exact List.mem_toFinset.mpr hmem
    exact ⟨hselectedMem, by omega⟩
  · rintro ⟨ht, htlast⟩
    have hmem : t ∈ times := by
      have hmem' : t ∈ times.toFinset := by rw [hselected]; exact ht
      exact List.mem_toFinset.mp hmem'
    have hidxLen : times.idxOf t < times.length :=
      List.idxOf_lt_length_iff.mpr hmem
    have hget : times.get ⟨times.idxOf t, hidxLen⟩ = t :=
      List.idxOf_get hidxLen
    have hval : t.val ≤ last.val := by omega
    have horder :
        times.get ⟨times.idxOf t, hidxLen⟩ ≤ times.get ⟨q - 1, hlastIndex⟩ := by
      rw [hget]
      exact Fin.le_iff_val_le_val.mpr hval
    have hidx : times.idxOf t ≤ q - 1 :=
      (hsorted.strictMono_get.le_iff_le).mp horder
    exact (List.mem_take_iff_idxOf_lt hmem).mpr (by omega)

private theorem sortedTake_subset_filter_of_card
    (times : List (Fin p.T)) (hsorted : times.SortedLT)
    (selected : Finset (Fin p.T)) (hselected : times.toFinset = selected)
    (q k : ℕ) (hcard : q ≤ (selected.filter (fun t => t.val < k)).card) :
    q ≤ times.length ∧
      (times.take q).toFinset ⊆ selected.filter (fun t => t.val < k) := by
  have hselectedCard : selected.card = times.length := by
    rw [← hselected]
    exact List.toFinset_card_of_nodup hsorted.nodup
  have hqlength : q ≤ times.length := by
    calc
      q ≤ (selected.filter (fun t => t.val < k)).card := hcard
      _ ≤ selected.card := Finset.card_filter_le _ _
      _ = times.length := hselectedCard
  refine ⟨hqlength, ?_⟩
  intro t ht
  have htake : t ∈ times.take q := List.mem_toFinset.mp ht
  have hmem : t ∈ times := List.mem_of_mem_take htake
  have hidx : times.idxOf t < q :=
    (List.mem_take_iff_idxOf_lt hmem).mp htake
  have hidxLen : times.idxOf t < times.length :=
    List.idxOf_lt_length_iff.mpr hmem
  have hget : times.get ⟨times.idxOf t, hidxLen⟩ = t :=
    List.idxOf_get hidxLen
  have htSelected : t ∈ selected := by
    have htFin : t ∈ times.toFinset := List.mem_toFinset.mpr hmem
    rw [hselected] at htFin
    exact htFin
  have htCut : t.val < k := by
    by_contra hnot
    have hkt : k ≤ t.val := by omega
    have hsubset :
        selected.filter (fun u => u.val < k) ⊆
          (times.take (times.idxOf t)).toFinset := by
      intro u hu
      rcases Finset.mem_filter.mp hu with ⟨huSelected, huk⟩
      have huMem : u ∈ times := by
        have huFin : u ∈ times.toFinset := by rw [hselected]; exact huSelected
        exact List.mem_toFinset.mp huFin
      have huIdxLen : times.idxOf u < times.length :=
        List.idxOf_lt_length_iff.mpr huMem
      have huGet : times.get ⟨times.idxOf u, huIdxLen⟩ = u :=
        List.idxOf_get huIdxLen
      have huLt : u.val < t.val := by omega
      have horder :
          times.get ⟨times.idxOf u, huIdxLen⟩ <
            times.get ⟨times.idxOf t, hidxLen⟩ := by
        rw [huGet, hget]
        exact Fin.lt_def.mpr huLt
      have huIndex : times.idxOf u < times.idxOf t :=
        (hsorted.strictMono_get.lt_iff_lt).mp horder
      have huTake : u ∈ times.take (times.idxOf t) :=
        (List.mem_take_iff_idxOf_lt huMem).mpr huIndex
      exact List.mem_toFinset.mpr huTake
    have htakeNodup : (times.take (times.idxOf t)).Nodup :=
      List.Nodup.sublist (List.take_sublist _ _) hsorted.nodup
    have htakeCard : (times.take (times.idxOf t)).toFinset.card = times.idxOf t := by
      rw [List.toFinset_card_of_nodup htakeNodup, List.length_take,
        Nat.min_eq_left (Nat.le_of_lt hidxLen)]
    have hcontra : q ≤ times.idxOf t := by
      calc
        q ≤ (selected.filter (fun u => u.val < k)).card := hcard
        _ ≤ (times.take (times.idxOf t)).toFinset.card := Finset.card_le_card hsubset
        _ = times.idxOf t := htakeCard
    have hfalse : False := by omega
    exact hfalse.elim
  exact Finset.mem_filter.mpr ⟨htSelected, htCut⟩

/-- Candidate eligibility on the generated block is exactly the accepted
all-candidate controller's eligibility, including the generated physical
observation and candidate `v`'s own DATA coordinate. -/
theorem candidateEligible_iff_controller
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (v : Fin (M p)) (t : Fin p.T) :
    GeneratedForwardPrefixTests.candidateEligible x s h j rows v t ↔
      BootstrapAllCandidateController.candidateEligible
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val v t := by
  let phys := GeneratedForwardPrefixTests.actualPhysicalBlock x s h
  change
    (t ∈ calendarBlock p s ∧ phys.active j.val = true ∧
      phys.ids (phys.privateId j.val) t = false ∧
      PublicDiscreteDraws.slotDraw ((rows v).2 t).1 =
        PublicDiscreteDraws.dataSlot ∧
      0 < (ReferenceInitializationRun.ownEntry phys
        (PublicDiscreteDraws.followerPlayer p.two_le_m j.val.val) t).2.val.val) ↔
    ((t ∈ calendarBlock p s ∧ phys.active j.val = true ∧
      phys.ids (phys.privateId j.val) t = false ∧
      0 < (BootstrapPhysicalBlock.observationIndex phys
        (BootstrapPhysicalBlock.run phys t.val) t
        (PublicDiscreteDraws.followerPlayer p.two_le_m j.val.val)).val) ∧
      PublicDiscreteDraws.slotDraw ((rows v).2 t).1 =
        PublicDiscreteDraws.dataSlot)
  constructor
  · rintro ⟨hcal, hactive, hid, hdata, hobs⟩
    exact ⟨⟨hcal, hactive, hid,
      (GeneratedForwardPrefixTests.ownEntry_positive_iff_observationIndex
        phys j.val t).mp hobs⟩, hdata⟩
  · rintro ⟨⟨hcal, hactive, hid, hobs⟩, hdata⟩
    exact ⟨hcal, hactive, hid, hdata,
      (GeneratedForwardPrefixTests.ownEntry_positive_iff_observationIndex
        phys j.val t).mpr hobs⟩

/-- The controller's Boolean eligibility flag is the decision of the actual
generated eligibility predicate. -/
theorem candidateEligibleFlag_eq_true_iff_generated
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (v : Fin (M p)) (t : Fin p.T) :
    BootstrapAllCandidateController.candidateEligibleFlag
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val v t = true ↔
      GeneratedForwardPrefixTests.candidateEligible x s h j rows v t := by
  rw [BootstrapAllCandidateController.candidateEligibleFlag_eq_true_iff]
  exact (candidateEligible_iff_controller x s h j rows v t).symm

/-- Every candidate's actual generated forward bit is the corresponding bit
read by the accepted all-candidate controller at the actual private ID. -/
theorem candidateForwardBit_eq_generated
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (v : Fin (M p)) (t : Fin p.T) :
    BootstrapAllCandidateController.candidateForwardBit
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val v t =
      GeneratedForwardPrefixTests.candidateForwardSlice x s h j rows v t := rfl

/-- The full generated eligible set is the all-candidate controller's full
calendar prefix. -/
theorem eligibleSet_eq_controller_fullPrefix
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (v : Fin (M p)) :
    GeneratedForwardPrefixTests.eligibleSet x s h j rows v =
      BootstrapAllCandidateController.eligiblePrefix
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val v p.T := by
  ext t
  rw [GeneratedForwardPrefixTests.mem_eligibleSet_iff,
    BootstrapAllCandidateController.mem_eligiblePrefix_iff]
  constructor
  · intro ht
    exact ⟨t.isLt,
      (candidateEligible_iff_controller x s h j rows v t).mp ht⟩
  · rintro ⟨_, ht⟩
    exact (candidateEligible_iff_controller x s h j rows v t).mpr ht

/-- Every inclusive calendar cutoff of the generated eligible set is exactly
the accepted all-candidate controller's inclusive prefix set. -/
theorem eligiblePrefixSet_eq_controller_prefix
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (v : Fin (M p)) (k : ℕ) :
    GeneratedForwardPrefixTests.eligiblePrefixSet x s h j rows v k =
      BootstrapAllCandidateController.eligiblePrefix
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val v k := by
  ext t
  rw [GeneratedForwardPrefixTests.mem_eligiblePrefixSet_iff,
    BootstrapAllCandidateController.mem_eligiblePrefix_iff]
  constructor
  · rintro ⟨ht, htk⟩
    exact ⟨htk, (candidateEligible_iff_controller x s h j rows v t).mp
      ((GeneratedForwardPrefixTests.mem_eligibleSet_iff x s h j rows v t).mp ht)⟩
  · rintro ⟨htk, ht⟩
    exact ⟨(GeneratedForwardPrefixTests.mem_eligibleSet_iff x s h j rows v t).mpr
      ((candidateEligible_iff_controller x s h j rows v t).mpr ht), htk⟩

/-- Positive decoder quota rules out a pass at the empty calendar prefix. -/
theorem controller_no_pass_at_zero
    {s : Fin (n_boot p)}
    (phys : BootstrapPhysicalBlock.Input p s) (rows : CompleteRows p)
    (i : {i // i ∈ phys.uninformed}) (v : Fin (M p)) :
    ¬ BootstrapAllCandidateController.passesPrefix phys rows i v 0 := by
  intro hpass
  change q_dec p ≤
      (BootstrapAllCandidateController.eligiblePrefix phys rows i v 0).card ∧ _ at hpass
  have hempty : BootstrapAllCandidateController.eligiblePrefix phys rows i v 0 = ∅ := by
    classical
    ext t
    rw [BootstrapAllCandidateController.mem_eligiblePrefix_iff]
    simp
  rw [hempty] at hpass
  exact (Nat.not_le_of_gt (BootstrapAllCandidateController.q_dec_pos p)) hpass.1

/-- Once the actual input row is identified as `rows J`, the generated
selected-row set is exactly the accepted true-prefix controller's eligible
set. -/
theorem selectedEligibleSet_eq_truePrefix
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p)) (hrow : x.row = rows J) :
    GeneratedForwardPrefixTests.eligibleSet x s h j rows J =
      BootstrapTruePrefixController.eligiblePrefix
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) j.val p.T := by
  have hphysrow :
      (GeneratedForwardPrefixTests.actualPhysicalBlock x s h).row = rows J :=
    (GeneratedForwardPrefixTests.actualPhysicalBlock_row x s h).trans hrow
  rw [eligibleSet_eq_controller_fullPrefix]
  exact BootstrapAllCandidateController.true_candidate_prefix_eq
    (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J hphysrow p.T

/-- The selected candidate's generated first-quota event remains the accepted
true-prefix controller's pass predicate when the actual complete row is
`rows J`. -/
theorem selectedCandidatePasses_iff_generatedPrefixConditions
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p)) (hrow : x.row = rows J) :
    GeneratedForwardPrefixTests.selectedCandidatePasses x s h j ↔
      ∃ t : Fin p.T, t.val < p.T ∧
        t ∈ GeneratedForwardPrefixTests.eligibleSet x s h j rows J ∧
        q_dec p ≤
          (GeneratedForwardPrefixTests.eligiblePrefixSet x s h j rows J
            (t.val + 1)).card ∧
        ∀ r ∈ GeneratedForwardPrefixTests.eligiblePrefixSet x s h j rows J
            (t.val + 1),
          GeneratedForwardPrefixTests.candidateForwardSlice x s h j rows J r = true := by
  exact GeneratedForwardPrefixTests.selectedCandidatePasses_iff_generatedPrefixConditions
    x s h j rows J hrow

private theorem generatedEligibleSet_eq_chronologicalToFinset
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (v : Fin (M p)) :
    (GeneratedForwardPrefixTests.chronologicalEligibleTimes x s h j rows v).toFinset =
      GeneratedForwardPrefixTests.eligibleSet x s h j rows v := by
  ext t
  simp only [List.mem_toFinset,
    GeneratedForwardPrefixTests.mem_chronologicalEligibleTimes_iff]

/-- The virtual first-quota event is exactly the existence of a calendar
prefix on which this all-candidate controller passes. The cutoff is the
calendar time of the quota-th eligible entry, so later mismatches do not erase
an earlier pass. -/
theorem falseCandidatePasses_iff_existsControllerCalendarPass
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p))
    (v : FalseRowSliceFactorization.FalseRow p J) :
    GeneratedForwardPrefixTests.falseCandidatePasses x s h j rows J v ↔
      ∃ k, k ≤ p.T ∧
        BootstrapAllCandidateController.passesPrefix
          (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val v.1 k := by
  let phys := GeneratedForwardPrefixTests.actualPhysicalBlock x s h
  let times := GeneratedForwardPrefixTests.chronologicalEligibleTimes x s h j rows v.1
  let selected := GeneratedForwardPrefixTests.eligibleSet x s h j rows v.1
  have htimesSelected : times.toFinset = selected :=
    generatedEligibleSet_eq_chronologicalToFinset x s h j rows v.1
  have hsorted : times.SortedLT :=
    GeneratedForwardPrefixTests.chronologicalEligibleTimes_sorted x s h j rows v.1
  have hforward (t : Fin p.T) :
      BootstrapAllCandidateController.candidateForwardBit phys rows j.val v.1 t =
        GeneratedForwardPrefixTests.candidateForwardSlice x s h j rows v.1 t :=
    candidateForwardBit_eq_generated x s h j rows v.1 t
  have hprefix (k : ℕ) :
      GeneratedForwardPrefixTests.eligiblePrefixSet x s h j rows v.1 k =
        BootstrapAllCandidateController.eligiblePrefix phys rows j.val v.1 k :=
    eligiblePrefixSet_eq_controller_prefix x s h j rows v.1 k
  have hgeneratedPrefixSet (k : ℕ) :
      GeneratedForwardPrefixTests.eligiblePrefixSet x s h j rows v.1 k =
        selected.filter (fun t => t.val < k) := rfl
  have hlistNoDup : times.Nodup :=
    GeneratedForwardPrefixTests.chronologicalEligibleTimes_nodup x s h j rows v.1
  constructor
  · intro hpass
    have hfirst :=
      (GeneratedForwardPrefixTests.falseCandidatePasses_iff_first_quota
        x s h j rows J v).mp hpass
    have hfirstLen : q_dec p ≤ times.length := by
      simpa [times] using hfirst.1
    have hqpos : 0 < q_dec p := BootstrapAllCandidateController.q_dec_pos p
    let last : Fin p.T := times.get ⟨q_dec p - 1, by omega⟩
    let k := last.val + 1
    have htakeSet : (times.take (q_dec p)).toFinset =
        selected.filter (fun t => t.val < k) := by
      dsimp [k, last]
      exact sortedTake_toFinset_eq_filter_lt times hsorted selected htimesSelected
        (q_dec p) hqpos hfirstLen
    have hgeneratedPrefixSet :
        GeneratedForwardPrefixTests.eligiblePrefixSet x s h j rows v.1 k =
          (times.take (q_dec p)).toFinset := by
      change selected.filter (fun t => t.val < k) = _
      exact htakeSet.symm
    have hprefixCardEq :
        (BootstrapAllCandidateController.eligiblePrefix phys rows j.val v.1 k).card =
          (times.take (q_dec p)).toFinset.card := by
      rw [← hprefix k, hgeneratedPrefixSet]
    have htakeNodup : (times.take (q_dec p)).Nodup :=
      List.Nodup.sublist (List.take_sublist _ _) hlistNoDup
    have htakeCard : (times.take (q_dec p)).toFinset.card = q_dec p := by
      rw [List.toFinset_card_of_nodup htakeNodup, List.length_take,
        Nat.min_eq_left hfirstLen]
    have hquotaCard : q_dec p ≤
        (BootstrapAllCandidateController.eligiblePrefix phys rows j.val v.1 k).card := by
      rw [hprefixCardEq, htakeCard]
    have hall : BootstrapAllCandidateController.allForwardPrefix
        phys rows j.val v.1 k := by
      intro t ht
      have hmemFilter : t ∈ selected.filter (fun u => u.val < k) := by
        have htGenerated :
            t ∈ GeneratedForwardPrefixTests.eligiblePrefixSet x s h j rows v.1 k := by
          rw [hprefix k]
          exact ht
        have htParts :=
          (GeneratedForwardPrefixTests.mem_eligiblePrefixSet_iff
            x s h j rows v.1 k t).mp htGenerated
        change t ∈ selected ∧ t.val < k at htParts
        exact Finset.mem_filter.mpr htParts
      have hmemTake : t ∈ times.take (q_dec p) :=
        List.mem_toFinset.mp (by rw [htakeSet]; exact hmemFilter)
      have hbit := hfirst.2 t hmemTake
      exact (hforward t).trans hbit
    have htime : k ≤ p.T := by
      dsimp [k]
      omega
    exact ⟨k, htime, hquotaCard, hall⟩
  · rintro ⟨k, hk, hpass⟩
    change q_dec p ≤
        (BootstrapAllCandidateController.eligiblePrefix phys rows j.val v.1 k).card ∧
      BootstrapAllCandidateController.allForwardPrefix phys rows j.val v.1 k at hpass
    have hprefixCard : q_dec p ≤
        (selected.filter (fun t => t.val < k)).card := by
      have hcard := hpass.1
      rw [← hprefix k, hgeneratedPrefixSet k] at hcard
      exact hcard
    have hquota : q_dec p ≤ times.length := by
      exact (sortedTake_subset_filter_of_card times hsorted selected htimesSelected
        (q_dec p) k hprefixCard).1
    have htakeSubset :
        (times.take (q_dec p)).toFinset ⊆ selected.filter (fun t => t.val < k) :=
      (sortedTake_subset_filter_of_card times hsorted selected htimesSelected
        (q_dec p) k hprefixCard).2
    have hbits : ∀ t ∈ times.take (q_dec p),
        GeneratedForwardPrefixTests.candidateForwardSlice x s h j rows v.1 t = true := by
      intro t ht
      have hfilter : t ∈ selected.filter (fun u => u.val < k) :=
        htakeSubset (List.mem_toFinset.mpr ht)
      have htSet : t ∈ GeneratedForwardPrefixTests.eligiblePrefixSet
          x s h j rows v.1 k := by
        apply (GeneratedForwardPrefixTests.mem_eligiblePrefixSet_iff
          x s h j rows v.1 k t).mpr
        have htSelected : t ∈ selected := (Finset.mem_filter.mp hfilter).1
        have htlt : t.val < k := (Finset.mem_filter.mp hfilter).2
        exact ⟨htSelected, htlt⟩
      have htController : t ∈
          BootstrapAllCandidateController.eligiblePrefix phys rows j.val v.1 k := by
        rw [← hprefix k]
        exact htSet
      have hbit := hpass.2 t htController
      exact (hforward t).symm.trans hbit
    have hfirst : q_dec p ≤ times.length ∧
        ∀ t ∈ times.take (q_dec p),
          GeneratedForwardPrefixTests.candidateForwardSlice x s h j rows v.1 t = true :=
      ⟨hquota, hbits⟩
    exact (GeneratedForwardPrefixTests.falseCandidatePasses_iff_first_quota
      x s h j rows J v).mpr hfirst

/-- The actual virtual false-forward event is equivalent to some false
candidate passing the accepted controller at a calendar prefix. -/
theorem existsFalseForwardPrefixPass_iff_existsControllerCalendarPass
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p)) :
    GeneratedForwardPrefixTests.existsFalseForwardPrefixPass x s h j rows J ↔
      ∃ v : Fin (M p), v ≠ J ∧ ∃ k, k ≤ p.T ∧
        BootstrapAllCandidateController.passesPrefix
          (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val v k := by
  constructor
  · rintro ⟨v, hv⟩
    rcases (falseCandidatePasses_iff_existsControllerCalendarPass
      x s h j rows J v).mp hv with ⟨k, hk, hp⟩
    exact ⟨v.1, v.property, k, hk, hp⟩
  · rintro ⟨v, hv, k, hk, hp⟩
    exact ⟨⟨v, hv⟩,
      (falseCandidatePasses_iff_existsControllerCalendarPass
        x s h j rows J ⟨v, hv⟩).mpr ⟨k, hk, hp⟩⟩

/-- The complement of the generated virtual failure event produces the
all-candidate controller's clean-prefix condition through the entire block. -/
theorem cleanPrefix_of_no_virtual_failure
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p))
    (hno : ¬ GeneratedForwardPrefixTests.existsFalseForwardPrefixPass
      x s h j rows J) :
    BootstrapAllCandidateController.cleanPrefix
      (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J p.T := by
  intro n hn v hv hpass
  apply hno
  refine
    (existsFalseForwardPrefixPass_iff_existsControllerCalendarPass
      x s h j rows J).mpr ?_
  exact ⟨v, hv, n, hn, hpass⟩

/-- A false row stored as the all-candidate pending declaration on the same
generated block forces the existing virtual false-forward event. -/
theorem falsePending_implies_virtualFailure
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p)) (hrow : x.row = rows J)
    (v : Fin (M p)) (hv : v ≠ J)
    (hpending :
      (BootstrapAllCandidateController.run
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val p.T).pending =
          some v) :
    GeneratedForwardPrefixTests.existsFalseForwardPrefixPass x s h j rows J := by
  by_contra hno
  have hclean := cleanPrefix_of_no_virtual_failure x s h j rows J hno
  have hphysrow :
      (GeneratedForwardPrefixTests.actualPhysicalBlock x s h).row = rows J :=
    (GeneratedForwardPrefixTests.actualPhysicalBlock_row x s h).trans hrow
  have hselected := BootstrapAllCandidateController.pending_only_selected_on_cleanPrefix
    (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J v hphysrow
    p.T p.T le_rfl le_rfl hclean hpending
  exact hv hselected

/-- On the generated block, the complement of the virtual event implies
selected-candidate count, dead-bit, and pending agreement at every calendar
prefix. The clean-prefix condition is produced internally from that
complement. -/
theorem controller_run_agrees_of_no_virtual_failure
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p)) (hrow : x.row = rows J)
    (hno : ¬ GeneratedForwardPrefixTests.existsFalseForwardPrefixPass
      x s h j rows J)
    (k : ℕ) (hk : k ≤ p.T) :
    (BootstrapAllCandidateController.run
      (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val k).count J =
        (BootstrapTruePrefixController.run
          (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) j.val k).count ∧
      (BootstrapAllCandidateController.run
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val k).dead J =
          (BootstrapTruePrefixController.run
            (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) j.val k).dead ∧
      (BootstrapAllCandidateController.run
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val k).pending =
          if (BootstrapTruePrefixController.run
              (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) j.val k).pending = true
            then some J else none := by
  have hclean := cleanPrefix_of_no_virtual_failure x s h j rows J hno
  have hphysrow :
      (GeneratedForwardPrefixTests.actualPhysicalBlock x s h).row = rows J :=
    (GeneratedForwardPrefixTests.actualPhysicalBlock_row x s h).trans hrow
  exact BootstrapAllCandidateController.run_eq_true_on_cleanPrefix
    (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J hphysrow
    p.T k le_rfl hk hclean

/-- Under the same complement event, every selected save bit agrees with the
accepted true-prefix controller's save bit. -/
theorem candidateSavedAt_eq_true_savedAt_of_no_virtual_failure
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p)) (hrow : x.row = rows J)
    (hno : ¬ GeneratedForwardPrefixTests.existsFalseForwardPrefixPass
      x s h j rows J) (t : Fin p.T) :
    BootstrapAllCandidateController.candidateSavedAt
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J t =
      BootstrapTruePrefixController.savedAt
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) j.val t := by
  have hclean := cleanPrefix_of_no_virtual_failure x s h j rows J hno
  have hphysrow :
      (GeneratedForwardPrefixTests.actualPhysicalBlock x s h).row = rows J :=
    (GeneratedForwardPrefixTests.actualPhysicalBlock_row x s h).trans hrow
  exact BootstrapAllCandidateController.candidateSavedAt_eq_true_savedAt
    (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J hphysrow
    p.T le_rfl hclean t (by omega)

/-- The selected all-candidate boundary declaration agrees with the generated
true-prefix controller's declaration on this actual physical block. -/
theorem candidateBoundaryDeclaration_eq_true_of_no_virtual_failure
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p)) (hrow : x.row = rows J)
    (hno : ¬ GeneratedForwardPrefixTests.existsFalseForwardPrefixPass
      x s h j rows J) :
    (BootstrapAllCandidateController.candidateObservationTrace
      (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J).savedDeclaration s =
      (BootstrapTruePrefixController.observationTrace
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) j.val false).savedDeclaration s := by
  have hclean := cleanPrefix_of_no_virtual_failure x s h j rows J hno
  have hphysrow :
      (GeneratedForwardPrefixTests.actualPhysicalBlock x s h).row = rows J :=
    (GeneratedForwardPrefixTests.actualPhysicalBlock_row x s h).trans hrow
  exact BootstrapAllCandidateController.candidate_boundaryDeclaration_eq_true
    (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J hphysrow hclean

/-- A selected declaration on the clean generated block is the declaration
used by the actual reference boundary update. The dependent block index is
transported by the existing `actualBlockIndex` equality. -/
theorem selectedDeclaration_activates_actualReferenceBoundary
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p)) (hrow : x.row = rows J)
    (hno : ¬ GeneratedForwardPrefixTests.existsFalseForwardPrefixPass
      x s h j rows J)
    (hsaved :
      BootstrapBlockConstruction.ExplicitTrace.savedDeclaration
        (BootstrapAllCandidateController.candidateObservationTrace
          (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J) s = true) :
    (ReferenceInitializationRun.run x (s.val + 1)).activation j.val.val =
      some (ReferenceInitializationRun.boundaryActivation
        (GeneratedForwardPrefixTests.actualBoundary x s)) := by
  let b := GeneratedForwardPrefixTests.actualBoundary x s
  let hr := GeneratedForwardPrefixTests.actualBlockRemaining x s h
  let phys := GeneratedForwardPrefixTests.actualPhysicalBlock x s h
  let referencePhys := ReferenceInitializationRun.physical x b hr
  let index := GeneratedForwardPrefixTests.actualBlockIndex x s h
  let i := followerOfBlockCast index referencePhys j.val
  have hdeclaration := candidateBoundaryDeclaration_eq_true_of_no_virtual_failure
    x s h j rows J hrow hno
  have htrueSaved :
      BootstrapBlockConstruction.ExplicitTrace.savedDeclaration
        (BootstrapTruePrefixController.observationTrace phys j.val false) s = true := by
    rw [← hdeclaration]
    exact hsaved
  have htruePending :
      (BootstrapTruePrefixController.run phys j.val p.T).pending = true :=
    (BootstrapTruePrefixController.savedDeclaration_iff_pendingAtEnd phys j.val).mp
      htrueSaved
  have hrunCandidate :
      BootstrapTruePrefixController.run phys j.val p.T =
        ReferenceInitializationRun.candidate x b hr i := by
    change BootstrapTruePrefixController.run (index ▸ referencePhys) j.val p.T =
      BootstrapTruePrefixController.run referencePhys i p.T
    exact truePrefixRun_eq_of_blockCast index referencePhys j.val
  have hcandidatePending :
      (ReferenceInitializationRun.candidate x b hr i).pending = true := by
    rw [← hrunCandidate]
    exact htruePending
  have hfinishActivation := ReferenceInitializationRun.saved_activation
    x b hr i hcandidatePending
  have hsuccessor :
      ReferenceInitializationRun.run x (s.val + 1) =
        ReferenceInitializationRun.finishBlock x b hr := by
    rw [ReferenceInitializationRun.run_succ]
    change ReferenceInitializationRun.advance x b =
      ReferenceInitializationRun.finishBlock x b hr
    exact ReferenceInitializationRun.advance_of_no_crossing x b h.1 hr
  rw [hsuccessor]
  simpa [b, i, followerOfBlockCast] using hfinishActivation

/-- Candidate analysis preserves the generated physical stay gain at the
whole-block boundary, including slots after the declaration save. -/
theorem generatedCandidate_gain_eq_physicalStayGain
    (x : ReferenceInitializationRun.Input p) (s : Fin (n_boot p))
    (h : GeneratedForwardPrefixTests.processesBlock x s)
    (j : GeneratedForwardPrefixTests.ActiveIncomingFollower x s h)
    (rows : CompleteRows p) (J : Fin (M p)) :
    BootstrapBlockConstruction.effectiveCalendarBlockGain
        (BootstrapAllCandidateController.candidateObservationTrace
          (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J) s =
      BootstrapPhysicalBlock.physicalStayGain
        (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) j.val := by
  exact BootstrapAllCandidateController.candidateObservationTrace_gain_eq_physicalStayGain
    (GeneratedForwardPrefixTests.actualPhysicalBlock x s h) rows j.val J

