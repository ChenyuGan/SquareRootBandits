/-!
# Analysis filtration and conditional expectation for the generated run

The analysis filtration uses the actual complete-row/private product
coordinates. At a cutoff below the horizon it is generated by the existing
literal past projection: all base private coordinates and coordinator targets,
plus exactly the public calendar entries and player-round scalars with labels
strictly before the cutoff. At and after the horizon it is the full coordinate
sigma algebra. This is an enlarged analysis view; it is not player knowledge
or a claim about freshness of block-start draws.

Sources: `sources/zip4/manuscript/07_public_setup.tex:55-113`,
`sources/zip4/manuscript/appendix_b_communication.tex:247-292,403-450`.
-/

@[expose] public section

noncomputable section

namespace Bandits.Support.GeneratedBootstrapFiltration

open MeasureTheory
open Filter
open ConstructorDimensions BootstrapDimensions CompletePublicTable
open BootstrapPrivateRoundStreams PrivateRoundFreshness
open GeneratedBootstrapRoundLaw
open ReferenceInitializationRun
open scoped Classical

variable (p : Parameters)

private theorem pastCalendarEntry (t : Fin p.T) (r : CompleteRowStoppingLaw.CalendarArray p)
    (q : CompleteRowStoppingLaw.PastIndex p (GeneratedBootstrapRoundLaw.cutoff p t)) :
    (CompleteRowStoppingLaw.calendarSplitEquiv p
      (GeneratedBootstrapRoundLaw.cutoff p t) r).1 q = r q.1 := rfl

private theorem pastPrivateRoundScalar (t : Fin p.T)
    (x : ExtendedPrivateCoordinates p) (q : PastRoundLabel p t) :
    (extendedPrivateRoundSplitEquiv p t x).1.2.1 q =
      x.2.1 (pastRoundLabelUnderlying p t q) := rfl

/-- Restrict an actual later past to an earlier literal cutoff. The public
calendar and player-round scalar coordinates are restricted by subtype labels;
the base private coordinates and all coordinator targets are retained. -/
def pastRestrict (t u : Fin p.T) (htu : t.val ≤ u.val) :
    Past p u → Past p t := fun w =>
  (fun q => w.1 ⟨q.1, by
      have hq : q.1.val < t.val := q.2
      exact lt_of_lt_of_le hq htu⟩,
    (w.2.1,
      ((fun q => w.2.2.1
        ⟨⟨q.1.1, le_trans q.1.2 (Fin.le_iff_val_le_val.mpr htu)⟩,
          lt_of_lt_of_le q.2 (Fin.le_iff_val_le_val.mpr htu)⟩), w.2.2.2)))

/-- Literal label for the round `t` in the next strict public prefix. -/
def successorPastCalendarIndex (t : Fin p.T) (ht : t.val + 1 < p.T) :
    CompleteRowStoppingLaw.PastIndex p
      (GeneratedBootstrapRoundLaw.cutoff p ⟨t.val + 1, ht⟩) :=
  ⟨t, by
    change t.val < t.val + 1
    omega⟩

/-- Literal player-round label for the round `t` in the next strict private
prefix. -/
def successorPastScalarIndex (t : Fin p.T) (ht : t.val + 1 < p.T)
    (i : Fin p.m) : PastRoundLabel p ⟨t.val + 1, ht⟩ :=
  ⟨⟨(i, t), Fin.le_iff_val_le_val.mpr (by simp)⟩,
    Fin.lt_iff_val_lt_val.mpr (by simp)⟩

/-- Restriction of a later past agrees pointwise with the original projection
of that same source input. -/
theorem pastRestrict_past (t u : Fin p.T) (htu : t.val ≤ u.val)
    (e : Coordinates p) :
    pastRestrict p t u htu (GeneratedBootstrapRoundLaw.past p u e) =
      GeneratedBootstrapRoundLaw.past p t e := by
  apply Prod.ext
  · funext q
    simp only [pastRestrict, GeneratedBootstrapRoundLaw.past]
    rw [pastCalendarEntry, pastCalendarEntry]
  · apply Prod.ext
    · rfl
    · apply Prod.ext
      · funext q
        simp only [pastRestrict, GeneratedBootstrapRoundLaw.past]
        rw [pastPrivateRoundScalar, pastPrivateRoundScalar]
        simp [pastRoundLabelUnderlying]
      · rfl

private theorem pastRestrict_measurable (t u : Fin p.T) (htu : t.val ≤ u.val) :
    Measurable (pastRestrict p t u htu) := by
  unfold pastRestrict
  have hPublic : Measurable (fun w : Past p u =>
      fun q : CompleteRowStoppingLaw.PastIndex p (cutoff p t) =>
        w.1 ⟨q.1, by
          have hq : q.1.val < t.val := q.2
          exact lt_of_lt_of_le hq htu⟩) := by
    apply measurable_pi_iff.mpr
    intro q
    exact (measurable_pi_apply
      (⟨q.1, by
        have hq : q.1.val < t.val := q.2
        exact lt_of_lt_of_le hq htu⟩ :
        CompleteRowStoppingLaw.PastIndex p (cutoff p u))).comp measurable_fst
  have hPastScalars : Measurable (fun w : Past p u =>
      fun q : PastRoundLabel p t => w.2.2.1
        ⟨⟨q.1.1, le_trans q.1.2 (Fin.le_iff_val_le_val.mpr htu)⟩,
          lt_of_lt_of_le q.2 (Fin.le_iff_val_le_val.mpr htu)⟩) := by
    apply measurable_pi_iff.mpr
    intro q
    exact (measurable_pi_apply
      (⟨⟨q.1.1, le_trans q.1.2 (Fin.le_iff_val_le_val.mpr htu)⟩,
        lt_of_lt_of_le q.2 (Fin.le_iff_val_le_val.mpr htu)⟩ : PastRoundLabel p u)).comp
      (measurable_fst.comp (measurable_snd.comp measurable_snd))
  have hBase : Measurable (fun w : Past p u => w.2.1) :=
    measurable_fst.comp measurable_snd
  have hTargets : Measurable (fun w : Past p u => w.2.2.2) :=
    measurable_snd.comp (measurable_snd.comp measurable_snd)
  exact hPublic.prodMk (hBase.prodMk (hPastScalars.prodMk hTargets))

/-- The analysis sigma algebra at a strict prefix is the pullback of the
existing `Past` coordinate. Once all calendar labels have appeared, it freezes
at the ambient sigma algebra. -/
@[instance_reducible] def analysisSigma (n : ℕ) : MeasurableSpace (Coordinates p) :=
  if hn : n < p.T then
    MeasurableSpace.comap
      (GeneratedBootstrapRoundLaw.past p ⟨n, hn⟩) inferInstance
  else inferInstance

private theorem measurable_past (t : Fin p.T) :
    Measurable (GeneratedBootstrapRoundLaw.past p t) := by
  unfold GeneratedBootstrapRoundLaw.past
  change Measurable (fun e : Coordinates p =>
    ((CompleteRowStoppingLaw.calendarSplitEquiv p
      (GeneratedBootstrapRoundLaw.cutoff p t)
      ((CompleteRowStoppingLaw.calendarizeRowEquiv p) e.1)).1,
     ((PrivateRoundFreshness.extendedPrivateRoundSplitEquiv p t) e.2).1))
  exact (measurable_fst.comp
      ((CompleteRowStoppingLaw.calendarSplitEquiv p
        (GeneratedBootstrapRoundLaw.cutoff p t)).measurable.comp
          ((CompleteRowStoppingLaw.calendarizeRowEquiv p).measurable.comp measurable_fst))).prodMk
    (measurable_fst.comp
      ((PrivateRoundFreshness.extendedPrivateRoundSplitEquiv p t).measurable.comp measurable_snd))

/-- The explicit Nat-indexed filtration of enlarged analysis data. -/
def analysisFiltration :
    Filtration ℕ (inferInstance : MeasurableSpace (Coordinates p)) where
  seq := analysisSigma p
  mono' := by
    intro n m hnm
    by_cases hm : m < p.T
    · by_cases hn : n < p.T
      · let t : Fin p.T := ⟨n, hn⟩
        let u : Fin p.T := ⟨m, hm⟩
        have htu : t.val ≤ u.val := hnm
        have hfactor :
            GeneratedBootstrapRoundLaw.past p t =
              pastRestrict p t u htu ∘ GeneratedBootstrapRoundLaw.past p u := by
          funext e
          exact (pastRestrict_past p t u htu e).symm
        simp only [analysisSigma, dif_pos hn, dif_pos hm]
        exact MeasurableSpace.comap_le_comap_of_eq_comp
          (pastRestrict p t u htu) (pastRestrict_measurable p t u htu) hfactor
      · omega
    · by_cases hn : n < p.T
      · simp only [analysisSigma, dif_pos hn, dif_neg hm]
        change MeasurableSpace.comap (GeneratedBootstrapRoundLaw.past p
          ⟨n, hn⟩) inferInstance ≤
            (inferInstance : MeasurableSpace (Coordinates p))
        exact (measurable_past p ⟨n, hn⟩).comap_le
      · simp only [analysisSigma, dif_neg hn, dif_neg hm]
        exact le_rfl
  le' := by
    intro n
    by_cases hn : n < p.T
    · simp only [analysisSigma, dif_pos hn]
      exact (measurable_past p ⟨n, hn⟩).comap_le
    · simp only [analysisSigma, dif_neg hn]
      exact le_rfl

/-- At an actual round's zero-based cutoff, the filtration is exactly the
comap of the already accepted strict past. -/
theorem analysisFiltration_at (t : Fin p.T) :
    analysisFiltration p t.val =
      MeasurableSpace.comap (GeneratedBootstrapRoundLaw.past p t) inferInstance := by
  change analysisSigma p t.val = _
  simp [analysisSigma, t.isLt]

/-- The filtration is contained in the original complete-row/private
measurable space at every time. -/
theorem analysisFiltration_le (n : ℕ) :
    analysisFiltration p n ≤ (inferInstance : MeasurableSpace (Coordinates p)) :=
  (analysisFiltration p).le n

/-- The analysis filtration freezes at the actual full coordinate space at
and after the finite calendar horizon. -/
theorem analysisFiltration_eq_top_of_horizon (n : ℕ) (hn : p.T ≤ n) :
    analysisFiltration p n = (inferInstance : MeasurableSpace (Coordinates p)) := by
  unfold analysisFiltration
  simp [analysisSigma, Nat.not_lt_of_ge hn]

/-- The current analysis data can be read from the next strict past: the
calendar entry and original player scalar labels at time `t` have then entered
their literal prefix subtypes. -/
def currentFromSuccessorPast (t : Fin p.T) :
    ∀ (ht : t.val + 1 < p.T), Past p ⟨t.val + 1, ht⟩ → Current p := fun ht w =>
  (((fun i => (w.1 (successorPastCalendarIndex p t ht)).1 i),
      (w.1 (successorPastCalendarIndex p t ht)).2),
    fun i => w.2.2.1 (successorPastScalarIndex p t ht i))

theorem currentFromSuccessorPast_past (t : Fin p.T) (ht : t.val + 1 < p.T)
    (e : Coordinates p) :
    currentFromSuccessorPast p t ht
      (GeneratedBootstrapRoundLaw.past p ⟨t.val + 1, ht⟩ e) =
        current p t e := by
  apply Prod.ext
  · apply Prod.ext
    · funext i
      simp only [currentFromSuccessorPast, GeneratedBootstrapRoundLaw.past,
        GeneratedBootstrapRoundLaw.current, successorPastCalendarIndex]
      rw [pastCalendarEntry]
      simp [CompleteRowStoppingLaw.calendarizeRowEquiv,
        CompleteRowStoppingLaw.calendarizeRow, BootstrapModeService.roundCoordinates]
    · simp only [currentFromSuccessorPast, GeneratedBootstrapRoundLaw.past,
        GeneratedBootstrapRoundLaw.current, successorPastCalendarIndex]
      rw [pastCalendarEntry]
      simp [CompleteRowStoppingLaw.calendarizeRowEquiv,
        CompleteRowStoppingLaw.calendarizeRow, BootstrapModeService.roundCoordinates]
  · funext i
    simp only [currentFromSuccessorPast, GeneratedBootstrapRoundLaw.past,
      GeneratedBootstrapRoundLaw.current, successorPastScalarIndex]
    rw [pastPrivateRoundScalar]
    simp [pastRoundLabelUnderlying, BootstrapPhysicalInput.playerRoundScalarAt]

/-- Measurability of the actual current vector with respect to the next
analysis sigma algebra, including the last round where the filtration has
already frozen at the full coordinate sigma algebra. -/
theorem measurable_current_succ (t : Fin p.T) :
    Measurable[analysisFiltration p (t.val + 1)] (current p t) := by
  by_cases ht : t.val + 1 < p.T
  · let u : Fin p.T := ⟨t.val + 1, ht⟩
    rw [analysisFiltration_at p u]
    have hfactor : current p t = currentFromSuccessorPast p t ht ∘
        GeneratedBootstrapRoundLaw.past p u := by
      funext e
      exact (currentFromSuccessorPast_past p t ht e).symm
    rw [hfactor]
    have hcurFactor : Measurable (currentFromSuccessorPast p t ht) := by
      let q : CompleteRowStoppingLaw.PastIndex p
          (GeneratedBootstrapRoundLaw.cutoff p u) :=
        successorPastCalendarIndex p t ht
      have hentry : Measurable (fun w : Past p u => w.1 q) :=
        (measurable_pi_apply q).comp measurable_fst
      have hforward : Measurable (fun w : Past p u =>
          fun i => (w.1 q).1 i) := by
        apply measurable_pi_iff.mpr
        intro i
        exact (measurable_pi_apply i).comp (measurable_fst.comp hentry)
      have hcontrol : Measurable (fun w : Past p u => (w.1 q).2) :=
        measurable_snd.comp hentry
      have hpastScalars : Measurable (fun w : Past p u => w.2.2.1) :=
        measurable_fst.comp (measurable_snd.comp measurable_snd)
      have hscalars : Measurable (fun w : Past p u =>
          fun i : Fin p.m => w.2.2.1 (successorPastScalarIndex p t ht i)) := by
        apply measurable_pi_iff.mpr
        intro i
        exact (measurable_pi_apply (successorPastScalarIndex p t ht i)).comp hpastScalars
      unfold currentFromSuccessorPast
      change Measurable (fun w : Past p u =>
        (((fun i => (w.1 q).1 i), (w.1 q).2),
          fun i => w.2.2.1 (successorPastScalarIndex p t ht i)))
      exact (hforward.prodMk hcontrol).prodMk hscalars
    have hpastMeas : Measurable[MeasurableSpace.comap
        (GeneratedBootstrapRoundLaw.past p u) inferInstance]
        (GeneratedBootstrapRoundLaw.past p u) := by
      intro A hA
      exact ⟨A, hA, rfl⟩
    exact hcurFactor.comp hpastMeas
  · rw [analysisFiltration_eq_top_of_horizon p (t.val + 1) (by omega)]
    have hr : Measurable (fun e : Coordinates p =>
        BootstrapModeService.roundCoordinates p t e.1) := by
      change Measurable (fun e : Coordinates p =>
        CompleteRowStoppingLaw.calendarizeRowEquiv p e.1 t)
      exact (measurable_pi_apply t).comp
        ((CompleteRowStoppingLaw.calendarizeRowEquiv p).measurable.comp measurable_fst)
    have hs : Measurable (fun e : Coordinates p =>
        fun i : Fin p.m => BootstrapPhysicalInput.playerRoundScalarAt p e.2 i t) := by
      apply measurable_pi_iff.mpr
      intro i
      exact (BootstrapPhysicalInput.measurable_playerRoundScalarAt p i t).comp measurable_snd
    exact hr.prodMk hs

/-- The actual generated descriptor factors through the exact existing past
on every member of its real bootstrap calendar block. -/
theorem measurable_descriptor (ids : IDArray p)
    (rewards : Fin p.T → Fin p.K → Fin (D p + 1)) (C_star C_h : ℝ)
    (eta : ReferencePrelaunchFollower.LearningRate) (s : Fin (n_boot p))
    (t : Fin p.T) (ht : t ∈ calendarBlock p s) :
    Measurable[analysisFiltration p t.val]
      (descriptor p ids rewards C_star C_h eta s t) := by
  rw [analysisFiltration_at p t]
  obtain ⟨e₀⟩ := nonempty_of_isProbabilityMeasure (originalLaw p)
  let dPast := descriptorFromPast ids rewards C_star C_h eta s t e₀
  have hdPast : Measurable dPast :=
    measurable_descriptorFromPast ids rewards C_star C_h eta s t e₀
  have hrec : ∀ e, dPast (GeneratedBootstrapRoundLaw.past p t e) =
      descriptor p ids rewards C_star C_h eta s t e :=
    descriptorFromPast_reconstruct ids rewards C_star C_h eta s t ht e₀
  have heq : descriptor p ids rewards C_star C_h eta s t =
      dPast ∘ GeneratedBootstrapRoundLaw.past p t := by
    funext e
    exact (hrec e).symm
  rw [heq]
  have hpast : Measurable[MeasurableSpace.comap
      (GeneratedBootstrapRoundLaw.past p t) inferInstance]
      (GeneratedBootstrapRoundLaw.past p t) := by
    intro A hA
    exact ⟨A, hA, rfl⟩
  exact hdPast.comp hpast

private theorem integrable_of_abs_le_const {α : Type*} [MeasurableSpace α]
    {μ : Measure α} [IsProbabilityMeasure μ] {f : α → ℝ}
    (hf : Measurable f) (B : ℝ) (hB : 0 ≤ B)
    (hbound : ∀ x, |f x| ≤ B) : Integrable f μ := by
  refine (integrable_const B).mono' hf.stronglyMeasurable.aestronglyMeasurable ?_
  filter_upwards with x
  simpa only [Real.norm_eq_abs, abs_of_nonneg hB] using hbound x

/-- The bounded Borel test on the actual generated descriptor and entire
original current public/private vector. -/
def testValue (ids : IDArray p)
    (rewards : Fin p.T → Fin p.K → Fin (D p + 1)) (C_star C_h : ℝ)
    (eta : ReferencePrelaunchFollower.LearningRate) (s : Fin (n_boot p))
    (t : Fin p.T) (H : Option (Descriptor p) × Current p → ℝ)
    (e : Coordinates p) : ℝ :=
  H (descriptor p ids rewards C_star C_h eta s t e, current p t e)

/-- The conditional kernel obtained by integrating the test over the accepted
entire current-vector law. -/
def conditionalKernel (H : Option (Descriptor p) × Current p → ℝ)
    (d : Option (Descriptor p)) : ℝ :=
  ∫ c, H (d, c) ∂currentLaw p

/-- The current-vector integral evaluated at the actual generated descriptor. -/
def conditionalKernelValue (ids : IDArray p)
    (rewards : Fin p.T → Fin p.K → Fin (D p + 1)) (C_star C_h : ℝ)
    (eta : ReferencePrelaunchFollower.LearningRate) (s : Fin (n_boot p))
    (t : Fin p.T) (H : Option (Descriptor p) × Current p → ℝ)
    (e : Coordinates p) : ℝ :=
  conditionalKernel p H (descriptor p ids rewards C_star C_h eta s t e)

theorem measurable_conditionalKernel (H : Option (Descriptor p) × Current p → ℝ) :
    Measurable (conditionalKernel p H) := by
  exact measurable_of_countable _

theorem integrable_conditionalKernelSection
    (H : Option (Descriptor p) × Current p → ℝ) (hH : Measurable H)
    (B : ℝ) (hB : 0 ≤ B)
    (hbound : ∀ z, |H z| ≤ B) (d : Option (Descriptor p)) :
    Integrable (fun c : Current p => H (d, c)) (currentLaw p) := by
  apply integrable_of_abs_le_const
    ((hH.comp (measurable_const.prodMk measurable_id))) B hB
  intro c
  exact hbound (d, c)

theorem abs_conditionalKernel_le (H : Option (Descriptor p) × Current p → ℝ)
    (hH : Measurable H) (B : ℝ) (hB : 0 ≤ B)
    (hbound : ∀ z, |H z| ≤ B) (d : Option (Descriptor p)) :
    |conditionalKernel p H d| ≤ B := by
  have hsection := integrable_conditionalKernelSection p H hH B hB hbound d
  have habs : Integrable (fun c : Current p => |H (d, c)|) (currentLaw p) :=
    hsection.abs
  have hupper : (∫ c, |H (d, c)| ∂currentLaw p) ≤ B := by
    calc
      _ ≤ ∫ _c : Current p, B ∂currentLaw p :=
        integral_mono habs (integrable_const B) (fun c => hbound (d, c))
      _ = B := by rw [integral_const, probReal_univ, one_smul]
  calc
    _ ≤ ∫ c, |H (d, c)| ∂currentLaw p := abs_integral_le_integral_abs
    _ ≤ B := hupper

theorem integrable_testValue (ids : IDArray p)
    (rewards : Fin p.T → Fin p.K → Fin (D p + 1)) (C_star C_h : ℝ)
    (eta : ReferencePrelaunchFollower.LearningRate) (s : Fin (n_boot p))
    (t : Fin p.T) (ht : t ∈ calendarBlock p s)
    (H : Option (Descriptor p) × Current p → ℝ) (hH : Measurable H)
    (B : ℝ) (hB : 0 ≤ B) (hbound : ∀ z, |H z| ≤ B) :
    Integrable (testValue p ids rewards C_star C_h eta s t H) (originalLaw p) := by
  have hd := measurable_descriptor p ids rewards C_star C_h eta s t ht
  have hdAmbient := hd.mono (analysisFiltration_le p t.val) le_rfl
  have hc := (measurable_current_succ p t).mono
    (analysisFiltration_le p (t.val + 1)) le_rfl
  exact integrable_of_abs_le_const (hH.comp (hdAmbient.prodMk hc)) B hB
    (fun e => hbound (descriptor p ids rewards C_star C_h eta s t e, current p t e))

theorem integrable_conditionalKernelValue (ids : IDArray p)
    (rewards : Fin p.T → Fin p.K → Fin (D p + 1)) (C_star C_h : ℝ)
    (eta : ReferencePrelaunchFollower.LearningRate) (s : Fin (n_boot p))
    (t : Fin p.T) (ht : t ∈ calendarBlock p s)
    (H : Option (Descriptor p) × Current p → ℝ) (hH : Measurable H)
    (B : ℝ) (hB : 0 ≤ B) (hbound : ∀ z, |H z| ≤ B) :
    Integrable (conditionalKernelValue p ids rewards C_star C_h eta s t H)
      (originalLaw p) := by
  have hd := measurable_descriptor p ids rewards C_star C_h eta s t ht
  have hdAmbient := hd.mono (analysisFiltration_le p t.val) le_rfl
  exact integrable_of_abs_le_const
    ((measurable_conditionalKernel p H).comp hdAmbient) B hB
    (fun e => abs_conditionalKernel_le p H hH B hB hbound
      (descriptor p ids rewards C_star C_h eta s t e))

/-- Set-integral identity derived from the exact original joint product law.
The only event information is the actual past projection, and the test sees
the full current vector with law `currentLaw`. -/
theorem testValue_setIntegral_eq_kernel (ids : IDArray p)
    (rewards : Fin p.T → Fin p.K → Fin (D p + 1)) (C_star C_h : ℝ)
    (eta : ReferencePrelaunchFollower.LearningRate) (s : Fin (n_boot p))
    (t : Fin p.T) (ht : t ∈ calendarBlock p s)
    (H : Option (Descriptor p) × Current p → ℝ) (hH : Measurable H)
    (B : ℝ) (hB : 0 ≤ B) (hbound : ∀ z, |H z| ≤ B)
    (A : Set (Coordinates p))
    (hA : MeasurableSet[analysisFiltration p t.val] A) :
    ∫ e in A, testValue p ids rewards C_star C_h eta s t H e ∂originalLaw p =
      ∫ e in A, conditionalKernelValue p ids rewards C_star C_h eta s t H e
        ∂originalLaw p := by
  rw [analysisFiltration_at p t] at hA
  obtain ⟨C, hC, hpre⟩ := (MeasurableSpace.measurableSet_comap).mp hA
  obtain ⟨e₀⟩ := nonempty_of_isProbabilityMeasure (originalLaw p)
  let dPast : Past p t → Option (Descriptor p) :=
    descriptorFromPast ids rewards C_star C_h eta s t e₀
  have hdPast : Measurable dPast :=
    measurable_descriptorFromPast ids rewards C_star C_h eta s t e₀
  have hrec : ∀ e, dPast (GeneratedBootstrapRoundLaw.past p t e) =
      descriptor p ids rewards C_star C_h eta s t e :=
    descriptorFromPast_reconstruct ids rewards C_star C_h eta s t ht e₀
  let joint : Coordinates p → Past p t × Current p := fun e =>
    (GeneratedBootstrapRoundLaw.past p t e, current p t e)
  let S : Set (Past p t × Current p) := C ×ˢ Set.univ
  have hS : MeasurableSet S := hC.prod MeasurableSet.univ
  let f : Past p t × Current p → ℝ := fun z => H (dPast z.1, z.2)
  let g : Past p t × Current p → ℝ := fun z => conditionalKernel p H (dPast z.1)
  have hf : Measurable f :=
    hH.comp ((hdPast.comp measurable_fst).prodMk measurable_snd)
  have hg : Measurable g :=
    (measurable_conditionalKernel p H).comp (hdPast.comp measurable_fst)
  have hfInt : Integrable f ((pastLaw p t).prod (currentLaw p)) := by
    exact integrable_of_abs_le_const hf B hB fun z => hbound (dPast z.1, z.2)
  have hgInt : Integrable g ((pastLaw p t).prod (currentLaw p)) := by
    exact integrable_of_abs_le_const hg B hB fun z =>
      abs_conditionalKernel_le p H hH B hB hbound (dPast z.1)
  have hKernelSet :
      ∫ z in S, f z ∂((pastLaw p t).prod (currentLaw p)) =
        ∫ z in S, g z ∂((pastLaw p t).prod (currentLaw p)) := by
    rw [setIntegral_prod f hfInt.integrableOn, setIntegral_prod g hgInt.integrableOn]
    congr 1
    funext w
    simp [f, g, conditionalKernel]
  have hJointMap := (past_current_measurePreserving p t).map_eq
  have hjointMeas : Measurable joint := (past_current_measurePreserving p t).measurable
  have hFInd : AEStronglyMeasurable (S.indicator f)
      ((originalLaw p).map joint) := by
    rw [hJointMap]
    exact (hf.stronglyMeasurable.indicator hS).aestronglyMeasurable
  have hGInd : AEStronglyMeasurable (S.indicator g)
      ((originalLaw p).map joint) := by
    rw [hJointMap]
    exact (hg.stronglyMeasurable.indicator hS).aestronglyMeasurable
  have hXMap :
      ∫ e in joint ⁻¹' S, testValue p ids rewards C_star C_h eta s t H e
        ∂originalLaw p = ∫ z in S, f z ∂((pastLaw p t).prod (currentLaw p)) := by
    calc
      _ = ∫ e, (joint ⁻¹' S).indicator
          (testValue p ids rewards C_star C_h eta s t H) e ∂originalLaw p := by
            rw [integral_indicator (hS.preimage hjointMeas)]
      _ = ∫ e, (S.indicator f) (joint e) ∂originalLaw p := by
            apply integral_congr_ae (Eventually.of_forall fun e => ?_)
            simp [Set.indicator, joint, S, f, testValue, hrec e]
      _ = ∫ z, S.indicator f z ∂(originalLaw p).map joint :=
            (integral_map hjointMeas.aemeasurable hFInd).symm
      _ = ∫ z in S, f z ∂((pastLaw p t).prod (currentLaw p)) := by
            rw [hJointMap, integral_indicator hS]
  have hGMap :
      ∫ e in joint ⁻¹' S, conditionalKernelValue p ids rewards C_star C_h eta s t H e
        ∂originalLaw p = ∫ z in S, g z ∂((pastLaw p t).prod (currentLaw p)) := by
    calc
      _ = ∫ e, (joint ⁻¹' S).indicator
          (conditionalKernelValue p ids rewards C_star C_h eta s t H) e ∂originalLaw p := by
            rw [integral_indicator (hS.preimage hjointMeas)]
      _ = ∫ e, (S.indicator g) (joint e) ∂originalLaw p := by
            apply integral_congr_ae (Eventually.of_forall fun e => ?_)
            simp [Set.indicator, joint, S, g, conditionalKernelValue, hrec e]
      _ = ∫ z, S.indicator g z ∂(originalLaw p).map joint :=
            (integral_map hjointMeas.aemeasurable hGInd).symm
      _ = ∫ z in S, g z ∂((pastLaw p t).prod (currentLaw p)) := by
            rw [hJointMap, integral_indicator hS]
  have hpreJoint : joint ⁻¹' S = A := by
    ext e
    change (past p t e, current p t e) ∈ C ×ˢ Set.univ ↔ e ∈ A
    simp only [Set.mem_prod, Set.mem_univ, and_true]
    change e ∈ (past p t) ⁻¹' C ↔ e ∈ A
    rw [hpre]
  rw [← hpreJoint, hXMap, hGMap, hKernelSet]

/-- The conditional-expectation identity for every bounded jointly measurable
test of the actual generated descriptor and the original current vector. No
history, equal-state, atom-mass, independence, or conditional-mean premise is
used; the joint product law and pointwise past reconstruction supply the
conditional expectation. -/
theorem actual_condExp_identity (ids : IDArray p)
    (rewards : Fin p.T → Fin p.K → Fin (D p + 1)) (C_star C_h : ℝ)
    (eta : ReferencePrelaunchFollower.LearningRate) (s : Fin (n_boot p))
    (t : Fin p.T) (ht : t ∈ calendarBlock p s)
    (H : Option (Descriptor p) × Current p → ℝ) (hH : Measurable H)
    (B : ℝ) (hB : 0 ≤ B) (hbound : ∀ z, |H z| ≤ B) :
    condExp (analysisFiltration p t.val) (originalLaw p)
      (testValue p ids rewards C_star C_h eta s t H) =ᵐ[originalLaw p]
      conditionalKernelValue p ids rewards C_star C_h eta s t H := by
  have hkernel : AEStronglyMeasurable[analysisFiltration p t.val]
      (conditionalKernelValue p ids rewards C_star C_h eta s t H) (originalLaw p) := by
    change AEStronglyMeasurable[analysisFiltration p t.val]
      (conditionalKernel p H ∘ descriptor p ids rewards C_star C_h eta s t)
      (originalLaw p)
    exact StronglyMeasurable.aestronglyMeasurable
      (((measurable_conditionalKernel p H).comp
        (measurable_descriptor p ids rewards C_star C_h eta s t ht)).stronglyMeasurable)
  exact (ae_eq_condExp_of_forall_setIntegral_eq
    (analysisFiltration_le p t.val)
    (integrable_testValue p ids rewards C_star C_h eta s t ht H hH B hB hbound)
    (fun A hA hfinite =>
      (integrable_conditionalKernelValue p ids rewards C_star C_h eta s t ht H hH
        B hB hbound).integrableOn)
    (fun A hA hfinite =>
      (testValue_setIntegral_eq_kernel p ids rewards C_star C_h eta s t ht H hH
        B hB hbound A hA).symm)
    hkernel).symm

theorem conditionalKernel_unit_bounds (H : Option (Descriptor p) × Current p → ℝ)
    (hH : Measurable H) (hunit : ∀ z, 0 ≤ H z ∧ H z ≤ 1)
    (d : Option (Descriptor p)) :
    0 ≤ conditionalKernel p H d ∧ conditionalKernel p H d ≤ 1 := by
  have hI := integrable_conditionalKernelSection p H hH 1 (by norm_num)
    (fun z => abs_le.mpr ⟨by linarith [(hunit z).1], (hunit z).2⟩) d
  constructor
  · have hnonneg := integral_mono (integrable_const (0 : ℝ)) hI
      (fun c => (hunit (d, c)).1)
    simpa [conditionalKernel, integral_const, probReal_univ] using hnonneg
  · have hupper := integral_mono hI (integrable_const (1 : ℝ))
      (fun c => (hunit (d, c)).2)
    simpa [conditionalKernel, integral_const, probReal_univ] using hupper

/-- The source's one-based round label. The zero-based physical coordinate
`t` is consumed at clock index `t.val + 1`. -/
def sourceClockIndex (t : Fin p.T) : ℕ := t.val + 1

/-- The accepted clock API conditions on the filtration immediately before
the source round, which is exactly the analysis prefix at `t.val`. -/
theorem bootstrapConditionalMean_source_shift
    (X : ℕ → Coordinates p → ℝ) (t : Fin p.T) :
    BootstrapIntervalBounds.conditionalMean (originalLaw p)
      (analysisFiltration p) X (sourceClockIndex p t) =
        condExp (analysisFiltration p t.val) (originalLaw p)
          (X (sourceClockIndex p t)) := by
  simp [BootstrapIntervalBounds.conditionalMean, sourceClockIndex]

/-- Unit-range tests give literal conditional means in `[0,1]`. This is the
conditional expectation for the source round `t.val + 1` against `F t.val`. -/
theorem actual_conditionalMean_unit_bounds (ids : IDArray p)
    (rewards : Fin p.T → Fin p.K → Fin (D p + 1)) (C_star C_h : ℝ)
    (eta : ReferencePrelaunchFollower.LearningRate) (s : Fin (n_boot p))
    (t : Fin p.T) (ht : t ∈ calendarBlock p s)
    (H : Option (Descriptor p) × Current p → ℝ) (hH : Measurable H)
    (hunit : ∀ z, 0 ≤ H z ∧ H z ≤ 1) :
    ∀ᵐ e ∂originalLaw p,
      0 ≤ condExp (analysisFiltration p t.val) (originalLaw p)
        (testValue p ids rewards C_star C_h eta s t H) e ∧
      condExp (analysisFiltration p t.val) (originalLaw p)
        (testValue p ids rewards C_star C_h eta s t H) e ≤ 1 := by
  have hbound : ∀ z, |H z| ≤ (1 : ℝ) := fun z =>
    abs_le.mpr ⟨by linarith [(hunit z).1], (hunit z).2⟩
  have hce := actual_condExp_identity p ids rewards C_star C_h eta s t ht H hH
    1 (by norm_num) hbound
  have hk := conditionalKernel_unit_bounds p H hH hunit
  filter_upwards [hce] with e he
  rw [he]
  exact hk (descriptor p ids rewards C_star C_h eta s t e)

end Bandits.Support.GeneratedBootstrapFiltration

