module

public import Bandits.Support.ReferenceFirstLiveCalendarMarkedTransition

import Mathlib.Probability.Kernel.Composition.IntegralCompProd

/-!
# Finite first-LIVE calendar joint law

The calendar law is generated by the accepted one-date transition, in
chronological order, while retaining the original source, all label-zero
coordinates, and the complete past logical-cell list.

Sources: `sources/zip4/manuscript/06_interruptions.tex:381-426`,
`sources/zip4/manuscript/04_slow_fast_learner.tex:142-215,323-366`, and
`sources/zip4/manuscript/08_main_theorem.tex:78-109`.
-/

@[expose] public section

noncomputable section

open MeasureTheory
open ProbabilityTheory
open scoped ProbabilityTheory

namespace Bandits.Support.ReferenceFirstLiveFiniteCalendarJointLaw

open Bandits.Support.ReferenceFirstLiveCalendarMarkedTransition
open Bandits.Support.ReferenceFirstLiveChronologicalPrefixFoundation

variable {p : ConstructorDimensions.Parameters}

abbrev RateInput := ReferenceActivePhysicalStep.RateInput
abbrev RewardTable := ActualInitializationPhysicalStep.GridRewardTable
abbrev TimeControl := ContinuousLearningRows.TimeControl

/-- The probability law at a proof-bounded chronological boundary.  The
successor branch composes the preceding law with exactly that date's accepted
calendar transition kernel. -/
public def finiteCalendarLawAux (rate : RateInput p) (rewards : RewardTable p)
    (C_star C_h : ℝ) (control0 : TimeControl p) :
    (n : ℕ) → n ≤ p.T → Measure (Observation p rate)
  | 0, _ => initialCalendarLaw rate control0
  | n + 1, hn =>
      calendarTransitionKernel rate rewards C_star C_h
        (⟨n, Nat.lt_of_succ_le hn⟩ : Fin p.T) ∘ₘ
          finiteCalendarLawAux rate rewards C_star C_h control0 n
            (Nat.le_of_succ_le hn)

/-- The date-ordered calendar law, indexed by all finite boundaries through
the horizon. -/
public def finiteCalendarLaw (rate : RateInput p) (rewards : RewardTable p)
    (C_star C_h : ℝ) (control0 : TimeControl p)
    (n : Fin (p.T + 1)) : Measure (Observation p rate) :=
  finiteCalendarLawAux rate rewards C_star C_h control0 n.val
    (Nat.le_of_lt_succ n.isLt)

/-- The proof-bounded recursion step, with no law or branch supplied by the
caller. -/
public theorem finiteCalendarLawAux_succ (rate : RateInput p) (rewards : RewardTable p)
    (C_star C_h : ℝ) (control0 : TimeControl p) (n : ℕ) (hn : n + 1 ≤ p.T) :
    finiteCalendarLawAux rate rewards C_star C_h control0 (n + 1) hn =
      calendarTransitionKernel rate rewards C_star C_h
        (⟨n, Nat.lt_of_succ_le hn⟩ : Fin p.T) ∘ₘ
          finiteCalendarLawAux rate rewards C_star C_h control0 n
            (Nat.le_of_succ_le hn) := rfl

/-- The literal product initial law is a probability measure, by the accepted
zero-boundary source pushforward identity. -/
public theorem initialCalendarLaw_probability (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p) :
    IsProbabilityMeasure (initialCalendarLaw rate control0) := by
  rw [← observationAt_zero_map rate rewards C_star C_h control0]
  infer_instance

/-- Every bounded boundary law is a probability measure. -/
public theorem finiteCalendarLawAux_probability (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p) :
    ∀ n (hn : n ≤ p.T),
      IsProbabilityMeasure (finiteCalendarLawAux rate rewards C_star C_h control0 n hn) := by
  intro n
  induction n with
  | zero =>
      intro hn
      exact initialCalendarLaw_probability rate rewards C_star C_h control0
  | succ n ih =>
      intro hn
      dsimp [finiteCalendarLawAux]
      have hprev : IsProbabilityMeasure
          (finiteCalendarLawAux rate rewards C_star C_h control0 n
            (Nat.le_of_succ_le hn)) := ih (Nat.le_of_succ_le hn)
      have hcompProbability (μ : Measure (Observation p rate))
          [hμ : IsProbabilityMeasure μ] :
          IsProbabilityMeasure
            (calendarTransitionKernel rate rewards C_star C_h
              ⟨n, Nat.lt_of_succ_le hn⟩ ∘ₘ μ) := by
        infer_instance
      exact hcompProbability _ (hμ := hprev)

public theorem finiteCalendarLaw_probability (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p)
    (n : Fin (p.T + 1)) : IsProbabilityMeasure (finiteCalendarLaw rate rewards C_star C_h control0 n) :=
  finiteCalendarLawAux_probability rate rewards C_star C_h control0 n.val
    (Nat.le_of_lt_succ n.isLt)

/-- The zero boundary is the literal source-prefix initial law. -/
public theorem finiteCalendarLaw_zero (rate : RateInput p) (rewards : RewardTable p)
    (C_star C_h : ℝ) (control0 : TimeControl p) :
    finiteCalendarLaw rate rewards C_star C_h control0 (0 : Fin (p.T + 1)) =
      initialCalendarLaw rate control0 := rfl

/-- The successor boundary is obtained by integrating the same one-date
kernel against the preceding law. -/
public theorem finiteCalendarLaw_successor (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p)
    (t : Fin p.T) :
    finiteCalendarLaw rate rewards C_star C_h control0 t.succ =
      calendarTransitionKernel rate rewards C_star C_h t ∘ₘ
        finiteCalendarLaw rate rewards C_star C_h control0 t.castSucc := rfl

private theorem measurable_observationAt_zero (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p) :
    Measurable (observationAt rate rewards C_star C_h control0 0) := by
  have hsource : Measurable (fun za : EnlargedSource p =>
      ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 0 za.1) :=
    (ReferenceSourcePrefixHistoryFiltration.measurable_sourcePrefix control0 0).comp
      measurable_fst
  have hlabel : Measurable (fun za : EnlargedSource p => labelZero za.2) :=
    (measurable_labelZero (p := p)).comp measurable_snd
  have hformula : observationAt rate rewards C_star C_h control0 0 =
      fun za =>
        (ReferenceSourcePrefixHistoryFiltration.sourcePrefix control0 0 za.1,
          (labelZero za.2, [])) := by
    funext za
    simp only [observationAt,
      ReferenceFirstLiveCalendarMarkedTransition.calendarPast_zero rate rewards C_star C_h za]
  rw [hformula]
  exact hsource.prodMk (hlabel.prodMk measurable_const)

/-- Measurability at every proof-bounded boundary, including the terminal
boundary. -/
public theorem measurable_observationAt_boundary (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p)
    (n : ℕ) (hn : n ≤ p.T) :
    Measurable (observationAt rate rewards C_star C_h control0 n) := by
  by_cases hlt : n < p.T
  · exact measurable_observationAt rate rewards C_star C_h control0 ⟨n, hlt⟩
  · have heq : n = p.T := Nat.le_antisymm hn (Nat.le_of_not_gt hlt)
    subst n
    exact measurable_observationAt_horizon rate rewards C_star C_h control0

private theorem integrable_bounded_observationAt_boundary (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p)
    (n : ℕ) (hn : n ≤ p.T) (Phi : Observation p rate → ℝ)
    (hPhi : Measurable Phi) (B : ℝ) (hB : ∀ w, ‖Phi w‖ ≤ B) :
    Integrable (fun za => Phi (observationAt rate rewards C_star C_h control0 n za))
      (enlargedSourceLaw p) := by
  exact Integrable.of_bound
    ((hPhi.comp
      (measurable_observationAt_boundary rate rewards C_star C_h control0 n hn)).aestronglyMeasurable)
    B (Filter.Eventually.of_forall fun za => hB
      (observationAt rate rewards C_star C_h control0 n za))

/-- Every bounded Borel joint test has the same integral under the original
source observation and the recursively generated boundary law. -/
public theorem bounded_joint_test_aux (rate : RateInput p) (rewards : RewardTable p)
    (C_star C_h : ℝ) (control0 : TimeControl p) :
    ∀ n (hn : n ≤ p.T) (Phi : Observation p rate → ℝ),
      Measurable Phi → ∀ B : ℝ, (∀ w, ‖Phi w‖ ≤ B) →
        (∫ za, Phi (observationAt rate rewards C_star C_h control0 n za)
            ∂enlargedSourceLaw p) =
          ∫ w, Phi w ∂finiteCalendarLawAux rate rewards C_star C_h control0 n hn := by
  intro n
  induction n with
  | zero =>
      intro hn Phi hPhi B hB
      let theta := observationAt rate rewards C_star C_h control0 0
      have htheta : Measurable theta := measurable_observationAt_zero rate rewards C_star C_h control0
      have hinit : IsProbabilityMeasure (initialCalendarLaw rate control0) := by
        exact initialCalendarLaw_probability rate rewards C_star C_h control0
      have hPhiInit : Integrable Phi (initialCalendarLaw rate control0) :=
        Integrable.of_bound hPhi.aestronglyMeasurable B
          (Filter.Eventually.of_forall hB)
      have hPhiMap : Integrable Phi ((enlargedSourceLaw p).map theta) := by
        rw [observationAt_zero_map rate rewards C_star C_h control0]
        exact hPhiInit
      calc
        (∫ za, Phi (observationAt rate rewards C_star C_h control0 0 za)
            ∂enlargedSourceLaw p) =
            ∫ w, Phi w ∂(enlargedSourceLaw p).map theta := by
              exact (integral_map htheta.aemeasurable hPhiMap.aestronglyMeasurable).symm
        _ = ∫ w, Phi w ∂initialCalendarLaw rate control0 := by
              rw [observationAt_zero_map rate rewards C_star C_h control0]
        _ = ∫ w, Phi w ∂finiteCalendarLawAux rate rewards C_star C_h control0 0 hn := rfl
  | succ n ih =>
      intro hn Phi hPhi B hB
      let t : Fin p.T := ⟨n, Nat.lt_of_succ_le hn⟩
      let K := calendarTransitionKernel rate rewards C_star C_h t
      let betaPrev := finiteCalendarLawAux rate rewards C_star C_h control0 n
        (Nat.le_of_succ_le hn)
      let testK : Observation p rate → ℝ := fun w => ∫ y, Phi y ∂K w
      have htestK : Measurable testK :=
        measurable_calendarTransitionKernel_test rate rewards C_star C_h t Phi hPhi
      have htestK_bound : ∀ w, ‖testK w‖ ≤ B := by
        intro w
        exact norm_calendarTransitionKernel_test_le rate rewards C_star C_h t Phi B hB w
      have hstep := bounded_joint_test_successor rate rewards C_star C_h control0 t
        Phi hPhi B hB
      have hih := ih (Nat.le_of_succ_le hn) testK htestK B htestK_bound
      have hnextProbability : IsProbabilityMeasure
          (finiteCalendarLawAux rate rewards C_star C_h control0 (n + 1) hn) :=
        finiteCalendarLawAux_probability rate rewards C_star C_h control0 (n + 1) hn
      have hboundedIntegrable (μ : Measure (Observation p rate))
          [hμ : IsProbabilityMeasure μ] : Integrable Phi μ :=
        Integrable.of_bound hPhi.aestronglyMeasurable B
          (Filter.Eventually.of_forall hB)
      have hPhiNext : Integrable Phi
          (finiteCalendarLawAux rate rewards C_star C_h control0 (n + 1) hn) :=
        hboundedIntegrable _ (hμ := hnextProbability)
      have hPhiComp : Integrable Phi (K ∘ₘ betaPrev) := by
        rw [← finiteCalendarLawAux_succ rate rewards C_star C_h control0 n hn]
        exact hPhiNext
      have hPhiKernelComp : Integrable Phi ((K ∘ₖ Kernel.const Unit betaPrev) ()) := by
        simpa only [Measure.comp_eq_comp_const_apply] using hPhiComp
      have hkernelIntegral := ProbabilityTheory.Kernel.integral_comp
        (η := K) (κ := Kernel.const Unit betaPrev) (a := ()) hPhiKernelComp
      have hcompIntegral :
          (∫ y, Phi y ∂(K ∘ₘ betaPrev)) = ∫ w, testK w ∂betaPrev := by
        calc
          (∫ y, Phi y ∂(K ∘ₘ betaPrev)) =
              ∫ y, Phi y ∂((K ∘ₖ Kernel.const Unit betaPrev) ()) := by
                rw [Measure.comp_eq_comp_const_apply]
          _ = ∫ w, testK w ∂betaPrev := by
                simpa [testK, Kernel.const_apply] using hkernelIntegral
      calc
        (∫ za, Phi (observationAt rate rewards C_star C_h control0 (n + 1) za)
            ∂enlargedSourceLaw p) =
            ∫ za, testK (observationAt rate rewards C_star C_h control0 n za)
              ∂enlargedSourceLaw p := by
                simpa [testK, t] using hstep
        _ = ∫ w, testK w ∂betaPrev := by
              exact hih
        _ = ∫ y, Phi y ∂(K ∘ₘ betaPrev) := hcompIntegral.symm
        _ = ∫ w, Phi w ∂finiteCalendarLawAux rate rewards C_star C_h control0
              (n + 1) hn := by
                rw [finiteCalendarLawAux_succ rate rewards C_star C_h control0 n hn]

/-- Bounded joint tests at any boundary, indexed by `Fin (T + 1)`. -/
public theorem bounded_joint_test (rate : RateInput p) (rewards : RewardTable p)
    (C_star C_h : ℝ) (control0 : TimeControl p) (n : Fin (p.T + 1))
    (Phi : Observation p rate → ℝ) (hPhi : Measurable Phi)
    (B : ℝ) (hB : ∀ w, ‖Phi w‖ ≤ B) :
    (∫ za, Phi (observationAt rate rewards C_star C_h control0 n.val za)
        ∂enlargedSourceLaw p) =
      ∫ w, Phi w ∂finiteCalendarLaw rate rewards C_star C_h control0 n := by
  exact bounded_joint_test_aux rate rewards C_star C_h control0 n.val
    (Nat.le_of_lt_succ n.isLt) Phi hPhi B hB

/-- Exact equality of the observation pushforward and the recursively
generated calendar law, proved from measurable-set indicators of the joint
test identity. -/
public theorem observationAt_map_eq_finiteCalendarLaw (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p)
    (n : Fin (p.T + 1)) :
    (enlargedSourceLaw p).map (observationAt rate rewards C_star C_h control0 n.val) =
      finiteCalendarLaw rate rewards C_star C_h control0 n := by
  let theta := observationAt rate rewards C_star C_h control0 n.val
  have htheta : Measurable theta := measurable_observationAt_boundary rate rewards C_star C_h
    control0 n.val (Nat.le_of_lt_succ n.isLt)
  have hcalendarProbability : IsProbabilityMeasure
      (finiteCalendarLaw rate rewards C_star C_h control0 n) :=
    finiteCalendarLaw_probability rate rewards C_star C_h control0 n
  apply Measure.ext
  intro s hs
  let Phi : Observation p rate → ℝ := s.indicator 1
  have hPhi : Measurable Phi := measurable_const.indicator hs
  have hPhi_bound : ∀ w, ‖Phi w‖ ≤ (1 : ℝ) := by
    intro w
    by_cases hw : w ∈ s <;> simp [Phi, hw]
  have htest := bounded_joint_test rate rewards C_star C_h control0 n Phi hPhi 1 hPhi_bound
  have hPhiMap : Integrable Phi ((enlargedSourceLaw p).map theta) :=
    Integrable.of_bound hPhi.aestronglyMeasurable 1
      (Filter.Eventually.of_forall hPhi_bound)
  have hmeasureNeTop (μ : Measure (Observation p rate))
      (s : Set (Observation p rate)) [hμ : IsProbabilityMeasure μ] : μ s ≠ ⊤ :=
    measure_ne_top μ s
  have hmapIntegral :
      (∫ w, Phi w ∂(enlargedSourceLaw p).map theta) =
        ∫ za, Phi (theta za) ∂enlargedSourceLaw p :=
    integral_map htheta.aemeasurable hPhiMap.aestronglyMeasurable
  have hreal :
      ((enlargedSourceLaw p).map theta).real s =
        (finiteCalendarLaw rate rewards C_star C_h control0 n).real s := by
    rw [← integral_indicator_one hs, ← integral_indicator_one hs]
    dsimp [Phi] at htest hmapIntegral ⊢
    exact hmapIntegral.trans htest
  rw [measureReal_def, measureReal_def] at hreal
  exact (ENNReal.toReal_eq_toReal_iff'
    (hmeasureNeTop _ s)
    (hmeasureNeTop _ s (hμ := hcalendarProbability))).mp hreal

/-- The complete terminal observation consists of the identical original
source, every original label-zero coordinate, and the entire first-LIVE
chronological prefix. -/
public theorem bounded_joint_terminal_test (rate : RateInput p) (rewards : RewardTable p)
    (C_star C_h : ℝ) (control0 : TimeControl p)
    (Phi : Observation p rate → ℝ) (hPhi : Measurable Phi)
    (B : ℝ) (hB : ∀ w, ‖Phi w‖ ≤ B) :
    (∫ za, Phi (za.1,
        (labelZero za.2,
          firstLiveChronologicalPrefix rate rewards C_star C_h za))
        ∂enlargedSourceLaw p) =
      ∫ w, Phi w ∂finiteCalendarLaw rate rewards C_star C_h control0 (Fin.last p.T) := by
  have htest := bounded_joint_test rate rewards C_star C_h control0 (Fin.last p.T)
    Phi hPhi B hB
  calc
    (∫ za, Phi (za.1,
        (labelZero za.2,
          firstLiveChronologicalPrefix rate rewards C_star C_h za))
        ∂enlargedSourceLaw p) =
      ∫ za, Phi (observationAt rate rewards C_star C_h control0 p.T za)
        ∂enlargedSourceLaw p := by
          apply integral_congr_ae
          filter_upwards with za
          rw [observationAt_horizon]
    _ = ∫ w, Phi w ∂finiteCalendarLaw rate rewards C_star C_h control0 (Fin.last p.T) := by
          simpa using htest

/-- The full terminal source-retaining observation law is exactly the
recursively generated terminal calendar law. -/
public theorem observationAt_horizon_map_eq_finiteCalendarLaw (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p) :
    (enlargedSourceLaw p).map
        (fun za =>
          (za.1,
            (labelZero za.2,
              firstLiveChronologicalPrefix rate rewards C_star C_h za))) =
      finiteCalendarLaw rate rewards C_star C_h control0 (Fin.last p.T) := by
  have hobs : (fun za : EnlargedSource p =>
      (za.1,
        (labelZero za.2,
          firstLiveChronologicalPrefix rate rewards C_star C_h za))) =
      observationAt rate rewards C_star C_h control0 p.T := by
    funext za
    exact (observationAt_horizon rate rewards C_star C_h control0 za).symm
  simpa [hobs] using observationAt_map_eq_finiteCalendarLaw rate rewards C_star C_h
    control0 (Fin.last p.T)

/-- Project the chronological cells to their existing calendar-time and
numerical readout fields. -/
public def numericalListProjection (rate : RateInput p) (w : Observation p rate) :
    List (Fin p.T × ReferenceFirstLiveOverflowReadout.NumericalCellReadout p) :=
  w.2.2.map fun cell => (cell.time, cell.numerical)

public theorem measurable_numericalListProjection (rate : RateInput p) :
    Measurable (numericalListProjection rate) := by
  have hlist : Measurable (fun w : Observation p rate => w.2.2) :=
    measurable_snd.comp measurable_snd
  have hfields : Measurable (fun cell : Cell p rate => (cell.time, cell.numerical)) :=
    ReferenceFirstLiveChronologicalPrefixMeasurability.measurable_logicalCell_time.prodMk
      ReferenceFirstLiveChronologicalPrefixMeasurability.measurable_logicalCell_numerical
  exact ReferenceActiveHorizonMeasurability.measurable_list_map _ hlist _ hfields

/-- Every bounded Borel test of the terminal chronological numerical list has
the law induced by the recursively generated full joint calendar law. -/
public theorem bounded_terminal_numerical_list_test (rate : RateInput p)
    (rewards : RewardTable p) (C_star C_h : ℝ) (control0 : TimeControl p)
    (Psi : List (Fin p.T × ReferenceFirstLiveOverflowReadout.NumericalCellReadout p) → ℝ)
    (hPsi : Measurable Psi) (B : ℝ)
    (hB : ∀ xs, ‖Psi xs‖ ≤ B) :
    (∫ za, Psi ((firstLiveChronologicalPrefix rate rewards C_star C_h za).map
        fun cell => (cell.time, cell.numerical)) ∂enlargedSourceLaw p) =
      ∫ w, Psi (numericalListProjection rate w)
        ∂finiteCalendarLaw rate rewards C_star C_h control0 (Fin.last p.T) := by
  have hPhi : Measurable (fun w : Observation p rate =>
      Psi (numericalListProjection rate w)) :=
    hPsi.comp (measurable_numericalListProjection rate)
  have hPhiBound : ∀ w : Observation p rate,
      ‖Psi (numericalListProjection rate w)‖ ≤ B :=
    fun w => hB (numericalListProjection rate w)
  have htest := bounded_joint_terminal_test rate rewards C_star C_h control0
    (fun w => Psi (numericalListProjection rate w))
    hPhi B hPhiBound
  simpa [numericalListProjection, observationAt_horizon] using htest

end Bandits.Support.ReferenceFirstLiveFiniteCalendarJointLaw
