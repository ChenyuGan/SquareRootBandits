module

public import Bandits.Support.ReferenceFirstAcceptedUpNumericSnapshot

/-!
# First accepted DOWN with zero-seeded recovery

This module proves the actual first-assignment DOWN recovery, including a
diagnostic accepted after its first cutoff.  It uses the physical run and the
literal saved-emission projection from the accepted-UP history module; it does
not assert that later UP processing or the whole follower run succeeds.

Mathematical sources: `06_interruptions.tex:192-233,257-275,301-324,327-344`,
`appendix_a_local_protocol.tex:54-60`, and
`04_slow_fast_learner.tex:157-165`.
-/

@[expose] public section

noncomputable section

open Bandits.Support
open ConstructorDimensions
open ReferencePrelaunchFollower

namespace Bandits.Support.ReferenceFirstDownZeroRecovery

abbrev Parameters := ConstructorDimensions.Parameters
abbrev RateInput := ReferenceActivePhysicalStep.RateInput
abbrev State := ReferenceActivePhysicalStep.State
abbrev Record {p : Parameters} {rate : RateInput p} :=
  ReferenceActivePhysicalHorizon.RoundRecord (p := p) (rate := rate)
abbrev DownRecord {p : Parameters} {rate : RateInput p} :=
  OrdinaryMessageCodec.DownRecord
    (ReferencePrelaunchFollower.codecParams p rate.eta)

variable {p : Parameters} {rate : RateInput p}

private theorem foldCalendar_records_extends
    (initial : State p rate)
    (rows : CompletePublicTable.CompleteRows p) (selected : Fin (M p))
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (origin : ℕ) (hmode : ReferenceActivePhysicalHorizon.allActiveAtStart
      (p := p) (rate := rate) initial origin)
    (entries : List (ReferenceActivePhysicalHorizon.CalendarEntry p origin))
    (acc : ReferenceActivePhysicalHorizon.Run initial) :
    ∃ suffix,
      (entries.foldl
        (ReferenceActivePhysicalHorizon.foldRound initial rows selected rewards origin hmode)
        acc).records = acc.records ++ suffix := by
  induction entries generalizing acc with
  | nil => exact ⟨[], by simp⟩
  | cons entry entries ih =>
      obtain ⟨suffix, hsuffix⟩ := ih
        (ReferenceActivePhysicalHorizon.foldRound initial rows selected rewards origin
          hmode acc entry)
      let input := ReferenceActivePhysicalHorizon.roundInputAt initial rows selected rewards
        origin hmode acc entry
      refine ⟨[⟨input, ReferenceActivePhysicalStep.step input, rfl⟩] ++ suffix, ?_⟩
      rw [List.foldl_cons, hsuffix]
      simp only [ReferenceActivePhysicalHorizon.foldRound]
      simp [input, List.append_assoc]

/-- Any initial segment of a canonical physical run is itself the canonical
run over that shorter interval.  The suffix is generated by the same fold;
no matching-history hypothesis is required. -/
private theorem run_prefix_records_take
    (initial : State p rate)
    (rows : CompletePublicTable.CompleteRows p) (selected : Fin (M p))
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (start count : ℕ) (hspan : start + count ≤ p.T)
    (hmode : ReferenceActivePhysicalHorizon.allActiveAtStart initial start)
    (k : ℕ) (hk : k ≤ count) :
    ((ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
        hspan hmode).records.take k) =
      (ReferenceActivePhysicalHorizon.run initial rows selected rewards start k
        (by omega) hmode).records := by
  have hdecomp : k + (count - k) = count := Nat.add_sub_of_le hk
  have happend := ReferenceActivePhysicalHorizon.run_append initial rows selected rewards
    start k (count - k) (by omega) hmode
  have hextend := foldCalendar_records_extends initial rows selected rewards start hmode
    (ReferenceActivePhysicalHorizon.calendarEntries start (start + k) (count - k)
      (by omega) (by omega))
    (ReferenceActivePhysicalHorizon.run initial rows selected rewards start k (by omega) hmode)
  obtain ⟨suffix, hsuffix⟩ := hextend
  have hlength := ReferenceActivePhysicalHorizon.run_record_count initial rows selected
    rewards start k (by omega) hmode
  have hrunEq :
      ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
        hspan hmode =
      ReferenceActivePhysicalHorizon.foldCalendar initial rows selected rewards start
        (start + k) (count - k) (by omega) (by omega) hmode
        (ReferenceActivePhysicalHorizon.run initial rows selected rewards start k
          (by omega) hmode) := by
    simpa only [hdecomp] using happend
  have hrecords := congrArg ReferenceActivePhysicalHorizon.Run.records hrunEq
  change (ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
    hspan hmode).records.take k = _
  rw [hrecords]
  change ((ReferenceActivePhysicalHorizon.calendarEntries start (start + k) (count - k)
      (by omega) (by omega)).foldl
      (ReferenceActivePhysicalHorizon.foldRound initial rows selected rewards start hmode)
      (ReferenceActivePhysicalHorizon.run initial rows selected rewards start k
        (by omega) hmode)).records.take k = _
  rw [hsuffix]
  rw [List.take_append_of_le_length (by omega : k ≤
    (ReferenceActivePhysicalHorizon.run initial rows selected rewards start k
      (by omega) hmode).records.length)]
  simp [hlength]

/-- The actual record at index `j` is the successor record whose accepted
window is the physical prefix of length `j`. -/
private theorem run_record_eq_successor
    (initial : State p rate)
    (rows : CompletePublicTable.CompleteRows p) (selected : Fin (M p))
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (start count : ℕ) (hspan : start + count ≤ p.T)
    (hmode : ReferenceActivePhysicalHorizon.allActiveAtStart initial start)
    (j : Fin ((ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
      hspan hmode).records.length)) :
    (ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
      hspan hmode).records[j.val] =
    ReferenceFollowerSparseEmissionRecovery.successorRecord initial rows selected rewards
      start j.val (by
        have hcount := ReferenceActivePhysicalHorizon.run_record_count initial rows selected
          rewards start count hspan hmode
        have hj := j.isLt
        omega) hmode := by
  have hcount := ReferenceActivePhysicalHorizon.run_record_count initial rows selected rewards
    start count hspan hmode
  have hj : j.val < count := by omega
  have hprefix := run_prefix_records_take initial rows selected rewards start count hspan hmode
    (j.val + 1) (by omega)
  have hsuccessor :=
    ReferenceFollowerSparseEmissionRecovery.physicalRecords_eq_run_successor initial rows
      selected rewards start j.val (by omega) hmode
  have hphysicalPrefix :
      ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows selected rewards
        start j.val (by omega) hmode =
      (ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
        hspan hmode).records.take (j.val + 1) := by
    calc
      ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows selected rewards
          start j.val (by omega) hmode =
          (ReferenceActivePhysicalHorizon.run initial rows selected rewards start (j.val + 1)
            (by omega) hmode).records := hsuccessor
      _ = _ := hprefix.symm
  have hfullBound : j.val + 1 ≤
      (ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
        hspan hmode).records.length := by omega
  have hjTake : j.val <
      ((ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
        hspan hmode).records.take (j.val + 1)).length := by
    rw [List.length_take, Nat.min_eq_left hfullBound]
    omega
  have hgetTake := List.getElem_take
    (xs := (ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
      hspan hmode).records) (j := j.val + 1) (i := j.val) (h := hjTake)
  have hphysicalLength :=
    (ReferenceFollowerSparseEmissionRecovery.physicalRecords_time_and_length initial rows
      selected rewards start j.val (by omega) hmode).2
  have hphysicalIndex : j.val <
      (ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows selected rewards
        start j.val (by omega) hmode).length := by
    rw [hphysicalLength]
    omega
  have htakeIndex : j.val <
      ((ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
        hspan hmode).records.take (j.val + 1)).length := by
    exact hjTake
  have hphysicalTakeGetOpt := congrArg
    (fun records : List (Record (p := p) (rate := rate)) => records[j.val]?)
    hphysicalPrefix
  have hphysicalTakeGet :
      (ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows selected rewards
        start j.val (by omega) hmode)[j.val] =
      ((ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
        hspan hmode).records.take (j.val + 1))[j.val] := by
    rw [List.getElem?_eq_getElem hphysicalIndex,
      List.getElem?_eq_getElem htakeIndex] at hphysicalTakeGetOpt
    exact Option.some.inj hphysicalTakeGetOpt
  have hgetLast :
      (ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows selected rewards
        start j.val (by omega) hmode)[j.val]'hphysicalIndex =
      ReferenceFollowerSparseEmissionRecovery.successorRecord initial rows selected rewards
        start j.val (by omega) hmode := by
    have hpriorLength := ReferenceActivePhysicalHorizon.run_record_count initial rows selected
      rewards start j.val (by omega) hmode
    simp [ReferenceFollowerSparseEmissionRecovery.physicalRecords,
      ReferenceFollowerSparseEmissionRecovery.priorRun, hpriorLength]
  calc
    (ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
      hspan hmode).records[j.val] =
      ((ReferenceActivePhysicalHorizon.run initial rows selected rewards start count
        hspan hmode).records.take (j.val + 1))[j.val] := hgetTake.symm
    _ = (ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows selected rewards
        start j.val (by omega) hmode)[j.val] := hphysicalTakeGet.symm
    _ = _ := hgetLast

/-- On a prefix of at most `j+1` records, every index selected by
`firstReplyQueueRecords` uses the actual saved emission. -/
private theorem firstReplyQueueRecords_eq_savedPrefix
    (records : List (Record (p := p) (rate := rate)))
    (i : Fin (p.m - 1)) (j m : ℕ) (message : DownRecord (p := p) (rate := rate))
    (hm : m ≤ j + 1) :
    ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords records i j message m =
      (records.take m).map (fun record =>
        (true, ReferenceFollowerSparseEmissionRecovery.emissionContribution message i record)) := by
  apply List.ext_getElem
  · simp [ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords]
  · intro n hleft hright
    have hnTake : n < (records.take m).length := by
      simpa only [List.length_map] using hright
    have hnM : n < m := by
      rw [List.length_take] at hnTake
      exact lt_of_lt_of_le hnTake (Nat.min_le_left _ _)
    have hnJ : n ≤ j := by omega
    have hnJ' : 0 + n ≤ j := by omega
    simp only [ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords,
      List.getElem_map, List.getElem_zipIdx]
    simp only [ite_eq_left hnJ']

private theorem firstReplyQueueRecords_append_last
    (records : List (Record (p := p) (rate := rate)))
    (i : Fin (p.m - 1)) (j n : ℕ) (message : DownRecord (p := p) (rate := rate))
    (hn : 0 < n) (hbound : n ≤ j + 1) (hrecords : n ≤ records.length) :
    ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords records i j message n =
      ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords records i j message
          (n - 1) ++
        [(true, ReferenceFollowerSparseEmissionRecovery.emissionContribution message i
          records[n - 1])] := by
  have hboundPrev : n - 1 ≤ j + 1 := by omega
  have hrecordsPrev : n - 1 ≤ records.length := by omega
  rw [firstReplyQueueRecords_eq_savedPrefix records i j n message hbound,
    firstReplyQueueRecords_eq_savedPrefix records i j (n - 1) message hboundPrev]
  have hindex : n - 1 < records.length := by omega
  have htake : records.take n = records.take (n - 1) ++ [records[n - 1]] := by
    calc
      records.take n = records.take ((n - 1) + 1) :=
        congrArg (fun m => records.take m) (by omega)
      _ = records.take (n - 1) ++ [records[n - 1]] :=
        List.take_succ_eq_append_getElem hindex
  calc
    List.map (fun record => (true,
        ReferenceFollowerSparseEmissionRecovery.emissionContribution message i record))
        (records.take n) =
      List.map (fun record => (true,
        ReferenceFollowerSparseEmissionRecovery.emissionContribution message i record))
        (records.take (n - 1) ++ [records[n - 1]]) := congrArg _ htake
    _ = _ := by rw [List.map_append]; rfl

private theorem downTransition_accepted_scan_identity
    (i : Fin (p.m - 1)) (row : CompletePublicTable.CompleteRow p) (t : Fin p.T)
    (feedback : ReferencePrelaunchFollower.Observation p)
    (logged after : ReferencePrelaunchFollower.State p rate.eta)
    (raw : Option (AffineChannelLaw.Word (AffineBatchDecoder.width p)))
    (message : DownRecord (p := p) (rate := rate))
    (scan : FollowerCutoffScan.ScanResult p.T) (registers : ℕ × ℕ) (lastService : ℕ)
    (haccepted : OrdinaryMessageCodec.acceptDown
      (ReferencePrelaunchFollower.codecParams p rate.eta)
      (ReferencePrelaunchFollower.acceptedStart logged) (t.val + 1) message)
    (h : ActiveFollowerDownAcceptance.downTransition p i row t feedback rate logged =
      .accepted logged after raw message scan registers lastService) :
    scan = ActiveFollowerDownAcceptance.acceptedCutoffScan p rate message t
      (ActiveFollowerDownAcceptance.acceptedDownStartLE p rate message t logged haccepted) row := by
  unfold ActiveFollowerDownAcceptance.downTransition at h
  split at h
  next hselected =>
    split at h
    next hstatus =>
      split at h
      next hregisters =>
        split at h
        next hbatch =>
          split at h
          next hbuffer =>
            dsimp only at h
            split at h
            next hparsed => cases h
            next parsed hparsed =>
              split at h
              next haccepted =>
                split at h
                next failure hfailure => cases h
                next recovered hchecked =>
                  cases h
                  rfl
              next hnotaccepted => cases h
          next hbuffer => cases h
        next hbatch => cases h
      next hregisters => cases h
    next hstatus => cases h
  next hselected => cases h

/-- A selected payload whose source sigma is the physical run's first
coordinate is born by the actual first chosen installation. -/
private theorem selected_first_payload_birth
    (initial : State p rate)
    (rows : CompletePublicTable.CompleteRows p) (selectedRow : Fin (M p))
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (start count : ℕ) (hspan : start + count ≤ p.T)
    (hmode : ReferenceActivePhysicalHorizon.allActiveAtStart initial start)
    (hfirst : initial.coordinator = .first)
    (record : Record (p := p) (rate := rate))
    (selected : ReferenceActivePhysicalStep.Selection record.input)
    (hrecord : record ∈
      (ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards start count
        hspan hmode).records)
    (hselected : record.output.preparation.coordinator.selection = some selected)
    (hsigma : selected.view.payload.sigma.val = start)
    (i : Fin (p.m - 1)) :
    ∃ birthRecord installed choice,
      birthRecord ∈
        (ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards start count
          hspan hmode).records ∧
      ReferenceAssignmentPayloadPersistence.InstallationBirth birthRecord
        selected.view.payload ∧
      birthRecord.input.time.val = start ∧
      birthRecord.input.state.coordinator = .first ∧
      (ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards start count
        hspan hmode).records.head? = some birthRecord ∧
      CoordinatorRoundDispatch.dispatchFirst
        (ReferenceActivePhysicalStep.firstInput birthRecord.input) = .chosen installed choice ∧
      selected.view.payload = installed.registers.payload ∧
      installed.registers.payload = AssignmentStartPayload.Input.ofFirstAssignment
        (CoordinatorRoundDispatch.firstLaunchInput
          (ReferenceActivePhysicalStep.firstInput birthRecord.input)) ∧
      (installed.registers.payload.downRecord i).val.q = 0 := by
  obtain ⟨birthRecord, hbirthMem, hbirth, hbirthTime, _⟩ :=
    ReferenceSelectedPayloadChronology.actualRun_selectedPayload_has_birth
      initial rows selectedRow rewards start count hspan hmode hfirst record selected
      hrecord hselected
  have hbirthTimeStart : birthRecord.input.time.val = start := by
    calc
      birthRecord.input.time.val = selected.view.payload.sigma.val := hbirthTime
      _ = start := hsigma
  obtain ⟨n, hn, hgetBirth⟩ := List.mem_iff_getElem.mp hbirthMem
  have hrecordCount := ReferenceActivePhysicalHorizon.run_record_count initial rows
    selectedRow rewards start count hspan hmode
  have hnCount : n < count := by omega
  have hzero : 0 <
      (ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards start count
        hspan hmode).records.length := by omega
  have htimeValues := ReferenceActivePhysicalHorizon.run_time_values initial rows
    selectedRow rewards start count hspan hmode
  have htimeIndex :
      ((ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards start count
        hspan hmode).records[n]).input.time.val = start + n := by
    have hgetTimes := congrArg (fun times : List ℕ => times[n]?) htimeValues
    have hrecordTime :
        ((ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards start count
          hspan hmode).records.map (fun record => record.input.time.val))[n]? =
          some ((ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards start count
            hspan hmode).records[n].input.time.val) := by
      simp only [List.getElem?_map, List.getElem?_eq_getElem hn, Option.map_some]
    have hnCalendar : n <
        (ReferenceActivePhysicalHorizon.calendar start count).length := by
      simpa only [ReferenceActivePhysicalHorizon.calendar, List.length_range'] using hnCount
    have hcalendar :
        (ReferenceActivePhysicalHorizon.calendar start count)[n] = start + n := by
      change (List.range' start count)[n] = start + n
      exact List.getElem_range'_1 n hnCalendar
    have hcalendarTime :
        (ReferenceActivePhysicalHorizon.calendar start count)[n]? = some (start + n) := by
      rw [List.getElem?_eq_getElem hnCalendar, hcalendar]
    rw [hrecordTime, hcalendarTime] at hgetTimes
    exact Option.some.inj hgetTimes
  have hnZero : n = 0 := by
    rw [hgetBirth] at htimeIndex
    rw [hbirthTimeStart] at htimeIndex
    omega
  have hbirthFirst :
      (ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards start count
        hspan hmode).records.head? = some birthRecord := by
    have hgetBirth0 :
        (ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards start count
          hspan hmode).records[0] = birthRecord := by
      simpa only [hnZero] using hgetBirth
    simpa only [List.head?_eq_getElem?, List.getElem?_eq_getElem hzero] using
      congrArg some hgetBirth0
  have hbirthInput : birthRecord.input.state = initial := by
    cases hrecords : (ReferenceActivePhysicalHorizon.run initial rows selectedRow rewards
        start count hspan hmode).records with
    | nil =>
        rw [hrecords] at hbirthMem
        cases hbirthMem
    | cons head tail =>
        have hhead : birthRecord = head := by
          have hhead' : some head = some birthRecord := by simpa [hrecords] using hbirthFirst
          exact (Option.some.inj hhead').symm
        have hconnected := ReferenceActivePhysicalHorizon.run_connected initial rows
          selectedRow rewards start count hspan hmode
        rw [hrecords] at hconnected
        change head.input.state = initial ∧ _ at hconnected
        rw [hhead]
        exact hconnected.1
  have hinputFirst : birthRecord.input.state.coordinator = .first := by
    calc
      birthRecord.input.state.coordinator = initial.coordinator :=
        congrArg (fun state => state.coordinator) hbirthInput
      _ = .first := hfirst
  have hcoordActual : birthRecord.output.preparation.coordinator =
      ReferenceActivePhysicalStep.dispatch birthRecord.input := by
    rw [birthRecord.output_eq]
    exact (ReferenceActivePhysicalStep.prepare birthRecord.input).coordinator_eq
  have hcoordFirst : birthRecord.output.preparation.coordinator =
      .first (CoordinatorRoundDispatch.dispatchFirst
        (ReferenceActivePhysicalStep.firstInput birthRecord.input)) := by
    calc
      birthRecord.output.preparation.coordinator =
          ReferenceActivePhysicalStep.dispatch birthRecord.input := hcoordActual
      _ = .first (CoordinatorRoundDispatch.dispatchFirst
          (ReferenceActivePhysicalStep.firstInput birthRecord.input)) :=
        ReferenceActivePhysicalStep.dispatch_first birthRecord.input hinputFirst
  have hbirth' := hbirth
  unfold ReferenceAssignmentPayloadPersistence.InstallationBirth at hbirth'
  rw [hcoordFirst] at hbirth'
  cases hdispatch : CoordinatorRoundDispatch.dispatchFirst
      (ReferenceActivePhysicalStep.firstInput birthRecord.input) with
  | choiceDomainFailure installed =>
      simp [hdispatch] at hbirth'
  | recorderBoundaryFailure installed =>
      simp [hdispatch] at hbirth'
  | choiceRejected installed =>
      simp [hdispatch] at hbirth'
  | chosen installed choice =>
      simp only [hdispatch] at hbirth'
      rcases hbirth' with ⟨hpayload, _⟩
      have hpayloadInput := ReferenceAssignmentPayloadPersistence.firstChosen_payload_eq_input
        birthRecord.input installed choice hdispatch
      have hqueue := ReferenceAssignmentPayloadPersistence.firstChosen_down_queue_zero
        birthRecord.input installed choice hdispatch i
      exact ⟨birthRecord, installed, choice, hbirthMem, hbirth, hbirthTimeStart,
        hinputFirst, hbirthFirst, hdispatch, hpayload, hpayloadInput, hqueue⟩


/-- The accepted first-assignment DOWN is the actual first chosen payload's
zero-queue record, and its checked recovery is the literal enabled replay of
the real prefix through that diagnostic.  This theorem accepts only an actual
retained diagnostic and its one-based source sigma; it does not assume an UP
acceptance, a successful replay, or a desired numerical state. -/
theorem actual_first_down_zero_seeded_recovery
    (initial : State p rate)
    (rows : CompletePublicTable.CompleteRows p) (J : Fin (M p))
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (start count : ℕ) (hspan : start + count ≤ p.T)
    (hmode : ReferenceActivePhysicalHorizon.allActiveAtStart initial start)
    (hfirst : initial.coordinator = .first)
    (i : Fin (p.m - 1))
    (seed : ReferencePrelaunchFollower.State p rate.eta)
    (memory : ActiveFollowerLifecycle.LocalMemory p)
    (hseed : initial.followers i = .ordinary seed memory)
    (hnone : seed.lastDown = none)
    (hunoccupied : seed.status = .unoccupied)
    (hvalid : ActiveFollowerLifecycle.localBufferValid seed)
    (hpair : seed.buffer.Pairwise (fun a b => a.calendarRound < b.calendarRound))
    (htime : ∀ saved ∈ seed.buffer, saved.calendarRound ≤ start)
    (j : Fin ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
      hspan hmode).records.length))
    (message : DownRecord (p := p) (rate := rate))
    (hretained : ReferenceAcceptedUpFollowerHistory.RetainedDown
      (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
        hspan hmode).records[j.val] i message)
    (hsigma : message.val.sigma = start + 1) :
    ∃ logged cut after raw scan registers lastService,
      ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
        hspan hmode).records[j.val].output.followers i).downInput = some logged ∧
      ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
        hspan hmode).records[j.val].output.followers i).down = some cut ∧
      cut.outcome = .accepted logged after raw message scan registers lastService ∧
      ∃ (view : ReferenceDownReception.ChoiceTimeView p rate.eta)
        (selected : ReferenceActivePhysicalStep.Selection
        ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
          hspan hmode).records[j.val].input)),
        (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
          hspan hmode).records[j.val].output.preparation.coordinator.downView = some view ∧
        (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
          hspan hmode).records[j.val].output.preparation.coordinator.selection = some selected ∧
        selected.view = view ∧ message = view.payload.downRecord i ∧
        ∃ birthRecord installed firstChoice,
          birthRecord ∈ (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
            hspan hmode).records ∧
          ReferenceAssignmentPayloadPersistence.InstallationBirth birthRecord
            selected.view.payload ∧
          birthRecord.input.time.val = start ∧
          birthRecord.input.state.coordinator = .first ∧
          (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
            hspan hmode).records.head? = some birthRecord ∧
          CoordinatorRoundDispatch.dispatchFirst
            (ReferenceActivePhysicalStep.firstInput birthRecord.input) =
              .chosen installed firstChoice ∧
          selected.view.payload = installed.registers.payload ∧
          installed.registers.payload = AssignmentStartPayload.Input.ofFirstAssignment
            (CoordinatorRoundDispatch.firstLaunchInput
              (ReferenceActivePhysicalStep.firstInput birthRecord.input)) ∧
          message = installed.registers.payload.downRecord i ∧
          message.val.q = 0 ∧ seed.lastDown = none ∧ seed.status = .unoccupied ∧
          ∃ n0,
            n0 = scan.endpoint - message.val.sigma ∧
            scan.endpoint = min
              (FollowerCutoffScan.firstCutoff p rate.eta.val
                (ActiveFollowerDownAcceptance.downStart p rate message)
                (FollowerCutoffScan.completeRowProposalBit p rate.eta.val (rows J)))
              (start + j.val + 2) ∧
            0 < n0 ∧ n0 ≤ j.val + 1 ∧
            (∀ prior ∈ (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
              hspan hmode).records.take j.val,
              ¬ ReferenceFollowerBufferProvenance.acceptedDownReset i prior) ∧
            ActiveFollowerDownAcceptance.recoveryQueueRecords p rate message logged
              scan.endpoint =
                ((ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows J
                  rewards start j.val (by
                    have hcount := ReferenceActivePhysicalHorizon.run_record_count
                      initial rows J rewards start count hspan hmode
                    omega) hmode).take n0).map
                  (fun record => (true,
                    ReferenceFollowerSparseEmissionRecovery.emissionContribution
                      message i record)) ∧
            ActiveFollowerDownAcceptance.checkedRecovery p rate message logged
              scan.endpoint = .ok ⟨registers, lastService⟩ ∧
            registers = QueueReplay.replay (4 * rate.n) (0, 0)
              (ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords
                (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
                  hspan hmode).records i j.val message n0) ∧
            lastService =
