            (QueueReplay.replay (4 * rate.n) (0, 0)
              (ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords E.records i j.val
                message (n0 - 1))).1 ∧
          (let physicalInput :=
              ((ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows J rewards
                  start j.val hspanCurrent hmode).take n0).map
                (fun record => (true,
                  ReferenceFollowerSparseEmissionRecovery.emissionContribution message i record))
           ∀ k, ∃ middle,
            ActiveFollowerDownAcceptance.checkedReplay (D p) (p.T * D p)
              (4 * rate.n) 0 ⟨(0, message.val.q), 0⟩ (physicalInput.take k) = .ok middle ∧
            ActiveFollowerDownAcceptance.replay_register_domain (D p) (p.T * D p) middle ∧
            middle.registers = QueueReplay.replay (4 * rate.n) (0, message.val.q)
              (physicalInput.take k)) := by
        refine ⟨scan.endpoint - message.val.sigma, rfl, hendpoint, hn0pos,
          hn0Bound, hnoPrior, ?_, hcheckedRecovery, ?_, ?_, ?_⟩
        · exact hqueueRecovery
        · simpa [hbirthQueueZero'] using hregistersReplay
        · simpa [hbirthQueueZero'] using hlastServiceEq
        · exact hcheckedPrefixes
      have hinputE : (E.records[j.val].output.followers i).downInput = some logged := by
        exact (congrArg (fun record : Record (p := p) (rate := rate) =>
          (record.output.followers i).downInput) hcurrentEq).trans hcurrentInput
      have hdownE : (E.records[j.val].output.followers i).down = some cut := by
        exact (congrArg (fun record : Record (p := p) (rate := rate) =>
          (record.output.followers i).down) hcurrentEq).trans hcurrentDown
      let recoveredState := fun (record : Record (p := p) (rate := rate)) =>
        ({ logged with
          lastDown := some message
          S := registers.1
          delta := lastService
          backlog := registers.2
          status := if scan.endpoint =
            (record.output.preparation.followers.followers i).time.val + 2
            then .pending else .unoccupied
          downBatch := (ActiveFollowerDownAcceptance.currentDecodeStep p i
            (record.output.preparation.followers.followers i).row
            (record.output.preparation.followers.followers i).time
            (record.output.preparation.feedback.observations
              (PublicDiscreteDraws.followerPlayer p.two_le_m i)) rate logged).1
          buffer := [] } : ReferencePrelaunchFollower.State p rate.eta)
      have hstateEq : recoveredState current = recoveredState E.records[j.val] :=
        congrArg recoveredState hcurrentEq.symm
      have hafterE : after = recoveredState E.records[j.val] := by
        exact hafter.trans hstateEq
      rcases hresult with
        ⟨n0, hn0Eq, hendpoint, hn0pos', hn0Bound', hnoPrior', hqueueActual,
          hcheckedRecovery', hregistersReplay', hlastServiceReplay', hcheckedPrefixes'⟩
      refine ⟨logged, cut, after, raw, scan, registers, lastService,
        hinputE, hdownE, hcurrentAccepted,
        view, selected, hviewRecord, rfl, hselectedView, hmessageAtIndex,
        birthRecord, installed, firstChoice, hbirthMem, hbirth, hbirthTime,
        hbirthInputFirst, hbirthHead, hdispatch, hpayload, hpayloadInput,
        hmessageFirst, hbirthQueueZero', hnone, hunoccupied,
        n0, hn0Eq, hendpoint, hn0pos', hn0Bound',
        hnoPrior', hqueueActual, hcheckedRecovery', hregistersReplay',
        hlastServiceReplay', hcheckedPrefixes', hafterE⟩

section ActualLaunch

variable
    (source : BootstrapPrivateRoundStreams.SourceInput p)
    (rewards : ActualInitializationPhysicalStep.GridRewardTable p)
    (rate : RateInput p) (C_star C_h : ℝ)
    (b : ReferenceInitializationRun.Boundary p)
    (h : b.completed < BootstrapDimensions.n_boot p)
    (actual : ActualInitializationRun.BlockCarry p rate
      (ReferenceInitializationRun.nextBlock b h))
    (past : List (ActualInitializationRun.PhysicalRoundRecord p rate source rewards))
    (hr : ActualReferenceInitializationBlock.BlockStartRelated source rewards
      C_star C_h rate (ReferenceInitializationRun.nextBlock b h) actual b past)
    (hdown : ∀ i, ¬ InitializationFailureProvenance.generatedBlockDown
      (ActualReferenceInitializationBlock.referenceInput source rewards C_star C_h rate) b h i)
    (hclean : ∀ (i : Fin (p.m - 1))
      (hi : ActualReferenceInitializationBlock.refFollower i ∈
        (ReferenceInitializationRun.physical
          (ActualReferenceInitializationBlock.referenceInput source rewards C_star C_h rate)
          b h).uninformed),
      BootstrapAllCandidateController.cleanPrefix
        (ReferenceInitializationRun.physical
          (ActualReferenceInitializationBlock.referenceInput source rewards C_star C_h rate)
          b h)
        source.1.2 ⟨ActualReferenceInitializationBlock.refFollower i, hi⟩
        (ActualInitializationPhysicalStep.selectedRowIndex p source) p.T)
    (hforce : ∀ i, ReferenceInitializationRun.forced
      (ActualReferenceInitializationBlock.referenceInput source rewards C_star C_h rate)
      b h i = false)
    (launch : BootstrapCoordinatorLocalRound.LaunchedBlock p)
    (learnerSeed : ActualInitializationRun.CoordinatorLearnerZeroSeed p)
    (hlaunched : (ActualInitializationRun.combinedBoundaryHandoff p rate
      (ReferenceInitializationRun.nextBlock b h) source rewards actual.C_star actual.C_h
      (ActualInitializationRun.foldBlock p rate (ReferenceInitializationRun.nextBlock b h)
        source rewards actual)).disposition = .launched launch learnerSeed)

/-- Conditional specialization at the actual original-source launch boundary.
The local zero-seed conditions and retained DOWN selector stay explicit.
Coordinator mode and the active-at-boundary condition are derived from the
accepted source launch, with every source, reward, carry, block-start,
cleanliness, forcing, and launch input retained. -/
theorem actual_launched_first_down_zero_seeded_recovery
    (i : Fin (p.m - 1)) :
    let initial := ActualInitializationLaunchState.ofActualLaunchedBoundary source rewards rate
      C_star C_h b h actual past hr hdown hclean hforce launch learnerSeed hlaunched
    let start := BootstrapObservedFollower.blockStop p (ReferenceInitializationRun.nextBlock b h)
    let rows := source.1.2
    let J := ActualInitializationPhysicalStep.selectedRowIndex p source
    let count := p.T - start
    let hspan : start + count ≤ p.T := by
      have hstop : BootstrapObservedFollower.blockStop p
          (ReferenceInitializationRun.nextBlock b h) ≤ p.T := by
        unfold BootstrapObservedFollower.blockStop
        exact Nat.min_le_left _ _
      dsimp only [start, count]
      exact Nat.le_of_eq (Nat.add_sub_of_le hstop)
    let localInvariants := ReferenceFirstAcceptedUpNumericSnapshot.actual_launched_follower_local_invariants
      source rewards rate C_star C_h b h actual past hr hdown hclean hforce launch learnerSeed
      hlaunched i
    let hmode := localInvariants.2.1
    ∀ (seed : ReferencePrelaunchFollower.State p rate.eta)
      (memory : ActiveFollowerLifecycle.LocalMemory p)
      (_hseed : initial.followers i = .ordinary seed memory)
      (_hnone : seed.lastDown = none)
      (_hunoccupied : seed.status = .unoccupied)
      (_hvalid : ActiveFollowerLifecycle.localBufferValid seed)
      (_hpair : seed.buffer.Pairwise (fun a b => a.calendarRound < b.calendarRound))
      (_htime : ∀ saved ∈ seed.buffer, saved.calendarRound ≤ start)
      (j : Fin ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
        hspan hmode).records.length))
      (message : DownRecord (p := p) (rate := rate))
      (_hretained : ReferenceAcceptedUpFollowerHistory.RetainedDown
        (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
          hspan hmode).records[j.val] i message)
      (hsigma : message.val.sigma = start + 1),
      ∃ logged cut after raw scan registers lastService,
        ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
          hspan hmode).records[j.val].output.followers i).downInput = some logged ∧
        ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
          hspan hmode).records[j.val].output.followers i).down = some cut ∧
        cut.outcome = .accepted logged after raw message scan registers lastService ∧
        ∃ (view : ReferenceDownReception.ChoiceTimeView p rate.eta)
          (selected : ReferenceActivePhysicalStep.Selection
          ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
            hspan hmode).records[j.val].input)),
          (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
            hspan hmode).records[j.val].output.preparation.coordinator.downView = some view ∧
          (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
            hspan hmode).records[j.val].output.preparation.coordinator.selection = some selected ∧
          selected.view = view ∧ message = view.payload.downRecord i ∧
          ∃ birthRecord installed firstChoice,
            birthRecord ∈ (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
              hspan hmode).records ∧
            ReferenceAssignmentPayloadPersistence.InstallationBirth birthRecord
              selected.view.payload ∧
            birthRecord.input.time.val = start ∧
            birthRecord.input.state.coordinator = .first ∧
            (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
              hspan hmode).records.head? = some birthRecord ∧
            CoordinatorRoundDispatch.dispatchFirst
              (ReferenceActivePhysicalStep.firstInput birthRecord.input) =
                .chosen installed firstChoice ∧
            selected.view.payload = installed.registers.payload ∧
            installed.registers.payload = AssignmentStartPayload.Input.ofFirstAssignment
              (CoordinatorRoundDispatch.firstLaunchInput
                (ReferenceActivePhysicalStep.firstInput birthRecord.input)) ∧
            message = installed.registers.payload.downRecord i ∧
            message.val.q = 0 ∧ seed.lastDown = none ∧ seed.status = .unoccupied ∧
            ∃ n0,
              n0 = scan.endpoint - message.val.sigma ∧
              scan.endpoint = min
                (FollowerCutoffScan.firstCutoff p rate.eta.val
                  (ActiveFollowerDownAcceptance.downStart p rate message)
                  (FollowerCutoffScan.completeRowProposalBit p rate.eta.val (rows J)))
                (start + j.val + 2) ∧
              0 < n0 ∧ n0 ≤ j.val + 1 ∧
              (∀ prior ∈ (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
                hspan hmode).records.take j.val,
                ¬ ReferenceFollowerBufferProvenance.acceptedDownReset i prior) ∧
              ActiveFollowerDownAcceptance.recoveryQueueRecords p rate message logged
                scan.endpoint =
                  ((ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows J
                    rewards start j.val (by
                      have hcount := ReferenceActivePhysicalHorizon.run_record_count
                        initial rows J rewards start count hspan hmode
                      omega) hmode).take n0).map
                    (fun record => (true,
                      ReferenceFollowerSparseEmissionRecovery.emissionContribution
                        message i record)) ∧
              ActiveFollowerDownAcceptance.checkedRecovery p rate message logged
                scan.endpoint = .ok ⟨registers, lastService⟩ ∧
              registers = QueueReplay.replay (4 * rate.n) (0, 0)
                (ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords
                  (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
                    hspan hmode).records i j.val message n0) ∧
              lastService =
                (QueueReplay.replay (4 * rate.n) (0, 0)
                  (ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords
                    (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
                      hspan hmode).records i j.val message n0)).1 -
                (QueueReplay.replay (4 * rate.n) (0, 0)
                  (ReferenceFirstAcceptedUpNumericSnapshot.firstReplyQueueRecords
                    (ReferenceActivePhysicalHorizon.run initial rows J rewards start count
                      hspan hmode).records i j.val message (n0 - 1))).1 ∧
              (let physicalInput :=
                  ((ReferenceFollowerSparseEmissionRecovery.physicalRecords initial rows J rewards
                      start j.val (by
                        have hcount := ReferenceActivePhysicalHorizon.run_record_count
                          initial rows J rewards start count hspan hmode
                        omega) hmode).take n0).map
                    (fun record => (true,
                      ReferenceFollowerSparseEmissionRecovery.emissionContribution message i record))
               ∀ k, ∃ middle,
                ActiveFollowerDownAcceptance.checkedReplay (D p) (p.T * D p)
                  (4 * rate.n) 0 ⟨(0, message.val.q), 0⟩ (physicalInput.take k) = .ok middle ∧
                ActiveFollowerDownAcceptance.replay_register_domain (D p) (p.T * D p) middle ∧
                middle.registers = QueueReplay.replay (4 * rate.n) (0, message.val.q)
                  (physicalInput.take k)) ∧
              (after = ({ logged with
                lastDown := some message
                S := registers.1
                delta := lastService
                backlog := registers.2
                status := if scan.endpoint =
                  ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
                    hspan hmode).records[j.val].output.preparation.followers.followers i).time.val + 2
                  then .pending else .unoccupied
                downBatch := (ActiveFollowerDownAcceptance.currentDecodeStep p i
                  ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
                    hspan hmode).records[j.val].output.preparation.followers.followers i).row
                  ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
                    hspan hmode).records[j.val].output.preparation.followers.followers i).time
                  ((ReferenceActivePhysicalHorizon.run initial rows J rewards start count
                    hspan hmode).records[j.val].output.preparation.feedback.observations
                    (PublicDiscreteDraws.followerPlayer p.two_le_m i)) rate logged).1
                buffer := [] } : ReferencePrelaunchFollower.State p rate.eta)) := by
  dsimp only
  have hlocal := ReferenceFirstAcceptedUpNumericSnapshot.actual_launched_follower_local_invariants
    source rewards rate C_star C_h b h actual past hr hdown hclean hforce launch learnerSeed
    hlaunched i
  dsimp only at hlocal
  have hfirst := hlocal.1
  have hmode := hlocal.2.1
  intro seed memory hseed hnone hunoccupied hvalid hpair htime j message hretained hsigma
  exact actual_first_down_zero_seeded_recovery
    (ActualInitializationLaunchState.ofActualLaunchedBoundary source rewards rate
      C_star C_h b h actual past hr hdown hclean hforce launch learnerSeed hlaunched)
    source.1.2 (ActualInitializationPhysicalStep.selectedRowIndex p source) rewards
    (BootstrapObservedFollower.blockStop p (ReferenceInitializationRun.nextBlock b h))
    (p.T - BootstrapObservedFollower.blockStop p (ReferenceInitializationRun.nextBlock b h))
    (by dsimp [BootstrapObservedFollower.blockStop]; omega) hmode hfirst i seed memory
    hseed hnone hunoccupied hvalid hpair htime j message hretained hsigma

end ActualLaunch


end Bandits.Support.ReferenceFirstDownZeroRecovery

