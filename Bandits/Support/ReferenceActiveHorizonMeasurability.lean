/-- The existing total reward of `H.run`, as the finite sum of the original
typed own-observation values over its actual chronological records. -/
def runTotalReward (start count : ℕ) (hspan : start + count ≤ p.T)
    (input : ActiveRunInput (p := p) (rate := rate) start) : ℝ :=
  (runOfInput start count hspan input).totalReward

private theorem measurable_observationValue :
    Measurable (ReferenceActivePhysicalHorizon.observationValue (p := p)) := by
  exact measurable_subtype_coe.comp measurable_subtype_coe

/-- Joint Borel measurability of the finite sum of actual own observations. -/
theorem measurable_runTotalReward (start count : ℕ)
    (hspan : start + count ≤ p.T) : Measurable (runTotalReward (p := p) (rate := rate)
      start count hspan) := by
  induction count with
  | zero =>
      have heq : runTotalReward (p := p) (rate := rate) start 0 hspan = fun _ => 0 := by
        funext input
        simp [runTotalReward, runOfInput, ReferenceActivePhysicalHorizon.Run.totalReward,
          ReferenceActivePhysicalHorizon.run_zero_records]
      rw [heq]
      exact measurable_const
  | succ count ih =>
      have hprevSpan : start + count ≤ p.T := by omega
      have hprev := ih hprevSpan
      have hinput := measurable_roundInputAt (p := p) (rate := rate) (start := start)
        (count := count) hspan
        (measurable_runObservation (p := p) (rate := rate) start count hprevSpan)
      let inputAt (input : ActiveRunInput (p := p) (rate := rate) start) :=
        ReferenceActivePhysicalHorizon.roundInputAt input.val.1 input.val.2.1
          input.val.2.2.1 input.val.2.2.2 start input.property
          (runOfInput start count hprevSpan input)
          ⟨start + count, by omega, by omega⟩
      have hown := ReferenceActiveStepCompositionMeasurability.measurable_stepOwnEntries.comp hinput
      have hvalue (player : Fin p.m) : Measurable (fun input : ActiveRunInput
          (p := p) (rate := rate) start =>
            ReferenceActivePhysicalHorizon.observationValue (p := p)
              ((ReferenceActivePhysicalStep.step (inputAt input)).ownEntries player).2) := by
        exact measurable_observationValue.comp
          (measurable_snd.comp ((measurable_pi_apply player).comp hown))
      have hround : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
          ReferenceActivePhysicalHorizon.RoundRecord.totalReward
            ⟨inputAt input, ReferenceActivePhysicalStep.step (inputAt input), rfl⟩) := by
        change Measurable (fun input =>
          ∑ player : Fin p.m, ReferenceActivePhysicalHorizon.observationValue
            ((ReferenceActivePhysicalStep.step (inputAt input)).ownEntries player).2)
        exact Finset.measurable_fun_sum Finset.univ (fun player _ => hvalue player)
      have hrunEq (input : ActiveRunInput (p := p) (rate := rate) start) :
          runOfInput start (count + 1) hspan input =
            ReferenceActivePhysicalHorizon.foldRound input.val.1 input.val.2.1
              input.val.2.2.1 input.val.2.2.2 start input.property
              (runOfInput start count hprevSpan input)
              ⟨start + count, by omega, by omega⟩ := by
        exact ReferenceActivePhysicalHorizon.run_successor_step input.val.1 input.val.2.1
          input.val.2.2.1 input.val.2.2.2 start count hspan input.property
      have hrecordsEq (input : ActiveRunInput (p := p) (rate := rate) start) :
          (runOfInput start (count + 1) hspan input).records =
            (runOfInput start count hprevSpan input).records ++
              [⟨inputAt input, ReferenceActivePhysicalStep.step (inputAt input), rfl⟩] := by
        rw [hrunEq input]
        exact (ReferenceActivePhysicalHorizon.foldRound_equations input.val.1 input.val.2.1
          input.val.2.2.1 input.val.2.2.2 start input.property
          (runOfInput start count hprevSpan input)
          ⟨start + count, by omega, by omega⟩).2
      have heq : runTotalReward (p := p) (rate := rate) start (count + 1) hspan =
          fun input => runTotalReward (p := p) (rate := rate) start count hprevSpan input +
            ReferenceActivePhysicalHorizon.RoundRecord.totalReward
              ⟨inputAt input, ReferenceActivePhysicalStep.step (inputAt input), rfl⟩ := by
        funext input
        change ((runOfInput start (count + 1) hspan input).records.map
            ReferenceActivePhysicalHorizon.RoundRecord.totalReward).sum =
          ((runOfInput start count hprevSpan input).records.map
              ReferenceActivePhysicalHorizon.RoundRecord.totalReward).sum +
            ReferenceActivePhysicalHorizon.RoundRecord.totalReward
              ⟨inputAt input, ReferenceActivePhysicalStep.step (inputAt input), rfl⟩
        rw [hrecordsEq input]
        simp [List.map_append, List.sum_append]
      rw [heq]
      exact hprev.add hround

/-- Variable finite-calendar input: start and count vary jointly with all
original run data, restricted only by the span and all-active proofs. -/
abbrev CalendarRunInput :=
  {calendar : ℕ × (ℕ × RunData (p := p) (rate := rate)) //
    calendar.1 + calendar.2.1 ≤ p.T ∧
      ReferenceActivePhysicalHorizon.allActiveAtStart calendar.2.2.1 calendar.1}

/-- Countable legitimate tags, each carrying the actual finite-span proof. -/
abbrev CalendarTag := {tag : ℕ × ℕ // tag.1 + tag.2 ≤ p.T}

def calendarTagValue (input : CalendarRunInput (p := p) (rate := rate)) : ℕ × ℕ :=
  (input.val.1, input.val.2.1)

def calendarFiberSet (tag : CalendarTag (p := p)) :
    Set (CalendarRunInput (p := p) (rate := rate)) :=
  {input | calendarTagValue input = tag.val}

abbrev CalendarFiber (tag : CalendarTag (p := p)) :=
  ↥(calendarFiberSet (p := p) (rate := rate) tag)

private theorem measurable_calendarTagValue : Measurable
    (calendarTagValue (p := p) (rate := rate)) := by
  exact (measurable_fst.comp measurable_subtype_coe).prodMk
    (measurable_fst.comp (measurable_snd.comp measurable_subtype_coe))

theorem measurableSet_calendarFiberSet (tag : CalendarTag (p := p)) :
    MeasurableSet (calendarFiberSet (p := p) (rate := rate) tag) := by
  exact (measurableSet_singleton tag.val).preimage measurable_calendarTagValue

def calendarFiberFixedInput (tag : CalendarTag (p := p))
    (fiber : CalendarFiber (p := p) (rate := rate) tag) :
    ActiveRunInput (p := p) (rate := rate) tag.val.1 :=
  ⟨fiber.val.val.2.2, by
    have hstart := congrArg Prod.fst fiber.property
    rw [ReferenceActivePhysicalHorizon.allActiveAtStart]
    rw [← hstart]
    exact fiber.val.property.2⟩

private theorem measurable_calendarFiberFixedInput
    (tag : CalendarTag (p := p)) :
    Measurable (calendarFiberFixedInput (p := p) (rate := rate) tag) := by
  have hdata : Measurable (fun fiber : CalendarFiber (p := p) (rate := rate) tag =>
      fiber.val.val.2.2) :=
    measurable_snd.comp (measurable_snd.comp
      (measurable_subtype_coe.comp measurable_subtype_coe))
  exact hdata.subtype_mk

def calendarFiberRunObservation (tag : CalendarTag (p := p))
    (fiber : CalendarFiber (p := p) (rate := rate) tag) :
    RunObservationCode (p := p) (rate := rate) :=
  runObservation tag.val.1 tag.val.2 tag.property
    (calendarFiberFixedInput (p := p) (rate := rate) tag fiber)

theorem calendarFiberRunObservation_agrees
    (left right : CalendarTag (p := p))
    (input : CalendarRunInput (p := p) (rate := rate))
    (hleft : input ∈ calendarFiberSet (p := p) (rate := rate) left)
    (hright : input ∈ calendarFiberSet (p := p) (rate := rate) right) :
    calendarFiberRunObservation (p := p) (rate := rate) left ⟨input, hleft⟩ =
      calendarFiberRunObservation (p := p) (rate := rate) right ⟨input, hright⟩ := by
  have htag : left = right := Subtype.ext (hleft.symm.trans hright)
  subst right
  rfl

theorem calendarFiberSet_cover :
    (⋃ tag : CalendarTag (p := p),
      calendarFiberSet (p := p) (rate := rate) tag) = Set.univ := by
  ext input
  constructor
  · intro _
    simp
  · intro _
    refine Set.mem_iUnion.mpr ⟨⟨calendarTagValue input, input.property.1⟩, ?_⟩
    rfl

/-- Countable tag gluing of the same actual fixed-calendar `H.run` code. Each
tag is a genuine `(start,count)` pair with its span proof; no clipped or
out-of-range branch is introduced. -/
noncomputable def calendarRunObservation
    (input : CalendarRunInput (p := p) (rate := rate)) :
    RunObservationCode (p := p) (rate := rate) :=
  Set.liftCover (calendarFiberSet (p := p) (rate := rate))
    (calendarFiberRunObservation (p := p) (rate := rate))
    (calendarFiberRunObservation_agrees (p := p) (rate := rate))
    (calendarFiberSet_cover (p := p) (rate := rate)) input

theorem measurable_calendarRunObservation :
    Measurable (calendarRunObservation (p := p) (rate := rate)) :=
  measurable_liftCover
    (calendarFiberSet (p := p) (rate := rate))
    (fun tag => measurableSet_calendarFiberSet (p := p) (rate := rate) tag)
    (calendarFiberRunObservation (p := p) (rate := rate))
    (fun tag =>
      (measurable_runObservation (p := p) (rate := rate)
        tag.val.1 tag.val.2 tag.property).comp
        (measurable_calendarFiberFixedInput (p := p) (rate := rate) tag))
    (calendarFiberRunObservation_agrees (p := p) (rate := rate))
    (calendarFiberSet_cover (p := p) (rate := rate))

theorem calendarRunObservation_eq_actual (input : CalendarRunInput (p := p) (rate := rate)) :
    calendarRunObservation (p := p) (rate := rate) input =
      runObservation input.val.1 input.val.2.1 input.property.1
        ⟨input.val.2.2, input.property.2⟩ := by
  unfold calendarRunObservation
  rw [Set.liftCover_of_mem
    (S := calendarFiberSet (p := p) (rate := rate))
    (f := calendarFiberRunObservation (p := p) (rate := rate))
    (hf := calendarFiberRunObservation_agrees (p := p) (rate := rate))
    (hS := calendarFiberSet_cover (p := p) (rate := rate))
    (i := ⟨calendarTagValue input, input.property.1⟩)
    (x := input) (by rfl)]
  rfl

/-- The original final state on the varying calendar subtype. -/
def calendarRunFinalState (input : CalendarRunInput (p := p) (rate := rate)) :=
  (ReferenceActivePhysicalHorizon.run input.val.2.2.1 input.val.2.2.2.1
    input.val.2.2.2.2.1 input.val.2.2.2.2.2 input.val.1 input.val.2.1
    input.property.1 input.property.2).finalState

theorem measurable_calendarRunFinalState :
    Measurable (calendarRunFinalState (p := p) (rate := rate)) := by
  apply measurable_comap_iff.mpr
  have hcode := measurable_fst.comp
    (measurable_calendarRunObservation (p := p) (rate := rate))
  have heq : (fun input : CalendarRunInput (p := p) (rate := rate) =>
      ReferenceActivePhysicalStepMeasurability.encodeState
        (calendarRunFinalState (p := p) (rate := rate) input)) =
      fun input => (calendarRunObservation (p := p) (rate := rate) input).1 := by
    funext input
    rw [calendarRunObservation_eq_actual]
    rfl
  change Measurable (fun input : CalendarRunInput (p := p) (rate := rate) =>
    ReferenceActivePhysicalStepMeasurability.encodeState
      (calendarRunFinalState (p := p) (rate := rate) input))
  rw [heq]
  exact hcode

