module

public import Bandits.Support.ReferenceActiveStepCompositionMeasurability
public import Bandits.Support.ReferenceActivePhysicalHorizon

/-!
# Borel observations of the actual finite active horizon

Sources: `sources/zip4/manuscript/06_interruptions.tex:235-296`,
`sources/zip4/manuscript/appendix_a_local_protocol.tex:6-14,28-64`, and
`sources/zip4/manuscript/08_main_theorem.tex:29-42`.

This module measures the existing `ReferenceActivePhysicalHorizon.run` jointly
in its original initial state, complete rows, selected row index and full grid
reward table, on the stated all-active-at-start subtype. Every chronological
record is coded from its actual time, lossless existing state code and the
canonical whole-step code. The recursion is only the zero/successor proof for
the existing horizon fold; it introduces no second run or transition.

The result is deterministic support mathematics. It does not construct launch
or initialization, establish a law or history filtration, or close any
manuscript or regret assertion.
-/

@[expose] public section

noncomputable section

open MeasureTheory
open Bandits.Support.ConstructorDimensions
open Bandits.Support.ReferenceActivePhysicalStep
open Bandits.Support.ReferenceActiveStepCompositionMeasurability
open Bandits.Support.ReferenceActivePhysicalHorizon

namespace Bandits.Support.ReferenceActiveHorizonMeasurability

abbrev Parameters := ConstructorDimensions.Parameters
abbrev RateInput := ReferenceActivePhysicalStep.RateInput

variable {p : Parameters} {rate : RateInput p}

-- This is the same countable clock-code factor used by the admitted
-- one-step composition when giving its original physical tuple a Borel
-- product space.
local instance : MeasurableSpace (CoordinatorPhaseClock.StartRoundResult p) := ⊤

/-- The unchanged complete input tuple of the postlaunch horizon. -/
abbrev RunData :=
  ReferenceActivePhysicalStep.State p rate ×
    (CompletePublicTable.CompleteRows p ×
      (Fin (M p) × ActualInitializationPhysicalStep.GridRewardTable p))

/-- Fixed calendar inputs are restricted only by the original all-active
condition at the requested start. -/
abbrev ActiveRunInput (start : ℕ) :=
  {data : RunData (p := p) (rate := rate) //
    ReferenceActivePhysicalHorizon.allActiveAtStart data.1 start}

/-- One chronological record code: its physical time, encoded pre-state and
the complete existing whole-step code on that record's original input. -/
abbrev PhysicalCode :=
  Option (ReferenceLiveDispatchOutputMeasurability.SelectionData p rate) ×
    (Option (ReferenceDownReception.ChoiceTimeView p rate.eta) ×
      (FiniteBanditModel.ActionProfile p.m p.K ×
        ((Fin p.m → Fin (D p + 1)) ×
          ReferenceCollectionServiceTailMeasurability.CollectionTailCode p rate)))

abbrev WholeStepCode := PhysicalCode (p := p) (rate := rate) ×
  ((Fin (p.m - 1) → ReferenceFollowerTailComposition.FollowerObservable p rate) ×
    ReferenceActivePhysicalStepMeasurability.StateCode p rate)

abbrev RoundRecordCode :=
  ℕ × (ReferenceActivePhysicalStepMeasurability.StateCode p rate ×
    WholeStepCode (p := p) (rate := rate))

/-- The run observation pairs the existing final state code with the literal
ordered list of actual record codes. -/
abbrev RunObservationCode :=
  ReferenceActivePhysicalStepMeasurability.StateCode p rate × List (RoundRecordCode (p := p) (rate := rate))

instance roundRecordCodeMeasurableSpace :
    MeasurableSpace (RoundRecordCode (p := p) (rate := rate)) :=
  MeasurableSpace.prod (inferInstance : MeasurableSpace ℕ)
    (MeasurableSpace.prod
      (inferInstance : MeasurableSpace
        (ReferenceActivePhysicalStepMeasurability.StateCode p rate))
      (inferInstance : MeasurableSpace (WholeStepCode (p := p) (rate := rate))))

/-- The list observation keeps its exact finite length and every indexed
element in the element's original product/sum measurable space. In particular,
continuous real fibers are not made discrete. -/
def listObservationAt {α : Type*} (records : List α) (n : ℕ) : Unit ⊕ α :=
    match records[n]? with
    | none => Sum.inl ()
    | some record => Sum.inr record

def listObservationCoordinates {α : Type*} (records : List α) :
    ℕ × (ℕ → Unit ⊕ α) :=
  (records.length, listObservationAt records)

/-- The measurable structure on a finite list is generated by its length and
all indexed, sum-tagged entries, retaining the measurable structure of `α`. -/
instance (priority := 2000) listObservationMeasurableSpace {α : Type*}
    [MeasurableSpace α] : MeasurableSpace (List α) :=
  MeasurableSpace.comap listObservationCoordinates inferInstance

instance runObservationCodeMeasurableSpace :
    MeasurableSpace (RunObservationCode (p := p) (rate := rate)) :=
  MeasurableSpace.prod
    (inferInstance : MeasurableSpace
      (ReferenceActivePhysicalStepMeasurability.StateCode p rate))
    (@listObservationMeasurableSpace (RoundRecordCode (p := p) (rate := rate))
      (roundRecordCodeMeasurableSpace (p := p) (rate := rate)))

theorem measurable_listObservationCoordinates {α : Type*} [MeasurableSpace α] :
    Measurable (listObservationCoordinates (α := α)) :=
  comap_measurable _

private def mapListObservationTag {α β : Type*} (f : α → β) : Unit ⊕ α → Unit ⊕ β
  | .inl _ => .inl ()
  | .inr value => .inr (f value)

private theorem listObservationCoordinates_map {α β : Type*} (records : List α)
    (f : α → β) :
    listObservationCoordinates (records.map f) =
      (records.length, fun n => mapListObservationTag f (listObservationAt records n)) := by
  apply Prod.ext
  · simp [listObservationCoordinates]
  · funext n
    induction records generalizing n with
    | nil => cases n <;> rfl
    | cons head tail ih =>
        cases n with
        | zero => rfl
        | succ n => exact ih n

/-- Mapping a measurable function over a finite-list observation preserves
the original element spaces and is measurable. -/
theorem measurable_list_map {X : Type*} [MeasurableSpace X]
    {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (records : X → List α) (hrecords : Measurable records)
    (f : α → β) (hf : Measurable f) :
    Measurable (fun x => (records x).map f) := by
  apply measurable_comap_iff.mpr
  have hcoordinates := measurable_listObservationCoordinates.comp hrecords
  have htag : Measurable (mapListObservationTag f) :=
    Measurable.sumElim measurable_const (measurable_inr.comp hf)
  have hstream : Measurable (fun x =>
      fun n => mapListObservationTag f (listObservationAt (records x) n)) := by
    apply measurable_pi_iff.mpr
    intro n
    exact htag.comp ((measurable_pi_apply n).comp
      (measurable_snd.comp hcoordinates))
  have hmap : Measurable (fun x =>
      listObservationCoordinates ((records x).map f)) := by
    convert (measurable_fst.comp hcoordinates).prodMk hstream using 1
    funext x
    exact listObservationCoordinates_map (records x) f
  exact hmap

private theorem measurable_list_append_singleton {X : Type*} [MeasurableSpace X]
    {α : Type*} [MeasurableSpace α] (records : X → List α)
    (hrecords : Measurable records) (n : ℕ)
    (hlen : ∀ x, (records x).length = n) (last : X → α) (hlast : Measurable last) :
    Measurable (fun x => records x ++ [last x]) := by
  apply measurable_comap_iff.mpr
  have hcoordinates := measurable_listObservationCoordinates.comp hrecords
  have hlengthEq (x : X) : (records x ++ [last x]).length = n + 1 := by
    simp [List.length_append, hlen x]
  have hlength : Measurable (fun x => (records x ++ [last x]).length) := by
    have heq : (fun x => (records x ++ [last x]).length) = fun _ => n + 1 :=
      funext hlengthEq
    rw [heq]
    exact measurable_const
  have hstream : Measurable (fun x =>
      fun k => listObservationAt (records x ++ [last x]) k) := by
    apply measurable_pi_iff.mpr
    intro k
    by_cases hkn : k < n
    · have heq (x) :
          listObservationAt (records x ++ [last x]) k = listObservationAt (records x) k := by
        have hk : k < (records x).length := by rw [hlen x]; exact hkn
        simp only [listObservationAt]
        rw [List.getElem?_append_left hk]
      have heqFun : (fun x => listObservationAt (records x ++ [last x]) k) =
          fun x => listObservationAt (records x) k := funext heq
      rw [heqFun]
      exact (measurable_pi_apply k).comp (measurable_snd.comp hcoordinates)
    · by_cases hkeq : k = n
      · have heq (x) :
            listObservationAt (records x ++ [last x]) k = Sum.inr (last x) := by
          subst k
          have hk : (records x).length ≤ n := by rw [hlen x]
          simp only [listObservationAt]
          rw [List.getElem?_append_right hk]
          simp [hlen x]
        have heqFun : (fun x => listObservationAt (records x ++ [last x]) k) =
            fun x => Sum.inr (last x) := funext heq
        rw [heqFun]
        exact measurable_inr.comp hlast
      · have hnk : n < k := by omega
        have heq (x) :
            listObservationAt (records x ++ [last x]) k = Sum.inl () := by
          have hk : (records x).length ≤ k := by rw [hlen x]; omega
          have hindex : 1 ≤ k - (records x).length := by rw [hlen x]; omega
          simp only [listObservationAt]
          rw [List.getElem?_append_right hk]
          rw [List.getElem?_eq_none (by simpa using hindex)]
        have heqFun : (fun x => listObservationAt (records x ++ [last x]) k) =
            fun _ => Sum.inl () := funext heq
        rw [heqFun]
        exact measurable_const
  convert hlength.prodMk hstream using 1
  funext x
  exact Prod.ext (by simp [listObservationCoordinates, hlen x]) (funext fun k => rfl)

/-- The exact retained code for one record of the original run. -/
def roundRecordCode (record : ReferenceActivePhysicalHorizon.RoundRecord (p := p) (rate := rate)) :
    RoundRecordCode (p := p) (rate := rate) :=
  (record.input.time.val,
    (ReferenceActivePhysicalStepMeasurability.encodeState record.input.state,
      ReferenceActiveStepCompositionMeasurability.wholeStepCode record.input))

/-- Action profile retained in a whole-step record code. -/
def roundRecordCodeActions (code : RoundRecordCode (p := p) (rate := rate)) :
    Fin p.m → Fin p.K := code.2.2.1.2.2.1

/-- Full grid-feedback profile retained in a whole-step record code. -/
def roundRecordCodeFeedback (code : RoundRecordCode (p := p) (rate := rate)) :
    Fin p.m → Fin (D p + 1) := code.2.2.1.2.2.2.1

/-- A player's complete typed own entry reconstructed from the retained
simultaneous arm and collision-sensitive grid feedback. -/
def roundRecordCodeOwnEntry (code : RoundRecordCode (p := p) (rate := rate))
    (player : Fin p.m) : Fin p.K × ReferencePrelaunchFollower.Observation p :=
  (roundRecordCodeActions code player,
    ActualInitializationPhysicalStep.observationOfGrid p
      (roundRecordCodeFeedback code player))

theorem roundRecordCode_front
    (record : ReferenceActivePhysicalHorizon.RoundRecord (p := p) (rate := rate)) :
    (roundRecordCode record).2.2.1.1 =
        (ReferenceActivePhysicalStep.dispatch record.input).selection.map
          ReferenceLiveDispatchOutputMeasurability.encodeSelection ∧
      (roundRecordCode record).2.2.1.2.1 =
        (ReferenceActivePhysicalStep.dispatch record.input).downView ∧
      roundRecordCodeActions (roundRecordCode record) = record.actions ∧
      roundRecordCodeFeedback (roundRecordCode record) = record.gridFeedback := by
  have hfront := ReferenceActiveStepCompositionMeasurability.wholeStepCode_front record.input
  refine ⟨hfront.1, hfront.2.1, ?_, ?_⟩
  · change (ReferenceActivePhysicalStep.prepare record.input).arms.actions =
      record.output.preparation.arms.actions
    have hout := congrArg
      (fun output : ReferenceActivePhysicalStep.RoundOutput record.input =>
        output.preparation.arms.actions) record.output_eq
    exact hout.symm
  · change (ReferenceActivePhysicalStep.prepare record.input).feedback.feedback =
      record.output.preparation.feedback.feedback
    have hout := congrArg
      (fun output : ReferenceActivePhysicalStep.RoundOutput record.input =>
        output.preparation.feedback.feedback) record.output_eq
    exact hout.symm

/-- Every stored code field decodes to the same original record and its
literal output. The coordinator and follower decoders retain their complete
failure and UP/DOWN diagnostic observations; the state decoder retains all
original continuous buffers and banks. -/
theorem roundRecordCode_reconstructs
    (record : ReferenceActivePhysicalHorizon.RoundRecord (p := p) (rate := rate)) :
    ReferenceActivePhysicalStepMeasurability.decodeState (roundRecordCode record).2.1 =
        record.input.state ∧
      ReferenceCollectionServiceTailMeasurability.decodeCollectionObservation
        (roundRecordCode record).2.2.1.2.2.2.2 = record.coordinatorDiagnostics ∧
      (∀ i, ReferenceFollowerTailComposition.reconstructFollowerObservable
        ((roundRecordCode record).2.2.2.1 i) = record.followerDiagnostics i) ∧
      ReferenceActivePhysicalStepMeasurability.decodeState (roundRecordCode record).2.2.2.2 =
        record.output.next ∧
      (∀ player, roundRecordCodeOwnEntry (roundRecordCode record) player =
        record.ownEntries player) := by
  have hwhole := ReferenceActiveStepCompositionMeasurability.wholeStepCode_reconstructs
    record.input
  refine ⟨ReferenceActivePhysicalStepMeasurability.decodeState_encodeState _, ?_, ?_, ?_, ?_⟩
  · calc
      ReferenceCollectionServiceTailMeasurability.decodeCollectionObservation
          (ReferenceActiveStepCompositionMeasurability.wholeStepCode record.input).1.2.2.2.2 =
          (ReferenceActivePhysicalStep.prepare record.input).observeCoordinator := hwhole.1
      _ = record.coordinatorDiagnostics := by
        change (ReferenceActivePhysicalStep.prepare record.input).observeCoordinator =
          record.output.coordinator
        have hout := congrArg
          (fun output : ReferenceActivePhysicalStep.RoundOutput record.input => output.coordinator)
          record.output_eq
        exact hout.symm
  · intro i
    calc
      ReferenceFollowerTailComposition.reconstructFollowerObservable
          ((ReferenceActiveStepCompositionMeasurability.wholeStepCode record.input).2.1 i) =
          (ReferenceActivePhysicalStep.prepare record.input).observeFollower i := hwhole.2.1 i
      _ = record.followerDiagnostics i := by
        change (ReferenceActivePhysicalStep.prepare record.input).observeFollower i =
          record.output.followers i
        have hout := congrArg
          (fun output : ReferenceActivePhysicalStep.RoundOutput record.input => output.followers i)
          record.output_eq
        exact hout.symm
  · calc
      ReferenceActivePhysicalStepMeasurability.decodeState
          (ReferenceActiveStepCompositionMeasurability.wholeStepCode record.input).2.2 =
          (ReferenceActivePhysicalStep.step record.input).next := hwhole.2.2
      _ = record.output.next := by
        have hout := congrArg
          (fun output : ReferenceActivePhysicalStep.RoundOutput record.input => output.next)
          record.output_eq
        exact hout.symm
  · intro player
    calc
      roundRecordCodeOwnEntry (roundRecordCode record) player =
          (ReferenceActivePhysicalStep.step record.input).ownEntries player := by
        change ((ReferenceActiveStepCompositionMeasurability.wholeStepCode record.input).1.2.2.1 player,
          ActualInitializationPhysicalStep.observationOfGrid p
            ((ReferenceActiveStepCompositionMeasurability.wholeStepCode record.input).1.2.2.2.1 player)) = _
        exact ReferenceActiveStepCompositionMeasurability.wholeStepCode_ownEntry
          record.input player
      _ = record.ownEntries player := by
        change (ReferenceActivePhysicalStep.step record.input).ownEntries player =
          record.output.ownEntries player
        have hout := congrArg
          (fun output : ReferenceActivePhysicalStep.RoundOutput record.input => output.ownEntries player)
          record.output_eq
        exact hout.symm

/-- The literal existing run from a fixed active boundary. -/
def runOfInput (start count : ℕ) (hspan : start + count ≤ p.T)
    (input : ActiveRunInput (p := p) (rate := rate) start) :
    ReferenceActivePhysicalHorizon.Run input.val.1 :=
  ReferenceActivePhysicalHorizon.run input.val.1 input.val.2.1 input.val.2.2.1
    input.val.2.2.2 start count hspan input.property

/-- Product/list observation of that same existing run. -/
def runObservation (start count : ℕ) (hspan : start + count ≤ p.T)
    (input : ActiveRunInput (p := p) (rate := rate) start) :
    RunObservationCode (p := p) (rate := rate) :=
  (ReferenceActivePhysicalStepMeasurability.encodeState
      (runOfInput start count hspan input).finalState,
    (runOfInput start count hspan input).records.map roundRecordCode)

theorem runObservation_records (start count : ℕ) (hspan : start + count ≤ p.T)
    (input : ActiveRunInput (p := p) (rate := rate) start) :
    (runObservation start count hspan input).2 =
      (runOfInput start count hspan input).records.map roundRecordCode := rfl

/-- The literal observation list contains one entry for every physical round,
including zero-count horizons. -/
theorem runObservation_recordCount (start count : ℕ)
    (hspan : start + count ≤ p.T)
    (input : ActiveRunInput (p := p) (rate := rate) start) :
    (runObservation start count hspan input).2.length = count := by
  simp only [runObservation, List.length_map]
  exact ReferenceActivePhysicalHorizon.run_record_count input.val.1 input.val.2.1
    input.val.2.2.1 input.val.2.2.2 start count hspan input.property

/-- Record timestamps enumerate the requested half-open calendar interval in
chronological order, with no action at a terminal sentinel. -/
theorem runObservation_times (start count : ℕ)
    (hspan : start + count ≤ p.T)
    (input : ActiveRunInput (p := p) (rate := rate) start) :
    ((runObservation start count hspan input).2.map Prod.fst) =
      ReferenceActivePhysicalHorizon.calendar start count := by
  change ((runOfInput start count hspan input).records.map roundRecordCode).map Prod.fst = _
  rw [List.map_map]
  change (runOfInput start count hspan input).records.map
      (fun record => record.input.time.val) = _
  exact ReferenceActivePhysicalHorizon.run_time_values input.val.1 input.val.2.1
    input.val.2.2.1 input.val.2.2.2 start count hspan input.property

theorem runObservation_finalState (start count : ℕ) (hspan : start + count ≤ p.T)
    (input : ActiveRunInput (p := p) (rate := rate) start) :
    ReferenceActivePhysicalStepMeasurability.decodeState
        (runObservation start count hspan input).1 =
      (runOfInput start count hspan input).finalState :=
  ReferenceActivePhysicalStepMeasurability.decodeState_encodeState _

private theorem measurable_roundInputAt {start count : ℕ}
    (hspan : start + (count + 1) ≤ p.T)
    (hrun : Measurable (runObservation (p := p) (rate := rate) start count (by omega))) :
    Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      ReferenceActivePhysicalHorizon.roundInputAt input.val.1 input.val.2.1
        input.val.2.2.1 input.val.2.2.2 start input.property
        (runOfInput start count (by omega) input)
        ⟨start + count, by omega, by omega⟩) := by
  let time : Fin p.T := ⟨start + count, by omega⟩
  have hdata : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      input.val) := measurable_subtype_coe
  have hinitial : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      input.val.1) := measurable_fst.comp hdata
  have hrows : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      input.val.2.1) := measurable_fst.comp (measurable_snd.comp hdata)
  have hselected : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      input.val.2.2.1) := measurable_fst.comp
        (measurable_snd.comp (measurable_snd.comp hdata))
  have hrewards : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      input.val.2.2.2) := measurable_snd.comp
        (measurable_snd.comp (measurable_snd.comp hdata))
  have hruncode := measurable_fst.comp hrun
  have hfinal : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      (runOfInput start count (by omega) input).finalState) := by
    apply measurable_comap_iff.mpr
    exact hruncode
  have hstate := hfinal
  have hcoordinates : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      ((runOfInput start count (by omega) input).finalState,
        (input.val.2.1,
          (input.val.2.2.1, (time, input.val.2.2.2))))) := by
    exact hstate.prodMk (hrows.prodMk (hselected.prodMk
      (measurable_const.prodMk hrewards)))
  have hencoded : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      ReferenceActivePhysicalStepMeasurability.encodeRoundInput
        (ReferenceActivePhysicalHorizon.roundInputAt input.val.1 input.val.2.1
          input.val.2.2.1 input.val.2.2.2 start input.property
          (runOfInput start count (by omega) input)
          ⟨start + count, by omega, by omega⟩)) := by
    exact hcoordinates.subtype_mk (h := fun input =>
      (ReferenceActivePhysicalHorizon.roundInputAt input.val.1 input.val.2.1
        input.val.2.2.1 input.val.2.2.2 start input.property
        (runOfInput start count (by omega) input)
        ⟨start + count, by omega, by omega⟩).active)
  apply measurable_comap_iff.mpr
  exact hencoded

/-- Joint Borel measurability of the final state code and every chronological
complete observation code, on the entire fixed-start/count all-active domain. -/
theorem measurable_runObservation (start count : ℕ)
    (hspan : start + count ≤ p.T) :
    Measurable (runObservation (p := p) (rate := rate) start count hspan) := by
  induction count with
  | zero =>
      have heq : runObservation (p := p) (rate := rate) start 0 hspan =
          fun input =>
            (ReferenceActivePhysicalStepMeasurability.encodeState input.val.1, []) := by
        funext input
        simp [runObservation, runOfInput,
          ReferenceActivePhysicalHorizon.run_zero_final,
          ReferenceActivePhysicalHorizon.run_zero_records]
      rw [heq]
      exact (ReferenceActivePhysicalStepMeasurability.measurable_encodeState.comp
        (measurable_fst.comp measurable_subtype_coe)).prodMk measurable_const
  | succ count ih =>
      have hprevSpan : start + count ≤ p.T := by omega
      have hprev := ih hprevSpan
      have hinput := measurable_roundInputAt (p := p) (rate := rate) (start := start)
        (count := count) hspan hprev
      let inputAt (input : ActiveRunInput (p := p) (rate := rate) start) :=
        ReferenceActivePhysicalHorizon.roundInputAt input.val.1 input.val.2.1
          input.val.2.2.1 input.val.2.2.2 start input.property
          (runOfInput start count hprevSpan input)
          ⟨start + count, by omega, by omega⟩
      have hnextCode : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
          ReferenceActivePhysicalStepMeasurability.encodeState
            (ReferenceActivePhysicalStep.step (inputAt input)).next) :=
        (ReferenceActivePhysicalStepMeasurability.measurable_encodeState.comp
          (ReferenceActiveStepCompositionMeasurability.measurable_stepNext.comp hinput))
      have hlastCode : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
          roundRecordCode ⟨inputAt input, ReferenceActivePhysicalStep.step (inputAt input), rfl⟩) := by
        have htime : Measurable (fun _ : ActiveRunInput (p := p) (rate := rate) start =>
            (start + count)) := measurable_const
        have hstate := ReferenceActivePhysicalStepMeasurability.measurable_encodeState.comp
          (ReferenceActivePhysicalStepMeasurability.measurable_state.comp hinput)
        have hwhole :=
          ReferenceActiveStepCompositionMeasurability.measurable_wholeStepCode.comp hinput
        change Measurable (fun input =>
          ((start + count),
            (ReferenceActivePhysicalStepMeasurability.encodeState (inputAt input).state,
              ReferenceActiveStepCompositionMeasurability.wholeStepCode (inputAt input))))
        exact htime.prodMk (hstate.prodMk hwhole)
      have hprevCodes := measurable_snd.comp hprev
      have hlen : ∀ input : ActiveRunInput (p := p) (rate := rate) start,
          ((runOfInput start count hprevSpan input).records.map roundRecordCode).length = count := by
        intro input
        simp only [List.length_map]
        exact ReferenceActivePhysicalHorizon.run_record_count input.val.1 input.val.2.1
          input.val.2.2.1 input.val.2.2.2 start count hprevSpan input.property
      have hrecords := measurable_list_append_singleton
        (fun input : ActiveRunInput (p := p) (rate := rate) start =>
          (runOfInput start count hprevSpan input).records.map roundRecordCode)
        hprevCodes count hlen
        (fun input => roundRecordCode ⟨inputAt input,
          ReferenceActivePhysicalStep.step (inputAt input), rfl⟩) hlastCode
      have hrunEq (input : ActiveRunInput (p := p) (rate := rate) start) :
          runOfInput start (count + 1) hspan input =
            ReferenceActivePhysicalHorizon.foldRound input.val.1 input.val.2.1
              input.val.2.2.1 input.val.2.2.2 start input.property
              (runOfInput start count hprevSpan input)
              ⟨start + count, by omega, by omega⟩ := by
        exact ReferenceActivePhysicalHorizon.run_successor_step input.val.1 input.val.2.1
          input.val.2.2.1 input.val.2.2.2 start count hspan input.property
      have hfold (input : ActiveRunInput (p := p) (rate := rate) start) :=
        ReferenceActivePhysicalHorizon.foldRound_equations input.val.1 input.val.2.1
          input.val.2.2.1 input.val.2.2.2 start input.property
          (runOfInput start count hprevSpan input)
          ⟨start + count, by omega, by omega⟩
      have hfinalEq (input : ActiveRunInput (p := p) (rate := rate) start) :
          (runOfInput start (count + 1) hspan input).finalState =
            (ReferenceActivePhysicalStep.step (inputAt input)).next := by
        rw [hrunEq input]
        exact (hfold input).1
      have hrecordsEq (input : ActiveRunInput (p := p) (rate := rate) start) :
          (runOfInput start (count + 1) hspan input).records =
            (runOfInput start count hprevSpan input).records ++
              [⟨inputAt input, ReferenceActivePhysicalStep.step (inputAt input), rfl⟩] := by
        rw [hrunEq input]
        exact (hfold input).2
      have hfinal : Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
          ReferenceActivePhysicalStepMeasurability.encodeState
            (runOfInput start (count + 1) hspan input).finalState) := by
        have heq : (fun input : ActiveRunInput (p := p) (rate := rate) start =>
            ReferenceActivePhysicalStepMeasurability.encodeState
              (runOfInput start (count + 1) hspan input).finalState) =
            fun input => ReferenceActivePhysicalStepMeasurability.encodeState
              (ReferenceActivePhysicalStep.step (inputAt input)).next := by
          funext input
          rw [hfinalEq input]
        rw [heq]
        exact hnextCode
      have hrecordCodes : Measurable
          (fun input : ActiveRunInput (p := p) (rate := rate) start =>
            (runOfInput start (count + 1) hspan input).records.map roundRecordCode) := by
        have heq : (fun input : ActiveRunInput (p := p) (rate := rate) start =>
            (runOfInput start (count + 1) hspan input).records.map roundRecordCode) =
            fun input =>
              (runOfInput start count hprevSpan input).records.map roundRecordCode ++
                [roundRecordCode ⟨inputAt input,
                  ReferenceActivePhysicalStep.step (inputAt input), rfl⟩] := by
          funext input
          rw [hrecordsEq input]
          simp
        rw [heq]
        exact hrecords
      exact hfinal.prodMk hrecordCodes

/-- The final state of the same existing run is Borel in its original state
measurable space, jointly over all active run data. -/
theorem measurable_runFinalState (start count : ℕ)
    (hspan : start + count ≤ p.T) :
    Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      (runOfInput start count hspan input).finalState) := by
  apply measurable_comap_iff.mpr
  exact measurable_fst.comp (measurable_runObservation start count hspan)

/-- The literal chronological own-history list for one player. -/
