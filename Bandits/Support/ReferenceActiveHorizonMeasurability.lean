/-- The same original horizon total reward on varying legitimate calendar
inputs. -/
def calendarRunTotalReward (input : CalendarRunInput (p := p) (rate := rate)) : ℝ :=
  (ReferenceActivePhysicalHorizon.run input.val.2.2.1 input.val.2.2.2.1
    input.val.2.2.2.2.1 input.val.2.2.2.2.2 input.val.1 input.val.2.1
    input.property.1 input.property.2).totalReward

theorem measurable_calendarRunTotalReward :
    Measurable (calendarRunTotalReward (p := p) (rate := rate)) := by
  let fiberReward (tag : CalendarTag (p := p))
      (fiber : CalendarFiber (p := p) (rate := rate) tag) : ℝ :=
    (runOfInput tag.val.1 tag.val.2 tag.property
      (calendarFiberFixedInput (p := p) (rate := rate) tag fiber)).totalReward
  let agree : ∀ (left right : CalendarTag (p := p))
      (input : CalendarRunInput (p := p) (rate := rate))
      (hleft : input ∈ calendarFiberSet (p := p) (rate := rate) left)
      (hright : input ∈ calendarFiberSet (p := p) (rate := rate) right),
      fiberReward left ⟨input, hleft⟩ = fiberReward right ⟨input, hright⟩ := by
    intro left right input hleft hright
    have htag : left = right := Subtype.ext (hleft.symm.trans hright)
    subst right
    have hproof : hleft = hright := Subsingleton.elim _ _
    cases hproof
    rfl
  have hglue : Measurable (Set.liftCover
      (calendarFiberSet (p := p) (rate := rate)) fiberReward agree
      (calendarFiberSet_cover (p := p) (rate := rate))) := by
    exact measurable_liftCover
      (calendarFiberSet (p := p) (rate := rate))
      (fun tag => measurableSet_calendarFiberSet (p := p) (rate := rate) tag)
      fiberReward
      (fun tag =>
        (measurable_runTotalReward (p := p) (rate := rate)
          tag.val.1 tag.val.2 tag.property).comp
          (measurable_calendarFiberFixedInput (p := p) (rate := rate) tag))
      agree (calendarFiberSet_cover (p := p) (rate := rate))
  have heq : Set.liftCover
      (calendarFiberSet (p := p) (rate := rate)) fiberReward agree
      (calendarFiberSet_cover (p := p) (rate := rate)) =
      calendarRunTotalReward (p := p) (rate := rate) := by
    funext input
    rw [Set.liftCover_of_mem
      (S := calendarFiberSet (p := p) (rate := rate))
      (f := fiberReward) (hf := agree)
      (hS := calendarFiberSet_cover (p := p) (rate := rate))
      (i := ⟨calendarTagValue input, input.property.1⟩)
      (x := input) (by rfl)]
    rfl
  rw [← heq]
  exact hglue

end Bandits.Support.ReferenceActiveHorizonMeasurability

