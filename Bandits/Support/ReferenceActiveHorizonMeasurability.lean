        roundRecordCodeActions := by
    funext input
    simp only [runActionHistory, runObservation, runOfInput, List.map_map]
    apply List.map_congr_left
    intro record hrecord
    exact (roundRecordCode_front record).2.2.1.symm
  rw [heq]
  exact hmap

theorem measurable_runFeedbackHistory (start count : ℕ)
    (hspan : start + count ≤ p.T) :
    Measurable (runFeedbackHistory (p := p) (rate := rate) start count hspan) := by
  have hcodes := measurable_snd.comp
