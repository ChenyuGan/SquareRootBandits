theorem measurable_roundRecordCodeOwnEntry (player : Fin p.m) :
    Measurable (fun code : RoundRecordCode (p := p) (rate := rate) =>
      roundRecordCodeOwnEntry code player) := by
  have hphysical : Measurable (fun code : RoundRecordCode (p := p) (rate := rate) =>
      code.2.2.1) :=
    measurable_fst.comp (measurable_snd.comp (measurable_snd.comp measurable_id))
  have hactions : Measurable (fun code => roundRecordCodeActions code player) :=
    (measurable_pi_apply player).comp
      (measurable_fst.comp (measurable_snd.comp (measurable_snd.comp hphysical)))
  have hfeedback : Measurable (fun code => roundRecordCodeFeedback code player) :=
    (measurable_pi_apply player).comp
      (measurable_fst.comp (measurable_snd.comp (measurable_snd.comp
        (measurable_snd.comp hphysical))))
  have hobs : Measurable (fun code : RoundRecordCode (p := p) (rate := rate) =>
      ActualInitializationPhysicalStep.observationOfGrid p
        (roundRecordCodeFeedback code player)) :=
    (measurable_of_countable fun grid : Fin (D p + 1) =>
      ActualInitializationPhysicalStep.observationOfGrid p grid).comp hfeedback
  exact hactions.prodMk hobs

theorem measurable_runOwnHistory (start count : ℕ)
    (hspan : start + count ≤ p.T) (player : Fin p.m) :
    Measurable (fun input : ActiveRunInput (p := p) (rate := rate) start =>
      runOwnHistory (p := p) (rate := rate) start count hspan input player) := by
  have hcodes := measurable_snd.comp
    (measurable_runObservation (p := p) (rate := rate) start count hspan)
  have hmap := measurable_list_map
    (records := fun input : ActiveRunInput (p := p) (rate := rate) start =>
      (runOfInput start count hspan input).records.map roundRecordCode)
    hcodes (fun code => roundRecordCodeOwnEntry code player)
    (measurable_roundRecordCodeOwnEntry player)
  have heq : (fun input =>
      runOwnHistory (p := p) (rate := rate) start count hspan input player) =
      fun input => ((runObservation start count hspan input).2).map
        (fun code => roundRecordCodeOwnEntry code player) := by
    funext input
    simp only [runOwnHistory, runObservation, runOfInput, List.map_map]
    apply List.map_congr_left
    intro record hrecord
    exact ((roundRecordCode_reconstructs record).2.2.2.2 player).symm
  rw [heq]
  exact hmap

theorem measurable_runActionHistory (start count : ℕ)
    (hspan : start + count ≤ p.T) :
    Measurable (runActionHistory (p := p) (rate := rate) start count hspan) := by
  have hcodes := measurable_snd.comp
    (measurable_runObservation (p := p) (rate := rate) start count hspan)
  have hcode : Measurable (fun code : RoundRecordCode (p := p) (rate := rate) =>
      roundRecordCodeActions code) := by
    have hphysical : Measurable (fun code : RoundRecordCode (p := p) (rate := rate) =>
        code.2.2.1) :=
      measurable_fst.comp (measurable_snd.comp (measurable_snd.comp measurable_id))
    exact measurable_fst.comp (measurable_snd.comp (measurable_snd.comp hphysical))
  have hmap := measurable_list_map
    (records := fun input : ActiveRunInput (p := p) (rate := rate) start =>
      (runOfInput start count hspan input).records.map roundRecordCode)
    hcodes (fun code => roundRecordCodeActions code) hcode
  have heq : runActionHistory (p := p) (rate := rate) start count hspan =
