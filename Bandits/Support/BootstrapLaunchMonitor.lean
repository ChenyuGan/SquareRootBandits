/-!
# Coordinator bootstrap launch monitor

This module replays the coordinator's cumulative DOWN-positive counters and
block-boundary launch test from one true complete row and an explicitly
supplied rounded local observation history.  It does not construct physical
feedback or assert that the supplied history is generated by an execution.
Sources: `sources/zip4/manuscript/07_public_setup.tex:40-55,98-113,129-144`
and `sources/zip4/manuscript/appendix_b_communication.tex:97-99,640-689`.
-/

@[expose] public section

noncomputable section

open scoped BigOperators

namespace Bandits.Support.BootstrapLaunchMonitor

open Bandits.Support.ConstructorDimensions
open Bandits.Support.BootstrapDimensions
open Bandits.Support.BootstrapStartupCostScale
open Bandits.Support.CompletePublicTable
open Bandits.Support.ContinuousLearningRows
open Bandits.Support.FiniteBanditModel
open Bandits.Support.OrderedTupleSampler
open Bandits.Support.ProductSetLaw
open Bandits.Support.PublicDiscreteDraws

abbrev Parameters := ConstructorDimensions.Parameters

/-- A supplied local coordinator history whose observations lie on the source
`D`-grid.  Its arm coordinate is retained as local-history data, but the
monitor credits the true row's ordered-tuple arm instead. -/
structure RoundedCoordinatorHistory (p : Parameters) where
  localHistory : FiniteBanditModel.LocalHistory p.K p.T
  observation_on_grid : ∀ t,
    ∃ q : Fin (D p + 1),
      (localHistory t).2 = (q.val : ℝ) / (D p : ℝ)

/-- Every supplied rounded observation is in the source interval `[0,1]`. -/
theorem roundedCoordinatorObservation_mem_Icc (p : Parameters)
    (h : RoundedCoordinatorHistory p) (t : Fin p.T) :
    (h.localHistory t).2 ∈ Set.Icc (0 : ℝ) 1 := by
  obtain ⟨q, hq⟩ := h.observation_on_grid t
  have hD : (0 : ℝ) < (D p : ℝ) := by
    exact_mod_cast ConstructorDimensions.D_pos p
  have hqle : q.val ≤ D p := by omega
  have hqR : (q.val : ℝ) ≤ (D p : ℝ) := by exact_mod_cast hqle
  rw [hq]
  constructor
  · positivity
  · exact (div_le_one hD).2 hqR

/-- The true row's source slot at a calendar round, read from its accepted
continuous slice. -/
def trueCoordinatorSlot (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (t : Fin p.T) :
    PublicDiscreteDraws.Slot :=
  PublicDiscreteDraws.slotDraw
    (ContinuousLearningRows.sliceAt t (CompletePublicTable.completeRowLearning p row))

/-- The actual labelled coordinator arm `R_{0,t}` from the row's ordered
without-replacement tuple. -/
def trueCoordinatorArm (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (t : Fin p.T) : Fin p.K :=
  (OrderedTupleSampler.sample p.two_le_m p.m_lt_K
    (ContinuousLearningRows.sliceAt t (CompletePublicTable.completeRowLearning p row))).val
      ⟨0, ConstructorDimensions.m_pos p⟩

/-- The unique arm credited by one coordinator observation, if and only if the
true row slot is DOWN and the supplied local rounded observation is positive.
The local-history arm coordinate is deliberately not used. -/
def positiveDownArm (p : Parameters)
    (row : CompletePublicTable.CompleteRow p)
    (h : RoundedCoordinatorHistory p) (t : Fin p.T) : Option (Fin p.K) :=
  if trueCoordinatorSlot p row t = PublicDiscreteDraws.downSlot ∧
      0 < (h.localHistory t).2 then
    some (trueCoordinatorArm p row t)
  else none

/-- The cumulative count of a particular arm among a finite set of calendar
rounds, using only true-row DOWN slots and supplied local observations. -/
def countOnRounds (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (rounds : Finset (Fin p.T)) (a : Fin p.K) : ℕ :=
  ∑ t ∈ rounds, if positiveDownArm p row h t = some a then 1 else 0

/-- The counter vector after one supplied DOWN-positive observation. -/
def creditCounter {K : ℕ} (c : Fin K → ℕ) (arm? : Option (Fin K)) :
    Fin K → ℕ :=
  fun a => c a + if arm? = some a then 1 else 0

theorem creditCounter_mono {K : ℕ} (c : Fin K → ℕ) (arm? : Option (Fin K))
    (a : Fin K) : c a ≤ creditCounter c arm? a := by
  simp only [creditCounter]
  omega

theorem creditCounter_le_succ {K : ℕ} (c : Fin K → ℕ) (arm? : Option (Fin K))
    (a : Fin K) : creditCounter c arm? a ≤ c a + 1 := by
  simp only [creditCounter]
  split_ifs <;> omega

/-- The actual finite family of counter sums on the manuscript's `m`-subsets. -/
def supportedSetSums (p : Parameters) (c : Fin p.K → ℕ) : Finset ℕ :=
  (ProductSetLaw.support p.K p.m).image (fun S => ∑ a ∈ S, c a)

theorem supportedSetSums_nonempty (p : Parameters) (c : Fin p.K → ℕ) :
    (supportedSetSums p c).Nonempty := by
  obtain ⟨S, hS⟩ := ProductSetLaw.support_nonempty
    (ConstructorDimensions.m_pos p) p.m_lt_K
  exact ⟨∑ a ∈ S, c a, Finset.mem_image.mpr ⟨S, hS, rfl⟩⟩

/-- Every member of the source support is an actual `m`-element set. -/
theorem supportedSet_card (p : Parameters) {S : Finset (Fin p.K)}
    (hS : S ∈ ProductSetLaw.support p.K p.m) : S.card = p.m := by
  change S ∈ Finset.univ.powersetCard p.m at hS
  exact (Finset.mem_powersetCard.mp hS).2

/-- Genuine maximum counter sum over the nonempty finite source support. -/
def maximumSupportedCounterSum (p : Parameters)
    (c : Fin p.K → ℕ) : ℕ :=
  (supportedSetSums p c).max' (supportedSetSums_nonempty p c)

/-- The source monitor `H = K max_{S∈𝒮} ∑_{a∈S} C(a)`. -/
def monitorValue (p : Parameters) (c : Fin p.K → ℕ) : ℕ :=
  p.K * maximumSupportedCounterSum p c

theorem maximumSupportedCounterSum_mono (p : Parameters)
    {c d : Fin p.K → ℕ} (hcd : ∀ a, c a ≤ d a) :
    maximumSupportedCounterSum p c ≤ maximumSupportedCounterSum p d := by
  classical
  apply Finset.max'_le (supportedSetSums p c)
    (supportedSetSums_nonempty p c) (maximumSupportedCounterSum p d)
  intro x hx
  rcases Finset.mem_image.mp hx with ⟨S, hS, rfl⟩
  have hsum : (∑ a ∈ S, c a) ≤ ∑ a ∈ S, d a := by
    apply Finset.sum_le_sum
    intro a ha
    exact hcd a
  exact hsum.trans (by
    have hmem : (∑ a ∈ S, d a) ∈ supportedSetSums p d :=
      Finset.mem_image.mpr ⟨S, hS, rfl⟩
    simpa only [maximumSupportedCounterSum] using
      (Finset.le_max' (supportedSetSums p d) _ hmem))

theorem monitorValue_nonneg (p : Parameters) (c : Fin p.K → ℕ) :
    0 ≤ monitorValue p c := Nat.zero_le _

/-- The monitor starts at zero when every arm counter is zero. -/
theorem monitorValue_zero (p : Parameters) :
    monitorValue p (fun _ : Fin p.K => 0) = 0 := by
  have hmax : maximumSupportedCounterSum p (fun _ : Fin p.K => 0) ≤ 0 := by
    apply Finset.max'_le (supportedSetSums p (fun _ : Fin p.K => 0))
      (supportedSetSums_nonempty p (fun _ : Fin p.K => 0)) 0
    intro x hx
    rcases Finset.mem_image.mp hx with ⟨S, hS, rfl⟩
    simp
  unfold monitorValue
  have : maximumSupportedCounterSum p (fun _ : Fin p.K => 0) = 0 :=
    Nat.eq_zero_of_le_zero hmax
  simp [this]

theorem monitorValue_mono (p : Parameters) {c d : Fin p.K → ℕ}
    (hcd : ∀ a, c a ≤ d a) : monitorValue p c ≤ monitorValue p d := by
  exact Nat.mul_le_mul_left p.K (maximumSupportedCounterSum_mono p hcd)

/-- One observation changes the source maximum by at most one and hence `H`
by at most `K`. -/
theorem monitorValue_credit_le (p : Parameters) (c : Fin p.K → ℕ)
    (arm? : Option (Fin p.K)) :
    monitorValue p (creditCounter c arm?) ≤ monitorValue p c + p.K := by
  classical
  unfold monitorValue maximumSupportedCounterSum
  have hset : ∀ S ∈ ProductSetLaw.support p.K p.m,
      (∑ a ∈ S, creditCounter c arm? a) ≤ (∑ a ∈ S, c a) + 1 := by
    intro S hS
    unfold creditCounter
    rw [Finset.sum_add_distrib]
    have hone : (∑ a ∈ S, if arm? = some a then 1 else 0) ≤ 1 := by
      cases arm? with
      | none => simp
      | some b =>
        by_cases hb : b ∈ S
        · simp [hb]
        · simp [hb]
    omega
  have hmax : maximumSupportedCounterSum p (creditCounter c arm?) ≤
      maximumSupportedCounterSum p c + 1 := by
    apply Finset.max'_le (supportedSetSums p (creditCounter c arm?))
      (supportedSetSums_nonempty p (creditCounter c arm?))
      (maximumSupportedCounterSum p c + 1)
    intro x hx
    rcases Finset.mem_image.mp hx with ⟨S, hS, rfl⟩
    have hmem : (∑ a ∈ S, c a) ∈ supportedSetSums p c :=
      Finset.mem_image.mpr ⟨S, hS, rfl⟩
    exact (hset S hS).trans (Nat.add_le_add_right
      (by
        simpa only [maximumSupportedCounterSum] using
          (Finset.le_max' (supportedSetSums p c) _ hmem)) 1)
  have hmul := Nat.mul_le_mul_left p.K hmax
  calc
    p.K * maximumSupportedCounterSum p (creditCounter c arm?) ≤
        p.K * (maximumSupportedCounterSum p c + 1) := hmul
    _ = p.K * maximumSupportedCounterSum p c + p.K := by
      rw [Nat.mul_add]
      simp

/-- One round's indicator contribution to an arm counter. -/
def armContribution (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (t : Fin p.T) (a : Fin p.K) : ℕ :=
  if positiveDownArm p row h t = some a then 1 else 0

def prefixCounter (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hn : n ≤ p.T) (a : Fin p.K) : ℕ :=
  ∑ i : Fin n,
    armContribution p row h ⟨i.val,
      Nat.lt_of_lt_of_le i.isLt hn⟩ a

/-- Adding the next in-horizon round extends the prefix counter by precisely
that round's true-row DOWN-positive indicator. -/
theorem prefixCounter_succ (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hn : n < p.T) (a : Fin p.K) :
    prefixCounter p row h (n + 1) (Nat.succ_le_of_lt hn) a =
      prefixCounter p row h n (Nat.le_of_lt hn) a +
        armContribution p row h ⟨n, hn⟩ a := by
  unfold prefixCounter
  rw [Fin.sum_univ_castSucc]
  simp only [Fin.val_castSucc, Fin.val_last]

/-- The first recorded threshold crossing state. `launchPosition` counts the
number of processed rounds; the source launch round is `launchPosition + 1`.
The value `T` therefore represents no effective launch within the horizon,
while `crossingBlock` distinguishes a crossing at the final boundary. -/
structure State (p : Parameters) where
  counters : Fin p.K → ℕ
  crossingBlock : Option (Fin (n_boot p))
  launchPosition : ℕ

/-- Initial monitor state: all counters zero and no launch. -/
def initialState (p : Parameters) : State p where
  counters := fun _ => 0
  crossingBlock := none
  launchPosition := p.T

/-- Initial replay state: zero counters, no crossing, and the no-launch
sentinel position. -/
theorem initialState_spec (p : Parameters) :
    (initialState p).counters = (fun _ : Fin p.K => 0) ∧
      (initialState p).crossingBlock = none ∧
      (initialState p).launchPosition = p.T :=
  ⟨rfl, rfl, rfl⟩

/-- Whether this calendar round ends its actual (possibly shortened final)
`calendarBlock`, written using the accepted quotient block endpoint. -/
def calendarBlockEnd (p : Parameters) (t : Fin p.T) : Prop :=
  manuscriptRound p t = min p.T
    ((roundBlockIndex p t).val.succ * B_boot p)

/-- The transition boundary is exactly the clipped endpoint of the accepted
`calendarBlock` containing this round. -/
theorem calendarBlockEnd_iff_actual_calendarBlock_endpoint (p : Parameters)
    (t : Fin p.T) :
    calendarBlockEnd p t ↔
      t ∈ BootstrapDimensions.calendarBlock p (roundBlockIndex p t) ∧
        manuscriptRound p t = min p.T
          ((roundBlockIndex p t).val.succ * B_boot p) := by
  constructor
  · intro hend
    exact ⟨BootstrapDimensions.round_mem_quotient_block p t, hend⟩
  · rintro ⟨_, hend⟩
    exact hend

/-- If a block is not first, the previous clipped block ends immediately
before its start. -/
theorem previousCalendarBlockEnd (p : Parameters) (s : Fin (n_boot p))
    (hs : 0 < s.val) :
    ∃ u : Fin p.T,
      u.val + 1 = s.val * B_boot p ∧
      roundBlockIndex p u = ⟨s.val - 1, by omega⟩ ∧
      calendarBlockEnd p u := by
  let start := s.val * B_boot p
  have hstartLt : start < p.T := by
    obtain ⟨v, hv⟩ := BootstrapDimensions.calendarBlock_nonempty p s
    have hv' := (BootstrapDimensions.mem_calendarBlock_iff p s v).1 hv
    exact lt_of_le_of_lt hv'.1 v.isLt
  have hstartPos : 0 < start := Nat.mul_pos hs (B_boot_pos p)
  let u : Fin p.T := ⟨start - 1, by omega⟩
  let r : Fin (n_boot p) := ⟨s.val - 1, by omega⟩
  have hprevLength : (s.val - 1) * B_boot p + B_boot p = start := by
    calc
      (s.val - 1) * B_boot p + B_boot p = ((s.val - 1) + 1) * B_boot p := by
        rw [Nat.add_mul, one_mul]
      _ = s.val * B_boot p := by rw [Nat.sub_add_cancel (by omega)]
  have hmem : u ∈ BootstrapDimensions.calendarBlock p r := by
    rw [BootstrapDimensions.mem_calendarBlock_iff]
    constructor
    · change (s.val - 1) * B_boot p ≤ start - 1
      have hlt : (s.val - 1) * B_boot p < start := by
        rw [← hprevLength]
        exact Nat.lt_add_of_pos_right (B_boot_pos p)
      omega
    · apply Nat.lt_min.mpr
      have huLtStart : u.val < start := by
        dsimp [u]
        omega
      constructor
      · exact lt_trans huLtStart hstartLt
      · change u.val < (s.val - 1 + 1) * B_boot p
        rw [Nat.sub_add_cancel (by omega)]
        exact huLtStart
  have hquot :=
    (BootstrapDimensions.mem_calendarBlock_iff_quotient p r u).1 hmem
  have hindex : roundBlockIndex p u = r := by
    apply Fin.ext
    exact hquot.symm
  have huEnd : u.val + 1 = start := by
    change start - 1 + 1 = start
    omega
  have hend : calendarBlockEnd p u := by
    change manuscriptRound p u =
      min p.T ((roundBlockIndex p u).val.succ * B_boot p)
    rw [hindex]
    change u.val + 1 = min p.T ((s.val - 1 + 1) * B_boot p)
    rw [huEnd]
    have hmul : (s.val - 1 + 1) * B_boot p = start := by
      rw [Nat.sub_add_cancel (by omega)]
    rw [hmul, Nat.min_eq_right (Nat.le_of_lt hstartLt)]
  exact ⟨u, huEnd, hindex, hend⟩

/-- A round's monitor transition. Once a crossing is recorded, the branch
returns the old state without consulting the row or local history. -/
noncomputable def roundStep (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (s : State p) (t : Fin p.T) : State p := by
  classical
  exact if s.crossingBlock.isSome then s else
      let c' := creditCounter s.counters (positiveDownArm p row h t)
      if hend : calendarBlockEnd p t ∧
          monitorValue p c' > 4 * BootstrapStartupCostScale.Q C_star C_h p then
        ⟨c', some (roundBlockIndex p t), manuscriptRound p t⟩
      else ⟨c', none, p.T⟩

/-- State after the first `n` calendar rounds. At each round it reads the
true row and supplied observation only while no launch has been recorded. -/
noncomputable def stateAfter (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p) :
    ℕ → State p
  | 0 => initialState p
  | n + 1 =>
      let s := stateAfter C_star C_h p row h n
      if hn : n < p.T then roundStep C_star C_h p row h s ⟨n, hn⟩ else s

theorem stateAfter_succ_of_lt (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hn : n < p.T) :
    stateAfter C_star C_h p row h (n + 1) =
      roundStep C_star C_h p row h (stateAfter C_star C_h p row h n) ⟨n, hn⟩ := by
  simp [stateAfter, hn]

theorem stateAfter_succ_of_ge (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hn : p.T ≤ n) :
    stateAfter C_star C_h p row h (n + 1) = stateAfter C_star C_h p row h n := by
  simp [stateAfter, Nat.not_lt_of_ge hn]

theorem roundStep_launchPosition_le (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (s : State p) (t : Fin p.T) (hs : s.launchPosition ≤ p.T) :
    (roundStep C_star C_h p row h s t).launchPosition ≤ p.T := by
  classical
  by_cases hc : s.crossingBlock.isSome
  · simpa [roundStep, hc] using hs
  · by_cases hcross : calendarBlockEnd p t ∧
        monitorValue p (creditCounter s.counters (positiveDownArm p row h t)) >
          4 * BootstrapStartupCostScale.Q C_star C_h p
    · simpa [roundStep, hc, hcross] using
        (BootstrapDimensions.manuscriptRound_bounds p t).2
    · simp [roundStep, hc, hcross]

/-- The source round number associated to the replay's launch position. -/
def launchRound (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p) : ℕ :=
  (stateAfter C_star C_h p row h p.T).launchPosition + 1

theorem stateAfter_launchPosition_bounds (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) :
    (stateAfter C_star C_h p row h n).launchPosition ≤ p.T := by
  induction n with
  | zero => simp [stateAfter, initialState]
  | succ n ih =>
      by_cases hn : n < p.T
      · rw [stateAfter_succ_of_lt C_star C_h p row h n hn]
        exact roundStep_launchPosition_le C_star C_h p row h
          (stateAfter C_star C_h p row h n) ⟨n, hn⟩ ih
      · rw [stateAfter_succ_of_ge C_star C_h p row h n (Nat.le_of_not_gt hn)]
        exact ih

/-- Launch positions remain within the horizon; no-crossing states retain the
`T` sentinel, and a recorded crossing lies within the processed prefix. -/
theorem stateAfter_invariants (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) :
    (stateAfter C_star C_h p row h n).launchPosition ≤ p.T ∧
    ((stateAfter C_star C_h p row h n).crossingBlock = none →
      (stateAfter C_star C_h p row h n).launchPosition = p.T) ∧
    ((stateAfter C_star C_h p row h n).crossingBlock.isSome = true →
      (stateAfter C_star C_h p row h n).launchPosition ≤ n) := by
  induction n with
  | zero =>
      simp [stateAfter, initialState]
  | succ n ih =>
      by_cases hn : n < p.T
      · rw [stateAfter_succ_of_lt C_star C_h p row h n hn]
        let prev := stateAfter C_star C_h p row h n
        cases hb : prev.crossingBlock with
        | none =>
            have hpos : prev.launchPosition = p.T := ih.2.1 hb
            by_cases htest : calendarBlockEnd p ⟨n, hn⟩ ∧
                monitorValue p (creditCounter prev.counters
                  (positiveDownArm p row h ⟨n, hn⟩)) >
                  4 * BootstrapStartupCostScale.Q C_star C_h p
            · simp [roundStep, prev, hb, htest,
                BootstrapDimensions.manuscriptRound]
              omega
            · simp [roundStep, prev, hb, htest]
        | some b =>
            have hsome : prev.crossingBlock.isSome = true := by rw [hb]; rfl
            have hpos := ih.2.2 hsome
            have hstep : roundStep C_star C_h p row h
                (stateAfter C_star C_h p row h n) ⟨n, hn⟩ =
                stateAfter C_star C_h p row h n := by
              simp [roundStep, prev, hb]
            rw [hstep]
            refine ⟨ih.1, ?_, ?_⟩
            · intro hnone
              rw [hb] at hnone
              contradiction
            · intro _
              exact Nat.le_trans hpos (Nat.le_succ n)
      · rw [stateAfter_succ_of_ge C_star C_h p row h n (Nat.le_of_not_gt hn)]
        rcases ih with ⟨hbound, hnone, hsome⟩
        refine ⟨hbound, hnone, ?_⟩
        intro hc
        exact Nat.le_trans (hsome hc) (Nat.le_succ n)

theorem launchRound_bounds (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p) :
    1 ≤ launchRound C_star C_h p row h ∧
      launchRound C_star C_h p row h ≤ p.T + 1 := by
  unfold launchRound
  have hp := stateAfter_launchPosition_bounds C_star C_h p row h p.T
  omega

/-- The accepted counter vector at any prefix is exactly the sum of concrete
true-row DOWN-positive observations before the earlier of that prefix and the
recorded launch. -/
theorem stateAfter_counter_prefix (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hn : n ≤ p.T) (a : Fin p.K) :
    (stateAfter C_star C_h p row h n).counters a =
      prefixCounter p row h
        (min n (stateAfter C_star C_h p row h n).launchPosition)
        (Nat.le_trans (Nat.min_le_left _ _) hn) a := by
  induction n with
  | zero =>
      simp only [stateAfter, initialState]
      change (0 : ℕ) = ∑ i : Fin 0,
        armContribution p row h ⟨i.val, Nat.lt_of_lt_of_le i.isLt hn⟩ a
      exact (Fin.sum_univ_zero _).symm
  | succ n ih =>
      have hnlt : n < p.T := by omega
      rw [stateAfter_succ_of_lt C_star C_h p row h n hnlt]
      let prev := stateAfter C_star C_h p row h n
      have hinv := stateAfter_invariants C_star C_h p row h n
      cases hb : prev.crossingBlock with
      | none =>
          have hpos : prev.launchPosition = p.T := hinv.2.1 hb
          have hprev := ih (Nat.le_of_lt hnlt)
          have hprevPrefix : prev.counters a =
              prefixCounter p row h n (Nat.le_of_lt hnlt) a := by
            simpa [prev, hpos, Nat.min_eq_left (Nat.le_of_lt hnlt)] using hprev
          by_cases htest : calendarBlockEnd p ⟨n, hnlt⟩ ∧
              monitorValue p (creditCounter prev.counters
                (positiveDownArm p row h ⟨n, hnlt⟩)) >
                4 * BootstrapStartupCostScale.Q C_star C_h p
          · have hlaunch : manuscriptRound p ⟨n, hnlt⟩ = n + 1 := rfl
            simpa [roundStep, prev, hb, htest, hlaunch, creditCounter,
              armContribution, hprevPrefix] using
                (prefixCounter_succ p row h n hnlt a).symm
          ·
            have hmin : min (n + 1) p.T = n + 1 := Nat.min_eq_left hn
            simpa [roundStep, prev, hb, htest, hpos, hmin, creditCounter,
              armContribution, hprevPrefix] using
                (prefixCounter_succ p row h n hnlt a).symm
      | some b =>
          have hsome : prev.crossingBlock.isSome = true := by rw [hb]; rfl
          have hpos := hinv.2.2 hsome
          have hprev := ih (Nat.le_of_lt hnlt)
          have hmin0 : min n prev.launchPosition = prev.launchPosition :=
            Nat.min_eq_right hpos
          have hmin1 : min (n + 1) prev.launchPosition = prev.launchPosition :=
            Nat.min_eq_right (Nat.le_trans hpos (Nat.le_succ n))
          simpa [roundStep, prev, hb, hmin0, hmin1] using hprev

/-- The replay is constant after round `T`. -/
theorem stateAfter_eq_horizon_of_le (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hn : p.T ≤ n) :
    stateAfter C_star C_h p row h n = stateAfter C_star C_h p row h p.T := by
  induction n with
  | zero =>
      have hT : p.T = 0 := by omega
      simp [hT]
  | succ n ih =>
      by_cases hTn : p.T ≤ n
      · rw [stateAfter_succ_of_ge C_star C_h p row h n hTn, ih hTn]
      · have heq : n + 1 = p.T := by omega
        rw [heq]

theorem stateAfter_counter_succ_mono (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (a : Fin p.K) :
    (stateAfter C_star C_h p row h n).counters a ≤
      (stateAfter C_star C_h p row h (n + 1)).counters a := by
  by_cases hn : n < p.T
  · rw [stateAfter_succ_of_lt C_star C_h p row h n hn]
    cases hb : (stateAfter C_star C_h p row h n).crossingBlock with
    | none =>
        by_cases htest : calendarBlockEnd p ⟨n, hn⟩ ∧
            monitorValue p (creditCounter (stateAfter C_star C_h p row h n).counters
              (positiveDownArm p row h ⟨n, hn⟩)) >
              4 * BootstrapStartupCostScale.Q C_star C_h p
        · simpa [roundStep, hb, htest] using
            (creditCounter_mono (stateAfter C_star C_h p row h n).counters
              (positiveDownArm p row h ⟨n, hn⟩) a)
        · simpa [roundStep, hb, htest] using
            (creditCounter_mono (stateAfter C_star C_h p row h n).counters
              (positiveDownArm p row h ⟨n, hn⟩) a)
    | some b => simp [roundStep, hb]
  · rw [stateAfter_succ_of_ge C_star C_h p row h n (Nat.le_of_not_gt hn)]

theorem stateAfter_counter_mono (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n m : ℕ) (hnm : n ≤ m) (a : Fin p.K) :
    (stateAfter C_star C_h p row h n).counters a ≤
      (stateAfter C_star C_h p row h m).counters a := by
  induction m generalizing n with
  | zero =>
      have hn0 : n = 0 := by omega
      subst n
      exact Nat.le_refl _
  | succ m ih =>
      by_cases hnm' : n ≤ m
      · exact (ih n hnm').trans
          (stateAfter_counter_succ_mono C_star C_h p row h m a)
      · have hne : n = m + 1 := by omega
        subst n
        exact Nat.le_refl _

/-- The monitor is monotone along the replay because counters never decrease. -/
theorem stateAfter_monitor_mono (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n m : ℕ) (hnm : n ≤ m) :
    monitorValue p (stateAfter C_star C_h p row h n).counters ≤
      monitorValue p (stateAfter C_star C_h p row h m).counters := by
  apply monitorValue_mono
  intro a
  exact stateAfter_counter_mono C_star C_h p row h n m hnm a

/-- One calendar round can raise `H` by at most `K`; a frozen state changes it
by zero. -/
theorem stateAfter_monitor_succ_le (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) :
    monitorValue p (stateAfter C_star C_h p row h (n + 1)).counters ≤
      monitorValue p (stateAfter C_star C_h p row h n).counters + p.K := by
  by_cases hn : n < p.T
  · rw [stateAfter_succ_of_lt C_star C_h p row h n hn]
    cases hb : (stateAfter C_star C_h p row h n).crossingBlock with
    | none =>
        by_cases htest : calendarBlockEnd p ⟨n, hn⟩ ∧
            monitorValue p (creditCounter (stateAfter C_star C_h p row h n).counters
              (positiveDownArm p row h ⟨n, hn⟩)) >
              4 * BootstrapStartupCostScale.Q C_star C_h p
        · simpa [roundStep, hb, htest] using
            monitorValue_credit_le p (stateAfter C_star C_h p row h n).counters
              (positiveDownArm p row h ⟨n, hn⟩)
        · simpa [roundStep, hb, htest] using
            monitorValue_credit_le p (stateAfter C_star C_h p row h n).counters
              (positiveDownArm p row h ⟨n, hn⟩)
    | some b => simp [roundStep, hb]
  · rw [stateAfter_succ_of_ge C_star C_h p row h n (Nat.le_of_not_gt hn)]
    omega

/-- Over any interval of calendar prefixes, the statistic increases by at
most `K` per processed round. -/
theorem stateAfter_monitor_growth (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n m : ℕ) (hnm : n ≤ m) :
    monitorValue p (stateAfter C_star C_h p row h m).counters ≤
      monitorValue p (stateAfter C_star C_h p row h n).counters + p.K * (m - n) := by
  induction m generalizing n with
  | zero =>
      have hn0 : n = 0 := by omega
      subst n
      simp
  | succ m ih =>
      by_cases hnm' : n ≤ m
      · have hprev := ih n hnm'
        have hstep := stateAfter_monitor_succ_le C_star C_h p row h m
        calc
          monitorValue p (stateAfter C_star C_h p row h (m + 1)).counters ≤
              monitorValue p (stateAfter C_star C_h p row h m).counters + p.K := hstep
          _ ≤ (monitorValue p (stateAfter C_star C_h p row h n).counters +
                p.K * (m - n)) + p.K := Nat.add_le_add_right hprev p.K
          _ = monitorValue p (stateAfter C_star C_h p row h n).counters +
                p.K * ((m + 1) - n) := by
              rw [show (m + 1) - n = (m - n) + 1 by omega, Nat.mul_succ]
              omega
      · have hne : n = m + 1 := by omega
        subst n
        simp

/-- Number of true-row DOWN-positive observations in a supplied round prefix. -/
def positivePrefixCount (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hn : n ≤ p.T) : ℕ :=
  ∑ i : Fin n,
    if (positiveDownArm p row h ⟨i.val, Nat.lt_of_lt_of_le i.isLt hn⟩).isSome
      then 1 else 0

theorem armContribution_le_positiveIndicator (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (t : Fin p.T) (a : Fin p.K) :
    armContribution p row h t a ≤
      (if (positiveDownArm p row h t).isSome then 1 else 0) := by
  cases ho : positiveDownArm p row h t with
  | none => simp [armContribution, ho]
  | some b =>
      by_cases hba : b = a <;> simp [armContribution, ho, hba]

theorem prefixCounter_le_positivePrefixCount (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hn : n ≤ p.T) (a : Fin p.K) :
    prefixCounter p row h n hn a ≤ positivePrefixCount p row h n hn := by
  unfold prefixCounter positivePrefixCount
  apply Finset.sum_le_sum
  intro i hi
  exact armContribution_le_positiveIndicator p row h
    ⟨i.val, Nat.lt_of_lt_of_le i.isLt hn⟩ a

theorem maximumSupportedCounterSum_le_of_arm_bound (p : Parameters)
    (c : Fin p.K → ℕ) (N : ℕ) (hc : ∀ a, c a ≤ N) :
    maximumSupportedCounterSum p c ≤ p.m * N := by
  classical
  apply Finset.max'_le (supportedSetSums p c) (supportedSetSums_nonempty p c)
    (p.m * N)
  intro x hx
  rcases Finset.mem_image.mp hx with ⟨S, hS, rfl⟩
  have hsum : (∑ a ∈ S, c a) ≤ S.card * N := by
    calc
      (∑ a ∈ S, c a) ≤ ∑ a ∈ S, N := by
        apply Finset.sum_le_sum
        intro a ha
        exact hc a
      _ = S.card * N := by simp
  rw [supportedSet_card p hS] at hsum
  exact hsum

/-- `H` is bounded by `K*m` times the number of supplied prelaunch DOWN
positives. This bound concerns only the explicit local-history input. -/
theorem stateAfter_monitor_le_positive_count (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hn : n ≤ p.T) :
    monitorValue p (stateAfter C_star C_h p row h n).counters ≤
      p.K * (p.m * positivePrefixCount p row h
        (min n (stateAfter C_star C_h p row h n).launchPosition)
        (Nat.le_trans (Nat.min_le_left _ _) hn)) := by
  apply Nat.mul_le_mul_left
  apply maximumSupportedCounterSum_le_of_arm_bound
  intro a
  rw [stateAfter_counter_prefix C_star C_h p row h n hn a]
  exact prefixCounter_le_positivePrefixCount p row h
    (min n (stateAfter C_star C_h p row h n).launchPosition)
    (Nat.le_trans (Nat.min_le_left _ _) hn) a

/-- A single credited positive observation cannot lower the monitor. -/
theorem monitorValue_credit_mono (p : Parameters) (c : Fin p.K → ℕ)
    (arm? : Option (Fin p.K)) :
    monitorValue p c ≤ monitorValue p (creditCounter c arm?) := by
  apply monitorValue_mono
  intro a
  exact creditCounter_mono c arm? a

/-- The replay exposes a counter vector for every requested round prefix,
truncated at the first recorded launch. -/
noncomputable def acceptedPrefixCounters (C_star C_h : ℝ)
    (p : Parameters) (row : CompletePublicTable.CompleteRow p)
    (h : RoundedCoordinatorHistory p) (n : ℕ) : Fin p.K → ℕ :=
  fun a => prefixCounter p row h
    (min (min n (stateAfter C_star C_h p row h n).launchPosition) p.T)
    (Nat.min_le_right _ _) a

/-- For every requested prefix, the returned counters are exactly the
concrete cumulative DOWN-positive indicators up to the earlier of that prefix,
the recorded launch position, and the horizon. -/
theorem stateAfter_eq_acceptedPrefixCounters (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (a : Fin p.K) :
    (stateAfter C_star C_h p row h n).counters a =
      acceptedPrefixCounters C_star C_h p row h n a := by
  by_cases hn : n ≤ p.T
  · unfold acceptedPrefixCounters
    rw [stateAfter_counter_prefix C_star C_h p row h n hn a]
    congr 1
    omega
  · have hTn : p.T ≤ n := by omega
    have hstate := stateAfter_eq_horizon_of_le C_star C_h p row h n hTn
    unfold acceptedPrefixCounters
    have hcounter := congrArg (fun q : State p => q.counters a) hstate
    have hlaunchPos := congrArg (fun q : State p => q.launchPosition) hstate
    have hposT := stateAfter_launchPosition_bounds C_star C_h p row h p.T
    have hposn := stateAfter_launchPosition_bounds C_star C_h p row h n
    have hposTn : (stateAfter C_star C_h p row h p.T).launchPosition ≤ n :=
      hposT.trans hTn
    have hposnLe : (stateAfter C_star C_h p row h n).launchPosition ≤ n := by
      rw [hlaunchPos]
      exact hposTn
    have hminRight :
        min (min n (stateAfter C_star C_h p row h n).launchPosition) p.T =
          (stateAfter C_star C_h p row h n).launchPosition := by
      rw [Nat.min_eq_right hposnLe]
      exact Nat.min_eq_left hposn
    have hminEq :
        min p.T (stateAfter C_star C_h p row h p.T).launchPosition =
          min (min n (stateAfter C_star C_h p row h n).launchPosition) p.T := by
      calc
        min p.T (stateAfter C_star C_h p row h p.T).launchPosition =
            (stateAfter C_star C_h p row h p.T).launchPosition :=
              Nat.min_eq_right hposT
        _ = (stateAfter C_star C_h p row h n).launchPosition := hlaunchPos.symm
        _ = min (min n (stateAfter C_star C_h p row h n).launchPosition) p.T :=
              hminRight.symm
    have hprefix :=
      stateAfter_counter_prefix C_star C_h p row h p.T (Nat.le_refl _) a
    calc
      (stateAfter C_star C_h p row h n).counters a =
          (stateAfter C_star C_h p row h p.T).counters a := hcounter
      _ =
          prefixCounter p row h
            (min p.T (stateAfter C_star C_h p row h p.T).launchPosition) _ a := hprefix
      _ = prefixCounter p row h
            (min (min n (stateAfter C_star C_h p row h n).launchPosition) p.T) _ a := by
              simp only [hminEq]

/-- A block-boundary crossing records precisely the current quotient block and
the following source round. -/
theorem roundStep_crossing_spec (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (s : State p) (t : Fin p.T)
    (hactive : s.crossingBlock = none)
    (hend : calendarBlockEnd p t)
    (hcross : monitorValue p (creditCounter s.counters (positiveDownArm p row h t)) >
      4 * BootstrapStartupCostScale.Q C_star C_h p) :
    (roundStep C_star C_h p row h s t).crossingBlock =
        some (roundBlockIndex p t) ∧
      (roundStep C_star C_h p row h s t).launchPosition = manuscriptRound p t := by
  simp [roundStep, hactive, hend, hcross]

/-- A non-crossing block-end test leaves the launch sentinel at `T`. -/
theorem roundStep_no_crossing_position (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (s : State p) (t : Fin p.T) (hactive : s.crossingBlock = none)
    (hno : ¬ (calendarBlockEnd p t ∧
      monitorValue p (creditCounter s.counters (positiveDownArm p row h t)) >
        4 * BootstrapStartupCostScale.Q C_star C_h p)) :
    (roundStep C_star C_h p row h s t).crossingBlock = none ∧
      (roundStep C_star C_h p row h s t).launchPosition = p.T := by
  simp [roundStep, hactive, hno]

/-- At a true calendar-block end, a transition with no recorded crossing has
monitor at most the strict launch threshold. -/
theorem roundStep_boundary_monitor_le_of_none (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (s : State p) (t : Fin p.T) (hactive : s.crossingBlock = none)
    (hend : calendarBlockEnd p t)
    (hresult : (roundStep C_star C_h p row h s t).crossingBlock = none) :
    monitorValue p (creditCounter s.counters (positiveDownArm p row h t)) ≤
      4 * BootstrapStartupCostScale.Q C_star C_h p := by
  by_contra hle
  have hcross : monitorValue p (creditCounter s.counters (positiveDownArm p row h t)) >
      4 * BootstrapStartupCostScale.Q C_star C_h p := by omega
  have hstep := roundStep_crossing_spec C_star C_h p row h s t hactive hend hcross
  rw [hresult] at hstep
  cases hstep.1

/-- Every calendar-block boundary before a state with no launch has monitor at
most `4Q`. -/
theorem stateAfter_no_crossing_boundary_monitors (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (hnone : (stateAfter C_star C_h p row h n).crossingBlock = none) :
    ∀ t : Fin p.T, t.val < n → calendarBlockEnd p t →
      monitorValue p (stateAfter C_star C_h p row h (t.val + 1)).counters ≤
        4 * BootstrapStartupCostScale.Q C_star C_h p := by
  induction n with
  | zero =>
      intro t ht
      omega
  | succ n ih =>
      by_cases hn : n < p.T
      · rw [stateAfter_succ_of_lt C_star C_h p row h n hn] at hnone
        let prev := stateAfter C_star C_h p row h n
        have hprevNone : prev.crossingBlock = none := by
          cases hb : prev.crossingBlock with
          | none => rfl
          | some b => simp [roundStep, prev, hb] at hnone
        intro t ht hend
        by_cases htlt : t.val < n
        · exact ih hprevNone t htlt hend
        · have hteq : t.val = n := by omega
          have hround : t = ⟨n, hn⟩ := Fin.ext hteq
          subst t
          rw [stateAfter_succ_of_lt C_star C_h p row h n hn]
          have hbound := roundStep_boundary_monitor_le_of_none C_star C_h p row h prev
            ⟨n, hn⟩ hprevNone hend hnone
          have hprevNone' : (stateAfter C_star C_h p row h n).crossingBlock = none := by
            simpa [prev] using hprevNone
          simp [roundStep, hprevNone']
          split_ifs <;> simpa [prev] using hbound
      · rw [stateAfter_succ_of_ge C_star C_h p row h n (Nat.le_of_not_gt hn)] at hnone
        intro t ht hend
        have htlt : t.val < n := by omega
        exact ih hnone t htlt hend

/-- Once a crossing is stored, later rounds leave the entire monitor state
unchanged. -/
theorem stateAfter_eq_of_crossing_before (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n m : ℕ) (hnm : n ≤ m) (s : Fin (n_boot p))
    (hc : (stateAfter C_star C_h p row h n).crossingBlock = some s) :
    stateAfter C_star C_h p row h m = stateAfter C_star C_h p row h n := by
  induction m generalizing n with
  | zero =>
      have hn0 : n = 0 := by omega
      subst n
      rfl
  | succ m ih =>
      by_cases hnm' : n ≤ m
      · have hmid := ih n hnm' hc
        by_cases hm : m < p.T
        · rw [stateAfter_succ_of_lt C_star C_h p row h m hm, hmid]
          simp [roundStep, hc]
        · rw [stateAfter_succ_of_ge C_star C_h p row h m (Nat.le_of_not_gt hm), hmid]
      · have hne : n = m + 1 := by omega
        subst n
        rfl

/-- The recorded launch is the first strict crossing at a true calendar-block
boundary. Every earlier boundary monitor is at most `4Q`. -/
theorem stateAfter_crossing_is_first_boundary (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (s : Fin (n_boot p))
    (hcrossing : (stateAfter C_star C_h p row h n).crossingBlock = some s) :
    ∃ t : Fin p.T,
      t.val < n ∧
      roundBlockIndex p t = s ∧
      calendarBlockEnd p t ∧
      (stateAfter C_star C_h p row h (t.val + 1)).crossingBlock = some s ∧
      (stateAfter C_star C_h p row h (t.val + 1)).launchPosition = manuscriptRound p t ∧
      monitorValue p (stateAfter C_star C_h p row h (t.val + 1)).counters >
        4 * BootstrapStartupCostScale.Q C_star C_h p ∧
      (∀ u : Fin p.T, u.val < t.val → calendarBlockEnd p u →
        monitorValue p (stateAfter C_star C_h p row h (u.val + 1)).counters ≤
          4 * BootstrapStartupCostScale.Q C_star C_h p) := by
  induction n with
  | zero =>
      simp [stateAfter, initialState] at hcrossing
  | succ n ih =>
      by_cases hn : n < p.T
      · have hstep := stateAfter_succ_of_lt C_star C_h p row h n hn
        rw [hstep] at hcrossing
        let prev := stateAfter C_star C_h p row h n
        cases hb : prev.crossingBlock with
        | some b =>
            have hcrossPrev : (stateAfter C_star C_h p row h n).crossingBlock = some s := by
              simpa [roundStep, prev, hb] using hcrossing
            obtain ⟨t, ht, hidx, hend, hrecord, hlaunch, hmon, hprior⟩ := ih hcrossPrev
            exact ⟨t, by omega, hidx, hend, hrecord, hlaunch, hmon, hprior⟩
        | none =>
            by_cases htest : calendarBlockEnd p ⟨n, hn⟩ ∧
                monitorValue p (creditCounter prev.counters
                  (positiveDownArm p row h ⟨n, hn⟩)) >
                  4 * BootstrapStartupCostScale.Q C_star C_h p
            · let t : Fin p.T := ⟨n, hn⟩
              have hidx : roundBlockIndex p t = s := by
                have hsome : some (roundBlockIndex p t) = some s := by
                  simpa [roundStep, prev, hb, htest, t] using hcrossing
                exact Option.some.inj hsome
              have hend : calendarBlockEnd p t := by simpa [t] using htest.1
              have hrecord :
                  (stateAfter C_star C_h p row h (t.val + 1)).crossingBlock = some s := by
                rw [hstep]
                simpa [roundStep, prev, hb, htest, t] using hcrossing
              have hlaunch :
                  (stateAfter C_star C_h p row h (t.val + 1)).launchPosition = manuscriptRound p t := by
                rw [hstep]
                simp [roundStep, prev, hb, htest, t]
              have hmon : monitorValue p
                  (stateAfter C_star C_h p row h (t.val + 1)).counters >
                    4 * BootstrapStartupCostScale.Q C_star C_h p := by
                rw [hstep]
                simp [roundStep, prev, hb, htest]
              have hpriorState :
                  (stateAfter C_star C_h p row h n).crossingBlock = none := by
                simpa [prev] using hb
              have hprior := stateAfter_no_crossing_boundary_monitors
                C_star C_h p row h n hpriorState
              refine ⟨t, by simp [t], hidx, hend, hrecord, hlaunch, hmon, ?_⟩
              intro u hu hend'
              exact hprior u (by omega) hend'
            · simp [roundStep, prev, hb, htest] at hcrossing
      · rw [stateAfter_succ_of_ge C_star C_h p row h n (Nat.le_of_not_gt hn)] at hcrossing
        obtain ⟨t, ht, hidx, hend, hrecord, hlaunch, hmon, hprior⟩ := ih hcrossing
        exact ⟨t, by omega, hidx, hend, hrecord, hlaunch, hmon, hprior⟩

/-- At a first crossing, the overshoot is bounded by the exact number of
rounds in its clipped calendar block. -/
theorem stateAfter_crossing_overshoot (C_star C_h : ℝ) (p : Parameters)
    (row : CompletePublicTable.CompleteRow p) (h : RoundedCoordinatorHistory p)
    (n : ℕ) (s : Fin (n_boot p))
    (hcrossing : (stateAfter C_star C_h p row h n).crossingBlock = some s) :
    ∃ t : Fin p.T,
      t.val < n ∧
      roundBlockIndex p t = s ∧
      calendarBlockEnd p t ∧
      (stateAfter C_star C_h p row h (t.val + 1)).crossingBlock = some s ∧
      (stateAfter C_star C_h p row h (t.val + 1)).launchPosition = manuscriptRound p t ∧
      4 * BootstrapStartupCostScale.Q C_star C_h p <
        monitorValue p (stateAfter C_star C_h p row h (t.val + 1)).counters ∧
      monitorValue p (stateAfter C_star C_h p row h (t.val + 1)).counters ≤
        4 * BootstrapStartupCostScale.Q C_star C_h p +
          p.K * (BootstrapDimensions.calendarBlock p s).card ∧
      (∀ u : Fin p.T, u.val < t.val → calendarBlockEnd p u →
        monitorValue p (stateAfter C_star C_h p row h (u.val + 1)).counters ≤
          4 * BootstrapStartupCostScale.Q C_star C_h p) := by
  obtain ⟨t, ht, hidx, hend, hrecord, hlaunch, hmon, hprior⟩ :=
    stateAfter_crossing_is_first_boundary C_star C_h p row h n s hcrossing
  have hmem : t ∈ BootstrapDimensions.calendarBlock p s := by
    rw [← hidx]
    exact BootstrapDimensions.round_mem_quotient_block p t
  have hstartLe : s.val * B_boot p ≤ t.val :=
    (BootstrapDimensions.mem_calendarBlock_iff p s t).1 hmem |>.1
  have hstartLt : s.val * B_boot p < p.T := by
    obtain ⟨v, hv⟩ := BootstrapDimensions.calendarBlock_nonempty p s
    exact lt_of_le_of_lt
      ((BootstrapDimensions.mem_calendarBlock_iff p s v).1 hv).1 v.isLt
  have hstartBound :
      monitorValue p
        (stateAfter C_star C_h p row h (s.val * B_boot p)).counters ≤
          4 * BootstrapStartupCostScale.Q C_star C_h p := by
    by_cases hs : s.val = 0
    · have hzero : monitorValue p (stateAfter C_star C_h p row h 0).counters = 0 := by
        simpa [stateAfter, initialState] using monitorValue_zero p
      simp [hs, stateAfter, initialState, monitorValue_zero]
    · obtain ⟨u, hu, _, hendPrev⟩ := previousCalendarBlockEnd p s (by omega)
      have huLt : u.val < t.val := by omega
      have hbound := hprior u huLt hendPrev
      rw [← hu]
      exact hbound
  have hendRound : manuscriptRound p t =
      min p.T ((s.val + 1) * B_boot p) := by
    simpa [calendarBlockEnd, hidx] using hend
  have hcard : (BootstrapDimensions.calendarBlock p s).card =
      manuscriptRound p t - s.val * B_boot p := by
    rw [BootstrapDimensions.calendarBlock_card, ← hendRound]
  have hgrowth := stateAfter_monitor_growth C_star C_h p row h
    (s.val * B_boot p) (manuscriptRound p t) (by
      change s.val * B_boot p ≤ t.val + 1
      exact Nat.le_trans hstartLe (Nat.le_succ _))
  have hupper :
      monitorValue p (stateAfter C_star C_h p row h (t.val + 1)).counters ≤
        4 * BootstrapStartupCostScale.Q C_star C_h p +
          p.K * (BootstrapDimensions.calendarBlock p s).card := by
    calc
      monitorValue p (stateAfter C_star C_h p row h (t.val + 1)).counters ≤
          monitorValue p
            (stateAfter C_star C_h p row h (s.val * B_boot p)).counters +
              p.K * (manuscriptRound p t - s.val * B_boot p) := by
                simpa [manuscriptRound] using hgrowth
      _ ≤ 4 * BootstrapStartupCostScale.Q C_star C_h p +
            p.K * (manuscriptRound p t - s.val * B_boot p) :=
              Nat.add_le_add_right hstartBound _
      _ = 4 * BootstrapStartupCostScale.Q C_star C_h p +
            p.K * (BootstrapDimensions.calendarBlock p s).card := by
              rw [← hcard]
  exact ⟨t, ht, hidx, hend, hrecord, hlaunch, hmon, hupper, hprior⟩

/-- With no recorded crossing at the horizon, the returned source launch time
is the `T+1` sentinel. -/
theorem launchRound_eq_T_add_one_of_no_crossing (C_star C_h : ℝ)
    (p : Parameters) (row : CompletePublicTable.CompleteRow p)
    (h : RoundedCoordinatorHistory p)
    (hnone : (stateAfter C_star C_h p row h p.T).crossingBlock = none) :
    launchRound C_star C_h p row h = p.T + 1 := by
  have hsentinel :=
    (stateAfter_invariants C_star C_h p row h p.T).2.1 hnone
  simp [launchRound, hsentinel]

/-- An effective launch is exactly one round after the first strict
calendar-block boundary crossing, with all earlier boundary monitors below
threshold and the clipped-block overshoot bound. -/
theorem launchRound_effective_first_crossing (C_star C_h : ℝ)
    (p : Parameters) (row : CompletePublicTable.CompleteRow p)
    (h : RoundedCoordinatorHistory p) (s : Fin (n_boot p))
    (hcrossing : (stateAfter C_star C_h p row h p.T).crossingBlock = some s) :
    ∃ t : Fin p.T,
      roundBlockIndex p t = s ∧
      calendarBlockEnd p t ∧
      (stateAfter C_star C_h p row h (t.val + 1)).crossingBlock = some s ∧
      4 * BootstrapStartupCostScale.Q C_star C_h p <
        monitorValue p (stateAfter C_star C_h p row h (t.val + 1)).counters ∧
      monitorValue p (stateAfter C_star C_h p row h (t.val + 1)).counters ≤
        4 * BootstrapStartupCostScale.Q C_star C_h p +
          p.K * (BootstrapDimensions.calendarBlock p s).card ∧
      launchRound C_star C_h p row h = manuscriptRound p t + 1 ∧
      (∀ u : Fin p.T, u.val < t.val → calendarBlockEnd p u →
        monitorValue p (stateAfter C_star C_h p row h (u.val + 1)).counters ≤
          4 * BootstrapStartupCostScale.Q C_star C_h p) := by
  obtain ⟨t, ht, hidx, hend, hrecord, hpos, hmon, hover, hprior⟩ :=
    stateAfter_crossing_overshoot C_star C_h p row h p.T s hcrossing
  have hfreeze := stateAfter_eq_of_crossing_before C_star C_h p row h
    (t.val + 1) p.T (by omega) s hrecord
  have hlaunch : launchRound C_star C_h p row h = manuscriptRound p t + 1 := by
    unfold launchRound
    rw [hfreeze, hpos]
  exact ⟨t, hidx, hend, hrecord, hmon, hover, hlaunch, hprior⟩

/-- Prefix replay depends only on true-row slot/tuple coordinates and local
observation coordinates in its prefix. The supplied local action coordinates
and all future coordinates are absent from the equality premises. -/
theorem stateAfter_eq_of_equal_past (C_star C_h : ℝ) (p : Parameters)
    (row row' : CompletePublicTable.CompleteRow p)
    (h h' : RoundedCoordinatorHistory p) (n : ℕ)
    (hslot : ∀ t : Fin p.T, t.val < n →
      trueCoordinatorSlot p row t = trueCoordinatorSlot p row' t)
    (harm : ∀ t : Fin p.T, t.val < n →
      trueCoordinatorArm p row t = trueCoordinatorArm p row' t)
    (hobs : ∀ t : Fin p.T, t.val < n →
      (h.localHistory t).2 = (h'.localHistory t).2) :
    stateAfter C_star C_h p row h n = stateAfter C_star C_h p row' h' n := by
  induction n with
  | zero => rfl
  | succ n ih =>
      have hprev := ih
        (fun t ht => hslot t (Nat.lt_trans ht (Nat.lt_succ_self n)))
        (fun t ht => harm t (Nat.lt_trans ht (Nat.lt_succ_self n)))
        (fun t ht => hobs t (Nat.lt_trans ht (Nat.lt_succ_self n)))
      by_cases hn : n < p.T
      · rw [stateAfter_succ_of_lt C_star C_h p row h n hn,
          stateAfter_succ_of_lt C_star C_h p row' h' n hn]
        rw [hprev]
        have hpos : positiveDownArm p row h ⟨n, hn⟩ =
            positiveDownArm p row' h' ⟨n, hn⟩ := by
          unfold positiveDownArm
          rw [hslot ⟨n, hn⟩ (by simp), harm ⟨n, hn⟩ (by simp),
            hobs ⟨n, hn⟩ (by simp)]
        unfold roundStep
        rw [hpos]
      · rw [stateAfter_succ_of_ge C_star C_h p row h n (Nat.le_of_not_gt hn),
          stateAfter_succ_of_ge C_star C_h p row' h' n (Nat.le_of_not_gt hn)]
        exact hprev

end Bandits.Support.BootstrapLaunchMonitor

