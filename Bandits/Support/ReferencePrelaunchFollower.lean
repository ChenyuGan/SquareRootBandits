/-!
# Already activated ordinary follower before reference launch

Literal local replay of `07_public_setup.tex:52-55,123-140`, using the registers
and acceptance test of `06_interruptions.tex:108-114,164-177`, logging from
`06_interruptions.tex:193-203` and `05_binary_transport.tex:366-393`, and the
selected-unoccupied decoder branch of `06_interruptions.tex:245-276` with the
batch rule `05_binary_transport.tex:23-42`. All paths reject DOWN before any
assignment-dependent effect. There is no missing-set gate.

The history below enforces ONLY observation typing, and its length is bounded
by the horizon. It is supplied, not generated by physical initialization.
Activation, the prelaunch interpretation of the prefix, physical actions and
feedback, stopping-time/measurability/freshness, postlaunch cutoff scans and
queue recovery, and the full reference read induction remain future producers.
No assignment, live snapshot, proposal bit, service, queue update, UP decoder,
bootstrap arm rule or block monitor is constructed here. Ordinary boundaries
have no transition of their own. Completed decoder batches are audit data.
-/

@[expose] public section

noncomputable section

namespace Bandits.Support.ReferencePrelaunchFollower

open ConstructorDimensions CompletePublicTable OrdinaryMessageCodec
open SparseCalendarReplay ActiveRoundActions

/-- A positive learning rate; no cap is needed for this deterministic replay. -/
abbrev LearningRate := {eta : ℝ // 0 < eta}

/-- Literal canonical ordinary codec, with both size obligations discharged. -/
def codecParams (p : Parameters) (eta : LearningRate) : CodecParams where
  m := p.m
  K := p.K
  T := p.T
  D := D p
  bN := b_N p
  beta := CanonicalRecordingRates.beta p eta.val
  hT := T_pos p
  hD := D_pos p
  hKD := K_le_D p
  hbN := b_N_le_D p

/-- An effective activation round, including the terminal `T+1` endpoint. -/
abbrev Activation (p : Parameters) := {alpha : ℕ // 1 ≤ alpha ∧ alpha ≤ p.T + 1}

/-- Only bounded, quantized observation typing; no physical-history predicate. -/
abbrev Observation (p : Parameters) :=
  {y : SparseCalendarReward // ∃ q : Fin (D p + 1), y.val = (q.val : ℝ) / (D p : ℝ)}

/-- This player's supplied arms and quantized observations at offsets `< n`. -/
abbrev LocalHistory (p : Parameters) (n : ℕ) := Fin n → (Fin p.K × Observation p)

/-- Map a bounded history offset into the actual finite calendar. -/
def calendar {p : Parameters} {n : ℕ} (hn : n ≤ p.T) (u : Fin n) : Fin p.T :=
  ⟨u.val, Nat.lt_of_lt_of_le u.isLt hn⟩

/-- The actual ordinary registers; unused DOWN fields do not have defaults. -/
structure State (p : Parameters) (eta : LearningRate) where
  lastDown : Option (DownRecord (codecParams p eta))
  S : ℕ
  delta : ℕ
  backlog : ℕ
  status : FollowerStatus
  downBatch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p)
  buffer : List (SparseCalendarRecord p.K)
  initializationFailure : Bool

/-- Activation starts with no accepted DOWN, empty log and empty decoder. -/
def initial (p : Parameters) (eta : LearningRate) : State p eta :=
  ⟨none, 0, 0, 0, .unoccupied, AffineBatchDecoder.initial p, [], false⟩

/-- Zero accepted start without assigning the unused arm/escape/exponent fields. -/
def acceptedStart {p : Parameters} {eta : LearningRate} (s : State p eta) : ℕ :=
  match s.lastDown with
  | none => 0
  | some M => M.val.sigma

/-- Enumerate precisely all other players via Mathlib's skip-one embedding. -/
def otherPlayer (p : Parameters) (i : Fin (p.m - 1)) (j : Fin (p.m - 1)) : Fin p.m :=
  let heq : p.m - 1 + 1 = p.m := by have := p.two_le_m; omega
  Fin.cast heq ((Fin.cast heq.symm (PublicDiscreteDraws.followerPlayer p.two_le_m i)).succAbove j)

theorem otherPlayer_ne (p : Parameters) (i j : Fin (p.m - 1)) :
    otherPlayer p i j ≠ PublicDiscreteDraws.followerPlayer p.two_le_m i := by
  unfold otherPlayer
  intro h
  have h' := congrArg (Fin.cast (by have := p.two_le_m; omega : p.m = p.m - 1 + 1)) h
  apply Fin.succAbove_ne _ j
  apply Fin.ext
  exact congrArg Fin.val h'

theorem exists_otherPlayer (p : Parameters) (i : Fin (p.m - 1)) (j : Fin p.m)
    (hj : j ≠ PublicDiscreteDraws.followerPlayer p.two_le_m i) :
    ∃ k, otherPlayer p i k = j := by
  have heq : p.m - 1 + 1 = p.m := by have := p.two_le_m; omega
  have hne : Fin.cast heq.symm j ≠
      Fin.cast heq.symm (PublicDiscreteDraws.followerPlayer p.two_le_m i) := by
    intro h
    exact hj (Fin.cast_injective _ h)
  obtain ⟨k, hk⟩ := Fin.exists_succAbove_eq hne
  refine ⟨k, ?_⟩
  apply Fin.ext
  exact congrArg (fun z : Fin (p.m - 1 + 1) => z.val) hk

/-- Concrete sparse logging fields from THIS row and THIS recorded played arm.
`thin` is saved without testing its value. -/
def loggingRound {p : Parameters} (i : Fin (p.m - 1)) (row : CompleteRow p)
    (alpha : Activation p) (t : Fin p.T) (own : Fin p.K × Observation p) :
    SparseCalendarRound p.K (p.m - 1) where
  data := decide (PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.dataSlot)
  selectedSource := decide (PublicDiscreteDraws.recorderSourceDraw p.two_le_m p.m_lt_K
    (row.2 t).1 = PublicDiscreteDraws.followerPlayer p.two_le_m i)
  unoccupied := true
  active := decide (alpha.val ≤ t.val + 1)
  pilot := own.1
  otherPlayersPilots := fun j => PublicDiscreteDraws.pilotDraw (K_pos p)
    (otherPlayer p i j) (row.2 t).1
  observation := own.2.val
  thinScalar := (row.2 t).1 ContinuousControlSlice.Label.thin

/-- One actual stamped sparse record or nothing. Positivity and thinning are absent. -/
def logAt {p : Parameters} (i : Fin (p.m - 1)) (row : CompleteRow p)
    (alpha : Activation p) (t : Fin p.T) (own : Fin p.K × Observation p) :
    List (SparseCalendarRecord p.K) := by
  classical
  exact if loggingTestsPass (loggingRound i row alpha t own) then
    [recordAt (t.val + 1) (loggingRound i row alpha t own)] else []

theorem loggingTestsPass_iff {p : Parameters} (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p) :
    loggingTestsPass (loggingRound i row alpha t own) ↔
      alpha.val ≤ t.val + 1 ∧
      PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.dataSlot ∧
      PublicDiscreteDraws.recorderSourceDraw p.two_le_m p.m_lt_K (row.2 t).1 =
        PublicDiscreteDraws.followerPlayer p.two_le_m i ∧
      ∀ j : Fin p.m, j ≠ PublicDiscreteDraws.followerPlayer p.two_le_m i →
        PublicDiscreteDraws.pilotDraw (K_pos p) j (row.2 t).1 ≠ own.1 := by
  simp only [loggingTestsPass, loggingRound, decide_eq_true_eq,
    sourceMaskPasses, true_and]
  constructor
  · rintro ⟨ha, hd, hs, hm⟩
    refine ⟨ha, hd, hs, fun j hj => ?_⟩
    obtain ⟨k, rfl⟩ := exists_otherPlayer p i j hj
    exact hm k
  · rintro ⟨ha, hd, hs, hm⟩
    exact ⟨ha, hd, hs, fun k => hm _ (otherPlayer_ne p i k)⟩

/-- Source DOWN direction is index `0`, channel follower is exactly `i`. -/
def downInput {p : Parameters} (i : Fin (p.m - 1)) (row : CompleteRow p)
    (alpha : Activation p) (t : Fin p.T) (own : Fin p.K × Observation p) :
    AffineBatchDecoder.RoundInput (AffineBatchDecoder.width p) := by
  classical
  exact {
  selected := decide (alpha.val ≤ t.val + 1 ∧
    PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.downSlot ∧
    PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row.2 t).1 = i)
  receiverEnabled := true
  sample := (row.2 t).2 (0, i)
  roundedReward := own.2.val.val }

/-- A one-round adapter: `decodeStep` reads this trace ONLY at the supplied `t`.
No observation outside the supplied local prefix is fabricated. -/
def traceAt {p : Parameters} (i : Fin (p.m - 1)) (row : CompleteRow p)
    (alpha : Activation p) (t : Fin p.T) (own : Fin p.K × Observation p) :
    AffineBatchDecoder.Trace p := fun _ => downInput i row alpha t own

/-- Literal selected-unoccupied DOWN call, preserving the batch otherwise. -/
def decodeAt {p : Parameters} (i : Fin (p.m - 1)) (row : CompleteRow p)
    (alpha : Activation p) (t : Fin p.T) (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p)) :=
  if (downInput i row alpha t own).selected then
    AffineBatchDecoder.decodeStep p (traceAt i row alpha t own) batch t
  else (batch, none)

/-- Convert the actual returned flat word by the existing exact equivalence,
then run the existing DOWN parser. -/
def parsedAt {p : Parameters} (eta : LearningRate) (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p)) :
    Option (DownRecord (codecParams p eta)) :=
  parseDown (codecParams p eta)
    ((decodeAt i row alpha t own batch).2.map (wordEquivFlat (codecParams p eta)).symm)

/-- A local parsed decision passes the literal PRELAUNCH `0 < sigma ≤ tau` test. -/
def passing_at {p : Parameters} (eta : LearningRate) (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p)) : Prop :=
  ∃ M, parsedAt eta i row alpha t own batch = some M ∧
    acceptDown (codecParams p eta) 0 (t.val + 1) M

/-- Ordinary prelaunch transition. A passing decision ONLY sets the failure
flag. All accepted fields and status are preserved on every branch. -/
def step {p : Parameters} {eta : LearningRate} (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p) (s : State p eta) : State p eta := by
  classical
  exact if s.status = .unoccupied then
    { s with
      downBatch := (decodeAt i row alpha t own s.downBatch).1
      buffer := s.buffer ++ logAt i row alpha t own
      initializationFailure := s.initializationFailure ||
        decide (passing_at eta i row alpha t own s.downBatch) }
  else s

/-- Chronological fold over the supplied offsets; no boundary reset operation. -/
def run {p : Parameters} {n : ℕ} {eta : LearningRate} (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (history : LocalHistory p n)
    (hn : n ≤ p.T) : List (Fin n) → State p eta → State p eta
  | [], s => s
  | u :: us, s => run i row alpha history hn us
      (step i row alpha (calendar hn u) (history u) s)

/-- Full supplied prefix, processed once in increasing calendar order. -/
def replay {p : Parameters} {n : ℕ} (eta : LearningRate) (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (history : LocalHistory p n)
    (hn : n ≤ p.T) : State p eta :=
  run i row alpha history hn (List.ofFn (fun u : Fin n => u)) (initial p eta)

/-- The accepted registers are preserved even on a passing DOWN decision. -/
theorem step_registers {p : Parameters} {eta : LearningRate} (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p) (s : State p eta) :
    (step i row alpha t own s).lastDown = s.lastDown ∧
    (step i row alpha t own s).S = s.S ∧
    (step i row alpha t own s).delta = s.delta ∧
    (step i row alpha t own s).backlog = s.backlog ∧
    (step i row alpha t own s).status = s.status := by
  classical
  unfold step
  split_ifs <;> exact ⟨rfl, rfl, rfl, rfl, rfl⟩

theorem run_registers {p : Parameters} {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n)) (s : State p eta) :
    (run i row alpha history hn us s).lastDown = s.lastDown ∧
    (run i row alpha history hn us s).S = s.S ∧
    (run i row alpha history hn us s).delta = s.delta ∧
    (run i row alpha history hn us s).backlog = s.backlog ∧
    (run i row alpha history hn us s).status = s.status := by
  induction us generalizing s with
  | nil => exact ⟨rfl, rfl, rfl, rfl, rfl⟩
  | cons u us ih =>
    obtain ⟨h1, h2, h3, h4, h5⟩ := step_registers i row alpha (calendar hn u) (history u) s
    obtain ⟨g1, g2, g3, g4, g5⟩ := ih (step i row alpha (calendar hn u) (history u) s)
    exact ⟨g1.trans h1, g2.trans h2, g3.trans h3, g4.trans h4, g5.trans h5⟩

/-- No accepted record or service appears during replay. Source 07:132-135. -/
theorem replay_registers {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) :
    (replay eta i row alpha history hn).lastDown = none ∧
    acceptedStart (replay eta i row alpha history hn) = 0 ∧
    (replay eta i row alpha history hn).S = 0 ∧
    (replay eta i row alpha history hn).delta = 0 ∧
    (replay eta i row alpha history hn).backlog = 0 ∧
    (replay eta i row alpha history hn).status = .unoccupied := by
  obtain ⟨h1, h2, h3, h4, h5⟩ := run_registers i row alpha history hn
    (List.ofFn (fun u : Fin n => u)) (initial p eta)
  refine ⟨h1, ?_, h2, h3, h4, h5⟩
  change (match (run i row alpha history hn _ (initial p eta)).lastDown with
    | none => 0 | some M => M.val.sigma) = 0
  rw [h1]
  rfl

/-- The only selected-UP offer before launch is the admissible empty record. -/
def upOffer {p : Parameters} (eta : LearningRate) (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T) :
    Option (UpRecord (codecParams p eta)) := by
  classical
  exact if alpha.val ≤ t.val + 1 ∧
      PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.upSlot ∧
      PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row.2 t).1 = i then
    some ⟨upPlaceholder, Or.inl rfl⟩ else none

/-- Encode the selected-UP placeholder through the accepted ordinary codec. -/
def upWord {p : Parameters} (eta : LearningRate) (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T) :
    Option (Word (codecParams p eta)) :=
  (upOffer eta i row alpha t).map (encodeUp (codecParams p eta))

theorem upOffer_fields {p : Parameters} (eta : LearningRate) (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (M : UpRecord (codecParams p eta)) (h : upOffer eta i row alpha t = some M) :
    M.val = upPlaceholder := by
  classical
  unfold upOffer at h
  split_ifs at h
  · exact (congrArg Subtype.val (Option.some.inj h)).symm

/-- Unselected calls are exactly the decoder's ineligible no-op; this proof
uses the proved pending-size invariant, never a missing-set premise. -/
theorem decodeAt_fst {p : Parameters} (i : Fin (p.m - 1)) (row : CompleteRow p)
    (alpha : Activation p) (t : Fin p.T) (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p))
    (hk : batch.pending.length < AffineBatchDecoder.quota p) :
    (decodeAt i row alpha t own batch).1 =
      AffineBatchDecoder.step p (traceAt i row alpha t own) batch t := by
  cases hs : (downInput i row alpha t own).selected with
  | true => simp only [decodeAt, hs, ite_true, AffineBatchDecoder.decodeStep]
  | false =>
    have hne : ¬ AffineBatchDecoder.eligible (traceAt i row alpha t own t) := by
      intro h
      exact Bool.noConfusion (hs.symm.trans h.1)
    rw [AffineBatchDecoder.step_ineligible p _ batch t hk hne]
    simp only [decodeAt, hs, Bool.false_eq_true, ite_false]

/-- Exact per-round decoder preservation/clearing, including failed solvers. -/
theorem step_batch_spec {p : Parameters} {eta : LearningRate} (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p) (s : State p eta)
    (hu : s.status = .unoccupied)
    (hk : s.downBatch.pending.length < AffineBatchDecoder.quota p)
    (hc : ∀ b ∈ s.downBatch.completed, b.length = AffineBatchDecoder.quota p) :
    (step i row alpha t own s).downBatch.pending.length < AffineBatchDecoder.quota p ∧
    (∀ b ∈ (step i row alpha t own s).downBatch.completed,
      b.length = AffineBatchDecoder.quota p) ∧
    AffineBatchDecoder.collected (step i row alpha t own s).downBatch =
      AffineBatchDecoder.collected s.downBatch ++
        AffineBatchDecoder.positiveAt p (traceAt i row alpha t own) t := by
  classical
  simp only [step, hu, ite_true, decodeAt_fst i row alpha t own s.downBatch hk]
  exact AffineBatchDecoder.step_spec p _ s.downBatch t hk hc

/-- The fold's exact log list, including order and multiplicities. -/
theorem run_buffer {p : Parameters} {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n))
    (s : State p eta) (hu : s.status = .unoccupied) :
    (run i row alpha history hn us s).buffer =
      s.buffer ++ us.flatMap (fun u => logAt i row alpha (calendar hn u) (history u)) := by
  classical
  induction us generalizing s with
  | nil => simp only [run, List.flatMap_nil, List.append_nil]
  | cons u us ih =>
    have hu' := (step_registers i row alpha (calendar hn u) (history u) s).2.2.2.2.trans hu
    rw [run, ih _ hu']
    simp only [step, hu, ite_true, List.flatMap_cons, List.append_assoc]

/-- Pending size, full completed batches, and exact positive sample provenance. -/
theorem run_batch_spec {p : Parameters} {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n))
    (s : State p eta) (hu : s.status = .unoccupied)
    (hk : s.downBatch.pending.length < AffineBatchDecoder.quota p)
    (hc : ∀ b ∈ s.downBatch.completed, b.length = AffineBatchDecoder.quota p) :
    (run i row alpha history hn us s).downBatch.pending.length < AffineBatchDecoder.quota p ∧
    (∀ b ∈ (run i row alpha history hn us s).downBatch.completed,
      b.length = AffineBatchDecoder.quota p) ∧
    AffineBatchDecoder.collected (run i row alpha history hn us s).downBatch =
      AffineBatchDecoder.collected s.downBatch ++ us.flatMap (fun u =>
        AffineBatchDecoder.positiveAt p (traceAt i row alpha (calendar hn u) (history u))
          (calendar hn u)) := by
  induction us generalizing s with
  | nil => exact ⟨hk, hc, by simp only [run, List.flatMap_nil, List.append_nil]⟩
  | cons u us ih =>
    obtain ⟨hk', hc', heq⟩ := step_batch_spec i row alpha (calendar hn u) (history u) s hu hk hc
    have hu' := (step_registers i row alpha (calendar hn u) (history u) s).2.2.2.2.trans hu
    obtain ⟨hk'', hc'', heq'⟩ := ih _ hu' hk' hc'
    exact ⟨hk'', hc'', by
      simpa only [run, heq, List.flatMap_cons, List.append_assoc] using heq'⟩

/-- Concrete invariant of the replay, with no invariant supplied as a premise. -/
theorem replay_batch_spec {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) :
    (replay eta i row alpha history hn).downBatch.pending.length < AffineBatchDecoder.quota p ∧
    (∀ b ∈ (replay eta i row alpha history hn).downBatch.completed,
      b.length = AffineBatchDecoder.quota p) ∧
    AffineBatchDecoder.collected (replay eta i row alpha history hn).downBatch =
      (List.ofFn (fun u : Fin n => u)).flatMap (fun u =>
        AffineBatchDecoder.positiveAt p (traceAt i row alpha (calendar hn u) (history u))
          (calendar hn u)) := by
  obtain ⟨hk, hc, heq⟩ := run_batch_spec i row alpha history hn
    (List.ofFn (fun u : Fin n => u)) (initial p eta) rfl
    (AffineBatchDecoder.quota_pos p) (by simp only [initial, AffineBatchDecoder.initial,
      List.not_mem_nil, false_implies, implies_true])
  refine ⟨hk, hc, ?_⟩
  change AffineBatchDecoder.collected (replay eta i row alpha history hn).downBatch =
    AffineBatchDecoder.collected (initial p eta).downBatch ++ _ at heq
  have hi : AffineBatchDecoder.collected (initial p eta).downBatch = [] := rfl
  rw [hi, List.nil_append] at heq
  exact heq

/-- Membership of a one-round log contains exactly the recorder tests. -/
theorem mem_logAt_iff {p : Parameters} (i : Fin (p.m - 1)) (row : CompleteRow p)
    (alpha : Activation p) (t : Fin p.T) (own : Fin p.K × Observation p)
    (r : SparseCalendarRecord p.K) :
    r ∈ logAt i row alpha t own ↔
      loggingTestsPass (loggingRound i row alpha t own) ∧
      r = recordAt (t.val + 1) (loggingRound i row alpha t own) := by
  classical
  by_cases h : loggingTestsPass (loggingRound i row alpha t own) <;>
    simp only [logAt, h, ite_true, ite_false, List.mem_singleton, List.not_mem_nil,
      true_and, false_and]

/-- The full chronological sparse log, without a reward or thinning test. -/
theorem replay_buffer {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) :
    (replay eta i row alpha history hn).buffer =
      (List.ofFn (fun u : Fin n => u)).flatMap
        (fun u => logAt i row alpha (calendar hn u) (history u)) := by
  exact run_buffer i row alpha history hn _ (initial p eta) rfl

/-- Exact buffer membership retains the actual `(tau, arm, Y, V)` values. -/
theorem replay_buffer_mem_iff {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (r : SparseCalendarRecord p.K) :
    r ∈ (replay eta i row alpha history hn).buffer ↔
      ∃ u : Fin n, loggingTestsPass (loggingRound i row alpha (calendar hn u) (history u)) ∧
        r = recordAt (u.val + 1) (loggingRound i row alpha (calendar hn u) (history u)) := by
  rw [replay_buffer, List.mem_flatMap]
  simp only [List.mem_ofFn, exists_eq, true_and, mem_logAt_iff, calendar]

/-- Every saved candidate has this exact round, arm, quantized observation and
continuous scalar, including candidates with zero observation. -/
theorem replay_buffer_fields {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (r : SparseCalendarRecord p.K)
    (hr : r ∈ (replay eta i row alpha history hn).buffer) :
    ∃ u : Fin n, alpha.val ≤ u.val + 1 ∧ r.calendarRound = u.val + 1 ∧
      r.pilot = (history u).1 ∧ r.observation = (history u).2.val ∧
      r.thinScalar = (row.2 (calendar hn u)).1 ContinuousControlSlice.Label.thin := by
  obtain ⟨u, ht, rfl⟩ := (replay_buffer_mem_iff eta i row alpha history hn r).mp hr
  exact ⟨u, ((loggingTestsPass_iff i row alpha _ _).mp ht).1, rfl, rfl, rfl, rfl⟩

/-- The buffer is strictly time ordered: appending each calendar round once
cannot silently duplicate a candidate, even when arm/reward/scalar repeat. -/
theorem replay_buffer_pairwise {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) :
    (replay eta i row alpha history hn).buffer.Pairwise
      (fun a b => a.calendarRound < b.calendarRound) := by
  classical
  rw [replay_buffer, List.pairwise_flatMap]
  constructor
  · intro u _
    unfold logAt
    split_ifs
    · exact List.pairwise_singleton _ _
    · exact List.Pairwise.nil
  · apply (List.pairwise_ofFn.mpr (fun a b (hab : a < b) => hab)).imp
    intro u v huv a ha b hb
    obtain ⟨_, rfl⟩ := (mem_logAt_iff i row alpha _ _ a).mp ha
    obtain ⟨_, rfl⟩ := (mem_logAt_iff i row alpha _ _ b).mp hb
    exact Nat.add_lt_add_right huv 1

theorem replay_buffer_unique_round {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) {a b : SparseCalendarRecord p.K}
    (ha : a ∈ (replay eta i row alpha history hn).buffer)
    (hb : b ∈ (replay eta i row alpha history hn).buffer)
    (hab : a.calendarRound = b.calendarRound) : a = b := by
  obtain ⟨u, _, rfl⟩ := (replay_buffer_mem_iff eta i row alpha history hn a).mp ha
  obtain ⟨v, _, rfl⟩ := (replay_buffer_mem_iff eta i row alpha history hn b).mp hb
  have huv : u = v := by
    apply Fin.ext
    change u.val + 1 = v.val + 1 at hab
    omega
  subst v
  rfl

/-- One decoder call retains exactly its eligible stamped equation. -/
theorem mem_positiveAt_iff (p : Parameters) (tr : AffineBatchDecoder.Trace p)
    (t : Fin p.T) (e : AffineBatchDecoder.Entry p.T (AffineBatchDecoder.width p)) :
    e ∈ AffineBatchDecoder.positiveAt p tr t ↔
      AffineBatchDecoder.eligible (tr t) ∧ e = AffineBatchDecoder.entry p tr t := by
  classical
  by_cases h : AffineBatchDecoder.eligible (tr t) <;>
    simp only [AffineBatchDecoder.positiveAt, h, ite_true, ite_false,
      List.mem_singleton, List.not_mem_nil, true_and, false_and]

/-- Exact collected-equation provenance from the concrete DOWN sample and
positive own observation. No assertion about a physically sent word is made. -/
theorem replay_collected_mem_iff {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T)
    (e : AffineBatchDecoder.Entry p.T (AffineBatchDecoder.width p)) :
    e ∈ AffineBatchDecoder.collected (replay eta i row alpha history hn).downBatch ↔
      ∃ u : Fin n, alpha.val ≤ u.val + 1 ∧
        PublicDiscreteDraws.slotDraw (row.2 (calendar hn u)).1 = PublicDiscreteDraws.downSlot ∧
        PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K
          (row.2 (calendar hn u)).1 = i ∧
        0 < (history u).2.val.val ∧ e.time = calendar hn u ∧
        e.sample = (row.2 (calendar hn u)).2 (0, i) := by
  classical
  rw [(replay_batch_spec eta i row alpha history hn).2.2, List.mem_flatMap]
  simp only [List.mem_ofFn, exists_eq, true_and, mem_positiveAt_iff]
  apply exists_congr
  intro u
  constructor
  · rintro ⟨he, heq⟩
    have hs : (alpha.val ≤ u.val + 1 ∧
        PublicDiscreteDraws.slotDraw (row.2 (calendar hn u)).1 = PublicDiscreteDraws.downSlot ∧
        PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K
          (row.2 (calendar hn u)).1 = i) := of_decide_eq_true he.1
    exact ⟨hs.1, hs.2.1, hs.2.2, he.2.2,
      congrArg AffineBatchDecoder.Entry.time heq,
      congrArg AffineBatchDecoder.Entry.sample heq⟩
  · rintro ⟨ha, hd, hs, hy, ht, he⟩
    refine ⟨?_, ?_⟩
    · change decide (_ ∧ _ ∧ _) = true ∧ true = true ∧ 0 < (history u).2.val.val
      exact ⟨decide_eq_true ⟨ha, hd, hs⟩, rfl, hy⟩
    · cases e
      exact congrArg₂ AffineBatchDecoder.Entry.mk ht he

/-- Every entry of an actual completed batch has the positive-equation origin
above, and the completed batch has the source quota. -/
theorem replay_completed_provenance {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T)
    (batch : List (AffineBatchDecoder.Entry p.T (AffineBatchDecoder.width p)))
    (hb : batch ∈ (replay eta i row alpha history hn).downBatch.completed) :
    batch.length = AffineBatchDecoder.quota p ∧
      ∀ e ∈ batch, ∃ u : Fin n, alpha.val ≤ u.val + 1 ∧
        PublicDiscreteDraws.slotDraw (row.2 (calendar hn u)).1 = PublicDiscreteDraws.downSlot ∧
        PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K
          (row.2 (calendar hn u)).1 = i ∧
        0 < (history u).2.val.val ∧ e.time = calendar hn u ∧
        e.sample = (row.2 (calendar hn u)).2 (0, i) := by
  refine ⟨(replay_batch_spec eta i row alpha history hn).2.1 batch hb, ?_⟩
  intro e he
  apply (replay_collected_mem_iff eta i row alpha history hn e).mp
  exact List.mem_append_left _ (List.mem_flatten.mpr ⟨batch, hb, he⟩)

/-- Literal quota-reaching call clears for ANY solver outcome. -/
theorem decodeAt_complete {p : Parameters} (i : Fin (p.m - 1)) (row : CompleteRow p)
    (alpha : Activation p) (t : Fin p.T) (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p))
    (he : AffineBatchDecoder.eligible (traceAt i row alpha t own t))
    (hk : batch.pending.length + 1 = AffineBatchDecoder.quota p) :
    decodeAt i row alpha t own batch =
      (⟨[], batch.completed ++ [batch.pending ++ [AffineBatchDecoder.entry p
        (traceAt i row alpha t own) t]]⟩,
        AffineBatchDecoder.batchOutput (batch.pending ++ [AffineBatchDecoder.entry p
          (traceAt i row alpha t own) t])) := by
  have hs : (downInput i row alpha t own).selected = true := he.1
  rw [decodeAt, ite_eq_left hs]
  exact AffineBatchDecoder.decodeStep_complete p _ batch t he hk

/-- Splitting an ordinary prefix introduces no reset, at a block boundary or
any other point. The current log and partial batch pass through the fold. -/
theorem run_append {p : Parameters} {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (us vs : List (Fin n)) (s : State p eta) :
    run i row alpha history hn (us ++ vs) s =
      run i row alpha history hn vs (run i row alpha history hn us s) := by
  induction us generalizing s with
  | nil => rfl
  | cons u us ih => exact ih _

/-- Launch handoff for an already activated follower is the existing state. -/
def atLaunch {p : Parameters} {eta : LearningRate} (s : State p eta) : State p eta := s

theorem atLaunch_preserves {p : Parameters} {eta : LearningRate} (s : State p eta) :
    (atLaunch s).buffer = s.buffer ∧ (atLaunch s).downBatch = s.downBatch := ⟨rfl, rfl⟩

/-- A newly forced follower starts at activation, unlike an existing follower. -/
def forcedAtLaunch (p : Parameters) (eta : LearningRate) : State p eta := initial p eta

theorem forcedAtLaunch_state (p : Parameters) (eta : LearningRate) :
    forcedAtLaunch p eta = initial p eta := rfl

/-- Parsed local DOWN decisions, stamped with their actual decision time. -/
def decisionAt {p : Parameters} (eta : LearningRate) (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p)) :
    List (Fin p.T × DownRecord (codecParams p eta)) :=
  (parsedAt eta i row alpha t own batch).toList.map (fun M => (t, M))

theorem mem_decisionAt_iff {p : Parameters} (eta : LearningRate) (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p))
    (d : Fin p.T × DownRecord (codecParams p eta)) :
    d ∈ decisionAt eta i row alpha t own batch ↔
      d.1 = t ∧ parsedAt eta i row alpha t own batch = some d.2 := by
  simp only [decisionAt, List.mem_map, Option.mem_toList]
  constructor
  · rintro ⟨M, hm, rfl⟩
    exact ⟨rfl, hm⟩
  · rintro ⟨ht, hm⟩
    exact ⟨d.2, hm, Prod.ext ht.symm rfl⟩

theorem passing_at_iff_decisionAt {p : Parameters} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (t : Fin p.T) (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p)) :
    passing_at eta i row alpha t own batch ↔
      ∃ d ∈ decisionAt eta i row alpha t own batch,
        acceptDown (codecParams p eta) 0 (d.1.val + 1) d.2 := by
  constructor
  · rintro ⟨M, hm, ha⟩
    exact ⟨(t, M), (mem_decisionAt_iff eta i row alpha t own batch _).mpr ⟨rfl, hm⟩, ha⟩
  · rintro ⟨⟨v, M⟩, hd, ha⟩
    obtain ⟨ht, hm⟩ := (mem_decisionAt_iff eta i row alpha t own batch _).mp hd
    change v = t at ht
    rw [ht] at ha
    exact ⟨M, hm, ha⟩

/-- Audit projection for unoccupied inputs (proved for every replay prefix).
It follows the same state updates and is never a controller input. -/
def decisions {p : Parameters} {n : ℕ} {eta : LearningRate} (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (history : LocalHistory p n)
    (hn : n ≤ p.T) : List (Fin n) → State p eta →
      List (Fin p.T × DownRecord (codecParams p eta))
  | [], _ => []
  | u :: us, s => decisionAt eta i row alpha (calendar hn u) (history u) s.downBatch ++
      decisions i row alpha history hn us (step i row alpha (calendar hn u) (history u) s)

theorem step_failure_iff {p : Parameters} {eta : LearningRate} (i : Fin (p.m - 1))
    (row : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p) (s : State p eta) (hu : s.status = .unoccupied) :
    (step i row alpha t own s).initializationFailure = true ↔
      s.initializationFailure = true ∨ passing_at eta i row alpha t own s.downBatch := by
  classical
  simp only [step, hu, ite_true, Bool.or_eq_true, decide_eq_true_eq]

/-- Failure is exactly an initial failure or one of the fold's actual parsed
local decisions passing the literal test; spurious words need not be sent. -/
theorem run_failure_iff {p : Parameters} {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n))
    (s : State p eta) (hu : s.status = .unoccupied) :
    (run i row alpha history hn us s).initializationFailure = true ↔
      s.initializationFailure = true ∨
        ∃ d ∈ decisions i row alpha history hn us s,
          acceptDown (codecParams p eta) 0 (d.1.val + 1) d.2 := by
  induction us generalizing s with
  | nil => simp only [run, decisions, List.not_mem_nil, false_and, exists_false, or_false]
  | cons u us ih =>
    have hu' := (step_registers i row alpha (calendar hn u) (history u) s).2.2.2.2.trans hu
    rw [run, ih _ hu', step_failure_iff i row alpha _ _ s hu,
      passing_at_iff_decisionAt, decisions]
    simp only [List.mem_append, or_and_right, exists_or, or_assoc]

/-- The replay starts without failure, hence the exact existential test. -/
theorem replay_failure_iff {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) :
    (replay eta i row alpha history hn).initializationFailure = true ↔
      ∃ d ∈ decisions i row alpha history hn (List.ofFn (fun u : Fin n => u)) (initial p eta),
        acceptDown (codecParams p eta) 0 (d.1.val + 1) d.2 := by
  have h := run_failure_iff i row alpha history hn (List.ofFn (fun u : Fin n => u))
    (initial p eta) rfl
  change _ ↔ false = true ∨ _ at h
  change (run i row alpha history hn (List.ofFn (fun u : Fin n => u))
    (initial p eta)).initializationFailure = true ↔ _
  simpa only [Bool.false_eq_true, false_or] using h

/-- Successful parsing really comes from a completed local batch, with the
exact decoder solver output and exact five-block word; no word is invented. -/
theorem parsedAt_some_completed {p : Parameters} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (t : Fin p.T) (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p))
    (M : DownRecord (codecParams p eta))
    (hm : parsedAt eta i row alpha t own batch = some M) :
    ∃ w : AffineChannelLaw.Word (AffineBatchDecoder.width p),
      (decodeAt i row alpha t own batch).2 = some w ∧
      AffineBatchDecoder.quota p ≤
        (batch.pending ++ AffineBatchDecoder.positiveAt p (traceAt i row alpha t own) t).length ∧
      AffineBatchDecoder.batchOutput
        (batch.pending ++ AffineBatchDecoder.positiveAt p (traceAt i row alpha t own) t) = some w ∧
      (wordEquivFlat (codecParams p eta)).symm w = encodeDown (codecParams p eta) M := by
  have hw := parseDir_some_sound (codecParams p eta) .DOWN _ M hm
  obtain ⟨w, hraw, he⟩ := Option.map_eq_some_iff.mp hw
  have hs : (downInput i row alpha t own).selected = true := by
    cases hs : (downInput i row alpha t own).selected with
    | true => rfl
    | false =>
      simp only [decodeAt, hs, Bool.false_eq_true, ite_false] at hraw
      cases hraw
  have ho : AffineBatchDecoder.stepOutput p (traceAt i row alpha t own) batch t = some w := by
    rw [decodeAt, ite_eq_left hs] at hraw
    exact hraw
  have hge := (AffineBatchDecoder.stepOutput_eq_some_iff p _ batch t w).mp ho |>.1
  refine ⟨w, hraw, hge, ?_, he⟩
  rw [AffineBatchDecoder.stepOutput, ite_eq_right (Nat.not_lt.mpr hge)] at ho
  exact ho

/-- A sufficient raw-coordinate read interface for one past ordinary round.
It lists only recorder/decoder coordinates: slot, source, selection, thinning,
OTHER-player pilots and this follower's DOWN sample. No forward, proposal,
assignment, tuple, fast, own-pilot, UP or other-follower affine coordinate occurs.
Some listed coordinates can be unused in a particular slot. -/
def reads_agree {p : Parameters} (i : Fin (p.m - 1)) (row row' : CompleteRow p)
    (t : Fin p.T) : Prop :=
  (row.2 t).1 ContinuousControlSlice.Label.slot =
    (row'.2 t).1 ContinuousControlSlice.Label.slot ∧
  (row.2 t).1 ContinuousControlSlice.Label.rec =
    (row'.2 t).1 ContinuousControlSlice.Label.rec ∧
  (row.2 t).1 ContinuousControlSlice.Label.sel =
    (row'.2 t).1 ContinuousControlSlice.Label.sel ∧
  (row.2 t).1 ContinuousControlSlice.Label.thin =
    (row'.2 t).1 ContinuousControlSlice.Label.thin ∧
  (∀ j : Fin p.m, j ≠ PublicDiscreteDraws.followerPlayer p.two_le_m i →
    (row.2 t).1 (ContinuousControlSlice.Label.pilot j) =
      (row'.2 t).1 (ContinuousControlSlice.Label.pilot j)) ∧
  (row.2 t).2 (0, i) = (row'.2 t).2 (0, i)

/-- Equal raw read coordinates give equal concrete local logging fields. -/
theorem loggingRound_eq_of_reads_agree {p : Parameters} (i : Fin (p.m - 1))
    (row row' : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p) (h : reads_agree i row row' t) :
    loggingRound i row alpha t own = loggingRound i row' alpha t own := by
  have hslot : PublicDiscreteDraws.slotDraw (row.2 t).1 =
      PublicDiscreteDraws.slotDraw (row'.2 t).1 := by
    unfold PublicDiscreteDraws.slotDraw ContinuousControlSlice.coordinate
    rw [h.1]
  have hsource : PublicDiscreteDraws.recorderSourceDraw p.two_le_m p.m_lt_K (row.2 t).1 =
      PublicDiscreteDraws.recorderSourceDraw p.two_le_m p.m_lt_K (row'.2 t).1 := by
    unfold PublicDiscreteDraws.recorderSourceDraw ContinuousControlSlice.coordinate
    rw [h.2.1]
  have hpilots : (fun j : Fin (p.m - 1) => PublicDiscreteDraws.pilotDraw (K_pos p)
      (otherPlayer p i j) (row.2 t).1) =
      (fun j : Fin (p.m - 1) => PublicDiscreteDraws.pilotDraw (K_pos p)
        (otherPlayer p i j) (row'.2 t).1) := by
    funext j
    unfold PublicDiscreteDraws.pilotDraw ContinuousControlSlice.coordinate
    rw [h.2.2.2.2.1 _ (otherPlayer_ne p i j)]
  unfold loggingRound
  rw [hslot, hsource, hpilots, h.2.2.2.1]

/-- The DOWN channel direction and index remain fixed under the read equality. -/
theorem downInput_eq_of_reads_agree {p : Parameters} (i : Fin (p.m - 1))
    (row row' : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p) (h : reads_agree i row row' t) :
    downInput i row alpha t own = downInput i row' alpha t own := by
  have hslot : PublicDiscreteDraws.slotDraw (row.2 t).1 =
      PublicDiscreteDraws.slotDraw (row'.2 t).1 := by
    unfold PublicDiscreteDraws.slotDraw ContinuousControlSlice.coordinate
    rw [h.1]
  have hselected : PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row.2 t).1 =
      PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row'.2 t).1 := by
    unfold PublicDiscreteDraws.selectedFollowerDraw ContinuousControlSlice.coordinate
    rw [h.2.2.1]
  unfold downInput
  rw [hslot, hselected, h.2.2.2.2.2]

theorem step_eq_of_reads_agree {p : Parameters} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row row' : CompleteRow p) (alpha : Activation p)
    (t : Fin p.T) (own : Fin p.K × Observation p) (s : State p eta)
    (h : reads_agree i row row' t) :
    step i row alpha t own s = step i row' alpha t own s := by
  classical
  have hl := loggingRound_eq_of_reads_agree i row row' alpha t own h
  have hd := downInput_eq_of_reads_agree i row row' alpha t own h
  have ht : traceAt i row alpha t own = traceAt i row' alpha t own :=
    funext (fun _ => hd)
  unfold step logAt passing_at parsedAt decodeAt
  rw [hl, hd, ht]

/-- Preactivation observations and coordinates are ignored. No batch or log
reset is inferred from any bootstrap/block information. -/
theorem step_before_activation {p : Parameters} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (t : Fin p.T) (own : Fin p.K × Observation p) (s : State p eta)
    (ha : t.val + 1 < alpha.val) : step i row alpha t own s = s := by
  classical
  have hna := Nat.not_le.mpr ha
  have hl : logAt i row alpha t own = [] := by
    simp only [logAt, loggingTestsPass, loggingRound, hna, decide_false,
      Bool.false_eq_true, false_and, ite_false]
  have hd : decodeAt i row alpha t own s.downBatch = (s.downBatch, none) := by
    simp only [decodeAt, downInput, hna, false_and, decide_false,
      Bool.false_eq_true, ite_false]
  have hpnone : parsedAt eta i row alpha t own s.downBatch = none := by
    unfold parsedAt
    rw [hd]
    rfl
  have hp : ¬ passing_at eta i row alpha t own s.downBatch := by
    rintro ⟨M, hm, _⟩
    rw [hpnone] at hm
    cases hm
  simp only [step, hl, hd, hp, decide_false, Bool.or_false, List.append_nil]
  split_ifs <;> rfl

/-- Equality on this selected row's past read coordinates and own active
history suffices for equality of the entire ordinary-state fold. -/
theorem run_eq_of_past_reads {p : Parameters} {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row row' : CompleteRow p) (alpha : Activation p)
    (history history' : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n))
    (s : State p eta)
    (hr : ∀ u ∈ us, alpha.val ≤ u.val + 1 → reads_agree i row row' (calendar hn u))
    (hh : ∀ u ∈ us, alpha.val ≤ u.val + 1 → history u = history' u) :
    run i row alpha history hn us s = run i row' alpha history' hn us s := by
  induction us generalizing s with
  | nil => rfl
  | cons u us ih =>
    have hstep : step i row alpha (calendar hn u) (history u) s =
        step i row' alpha (calendar hn u) (history' u) s := by
      by_cases ha : alpha.val ≤ u.val + 1
      · rw [hh u (List.mem_cons_self) ha]
        exact step_eq_of_reads_agree i row row' alpha _ _ s (hr u (List.mem_cons_self) ha)
      · have hlt : (calendar hn u).val + 1 < alpha.val := Nat.lt_of_not_ge ha
        rw [step_before_activation i row alpha _ _ s hlt,
          step_before_activation i row' alpha _ _ s hlt]
    rw [run, run, hstep]
    exact ih _ (fun v hv => hr v (List.mem_cons_of_mem u hv))
      (fun v hv => hh v (List.mem_cons_of_mem u hv))

/-- Causal equality for the concrete replay. Only offsets `< n` after activation
are compared. In particular future coordinates, forward arrays, other rows and
proposal coordinates cannot affect this local replay with a supplied history. -/
theorem replay_eq_of_past_reads {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row row' : CompleteRow p) (alpha : Activation p)
    (history history' : LocalHistory p n) (hn : n ≤ p.T)
    (hr : ∀ u : Fin n, alpha.val ≤ u.val + 1 → reads_agree i row row' (calendar hn u))
    (hh : ∀ u : Fin n, alpha.val ≤ u.val + 1 → history u = history' u) :
    replay eta i row alpha history hn = replay eta i row' alpha history' hn :=
  run_eq_of_past_reads i row row' alpha history history' hn _ (initial p eta)
    (fun u _ => hr u) (fun u _ => hh u)

/-- Even arbitrary changes to this complete row's forward array are irrelevant. -/
theorem replay_forward_irrelevant {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (forward forward' : ForwardRow p)
    (learning : ContinuousLearningRows.LearningRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) :
    replay eta i (forward, learning) alpha history hn =
      replay eta i (forward', learning) alpha history hn := by
  apply replay_eq_of_past_reads
  · intro _ _
    exact ⟨rfl, rfl, rfl, rfl, fun _ _ => rfl, rfl⟩
  · intro _ _
    rfl

/-- The complete equation audit is also strictly chronological, even across
completed batches. This proves uniqueness of equation-origin calendar rounds. -/
theorem replay_collected_pairwise {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) :
    (AffineBatchDecoder.collected (replay eta i row alpha history hn).downBatch).Pairwise
      (fun a b => a.time.val < b.time.val) := by
  classical
  rw [(replay_batch_spec eta i row alpha history hn).2.2, List.pairwise_flatMap]
  constructor
  · intro u _
    unfold AffineBatchDecoder.positiveAt
    split_ifs
    · exact List.pairwise_singleton _ _
    · exact List.Pairwise.nil
  · apply (List.pairwise_ofFn.mpr (fun a b (hab : a < b) => hab)).imp
    intro u v huv a ha b hb
    obtain ⟨_, rfl⟩ := (mem_positiveAt_iff p _ _ a).mp ha
    obtain ⟨_, rfl⟩ := (mem_positiveAt_iff p _ _ b).mp hb
    exact huv

/-- Each audit decision is the parse of the actual state immediately before
one supplied offset. All earlier updates, including unsuccessful full batches,
are present in that state. -/
theorem mem_decisions_iff {p : Parameters} {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n)) (s : State p eta)
    (d : Fin p.T × DownRecord (codecParams p eta)) :
    d ∈ decisions i row alpha history hn us s ↔
      ∃ before u after, us = before ++ u :: after ∧ d.1 = calendar hn u ∧
        parsedAt eta i row alpha (calendar hn u) (history u)
          (run i row alpha history hn before s).downBatch = some d.2 := by
  induction us generalizing s with
  | nil =>
    constructor
    · intro h
      cases h
    · rintro ⟨before, u, after, h, _⟩
      have hlen := congrArg List.length h
      simp only [List.length_nil, List.length_append, List.length_cons] at hlen
      omega
  | cons v vs ih =>
    rw [decisions, List.mem_append, mem_decisionAt_iff, ih]
    constructor
    · rintro (h | ⟨before, u, after, heq, ht, hm⟩)
      · exact ⟨[], v, vs, rfl, h.1, h.2⟩
      · exact ⟨v :: before, u, after, congrArg (List.cons v) heq, ht, hm⟩
    · rintro ⟨before, u, after, heq, ht, hm⟩
      cases before with
      | nil =>
        have heq' : v = u ∧ vs = after := List.cons.inj heq
        obtain ⟨rfl, rfl⟩ := heq'
        exact Or.inl ⟨ht, hm⟩
      | cons w before =>
        have heq' : v = w ∧ vs = before ++ u :: after := List.cons.inj heq
        obtain ⟨rfl, heq''⟩ := heq'
        exact Or.inr ⟨before, u, after, heq'', ht, hm⟩

/-- Fully expanded failure criterion: a completed local DOWN parse at an
actual offset in this prefix passed `acceptDown cp 0 (offset+1)`. -/
theorem replay_failure_iff_prefix {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) :
    (replay eta i row alpha history hn).initializationFailure = true ↔
      ∃ before u after M,
        List.ofFn (fun u : Fin n => u) = before ++ u :: after ∧
        parsedAt eta i row alpha (calendar hn u) (history u)
          (run i row alpha history hn before (initial p eta)).downBatch = some M ∧
        acceptDown (codecParams p eta) 0 (u.val + 1) M := by
  rw [replay_failure_iff]
  constructor
  · rintro ⟨⟨t, M⟩, hd, ha⟩
    obtain ⟨before, u, after, heq, ht, hm⟩ :=
      (mem_decisions_iff i row alpha history hn _ (initial p eta) _).mp hd
    change t = calendar hn u at ht
    rw [ht] at ha
    exact ⟨before, u, after, M, heq, hm, ha⟩
  · rintro ⟨before, u, after, M, heq, hm, ha⟩
    refine ⟨(calendar hn u, M), ?_, ha⟩
    exact (mem_decisions_iff i row alpha history hn _ (initial p eta) _).mpr
      ⟨before, u, after, heq, rfl, hm⟩

/-- Exact branch-local scalar/sample agreement. DATA reads `rec`, then reads
`thin` and other pilots only when this follower is the source. DOWN reads `sel`,
then this follower's DOWN sample only when selected. UP reads `sel` for its offer.
The replay theorem below asks for this only at active PAST offsets. -/
def selected_reads_agree {p : Parameters} (i : Fin (p.m - 1))
    (row row' : CompleteRow p) (t : Fin p.T) : Prop :=
  (row.2 t).1 ContinuousControlSlice.Label.slot =
    (row'.2 t).1 ContinuousControlSlice.Label.slot ∧
  (PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.dataSlot →
    (row.2 t).1 ContinuousControlSlice.Label.rec =
      (row'.2 t).1 ContinuousControlSlice.Label.rec ∧
    (PublicDiscreteDraws.recorderSourceDraw p.two_le_m p.m_lt_K (row.2 t).1 =
        PublicDiscreteDraws.followerPlayer p.two_le_m i →
      (row.2 t).1 ContinuousControlSlice.Label.thin =
        (row'.2 t).1 ContinuousControlSlice.Label.thin ∧
      ∀ j : Fin p.m, j ≠ PublicDiscreteDraws.followerPlayer p.two_le_m i →
        (row.2 t).1 (ContinuousControlSlice.Label.pilot j) =
          (row'.2 t).1 (ContinuousControlSlice.Label.pilot j))) ∧
  ((PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.downSlot ∨
      PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.upSlot) →
    (row.2 t).1 ContinuousControlSlice.Label.sel =
      (row'.2 t).1 ContinuousControlSlice.Label.sel) ∧
  (PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.downSlot →
    PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row.2 t).1 = i →
      (row.2 t).2 (0, i) = (row'.2 t).2 (0, i))

/-- State DATA logging depends only on the coordinates in its actual branch. -/
theorem logAt_eq_of_selected_reads {p : Parameters} (i : Fin (p.m - 1))
    (row row' : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p) (h : selected_reads_agree i row row' t) :
    logAt i row alpha t own = logAt i row' alpha t own := by
  classical
  have hslot : PublicDiscreteDraws.slotDraw (row.2 t).1 =
      PublicDiscreteDraws.slotDraw (row'.2 t).1 := by
    unfold PublicDiscreteDraws.slotDraw ContinuousControlSlice.coordinate
    rw [h.1]
  by_cases hd : PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.dataSlot
  · have hsource : PublicDiscreteDraws.recorderSourceDraw p.two_le_m p.m_lt_K (row.2 t).1 =
        PublicDiscreteDraws.recorderSourceDraw p.two_le_m p.m_lt_K (row'.2 t).1 := by
      unfold PublicDiscreteDraws.recorderSourceDraw ContinuousControlSlice.coordinate
      rw [(h.2.1 hd).1]
    by_cases hs : PublicDiscreteDraws.recorderSourceDraw p.two_le_m p.m_lt_K (row.2 t).1 =
        PublicDiscreteDraws.followerPlayer p.two_le_m i
    · obtain ⟨hthin, hp⟩ := (h.2.1 hd).2 hs
      have hpilots : (fun j : Fin (p.m - 1) => PublicDiscreteDraws.pilotDraw (K_pos p)
          (otherPlayer p i j) (row.2 t).1) =
          (fun j : Fin (p.m - 1) => PublicDiscreteDraws.pilotDraw (K_pos p)
            (otherPlayer p i j) (row'.2 t).1) := by
        funext j
        unfold PublicDiscreteDraws.pilotDraw ContinuousControlSlice.coordinate
        rw [hp _ (otherPlayer_ne p i j)]
      have hl : loggingRound i row alpha t own = loggingRound i row' alpha t own := by
        unfold loggingRound
        rw [hslot, hsource, hpilots, hthin]
      unfold logAt
      rw [hl]
    · have hn : ¬ loggingTestsPass (loggingRound i row alpha t own) :=
        fun ht => hs ((loggingTestsPass_iff i row alpha t own).mp ht).2.2.1
      have hn' : ¬ loggingTestsPass (loggingRound i row' alpha t own) := by
        intro ht
        exact hs (hsource.trans ((loggingTestsPass_iff i row' alpha t own).mp ht).2.2.1)
      rw [logAt, logAt, ite_eq_right hn, ite_eq_right hn']
  · have hn : ¬ loggingTestsPass (loggingRound i row alpha t own) :=
      fun ht => hd ((loggingTestsPass_iff i row alpha t own).mp ht).2.1
    have hn' : ¬ loggingTestsPass (loggingRound i row' alpha t own) := by
      intro ht
      exact hd (hslot.trans ((loggingTestsPass_iff i row' alpha t own).mp ht).2.1)
    rw [logAt, logAt, ite_eq_right hn, ite_eq_right hn']

/-- DOWN updates need neither unread samples nor unrelated slot coordinates. -/
theorem decodeAt_eq_of_selected_reads {p : Parameters} (i : Fin (p.m - 1))
    (row row' : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (own : Fin p.K × Observation p)
    (batch : AffineBatchDecoder.State p.T (AffineBatchDecoder.width p))
    (h : selected_reads_agree i row row' t) :
    decodeAt i row alpha t own batch = decodeAt i row' alpha t own batch := by
  classical
  have hslot : PublicDiscreteDraws.slotDraw (row.2 t).1 =
      PublicDiscreteDraws.slotDraw (row'.2 t).1 := by
    unfold PublicDiscreteDraws.slotDraw ContinuousControlSlice.coordinate
    rw [h.1]
  by_cases hd : PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.downSlot
  · have hsel : PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row.2 t).1 =
        PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row'.2 t).1 := by
      unfold PublicDiscreteDraws.selectedFollowerDraw ContinuousControlSlice.coordinate
      rw [h.2.2.1 (Or.inl hd)]
    by_cases hs : PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row.2 t).1 = i
    · have hi : downInput i row alpha t own = downInput i row' alpha t own := by
        unfold downInput
        rw [hslot, hsel, h.2.2.2 hd hs]
      have ht : traceAt i row alpha t own = traceAt i row' alpha t own :=
        funext (fun _ => hi)
      unfold decodeAt
      rw [hi, ht]
    · have hs' : PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row'.2 t).1 ≠ i :=
        fun ht => hs (hsel.trans ht)
      simp only [decodeAt, downInput, hs, hs', and_false, decide_false,
        Bool.false_eq_true, ite_false]
  · have hd' : PublicDiscreteDraws.slotDraw (row'.2 t).1 ≠ PublicDiscreteDraws.downSlot :=
      fun ht => hd (hslot.trans ht)
    simp only [decodeAt, downInput, hd, hd', false_and, and_false, decide_false,
      Bool.false_eq_true, ite_false]

/-- Equality of exactly the selected ordinary reads preserves every state field. -/
theorem step_eq_of_selected_reads {p : Parameters} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row row' : CompleteRow p) (alpha : Activation p)
    (t : Fin p.T) (own : Fin p.K × Observation p) (s : State p eta)
    (h : selected_reads_agree i row row' t) :
    step i row alpha t own s = step i row' alpha t own s := by
  classical
  have hl := logAt_eq_of_selected_reads i row row' alpha t own h
  have hd := decodeAt_eq_of_selected_reads i row row' alpha t own s.downBatch h
  unfold step passing_at parsedAt
  rw [hl, hd]

/-- The UP placeholder and its encoding also obey the branch-local read rule. -/
theorem upOffer_eq_of_selected_reads {p : Parameters} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row row' : CompleteRow p) (alpha : Activation p) (t : Fin p.T)
    (h : selected_reads_agree i row row' t) :
    upOffer eta i row alpha t = upOffer eta i row' alpha t ∧
      upWord eta i row alpha t = upWord eta i row' alpha t := by
  classical
  have hslot : PublicDiscreteDraws.slotDraw (row.2 t).1 =
      PublicDiscreteDraws.slotDraw (row'.2 t).1 := by
    unfold PublicDiscreteDraws.slotDraw ContinuousControlSlice.coordinate
    rw [h.1]
  have ho : upOffer eta i row alpha t = upOffer eta i row' alpha t := by
    by_cases hu : PublicDiscreteDraws.slotDraw (row.2 t).1 = PublicDiscreteDraws.upSlot
    · have hsel : PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row.2 t).1 =
          PublicDiscreteDraws.selectedFollowerDraw p.two_le_m p.m_lt_K (row'.2 t).1 := by
        unfold PublicDiscreteDraws.selectedFollowerDraw ContinuousControlSlice.coordinate
        rw [h.2.2.1 (Or.inr hu)]
      unfold upOffer
      rw [hslot, hsel]
    · have hu' : PublicDiscreteDraws.slotDraw (row'.2 t).1 ≠ PublicDiscreteDraws.upSlot :=
        fun ht => hu (hslot.trans ht)
      simp only [upOffer, hu, hu', false_and, and_false, ite_false]
  exact ⟨ho, congrArg (Option.map (encodeUp (codecParams p eta))) ho⟩

/-- Exact branch-local causal equality of the ordinary fold. -/
theorem run_eq_of_selected_past_reads {p : Parameters} {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row row' : CompleteRow p) (alpha : Activation p)
    (history history' : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n)) (s : State p eta)
    (hr : ∀ u ∈ us, alpha.val ≤ u.val + 1 →
      selected_reads_agree i row row' (calendar hn u))
    (hh : ∀ u ∈ us, alpha.val ≤ u.val + 1 → history u = history' u) :
    run i row alpha history hn us s = run i row' alpha history' hn us s := by
  induction us generalizing s with
  | nil => rfl
  | cons u us ih =>
    have hstep : step i row alpha (calendar hn u) (history u) s =
        step i row' alpha (calendar hn u) (history' u) s := by
      by_cases ha : alpha.val ≤ u.val + 1
      · rw [hh u (List.mem_cons_self) ha]
        exact step_eq_of_selected_reads i row row' alpha _ _ s (hr u (List.mem_cons_self) ha)
      · have hlt : (calendar hn u).val + 1 < alpha.val := Nat.lt_of_not_ge ha
        rw [step_before_activation i row alpha _ _ s hlt,
          step_before_activation i row' alpha _ _ s hlt]
    rw [run, run, hstep]
    exact ih _ (fun v hv => hr v (List.mem_cons_of_mem u hv))
      (fun v hv => hh v (List.mem_cons_of_mem u hv))

/-- Exact selected-row PAST reads and equal own-history prefix determine the
state. There is no assumption about physical initialization or future rows. -/
theorem replay_eq_of_selected_past_reads {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row row' : CompleteRow p) (alpha : Activation p)
    (history history' : LocalHistory p n) (hn : n ≤ p.T)
    (hr : ∀ u : Fin n, alpha.val ≤ u.val + 1 →
      selected_reads_agree i row row' (calendar hn u))
    (hh : ∀ u : Fin n, alpha.val ≤ u.val + 1 → history u = history' u) :
    replay eta i row alpha history hn = replay eta i row' alpha history' hn :=
  run_eq_of_selected_past_reads i row row' alpha history history' hn _ (initial p eta)
    (fun u _ => hr u) (fun u _ => hh u)

/-- A selected-UP offer is exactly the replay's accepted-start/service/queue
register tuple, all zero by the proved register invariant. -/
theorem replay_upOffer_fields {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (t : Fin p.T)
    (M : UpRecord (codecParams p eta)) (hm : upOffer eta i row alpha t = some M) :
    M.val = ⟨acceptedStart (replay eta i row alpha history hn),
      (replay eta i row alpha history hn).S, (replay eta i row alpha history hn).delta,
      (replay eta i row alpha history hn).backlog⟩ := by
  obtain ⟨_, hstart, hS, hd, hb, _⟩ := replay_registers eta i row alpha history hn
  rw [hstart, hS, hd, hb]
  exact upOffer_fields eta i row alpha t M hm

/-- An entirely preactivation list leaves even a partially filled input batch
unchanged. This is preservation, not a reset. -/
theorem run_before_activation {p : Parameters} {n : ℕ} {eta : LearningRate}
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (us : List (Fin n)) (s : State p eta)
    (ha : ∀ u ∈ us, u.val + 1 < alpha.val) :
    run i row alpha history hn us s = s := by
  induction us generalizing s with
  | nil => rfl
  | cons u us ih =>
    rw [run, step_before_activation i row alpha _ _ s (ha u List.mem_cons_self)]
    exact ih s (fun v hv => ha v (List.mem_cons_of_mem u hv))

/-- In particular, a prefix ending before activation has the fresh state. -/
theorem replay_before_activation {p : Parameters} {n : ℕ} (eta : LearningRate)
    (i : Fin (p.m - 1)) (row : CompleteRow p) (alpha : Activation p)
    (history : LocalHistory p n) (hn : n ≤ p.T) (ha : n < alpha.val) :
    replay eta i row alpha history hn = initial p eta := by
  apply run_before_activation
  intro u _
  exact (Nat.succ_le_of_lt u.isLt).trans_lt ha

end Bandits.Support.ReferencePrelaunchFollower

